      const totalOccupants = areas.reduce((sum, a) => sum + a.occupantLoad, 0);

      expect(totalOccupants).toBe(150);
    });

    test('should exclude exitways from occupant load calculation', () => {
      // Para 1.4.3: Do not include exitways in occupant load
      const areas = [
        { area: 1000, activity: 'Office spaces', occupantLoad: 100, isExitway: false },
        { area: 100, activity: 'Exitway', occupantLoad: 0, isExitway: true }
      ];

      const occupiedAreas = areas.filter(a => !a.isExitway);
      const totalOccupants = occupiedAreas.reduce((sum, a) => sum + a.occupantLoad, 0);

      expect(totalOccupants).toBe(100);
      expect(areas.length).toBe(2);
      expect(occupiedAreas.length).toBe(1);
    });

    test('should exclude intermittent use spaces (lift lobbies, bathrooms)', () => {
      // Brief transitional use - don't include in total
      const areas = [
        { area: 1000, activity: 'Office spaces', occupantLoad: 100, intermittent: false },
        { area: 50, activity: 'Lift lobby', occupantLoad: 5, intermittent: true },
        { area: 30, activity: 'Bathrooms', occupantLoad: 3, intermittent: true }
      ];

      const permanentAreas = areas.filter(a => !a.intermittent);
      const totalOccupants = permanentAreas.reduce((sum, a) => sum + a.occupantLoad, 0);

      expect(totalOccupants).toBe(100); // Excludes lift lobby and bathrooms
    });
  });

  describe('Standing Space Adjacent to Fixed Seating (Para 1.4.4)', () => {
    test('should calculate standing area at 0.4 m²/person', () => {
      const standingArea = 40; // m²
      const standingDensity = 0.4; // m²/person
      const standingOccupants = Math.ceil(standingArea / standingDensity);

      // 40m² / 0.4 = 100 people
      expect(standingOccupants).toBe(100);
    });

    test('should ensure standing area does not obstruct escape routes', () => {
      // This is a validation check, not a calculation
      const standingArea = {
        area: 40,
        obstructsEscapeRoute: false,
        adjacentToFixedSeating: true
      };

      expect(standingArea.obstructsEscapeRoute).toBe(false);
    });

    test('should combine fixed seating and standing area', () => {
      const fixedSeats = 150;
      const standingArea = 40;
      const standingOccupants = standingArea / 0.4;
      const totalOccupants = fixedSeats + standingOccupants;

      expect(totalOccupants).toBe(250); // 150 + 100
    });
  });
});

