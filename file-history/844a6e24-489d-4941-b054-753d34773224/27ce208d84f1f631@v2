describe('WB 15m Boundary and Storage Height Compound Condition', () => {
  test('should NOT enhance FRR when ≥15m from boundary even if storage >3m', () => {
    const baseRatings = { life: 60, property: 120 };
    const result = applyBoundaryStorageModification(baseRatings, 'WB', true, 4.0, false);

    // Only one condition met (storage > 3m), but boundary ≥ 15m
    // Should NOT get enhanced rating
    expect(result.property).toBe(120); // Standard, not 180
    expect(result.propertyAlt).toBeUndefined();
  });

  test('should enhance FRR when < 15m from boundary AND storage >3m', () => {
    const baseRatings = { life: 60, property: 120 };
    const result = applyBoundaryStorageModification(baseRatings, 'WB', false, 4.0, false);

    // Both conditions met
    expect(result.property).toBe(180); // Enhanced per Note 2
  });

  test('should test exact 3.0m storage boundary', () => {
    const baseRatings = { life: 60, property: 120 };

    // At exactly 3.0m - should NOT enhance (> 3m means strictly greater)
    const resultAt3 = applyBoundaryStorageModification(baseRatings, 'WB', false, 3.0, false);
    expect(resultAt3.property).toBe(120); // Not enhanced at 3.0m

    // At 3.01m - should enhance
    const resultAbove3 = applyBoundaryStorageModification(baseRatings, 'WB', false, 3.01, false);
    expect(resultAbove3.property).toBe(180); // Enhanced above 3.0m
  });

  test('should test 15m boundary with storage at 3.0m vs 3.1m', () => {
    const baseRatings = { life: 60, property: 120 };

    // At 15m boundary (false = < 15m), storage at 3.0m
    const result1 = applyBoundaryStorageModification(baseRatings, 'WB', false, 3.0, false);
    expect(result1.property).toBe(120); // No enhancement (storage not > 3m)

    // At 15m boundary (false = < 15m), storage at 3.1m
    const result2 = applyBoundaryStorageModification(baseRatings, 'WB', false, 3.1, false);
    expect(result2.property).toBe(180); // Enhanced (both conditions met)
  });
});

