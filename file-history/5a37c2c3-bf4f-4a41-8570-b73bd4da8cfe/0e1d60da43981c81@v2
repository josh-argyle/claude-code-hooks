// NEW: Toggle NZS 4515 substitution choice based on scope
function toggleNZS4515Substitution() {
  const scopeSelect = document.querySelectorAll('.nzs-4515-scope-select');

  scopeSelect.forEach(select => {
    select.addEventListener('change', function() {
      const firecellDiv = this.closest('.firecell-item');
      const choiceDiv = firecellDiv.querySelector('.nzs-4515-substitution-choice');

      if (this.value === 'true') {
        choiceDiv.style.display = 'block';
      } else {
        choiceDiv.style.display = 'none';
        // Uncheck the substitution checkbox if scope is exceeded
        const checkbox = choiceDiv.querySelector('input[type="checkbox"]');
        if (checkbox) checkbox.checked = false;
      }
    });
  });
}

// Call on page load
document.addEventListener('DOMContentLoaded', toggleNZS4515Substitution);
