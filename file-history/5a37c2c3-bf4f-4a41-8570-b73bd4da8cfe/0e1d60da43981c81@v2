validateFirecell(firecellData) {
  // ... existing validations ...

  // NEW: Validate SM/SI occupant type
  if (['SM', 'SI'].includes(firecellData.riskGroup)) {
    if (firecellData.smOccupantType || firecellData.siOccupantType) {
      const occupantType = firecellData.smOccupantType || firecellData.siOccupantType;
      const validTypes = ['permanent', 'transient', 'education', 'care or detention'];
      if (!validTypes.includes(occupantType)) {
        throw new Error(`Invalid occupant type for SM/SI: ${occupantType}`);
      }
    }
  }

  // NEW: Validate installed fire safety systems
  if (firecellData.installedFireSafetySystems !== undefined) {
    if (!Array.isArray(firecellData.installedFireSafetySystems)) {
      throw new Error('installedFireSafetySystems must be an array');
    }
    // Validate each system code
    firecellData.installedFireSafetySystems.forEach(code => {
      if (code === 'none' || code === 'NZS-4515') return; // Special codes
      const numericCode = parseInt(code);
      if (isNaN(numericCode) || numericCode < 1 || numericCode > 20) {
        throw new Error(`Invalid fire safety system code: ${code}`);
      }
    });
  }

  // NEW: Validate NZS 4515 flags
  if (firecellData.usesNZS4515Sprinklers !== undefined && typeof firecellData.usesNZS4515Sprinklers !== 'boolean') {
    throw new Error('usesNZS4515Sprinklers must be a boolean');
  }

  const validatedFirecell = {
    // ... existing properties ...
  };

  // NEW: Add SM/SI occupant type
  if (firecellData.riskGroup === 'SM' && firecellData.smOccupantType) {
    validatedFirecell.smOccupantType = firecellData.smOccupantType;
  }
  if (firecellData.riskGroup === 'SI' && firecellData.siOccupantType) {
    validatedFirecell.siOccupantType = firecellData.siOccupantType;
  }

  // NEW: Add NZS 4515 flags
  if (firecellData.usesNZS4515Sprinklers !== undefined) {
    validatedFirecell.usesNZS4515Sprinklers = firecellData.usesNZS4515Sprinklers;
  }

  // NEW: Add installed systems
  if (firecellData.installedFireSafetySystems) {
    validatedFirecell.installedFireSafetySystems = firecellData.installedFireSafetySystems;
  }

  return validatedFirecell;
}

// NEW: Helper method to calculate total building floor area
getTotalFloorArea() {
  return this.firecells.reduce((sum, fc) => sum + (fc.floorArea || 0), 0);
}

// NEW: Helper method to check NZS 4515 scope
isWithinNZS4515Scope() {
  return this.getTotalFloorArea() <= 2000;
}
