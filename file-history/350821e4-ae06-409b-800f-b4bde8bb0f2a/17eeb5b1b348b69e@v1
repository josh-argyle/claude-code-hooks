extends layout

block content
  h1= title

  div
    button#fillTestData(type="button") Fill Test Data

  form#projectForm(method="post", action="/process")

    // C/AS2 Scope Validation (Para 1.1.2)
    fieldset
      legend C/AS2 Scope Confirmation
      p.help-text(style="font-style: italic; color: #666; margin-bottom: 15px;")
        | This compliance pathway (C/AS2) is NOT suitable for buildings with complex features.
        | Please confirm your building does NOT have any of the following:

      ul(style="margin-left: 20px; margin-bottom: 15px; color: #444;")
        li Atriums
        li Prison facilities
        li Recreation centres with tiered seating for more than 2000 people
        li Non-limited intermediate floors
        li More than 20 storeys above ground
        li
          | Building features requiring a stay-in-place evacuation strategy (C/AS2 does not provide for these):
          ul(style="margin-left: 20px; margin-top: 5px;")
            li Operating theatres
            li Intensive care units
            li Hyperbaric chambers
            li Delivery rooms
            li Recovery rooms

      p(style="color: #d32f2f; font-weight: bold; margin-bottom: 10px;")
        | If your building has any of these features, alternative compliance methods are required.

      div
        label(for="confirmedNoComplexFeatures" style="display: flex; align-items: center; gap: 10px;")
          input#confirmedNoComplexFeatures(type="checkbox", name="confirmedNoComplexFeatures", required)
          span I confirm this building does NOT have any of the complex features listed above (Required)

    // Project-level fields
    fieldset
      legend Project Information

      div
        label(for="hasRemoteReceivingCentreConnection") Has Remote Receiving Centre Connection:
        select#hasRemoteReceivingCentreConnection(name="hasRemoteReceivingCentreConnection")
          option(value="") -- Select --
          option(value="true") Yes
          option(value="false") No

      div
        label(for="storesHazardousGoods") Stores Hazardous Goods:
        select#storesHazardousGoods(name="storesHazardousGoods")
          option(value="") -- Select --
          option(value="true") Yes
          option(value="false") No

      div
        label(for="distanceFromBoundary15mOrMore") Distance from Relevant Boundary:
        select#distanceFromBoundary15mOrMore(name="distanceFromBoundary15mOrMore")
          option(value="") -- Select --
          option(value="true") 15 metres or greater
          option(value="false") Less than 15 metres
        p.help-text(style="font-style: italic; color: #666; margin-top: 5px;")
          | For WB/VP unsprinklered buildings over 5000m², unlimited floor area is permitted when ≥15m from relevant boundary (C/AS2 Table 2.1 Note 2).

    // Building vertical structure
    fieldset
      legend Building Vertical Structure
      p.help-text(style="font-style: italic; color: #666; margin-bottom: 15px;") Define the number of floors in your building. This is used to check single-level building requirements in Notes 1b and 1c.

      div(style="display: flex; gap: 20px; margin-bottom: 15px;")
        div(style="flex: 1;")
          label(for="numberOfFloorsAboveGround") Floors Above Ground:
          input#numberOfFloorsAboveGround(type="number", name="numberOfFloorsAboveGround", min="0", max="50", value="0", required, title="Number of floors above ground level (not including ground floor itself). Example: 3 means Ground + 1st + 2nd + 3rd floor.")

        div(style="flex: 1;")
          label(for="numberOfBasementLevels") Basement Levels:
          input#numberOfBasementLevels(type="number", name="numberOfBasementLevels", min="0", max="10", value="0", required, title="Number of basement levels below ground. Example: 2 means B1 and B2.")

      div.floor-preview(style="padding: 10px; background: #f5f5f5; border-radius: 4px; margin-top: 10px;")
        strong Available Floors:
        span#floorPreview G

    // Firecells section
    fieldset
      legend Firecells

      div#firecellsContainer
        // Initial firecell
        div.firecell-item(data-index="0")
          h3 Firecell 1

          div
            label Risk Group:
            select(name="firecells[0][riskGroup]", required, onchange="toggleConditionalFields(this)")
              option(value="") -- Select Risk Group --
              each riskGroup in riskGroups
                option(value=riskGroup)= riskGroup

          // SM/SI: Sleeping occupant type dropdown (4 options)
          div.sleeping-occupant-type(style="display: none;")
            label Sleeping Occupant Type:
            select(name="firecells[0][sleepingOccupantType]", required)
              option(value="") -- Select Occupant Type --
              option(value="permanent") Permanent Accommodation (apartments, boarding houses)
              option(value="transient") Transient Accommodation (hotels, motels, hostels)
              option(value="education") Educational Accommodation (boarding schools, university halls)
              option(value="careOrDetention") Care or Detention (hospitals, prisons, aged care)
            p.help-text(style="font-size: 0.9em; color: #666; font-style: italic; margin-top: 5px;")
              | This determines which fire safety systems are required per CAS2 Table 2.2

          // CA/WB/WS/VP: Occupant density activity dropdown (50+ options)
          div.other-occupant-type
            label Occupant Density Activity:
            select(name="firecells[0][occupantType]", required)
              option(value="") -- Select Activity Type --
              each occupantType in occupantTypes
                option(value=occupantType)= occupantType
            p.help-text(style="font-size: 0.9em; color: #666; font-style: italic; margin-top: 5px;")
              | Used to calculate occupant load from floor area per CAS2 Table 1.2

          // SM/SI: Show "Bed Spaces" input (manual entry)
          div.sm-si-only(style="display: none;")
            label Bed Spaces:
            input.bed-spaces-input(type="number", name="firecells[0][occupantLoad]", min="0", step="1", title="Number of beds (accounts for staff and visitors per CAS2 1.4.5)", placeholder="e.g., 10 beds")

          // CA/WB/WS/VP: Show read-only calculated occupant load (optional UX enhancement)
          div.calculated-occupant-load(style="display: none;")
            label Calculated Occupant Load:
            input(type="text", readonly, disabled, title="Auto-calculated from floor area and activity type per CAS2 Table 1.2", placeholder="Will be calculated automatically", style="background-color: #f0f0f0; cursor: not-allowed;")

          div
            label Escape Height (m):
            input(type="number", name="firecells[0][escapeHeight]", min="0", step="0.1", required)

          div
            label Is Sprinklered:
            select(name="firecells[0][isSprinklered]", required)
              option(value="") -- Select --
              option(value="true") Yes
              option(value="false") No

          div
            label Floor Area (m²):
            input(type="number", name="firecells[0][floorArea]", min="0.1", step="0.1", required)

          div
            label Floor:
            select.firecell-floor(name="firecells[0][floor]", required, title="Select which floor this firecell is located on. Required for single-level building checks (Notes 1b and 1c).")
              option(value="") -- Select Floor --

          // Escape Route Configuration
          fieldset.escape-routes-config
            legend Escape Route Configuration
            p.help-text(style="font-style: italic; color: #666; margin-bottom: 10px;")
              | Based on your building's architectural drawings and CAS2 Table 3.1 requirements.

            div
              label Number of Escape Routes:
              input.route-count(type="number", name="firecells[0][numberOfEscapeRoutes]", min="1", max="10", required, title="Total number of escape routes from this firecell per CAS2 Table 3.1")
              span.required-routes-hint(style="margin-left: 10px; color: #666; font-style: italic;")
                | (CAS2 Table 3.1 requires:
                span.min-routes -
                |  routes for this occupant load)

            // SM/SI: Maximum beds per route
            div.sm-si-route-distribution(style="display: none;")
              label Maximum Beds on Largest Escape Route:
              input(type="number", name="firecells[0][maxEscapeRouteBeds]", min="0", title="The highest number of beds served by any single escape route", placeholder="e.g., 10 beds")
              p.help-text(style="font-size: 0.9em; color: #666; margin-top: 5px;")
                | If routes serve different numbers of beds, enter the LARGEST number served by any one route.
                br
                | Example: Route A serves 10 beds, Route B serves 8 beds → Enter 10

            // CA/WB/WS/VP: Maximum occupants per route
            div.other-route-distribution(style="display: none;")
              label Maximum Occupants on Largest Escape Route:
              input(type="number", name="firecells[0][maxEscapeRouteOccupants]", min="0", title="The highest number of occupants served by any single escape route", placeholder="e.g., 50 occupants")
              p.help-text(style="font-size: 0.9em; color: #666; margin-top: 5px;")
                | If routes serve different numbers of occupants, enter the LARGEST number served by any one route.

          // Conditional fields for VP risk group
          div.vp-only(style="display: none;")
            label Has Vehicle Stacker:
            select(name="firecells[0][hasVehicleStacker]")
              option(value="") -- Select --
              option(value="true") Yes
              option(value="false") No

          // Conditional fields for CA risk group
          div.ca-only(style="display: none;")
            label Is Cinema or Theatre:
            select(name="firecells[0][isCinemaOrTheatre]")
              option(value="") -- Select --
              option(value="true") Yes
              option(value="false") No

            div
              label Is Early Childhood Centre:
              select.early-childhood-toggle(name="firecells[0][isEarlyChildhoodCentre]")
                option(value="") -- Select --
                option(value="true") Yes
                option(value="false") No

          // Conditional fields for CA early childhood centres - Condition (a): Escape height ≤ 2.0m
          div.early-childhood-low-height(style="display: none;")
            p.info-message(style="font-style: italic; color: #666; margin: 10px 0;") CAS2 2.2.4(a) - Single storey early childhood centre requirements

            div
              label Has Dedicated Sleeping Areas:
              select.sleeping-areas-toggle(name="firecells[0][hasDedicatedSleepingAreas]")
                option(value="") -- Select --
                option(value="true") Yes
                option(value="false") No

            div.sleeping-area-fields(style="display: none;")
              label(title="Required for dedicated sleeping areas in single-storey early childhood centres per NZS 4512") Supplementary smoke detectors compliant with NZS 4512:
              select(name="firecells[0][supplementarySmokeDetectorsCompliant]")
                option(value="") -- Select --
                option(value="true") Yes - Compliant
                option(value="false") No - Non-compliant

          // Conditional fields for CA early childhood centres - Condition (b): Escape height > 2.0m
          div.early-childhood-high-height(style="display: none;")
            div
              label(title="Two separate places of safety with fire separations and direct access to safe path/final exit per CAS2 2.2.4(b)(ii)&(iii)") Two separate places of safety with fire separations and direct access:
              select(name="firecells[0][placesOfSafetyCompliant]")
                option(value="") -- Select --
                option(value="true") Yes - Compliant
                option(value="false") No - Non-compliant

          button.remove-firecell(type="button", style="display: none;") Remove Firecell

      div
        button#addFirecell(type="button") Add Another Firecell

    div
      button(type="submit") Process Project

