const { generateComplianceParagraphs } = require('../../../../api/processors/fire-safety-systems/compliance-generator');
const ProjectModel = require('../../../../api/models/project-model');

describe('Fire Safety Systems Compliance Generator', () => {
  test('should return array of paragraphs', () => {
    const projectModel = new ProjectModel();
    projectModel.addFirecell({
      riskGroup: 'SM',
      sleepingOccupantType: 'permanent',
      occupantLoad: 30,
      escapeHeight: 8,
      isSprinklered: false,
      floorArea: 400,
      floor: 'G'
    });
    projectModel.firecells[0].processedFireSafetySystems = [
      {
        code: '1',
        type: 1,
        definition: 'Type 1 – Domestic smoke alarm system'
      }
    ];
    projectModel.remoteReceivingCentreCompliance = {
      required: false,
      provided: false,
      status: 'compliant',
      message: 'Not required for permanent accommodation with escape height < 10m'
    };

    const result = generateComplianceParagraphs(projectModel);

    expect(Array.isArray(result)).toBe(true);
    expect(result.length).toBeGreaterThan(0);
  });

  test('should include C/AS2 intro paragraph with Table 2.2 reference', () => {
    const projectModel = new ProjectModel();
    projectModel.addFirecell({
      riskGroup: 'WB',
      occupantType: 'Office spaces',
      occupantLoad: 50,
      escapeHeight: 12,
      isSprinklered: false,
      floorArea: 400,
      floor: 'G'
    });
    projectModel.firecells[0].processedFireSafetySystems = [
      {
        code: '5',
        type: 5,
        definition: 'Type 5 – Automatic fire alarm system'
      }
    ];
    projectModel.remoteReceivingCentreCompliance = {
      required: true,
      provided: true,
      status: 'compliant',
      message: 'Connection provided as required'
    };

    const result = generateComplianceParagraphs(projectModel);

    const intro = result.find(p => p.type === 'info' && p.title.includes('Fire Safety System'));
    expect(intro).toBeDefined();
    expect(intro.content).toContain('C/AS2');
    expect(intro.content).toContain('Table 2.2');
  });

  test('should create table with correct headers and system data', () => {
    const projectModel = new ProjectModel();
    projectModel.addFirecell({
      riskGroup: 'CA',
      occupantType: 'Mall areas used for assembly uses',
      occupantLoad: 100,
      escapeHeight: 15,
      isSprinklered: false,
      floorArea: 500,
      floor: 'G'
    });
    projectModel.firecells[0].processedFireSafetySystems = [
      {
        code: '5',
        type: 5,
        definition: 'Type 5 – Automatic fire alarm system'
      },
      {
        code: '15',
        type: 15,
        definition: 'Type 15 – Emergency lighting system'
      }
    ];
    projectModel.remoteReceivingCentreCompliance = {
      required: true,
      provided: true,
      status: 'compliant',
      message: 'Connection provided'
    };

    const result = generateComplianceParagraphs(projectModel);

    const table = result.find(p => p.type === 'table');
    expect(table).toBeDefined();
    expect(table.content.headers).toContain('Firecell');
    expect(table.content.headers).toContain('Risk Group');
    expect(table.content.headers).toContain('Required Systems');
    expect(table.content.rows.length).toBe(1);
    expect(table.content.rows[0]).toContain('CA');
  });

  test('should include remote receiving centre compliance paragraph', () => {
    const projectModel = new ProjectModel();
    projectModel.addFirecell({
      riskGroup: 'SM',
      sleepingOccupantType: 'permanent',
      occupantLoad: 40,
      escapeHeight: 12,
      isSprinklered: false,
      floorArea: 350,
      floor: 'G'
    });
    projectModel.firecells[0].processedFireSafetySystems = [
      {
        code: '2',
        type: 2,
        definition: 'Type 2 – Manual fire alarm system'
      }
    ];
    projectModel.remoteReceivingCentreCompliance = {
      required: true,
      provided: false,
      status: 'non-compliant',
      message: 'Remote receiving centre connection required but not provided'
    };

    const result = generateComplianceParagraphs(projectModel);

    const compliance = result.find(p => p.type === 'compliance');
    expect(compliance).toBeDefined();
    expect(compliance.content.status).toBe('non-compliant');
    expect(compliance.title).toContain('Remote Receiving Centre');
  });

  test('should handle empty firecells array', () => {
    const projectModel = new ProjectModel();
    projectModel.remoteReceivingCentreCompliance = {
      required: false,
      provided: false,
      status: 'compliant',
      message: 'Not required'
    };

    const result = generateComplianceParagraphs(projectModel);

    expect(Array.isArray(result)).toBe(true);
    // Should still have intro paragraph
    expect(result.length).toBeGreaterThan(0);
  });

  test('should handle multiple firecells with different systems', () => {
    const projectModel = new ProjectModel();

    // Firecell 1
    projectModel.addFirecell({
      riskGroup: 'SM',
      sleepingOccupantType: 'permanent',
      occupantLoad: 30,
      escapeHeight: 8,
      isSprinklered: false,
      floorArea: 400,
      floor: 'G'
    });
    projectModel.firecells[0].processedFireSafetySystems = [
      {
        code: '1',
        type: 1,
        definition: 'Type 1 – Domestic smoke alarm system'
      }
    ];

    // Firecell 2
    projectModel.addFirecell({
      riskGroup: 'WB',
      occupantType: 'Office spaces',
      occupantLoad: 75,
      escapeHeight: 20,
      isSprinklered: false,
      floorArea: 600,
      floor: 'G'
    });
    projectModel.firecells[1].processedFireSafetySystems = [
      {
        code: '5',
        type: 5,
        definition: 'Type 5 – Automatic fire alarm system'
      },
      {
        code: '15',
        type: 15,
        definition: 'Type 15 – Emergency lighting system'
      }
    ];

    projectModel.remoteReceivingCentreCompliance = {
      required: true,
      provided: true,
      status: 'compliant',
      message: 'Connection provided'
    };

    const result = generateComplianceParagraphs(projectModel);

    const table = result.find(p => p.type === 'table');
    expect(table).toBeDefined();
    expect(table.content.rows.length).toBe(2);
  });

  test('all paragraphs should have required structure', () => {
    const projectModel = new ProjectModel();
    projectModel.addFirecell({
      riskGroup: 'WB',
      occupantType: 'Office spaces',
      occupantLoad: 50,
      escapeHeight: 8,
      isSprinklered: false,
      floorArea: 400,
      floor: 'G'
    });
    projectModel.firecells[0].processedFireSafetySystems = [
      {
        code: '2',
        type: 2,
        definition: 'Type 2 – Manual fire alarm system'
      }
    ];
    projectModel.remoteReceivingCentreCompliance = {
      required: false,
      provided: false,
      status: 'compliant',
      message: 'Not required'
    };

    const result = generateComplianceParagraphs(projectModel);

    result.forEach(paragraph => {
      expect(paragraph).toHaveProperty('title');
      expect(paragraph).toHaveProperty('type');
      expect(paragraph).toHaveProperty('content');
      expect(paragraph).toHaveProperty('timestamp');
    });
  });
});