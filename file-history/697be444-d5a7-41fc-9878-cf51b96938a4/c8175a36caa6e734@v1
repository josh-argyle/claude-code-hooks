  describe('Bulk Firecell Operations', () => {
    test('should successfully create all 20 test firecells', () => {
      testFirecells.forEach((firecellData, index) => {
        const firecellIndex = projectModel.addFirecell(firecellData);
        expect(firecellIndex).toBe(index);
      });

      expect(projectModel.getFirecellCount()).toBe(20);
    });

    test('should correctly store and retrieve all firecell data', () => {
      // Add all firecells
      testFirecells.forEach(firecellData => {
        projectModel.addFirecell(firecellData);
      });

      // Verify each one
      testFirecells.forEach((expectedData, index) => {
        const retrievedData = projectModel.getFirecell(index);
        expect(retrievedData).toEqual({
          ...expectedData,
          compliance: {}
        });
      });
    });

    test('should handle mixed operations on all firecells', () => {
      // Add all firecells
      testFirecells.forEach(firecellData => {
        projectModel.addFirecell(firecellData);
      });

      // Update every 3rd firecell
      for (let i = 2; i < 20; i += 3) {
        const updates = { occupantLoad: testFirecells[i].occupantLoad + 10 };
        const updated = projectModel.updateFirecell(i, updates);
        expect(updated.occupantLoad).toBe(testFirecells[i].occupantLoad + 10);
      }

      // Remove every 5th firecell (from the end to maintain indices)
      const toRemove = [19, 14, 9, 4];
      toRemove.forEach(index => {
        const removed = projectModel.removeFirecell(index);
        expect(removed).toBeDefined();
      });

      expect(projectModel.getFirecellCount()).toBe(16);
    });
  });

  describe('Risk Group Coverage', () => {
    beforeEach(() => {
      testFirecells.forEach(firecellData => {
        projectModel.addFirecell(firecellData);
      });
    });

    test('should cover all risk groups', () => {
      const allFirecells = projectModel.getAllFirecells();
      const riskGroups = [...new Set(allFirecells.map(f => f.riskGroup))];

      expect(riskGroups).toEqual(expect.arrayContaining(['SM', 'SI', 'CA', 'WB', 'WS', 'VP']));
      expect(riskGroups.length).toBe(6);
    });

    test('should have appropriate distribution of risk groups', () => {
      const allFirecells = projectModel.getAllFirecells();
      const distribution = allFirecells.reduce((acc, firecell) => {
        acc[firecell.riskGroup] = (acc[firecell.riskGroup] || 0) + 1;
        return acc;
      }, {});

      // Verify we have multiple examples of each risk group
      expect(distribution.SM).toBeGreaterThanOrEqual(2);
      expect(distribution.SI).toBeGreaterThanOrEqual(2);
      expect(distribution.CA).toBeGreaterThanOrEqual(3);
      expect(distribution.WB).toBeGreaterThanOrEqual(3);
      expect(distribution.WS).toBeGreaterThanOrEqual(3);
      expect(distribution.VP).toBeGreaterThanOrEqual(2);
    });
  });

  describe('Configuration Diversity', () => {
    beforeEach(() => {
      testFirecells.forEach(firecellData => {
        projectModel.addFirecell(firecellData);
      });
    });

    test('should include both sprinklered and unsprinklered firecells', () => {
      const allFirecells = projectModel.getAllFirecells();
      const sprinklered = allFirecells.filter(f => f.isSprinklered).length;
      const unsprinklered = allFirecells.filter(f => !f.isSprinklered).length;

      expect(sprinklered).toBeGreaterThan(0);
      expect(unsprinklered).toBeGreaterThan(0);
      expect(sprinklered + unsprinklered).toBe(20);
    });

    test('should cover a wide range of occupant loads', () => {
      const allFirecells = projectModel.getAllFirecells();
      const occupantLoads = allFirecells.map(f => f.occupantLoad);

      const min = Math.min(...occupantLoads);
      const max = Math.max(...occupantLoads);

      expect(min).toBe(1); // Minimum edge case
      expect(max).toBe(1000); // Maximum edge case
      expect(max - min).toBeGreaterThan(900); // Wide range coverage
    });

    test('should cover a range of escape heights', () => {
      const allFirecells = projectModel.getAllFirecells();
      const escapeHeights = allFirecells.map(f => f.escapeHeight);

      const min = Math.min(...escapeHeights);
      const max = Math.max(...escapeHeights);

      expect(min).toBe(2.5); // Low building
      expect(max).toBe(50); // Tall building
      expect(max - min).toBeGreaterThan(40); // Wide range coverage
    });

    test('should include diverse occupant types', () => {
      const allFirecells = projectModel.getAllFirecells();
      const occupantTypes = [...new Set(allFirecells.map(f => f.occupantType))];

