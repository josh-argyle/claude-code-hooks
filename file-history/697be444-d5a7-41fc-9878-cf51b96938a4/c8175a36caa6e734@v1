      expect(occupantTypes.length).toBeGreaterThanOrEqual(15);

      // Verify some key categories are included
      expect(occupantTypes).toEqual(expect.arrayContaining([
        'Office spaces',
        'Bulk storage including racks and shelves',
        'Gaming, casino areas',
        'Care and detention',
        'Parking buildings, garages'
      ]));
    });
