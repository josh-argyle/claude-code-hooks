      // Perform multiple operations
      const snapshot1 = projectModel.getAllFirecells();

      // Update some firecells
      projectModel.updateFirecell(0, { occupantLoad: 999 });
      projectModel.updateFirecell(5, { escapeHeight: 30 });

      // Remove and re-add a firecell
      const removed = projectModel.removeFirecell(10);
      const newIndex = projectModel.addFirecell(removed);

      // Verify integrity
      expect(projectModel.getFirecellCount()).toBe(20);
      expect(projectModel.getFirecell(0).occupantLoad).toBe(999);
      expect(projectModel.getFirecell(5).escapeHeight).toBe(30);
      expect(projectModel.getFirecell(newIndex)).toEqual(removed);
    });

    test('should handle edge cases properly', () => {
      // Test edge case firecells (indices 15 and 16)
      const edgeCase1 = testFirecells[15]; // Max values
      const edgeCase2 = testFirecells[16]; // Min values

      const index1 = projectModel.addFirecell(edgeCase1);
      const index2 = projectModel.addFirecell(edgeCase2);

      const retrieved1 = projectModel.getFirecell(index1);
      const retrieved2 = projectModel.getFirecell(index2);

      expect(retrieved1.occupantLoad).toBe(1000);
      expect(retrieved1.escapeHeight).toBe(50);
      expect(retrieved2.occupantLoad).toBe(1);
      expect(retrieved2.escapeHeight).toBe(2.5);
    });
