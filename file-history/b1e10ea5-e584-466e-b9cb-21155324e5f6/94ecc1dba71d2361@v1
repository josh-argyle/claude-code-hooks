const { getOccupantDensityOptions, validateOccupantDensity } = require('../data');

class ProjectModel {
  constructor() {
    this.firecells = [];
    this.requiresRemoteReceivingCentre = false;
    this.hasRemoteReceivingCentreConnection = undefined;
    this.remoteReceivingCentreCompliance = null;
    this.storesHazardousGoods = undefined;
    this.hazardousSubstancesCompliance = null;
    this.hazardousSubstancesData = undefined;

    // Project identification
    this.projectName = undefined;

    // Building vertical structure configuration
    // Used for standardized floor identifiers in Notes 1b and 1c evaluation
    this.numberOfFloorsAboveGround = 0; // Default: Single-storey (ground floor only)
    this.numberOfBasementLevels = 0;    // Default: No basements

    // Project-level properties for fire-resistance processor
    this.isSprinklered = undefined;
    this.escapeHeight = undefined;
    this.primaryRiskGroup = undefined;
    this.buildingRiskGroup = undefined;
    this.maxStorageHeight = undefined;
    this.hasCrossVentilation = undefined;
    this.distanceFromBoundary15mOrMore = undefined;

    // C/AS2 Scope validation (Para 1.1.2)
    this.confirmedNoComplexFeatures = undefined; // User confirmation that building has no complex features
  }

  addFirecell(firecellData) {
    const validatedFirecell = this.validateFirecell(firecellData);
    this.firecells.push(validatedFirecell);
    return this.firecells.length - 1;
  }

  removeFirecell(index) {
    if (index < 0 || index >= this.firecells.length) {
      throw new Error('Invalid firecell index');
    }
    return this.firecells.splice(index, 1)[0];
  }

  updateFirecell(index, updates) {
    if (index < 0 || index >= this.firecells.length) {
      throw new Error('Invalid firecell index');
    }

    const currentFirecell = this.firecells[index];
    const updatedFirecell = { ...currentFirecell, ...updates };
    const validatedFirecell = this.validateFirecell(updatedFirecell);

    this.firecells[index] = validatedFirecell;
    return this.firecells[index];
  }

  validateFirecell(firecellData) {
    const validRiskGroups = ['SM', 'SI', 'CA', 'WB', 'WS', 'VP'];

    if (!firecellData.riskGroup || !validRiskGroups.includes(firecellData.riskGroup)) {
      throw new Error(`Invalid risk group. Must be one of: ${validRiskGroups.join(', ')}`);
    }

    // Validate SM/SI sleeping occupant type
    if (firecellData.riskGroup === 'SM' || firecellData.riskGroup === 'SI') {
      const validTypes = ['permanent', 'transient', 'education', 'careOrDetention'];

      if (!firecellData.sleepingOccupantType) {
        throw new Error(`${firecellData.riskGroup} risk group requires sleepingOccupantType`);
      }

      if (!validTypes.includes(firecellData.sleepingOccupantType)) {
        throw new Error(`Invalid sleepingOccupantType: ${firecellData.sleepingOccupantType}. Must be one of: ${validTypes.join(', ')}`);
      }

      // SM/SI: Bed spaces are REQUIRED (manual entry per CAS2 Section 1.4.5)
      if (firecellData.occupantLoad === undefined || typeof firecellData.occupantLoad !== 'number' || firecellData.occupantLoad < 0) {
        throw new Error('Bed spaces (occupant load) is required for SM/SI risk groups and must be a non-negative number');
      }
    } else {
      // CA/WB/WS/VP: Validate occupant density activity type
      if (!firecellData.occupantType || typeof firecellData.occupantType !== 'string') {
        throw new Error('Occupant type is required and must be a string');
      }

      if (!validateOccupantDensity(firecellData.occupantType)) {
        throw new Error(`Invalid occupant type: ${firecellData.occupantType}`);
      }

      // occupantLoad is optional (will be calculated)
      if (firecellData.occupantLoad !== undefined) {
        if (typeof firecellData.occupantLoad !== 'number' || firecellData.occupantLoad < 0) {
          throw new Error('Occupant load must be a non-negative number when provided');
        }
      }
    }

    if (firecellData.escapeHeight === undefined || typeof firecellData.escapeHeight !== 'number' || firecellData.escapeHeight < 0) {
      throw new Error('Escape height is required and must be a non-negative number');
    }

    if (typeof firecellData.isSprinklered !== 'boolean') {
      throw new Error('isSprinklered is required and must be a boolean');
    }

    if (firecellData.floorArea === undefined || typeof firecellData.floorArea !== 'number' || firecellData.floorArea <= 0) {
      throw new Error('Floor area is required and must be a positive number');
    }

    // Validate floor identifier (required for Notes 1b and 1c evaluation)
    if (!firecellData.floor || typeof firecellData.floor !== 'string') {
      throw new Error('Floor identifier is required and must be a string');
    }

    // NEW: Validate escape route configuration
    if (firecellData.numberOfEscapeRoutes !== undefined) {
      if (typeof firecellData.numberOfEscapeRoutes !== 'number' || firecellData.numberOfEscapeRoutes < 1) {
        throw new Error('Number of escape routes must be at least 1');
      }
    }

    if (firecellData.riskGroup === 'SM' || firecellData.riskGroup === 'SI') {
      if (firecellData.maxEscapeRouteBeds !== undefined) {
        if (typeof firecellData.maxEscapeRouteBeds !== 'number' || firecellData.maxEscapeRouteBeds < 0) {
          throw new Error('Max escape route beds must be a non-negative number');
        }
      }
    } else {
      if (firecellData.maxEscapeRouteOccupants !== undefined) {
        if (typeof firecellData.maxEscapeRouteOccupants !== 'number' || firecellData.maxEscapeRouteOccupants < 0) {
          throw new Error('Max escape route occupants must be a non-negative number');
        }
      }
    }

    // Validate optional properties
    if (firecellData.hasVehicleStacker !== undefined && typeof firecellData.hasVehicleStacker !== 'boolean') {
      throw new Error('hasVehicleStacker must be a boolean when provided');
    }

    if (firecellData.isCinemaOrTheatre !== undefined && typeof firecellData.isCinemaOrTheatre !== 'boolean') {
      throw new Error('isCinemaOrTheatre must be a boolean when provided');
    }

    const validatedFirecell = {
      riskGroup: firecellData.riskGroup,
      occupantLoad: firecellData.occupantLoad,
      escapeHeight: firecellData.escapeHeight,
      isSprinklered: firecellData.isSprinklered,
      floorArea: firecellData.floorArea,
      floor: firecellData.floor.toUpperCase().trim(), // Normalize to uppercase for consistency
      compliance: {}
    };

    // Add occupantType or sleepingOccupantType based on risk group
    if (firecellData.riskGroup === 'SM' || firecellData.riskGroup === 'SI') {
      validatedFirecell.sleepingOccupantType = firecellData.sleepingOccupantType;
    } else {
      validatedFirecell.occupantType = firecellData.occupantType;
    }

    // NEW: Add escape route configuration
    if (firecellData.numberOfEscapeRoutes !== undefined) {
      validatedFirecell.numberOfEscapeRoutes = firecellData.numberOfEscapeRoutes;
    }

    if (firecellData.maxEscapeRouteBeds !== undefined) {
      validatedFirecell.maxEscapeRouteBeds = firecellData.maxEscapeRouteBeds;
    }

    if (firecellData.maxEscapeRouteOccupants !== undefined) {
      validatedFirecell.maxEscapeRouteOccupants = firecellData.maxEscapeRouteOccupants;
    }

    // Add optional properties only for relevant risk groups
    if (firecellData.riskGroup === 'VP' && firecellData.hasVehicleStacker !== undefined) {
      validatedFirecell.hasVehicleStacker = firecellData.hasVehicleStacker;
    }

    if (firecellData.riskGroup === 'CA' && firecellData.isCinemaOrTheatre !== undefined) {
      validatedFirecell.isCinemaOrTheatre = firecellData.isCinemaOrTheatre;
    }

    // Add CAS2 2.2.4 early childhood centre properties (Note 4)
    if (firecellData.riskGroup === 'CA' && firecellData.isEarlyChildhoodCentre !== undefined) {
      validatedFirecell.isEarlyChildhoodCentre = firecellData.isEarlyChildhoodCentre;

      // Condition (a) properties: escape height ≤ 2.0m
      if (firecellData.hasDedicatedSleepingAreas !== undefined) {
        validatedFirecell.hasDedicatedSleepingAreas = firecellData.hasDedicatedSleepingAreas;
      }
      if (firecellData.supplementarySmokeDetectorsCompliant !== undefined) {
        validatedFirecell.supplementarySmokeDetectorsCompliant = firecellData.supplementarySmokeDetectorsCompliant;
      }

      // Condition (b) properties: escape height > 2.0m
      if (firecellData.placesOfSafetyCompliant !== undefined) {
        validatedFirecell.placesOfSafetyCompliant = firecellData.placesOfSafetyCompliant;
      }
    }

    return validatedFirecell;
  }

  getFirecell(index) {
    if (index < 0 || index >= this.firecells.length) {
      throw new Error('Invalid firecell index');
    }
    return this.firecells[index];
  }

  getAllFirecells() {
    return [...this.firecells];
  }

  getFirecellCount() {
    return this.firecells.length;
  }

  /**
   * Calculate total number of storeys in the building
   * Used for C/AS2 Para 1.1.2(e) validation (>20 storeys requires alternative compliance)
   *
   * @returns {number} Total storeys = Ground floor (1) + floors above ground
   *
   * @example
   * numberOfFloorsAboveGround = 0  → storeyCount = 1  (single storey)
   * numberOfFloorsAboveGround = 19 → storeyCount = 20 (max for C/AS2)
   * numberOfFloorsAboveGround = 20 → storeyCount = 21 (exceeds C/AS2 limit)
   */
  get storeyCount() {
    const floorsAbove = this.numberOfFloorsAboveGround || 0;
    return floorsAbove + 1; // Ground floor + floors above
  }
}

module.exports = ProjectModel;