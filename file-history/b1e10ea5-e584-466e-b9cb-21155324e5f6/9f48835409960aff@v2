const { parseSystemCode } = require('../../../data/services/fire-safety-systems-service');

/**
 * C/AS2 Para 2.2.3 - NZS 4515 Sprinkler Substitution
 *
 * "For risk group SM educational accommodation and risk group SI,
 * the sprinkler component of a Type 7 may be substituted with an
 * automatic sprinkler system that complies with NZS 4515 for life
 * protection if the building is within the scope of NZS 4515."
 *
 * NZS 4515:2009 Scope (Section 1.1.3):
 * - Basic: ≤500m², ≤3 storeys
 * - Extended: ≤2000m², ≤4 storeys (requires 60-min supply, fire brigade alarm, sprinkler inlet)
 * This evaluator uses the 2000m² extended scope limit for maximum flexibility.
 *
 * @param {Object} firecell - Current firecell being evaluated
 * @param {string} firecell.riskGroup - Risk group (SM or SI)
 * @param {string} [firecell.sleepingOccupantType] - Sleeping occupant type (education for SM, careOrDetention for SI)
 * @param {Array<string>} [firecell.fireSafetySystems] - Required fire safety system codes
 * @param {boolean} [firecell.usesNZS4515Sprinklers] - User selection flag
 * @param {Object} projectModel - Full project model
 * @param {Array} allFirecells - All firecells in the building
 * @returns {Object} Evaluation result
 */
function evaluatePara2_2_3(firecell, projectModel, allFirecells) {
  // Check if this paragraph applies to this firecell
  const applies = (
    (firecell.riskGroup === 'SM' && firecell.sleepingOccupantType === 'education') ||
    (firecell.riskGroup === 'SI')
  );

  if (!applies) {
    return {
      applies: false,
      eligible: false,
      substitutionAllowed: false
    };
  }

  // Calculate total building floor area
  const totalFloorArea = allFirecells.reduce((sum, fc) => sum + (fc.floorArea || 0), 0);
  const withinScope = totalFloorArea <= 2000;

  // Check if Type 7 is required
  const requiresType7 = firecell.fireSafetySystems?.some(sys => {
    const parsed = parseSystemCode(sys);
    return parsed.type === 7;
  });

  // Check if user selected NZS 4515
  const userSelectedNZS4515 = firecell.usesNZS4515Sprinklers === true;

  return {
    applies: true,
    eligible: withinScope && requiresType7,
    substitutionAllowed: withinScope && requiresType7,
    userSelectedSubstitution: userSelectedNZS4515,
    totalFloorArea: totalFloorArea,
    withinNZS4515Scope: withinScope,
    scopeLimit: 2000,
    paragraph: '2.2.3',
    requiresType7: requiresType7
  };
}

module.exports = { evaluatePara2_2_3 };
