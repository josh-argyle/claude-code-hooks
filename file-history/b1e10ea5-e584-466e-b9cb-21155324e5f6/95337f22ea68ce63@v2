const { validateFireSafetySystems } = require('../../../../api/processors/fire-safety-systems/system-validator');

describe('Fire Safety System Validator', () => {

  describe('Basic Validation', () => {
    test('all required systems installed should be compliant', () => {
      const firecell = {
        fireSafetySystems: ['4^5', '9', '18^2'],
        installedFireSafetySystems: ['4', '9', '18']
      };

      const validation = validateFireSafetySystems(firecell, {});

      expect(validation.compliant).toBe(true);
      expect(validation.missingSystems).toHaveLength(0);
      expect(validation.requiredSystems).toHaveLength(3);
    });

    test('missing required system should be non-compliant', () => {
      const firecell = {
        fireSafetySystems: ['4^5', '9', '18^2'],
        installedFireSafetySystems: ['4', '18'] // Missing Type 9
      };

      const validation = validateFireSafetySystems(firecell, {});

      expect(validation.compliant).toBe(false);
      expect(validation.missingSystems).toHaveLength(1);
      expect(validation.missingSystems[0].type).toBe(9);
    });

    test('extra systems should be tracked but not affect compliance', () => {
      const firecell = {
        fireSafetySystems: ['2', '18^2'],
        installedFireSafetySystems: ['2', '18', '16'] // Type 16 not required
      };

      const validation = validateFireSafetySystems(firecell, {});

      expect(validation.compliant).toBe(true);
      expect(validation.unnecessarySystems).toHaveLength(1);
      expect(validation.unnecessarySystems[0].code).toBe('16');
    });
  });

  describe('NZS 4515 Substitution', () => {
    test('NZS 4515 should substitute Type 7', () => {
      const firecell = {
        fireSafetySystems: ['7', '9', '18^2'],
        installedFireSafetySystems: ['NZS-4515', '9', '18'],
        usesNZS4515Sprinklers: true
      };

      const validation = validateFireSafetySystems(firecell, {});

      expect(validation.compliant).toBe(true);
      expect(validation.substitutionsApplied.length).toBeGreaterThan(0);
      expect(validation.substitutionsApplied[0]).toContain('NZS 4515 substituted for Type 7');
      expect(validation.missingSystems).toHaveLength(0);
    });

    test('NZS 4515 without Type 7 required should be unnecessary', () => {
      const firecell = {
        fireSafetySystems: ['2', '18^2'], // No Type 7
        installedFireSafetySystems: ['2', '18', 'NZS-4515'],
        usesNZS4515Sprinklers: false
      };

      const validation = validateFireSafetySystems(firecell, {});

      expect(validation.compliant).toBe(true);
      expect(validation.unnecessarySystems).toHaveLength(1);
      expect(validation.unnecessarySystems[0].code).toBe('NZS-4515');
    });

    test('Type 7 missing when NZS 4515 not selected should be non-compliant', () => {
      const firecell = {
        fireSafetySystems: ['7', '9', '18^2'],
        installedFireSafetySystems: ['9', '18'], // No Type 7, no NZS 4515
        usesNZS4515Sprinklers: false
      };

      const validation = validateFireSafetySystems(firecell, {});

      expect(validation.compliant).toBe(false);
      expect(validation.missingSystems).toHaveLength(1);
      expect(validation.missingSystems[0].type).toBe(7);
    });
  });

  describe('System Notes Preservation', () => {
    test('should preserve notes from required systems', () => {
      const firecell = {
        fireSafetySystems: ['18^2', '2^1b'],
        installedFireSafetySystems: ['18', '2']
      };

      const validation = validateFireSafetySystems(firecell, {});

      expect(validation.requiredSystems[0].notes).toContain('2');
      expect(validation.requiredSystems[1].notes).toContain('1b');
    });
  });

  describe('Edge Cases', () => {
    test('empty installed systems should be non-compliant', () => {
      const firecell = {
        fireSafetySystems: ['4^5', '9'],
        installedFireSafetySystems: []
      };

      const validation = validateFireSafetySystems(firecell, {});

      expect(validation.compliant).toBe(false);
      expect(validation.missingSystems).toHaveLength(2);
    });

    test('"none" in installed systems should be ignored', () => {
      const firecell = {
        fireSafetySystems: ['2'],
        installedFireSafetySystems: ['none']
      };

      const validation = validateFireSafetySystems(firecell, {});

      // Should not crash, should show non-compliant
      expect(validation.compliant).toBe(false);
    });

    test('empty required systems should be compliant (no requirements)', () => {
      const firecell = {
        fireSafetySystems: [],
        installedFireSafetySystems: ['2', '18']
      };

      const validation = validateFireSafetySystems(firecell, {});

      expect(validation.compliant).toBe(true);
      expect(validation.unnecessarySystems).toHaveLength(2);
    });
  });
});
