const { parseSystemCode, getSystemTypeDefinition } = require('../../data/services/fire-safety-systems-service');

/**
 * Fire Safety System Validator
 * Compares required systems against installed systems and validates compliance
 * Handles NZS 4515 substitution per C/AS2 Para 2.2.3
 *
 * @param {Object} firecell - Firecell with required and installed systems
 * @param {Array<string>} firecell.fireSafetySystems - Required system codes
 * @param {Array<string>} firecell.installedFireSafetySystems - Installed system codes
 * @param {boolean} [firecell.usesNZS4515Sprinklers] - NZS 4515 substitution flag
 * @param {Object} projectModel - Project model (for future enhancements)
 * @returns {Object} Validation result with compliant status and details
 */
function validateFireSafetySystems(firecell, projectModel) {
  const required = firecell.fireSafetySystems || [];
  const installed = firecell.installedFireSafetySystems || [];

  const validation = {
    compliant: false,
    requiredSystems: [],
    installedSystems: [],
    missingSystems: [],
    unnecessarySystems: [],
    substitutionsApplied: [],
    details: []
  };

  // Process each required system
  required.forEach(reqCode => {
    const parsed = parseSystemCode(reqCode);
    const systemInfo = {
      code: reqCode,
      type: parsed.type,
      description: getSystemTypeDefinition(parsed.type),
      required: true,
      installed: false,
      compliant: false,
      notes: parsed.notes
    };

    // Check if installed (exact match or substitution)
    if (installed.includes(reqCode) || installed.includes(parsed.type.toString())) {
      systemInfo.installed = true;
      systemInfo.compliant = true;
    } else if (parsed.type === 7) {
      // Special case: Type 7 may be substituted with NZS 4515
      if (installed.includes('NZS-4515') && firecell.usesNZS4515Sprinklers === true) {
        systemInfo.installed = true;
        systemInfo.compliant = true;
        systemInfo.substitutedWith = 'NZS-4515';
        validation.substitutionsApplied.push('NZS 4515 substituted for Type 7 sprinkler component per C/AS2 2.2.3');
      } else {
        // Type 7 required but not installed and no NZS 4515 substitution
        validation.missingSystems.push(systemInfo);
      }
    } else {
      // System not installed and not Type 7
      validation.missingSystems.push(systemInfo);
    }

    validation.requiredSystems.push(systemInfo);
  });

  // Check for installed systems that aren't required
  installed.forEach(instCode => {
    if (instCode === 'none') return;

    const isRequired = required.some(req => {
      const parsed = parseSystemCode(req);
      return parsed.type.toString() === instCode || req === instCode;
    });

    // Special case: NZS-4515 may substitute Type 7
    const isNZS4515SubstitutingType7 =
      instCode === 'NZS-4515' &&
      required.some(req => parseSystemCode(req).type === 7);

    if (!isRequired && !isNZS4515SubstitutingType7) {
      validation.unnecessarySystems.push({
        code: instCode,
        description: getSystemDescription(instCode)
      });
    }
  });

  // Overall compliance
  validation.compliant = validation.missingSystems.length === 0;

  // Generate detailed compliance text
  if (validation.compliant) {
    validation.details.push('All required fire safety systems are installed and compliant.');
  } else {
    validation.details.push(`${validation.missingSystems.length} required system(s) missing or non-compliant.`);
  }

  return validation;
}

/**
 * Get human-readable description for a system code
 * @param {string} code - System code (numeric or special like NZS-4515)
 * @returns {string} Description
 */
function getSystemDescription(code) {
  if (code === 'NZS-4515') {
    return 'NZS 4515 - Fire sprinkler system for life safety in sleeping occupancies';
  }
  const numericCode = parseInt(code);
  if (!isNaN(numericCode)) {
    return getSystemTypeDefinition(numericCode);
  }
  return code;
}

module.exports = { validateFireSafetySystems };
