const ProjectModel = require('../../../api/models/project-model');

describe('ProjectModel - NZS 4515 and System Validation', () => {

  describe('Installed Fire Safety Systems Validation', () => {
    test('should accept valid installed systems array', () => {
      const model = new ProjectModel();
      expect(() => {
        model.addFirecell({
          riskGroup: 'CA',
          occupantType: 'Office spaces',
          escapeHeight: 5,
          isSprinklered: true,
          floorArea: 300,
          floor: 'G',
          installedFireSafetySystems: ['4', '9', '18', 'NZS-4515']
        });
      }).not.toThrow();
    });

    test('should reject non-array installed systems', () => {
      const model = new ProjectModel();
      expect(() => {
        model.addFirecell({
          riskGroup: 'CA',
          occupantType: 'Office spaces',
          escapeHeight: 5,
          isSprinklered: true,
          floorArea: 300,
          floor: 'G',
          installedFireSafetySystems: '4' // Should be array
        });
      }).toThrow('installedFireSafetySystems must be an array');
    });

    test('should reject invalid system codes', () => {
      const model = new ProjectModel();
      expect(() => {
        model.addFirecell({
          riskGroup: 'CA',
          occupantType: 'Office spaces',
          escapeHeight: 5,
          isSprinklered: true,
          floorArea: 300,
          floor: 'G',
          installedFireSafetySystems: ['4', '99'] // 99 is invalid
        });
      }).toThrow('Invalid fire safety system code: 99');
    });

    test('should accept special codes (none, NZS-4515)', () => {
      const model = new ProjectModel();
      expect(() => {
        model.addFirecell({
          riskGroup: 'CA',
          occupantType: 'Office spaces',
          escapeHeight: 5,
          isSprinklered: true,
          floorArea: 300,
          floor: 'G',
          installedFireSafetySystems: ['none']
        });
      }).not.toThrow();
    });
  });

  describe('NZS 4515 Helper Methods', () => {
    test('getTotalFloorArea() should sum all firecells', () => {
      const model = new ProjectModel();

      model.addFirecell({
        riskGroup: 'SM',
        sleepingOccupantType: 'education',
        occupantLoad: 30,
        escapeHeight: 8,
        isSprinklered: false,
        floorArea: 600,
        floor: 'G'
      });

      model.addFirecell({
        riskGroup: 'SM',
        sleepingOccupantType: 'education',
        occupantLoad: 30,
        escapeHeight: 8,
        isSprinklered: false,
        floorArea: 700,
        floor: '1'
      });

      expect(model.getTotalFloorArea()).toBe(1300);
    });

    test('isWithinNZS4515Scope() should return true when ≤2000m²', () => {
      const model = new ProjectModel();

      model.addFirecell({
        riskGroup: 'SM',
        sleepingOccupantType: 'education',
        occupantLoad: 30,
        escapeHeight: 8,
        isSprinklered: false,
        floorArea: 1500,
        floor: 'G'
      });

      expect(model.isWithinNZS4515Scope()).toBe(true);
    });

    test('isWithinNZS4515Scope() should return false when >2000m²', () => {
      const model = new ProjectModel();

      model.addFirecell({
        riskGroup: 'SM',
        sleepingOccupantType: 'education',
        occupantLoad: 50,
        escapeHeight: 8,
        isSprinklered: false,
        floorArea: 2500,
        floor: 'G'
      });

      expect(model.isWithinNZS4515Scope()).toBe(false);
    });

    test('isWithinNZS4515Scope() boundary: exactly 2000m² should return true', () => {
      const model = new ProjectModel();

      model.addFirecell({
        riskGroup: 'SM',
        sleepingOccupantType: 'education',
        occupantLoad: 40,
        escapeHeight: 8,
        isSprinklered: false,
        floorArea: 2000,
        floor: 'G'
      });

      expect(model.isWithinNZS4515Scope()).toBe(true);
    });
  });
});
