const { processMinimumFireSafetySystems } = require('./minimum-fire-safety-systems');
const { processFirecellFloorAreaLimits } = require('./firecell-floor-area-limits');
const { processRemoteReceivingCentre } = require('../remote-receiving-centre/orchestrator');
const { getFireSafetySystems, parseSystemCode } = require('../../data/services/fire-safety-systems-service');
const { applyNoteEvaluations } = require('./calculator');
const { evaluatePara2_2_3 } = require('./note-evaluators/para-2.2.3-evaluator');
const { validateFireSafetySystems } = require('./system-validator');

function processFireSafetySystems(projectModel) {
  const firecells = projectModel.getAllFirecells();

  for (let i = 0; i < firecells.length; i++) {
    const firecell = firecells[i];

    processFirecellFloorAreaLimits(firecell);

    // Prepare parameters based on risk group requirements
    let params = {
      escapeHeight: firecell.escapeHeight
    };

    // SM/SI risk groups need occupantType ('permanent', 'transient', 'education', 'careOrDetention')
    if (['SM', 'SI'].includes(firecell.riskGroup)) {
      // sleepingOccupantType now comes directly from the form
      params.occupantType = firecell.sleepingOccupantType;

      if (!params.occupantType) {
        throw new Error(`${firecell.riskGroup} firecell missing sleepingOccupantType`);
      }
    }

    // CA/WB/WS risk groups need occupantLoad
    if (['CA', 'WB', 'WS'].includes(firecell.riskGroup)) {
      params.occupantLoad = firecell.occupantLoad;
    }

    // VP risk group needs hasVehicleStacker
    if (firecell.riskGroup === 'VP') {
      params.hasVehicleStacker = firecell.hasVehicleStacker || false;
    }

    const baseSystems = getFireSafetySystems(firecell.riskGroup, params);

    if (baseSystems) {
      // Apply note evaluations to modify systems based on firecell-specific conditions
      const evaluated = applyNoteEvaluations(
        baseSystems,
        firecell,
        projectModel,
        firecells
      );

      // Store final systems after note evaluation
      projectModel.firecells[i].fireSafetySystems = evaluated.systems;
      projectModel.firecells[i].fireSafetySystemsCompliance = evaluated.complianceInfo;

      // NEW: Para 2.2.3 NZS 4515 substitution evaluation
      const para2_2_3Result = evaluatePara2_2_3(firecell, projectModel, firecells);
      projectModel.firecells[i].nzs4515SubstitutionInfo = para2_2_3Result;

      // Store in compliance info for report generation
      if (para2_2_3Result.applies) {
        projectModel.firecells[i].fireSafetySystemsCompliance.nzs4515Substitution = para2_2_3Result;
      }

      // NEW: Validate installed systems against required systems
      if (firecell.installedFireSafetySystems && firecell.installedFireSafetySystems.length > 0) {
        // Don't validate if user selected "none" (allow them to proceed to see requirements)
        const hasNoneSelected = firecell.installedFireSafetySystems.includes('none');

        if (!hasNoneSelected) {
          const validation = validateFireSafetySystems(projectModel.firecells[i], projectModel);
          projectModel.firecells[i].fireSafetySystemsValidation = validation;
        } else {
          // Track that no systems are installed
          projectModel.firecells[i].fireSafetySystemsValidation = {
            compliant: false,
            noSystemsInstalled: true,
            missingSystems: projectModel.firecells[i].fireSafetySystems || [],
            details: ['No fire safety systems are installed in this firecell. All required systems are missing.']
          };
        }
      }

      // Process each system and store detailed information
      const processedSystems = [];
      for (const system of evaluated.systems) {
        const parsed = parseSystemCode(system);
        const processed = processMinimumFireSafetySystems(parsed);

        processedSystems.push({
          code: system,
          ...processed
        });
      }

      // Store processed system details on firecell
      projectModel.firecells[i].processedFireSafetySystems = processedSystems;
    }
  }

  // Process remote receiving centre requirements after all firecells have their systems
  processRemoteReceivingCentre(projectModel);

  return projectModel;
}

module.exports = {
  processFireSafetySystems
};