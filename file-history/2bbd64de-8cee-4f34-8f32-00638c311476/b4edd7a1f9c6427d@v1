const { calculateOccupantLoad, needsOccupantLoadCalculation } = require('./occupant-load-calculator');

/**
 * Process occupant loads for all firecells in a project model
 * Calculates occupant loads for firecells that require it based on their risk group
 * @param {ProjectModel} projectModel - The project model containing all firecells
 * @returns {ProjectModel} The same project model with calculated occupant loads added
 */
function processOccupantLoads(projectModel) {
  const firecells = projectModel.getAllFirecells();

  for (let i = 0; i < firecells.length; i++) {
    const firecell = firecells[i];

    // Only calculate occupant load for risk groups that require it
    if (needsOccupantLoadCalculation(firecell.riskGroup)) {
      const calculatedLoad = calculateOccupantLoad(firecell.floorArea, firecell.occupantType);

      // Add calculated occupant load to the firecell
      projectModel.firecells[i].calculatedOccupantLoad = calculatedLoad;
    }
  }

  return projectModel;
}

module.exports = {
  processOccupantLoads
};