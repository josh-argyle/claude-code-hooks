#### B. JavaScript Updates

**Add new function** `updateOccupantLoadFields()` to handle conditional display:

```javascript
/**
 * Updates occupant load field visibility and calculation display
 * SM/SI: Shows manual "Bed Spaces" input
 * CA/WB/WS/VP: Shows calculated occupant load (read-only)
 *
 * @param {HTMLElement} firecellElement - The firecell container
 * @param {string} riskGroup - Selected risk group
 */
function updateOccupantLoadFields(firecellElement, riskGroup) {
  const smSiFields = firecellElement.querySelector('.sm-si-only');
  const calculatedFields = firecellElement.querySelector('.calculated-occupant-load');

  if (!smSiFields || !calculatedFields) return;

  if (riskGroup === 'SM' || riskGroup === 'SI') {
    // Show bed spaces input, hide calculated
    smSiFields.style.display = 'block';
    calculatedFields.style.display = 'none';

    // Make bed spaces input required
    const input = smSiFields.querySelector('input');
    if (input) input.required = true;
  } else if (['CA', 'WB', 'WS', 'VP'].includes(riskGroup)) {
    // Hide bed spaces, show calculated (optional UX)
    smSiFields.style.display = 'none';
    calculatedFields.style.display = 'block';

    // Remove required from bed spaces
    const input = smSiFields.querySelector('input');
    if (input) {
      input.required = false;
      input.value = ''; // Clear value
    }

    // Calculate and display occupant load (UX only - not submitted)
    calculateAndDisplayOccupantLoad(firecellElement);
  } else {
    // No risk group selected - hide both
    smSiFields.style.display = 'none';
    calculatedFields.style.display = 'none';
  }
}

/**
 * Calculate occupant load and display in UI (optional UX enhancement)
 * This is for user feedback only - actual calculation happens server-side
 */
function calculateAndDisplayOccupantLoad(firecellElement) {
  const floorAreaInput = firecellElement.querySelector('input[name*="floorArea"]');
  const occupantTypeSelect = firecellElement.querySelector('select[name*="occupantType"]');
  const calculatedInput = firecellElement.querySelector('.calculated-occupant-load input');

  if (!floorAreaInput || !occupantTypeSelect || !calculatedInput) return;

  const floorArea = parseFloat(floorAreaInput.value);
  const occupantType = occupantTypeSelect.value;

  if (floorArea && occupantType) {
    // Would need to import density data or use API call
    // For now, just show placeholder text
    calculatedInput.placeholder = 'Will be calculated automatically';
  } else {
    calculatedInput.placeholder = 'Enter floor area and activity type';
  }
}
```

**Integration points**:
1. Call from `toggleConditionalFields()` (alongside existing label update)
2. Call from `addFirecell()` (initialize new firecells)
3. Call from DOMContentLoaded (initialize existing firecells)

#### C. Keep Existing Label Update

The `updateOccupantLoadLabel()` function I just implemented should **remain** - it correctly changes the label text for the SM/SI input field.

