  async getAllLLMModels(req, res) {
    try {
      const models = await configService.getAllLLMModels();
      res.json(models);
    } catch (error) {
      res.status(500).json({ error: 'Failed to retrieve LLM models', code: 'OPERATION_FAILED' });
    }
  },

  async getActiveLLMModels(req, res) {
    try {
      const models = await configService.getActiveLLMModels();
      res.json(models);
    } catch (error) {
      res.status(500).json({ error: 'Failed to retrieve active LLM models', code: 'OPERATION_FAILED' });
    }
  },

  async createLLMModel(req, res) {
    try {
      const { model_key, display_name, is_active, is_default } = req.body;

      if (!model_key || !display_name) {
        return res.status(400).json({ error: 'Model key and display name are required', code: 'MISSING_FIELDS' });
      }

      const model = await configService.createLLMModel({
        model_key,
        display_name,
        is_active: is_active !== undefined ? is_active : true,
        is_default: is_default || false
      });

      res.status(201).json(model);
    } catch (error) {
      if (error.message === 'Model key already exists') {
        return res.status(400).json({ error: error.message, code: 'BAD_REQUEST' });
      }
      res.status(500).json({ error: 'Failed to create LLM model', code: 'OPERATION_FAILED' });
    }
  },

  async updateLLMModel(req, res) {
    try {
      const { id } = req.params;
      const { model_key, display_name, is_active, is_default } = req.body;

      // Validate UUID format
      const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
      if (!uuidRegex.test(id)) {
        return res.status(400).json({ error: 'Invalid model ID format', code: 'BAD_REQUEST' });
      }

      // Basic input validation
      if (model_key !== undefined && (typeof model_key !== 'string' || model_key.trim() === '')) {
        return res.status(400).json({ error: 'Model key must be a non-empty string', code: 'BAD_REQUEST' });
      }
      if (display_name !== undefined && (typeof display_name !== 'string' || display_name.trim() === '')) {
        return res.status(400).json({ error: 'Display name must be a non-empty string', code: 'BAD_REQUEST' });
      }
      if (is_active !== undefined && typeof is_active !== 'boolean') {
        return res.status(400).json({ error: 'is_active must be a boolean', code: 'BAD_REQUEST' });
      }
      if (is_default !== undefined && typeof is_default !== 'boolean') {
        return res.status(400).json({ error: 'is_default must be a boolean', code: 'BAD_REQUEST' });
      }

      const model = await configService.updateLLMModel(id, {
        model_key,
        display_name,
        is_active,
        is_default
      });

      if (!model) {
        return res.status(404).json({ error: 'Model not found', code: 'NOT_FOUND' });
      }

      res.json(model);
    } catch (error) {
      logger.error('Error updating LLM model:', { error: error.message });
      if (error.message === 'Model key already exists') {
        return res.status(400).json({ error: error.message, code: 'BAD_REQUEST' });
      }
      res.status(500).json({ error: 'Failed to update LLM model', code: 'OPERATION_FAILED' });
    }
  },

  async deleteLLMModel(req, res) {
    try {
      const { id } = req.params;

      // Validate UUID format
      const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
      if (!uuidRegex.test(id)) {
        return res.status(400).json({ error: 'Invalid model ID format', code: 'BAD_REQUEST' });
      }

      const model = await configService.deleteLLMModel(id);

      if (!model) {
        return res.status(404).json({ error: 'Model not found', code: 'NOT_FOUND' });
      }

      res.json({ success: true });
    } catch (error) {
      logger.error('Error deleting LLM model:', { error: error.message });
      if (error.message === 'Cannot delete default model') {
        return res.status(400).json({ error: error.message, code: 'BAD_REQUEST' });
      }
      res.status(500).json({ error: 'Failed to delete LLM model', code: 'OPERATION_FAILED' });
    }
  },

