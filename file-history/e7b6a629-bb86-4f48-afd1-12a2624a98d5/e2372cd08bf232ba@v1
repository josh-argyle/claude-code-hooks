  async createLLMTutorialModule(req, res) {
    const requestId = Date.now().toString();
    logger.info('createLLMTutorialModule - Request received:', {
      requestId,
      method: req.method,
      url: req.url,
      body: req.body,
      user: req.session?.user?.username || 'anonymous'
    });

    try {
      const { module_key, display_name, description, content, estimated_time, prerequisite_modules, is_active } = req.body;

      logger.debug('Validating required fields...', { requestId });
      if (!module_key || !display_name || !content) {
        logger.warn('Validation failed - missing required fields:', {
          requestId,
          module_key: !!module_key,
          display_name: !!display_name,
          content: !!content
        });
        return res.status(400).json({ error: 'Module key, display name, and content are required', code: 'MISSING_FIELDS' });
      }

      logger.info('Creating tutorial module with data:', {
        requestId,
        module_key,
        display_name,
        description: description ? 'provided' : 'not provided',
        content: content ? `${content.length} characters` : 'not provided',
        estimated_time: estimated_time ? parseInt(estimated_time) : null,
        prerequisite_modules: prerequisite_modules || [],
        is_active: is_active !== undefined ? is_active : true
      });

      const module = await configService.createLLMTutorialModule({
        module_key,
        display_name,
        description,
        content,
        estimated_time: estimated_time ? parseInt(estimated_time) : null,
        prerequisite_modules: prerequisite_modules || [],
        is_active: is_active !== undefined ? is_active : true
      });

      logger.info('Tutorial module created successfully:', {
        requestId,
        module_id: module.module_id,
        module_key: module.module_key
      });

      res.status(201).json(module);
    } catch (error) {
      logger.error('Error creating tutorial module:', {
        requestId,
        message: error.message,
        stack: error.stack,
        name: error.name,
        code: error.code
      });

      if (error.message === 'Module key already exists') {
        logger.info('Returning 400 - Module key already exists', { requestId });
        return res.status(400).json({ error: error.message, code: 'BAD_REQUEST' });
      }

      logger.error('Returning 500 - Internal server error', { requestId });
      res.status(500).json({ error: 'Failed to create tutorial module', code: 'OPERATION_FAILED' });
    }
  },

  async updateLLMTutorialModule(req, res) {
    try {
      const { id } = req.params;
      const { module_key, display_name, description, content, estimated_time, prerequisite_modules, is_active } = req.body;

      // Validate UUID format
      const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
      if (!uuidRegex.test(id)) {
        return res.status(400).json({ error: 'Invalid module ID format', code: 'BAD_REQUEST' });
      }

      // Validate and normalize prerequisite_modules
      let normalizedPrerequisites = [];
      if (prerequisite_modules !== undefined && prerequisite_modules !== null) {
        if (Array.isArray(prerequisite_modules)) {
          normalizedPrerequisites = prerequisite_modules.filter(id => id !== '');
        } else if (typeof prerequisite_modules === 'string' && prerequisite_modules !== '') {
          normalizedPrerequisites = [prerequisite_modules];
        }
      }

      const module = await configService.updateLLMTutorialModule(id, {
        module_key,
        display_name,
        description,
        content,
        estimated_time: estimated_time ? parseInt(estimated_time) : undefined,
        prerequisite_modules: normalizedPrerequisites,
        is_active
      });

      if (!module) {
        return res.status(404).json({ error: 'Tutorial module not found', code: 'NOT_FOUND' });
      }

      res.json(module);
    } catch (error) {
      logger.error('Error updating tutorial module:', { error: error.message });
      if (error.message === 'Module key already exists') {
        return res.status(400).json({ error: error.message, code: 'BAD_REQUEST' });
      }
      res.status(500).json({ error: 'Failed to update tutorial module', code: 'OPERATION_FAILED' });
    }
  },

  async deleteLLMTutorialModule(req, res) {
    try {
      const { id } = req.params;

      // Validate UUID format
      const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
      if (!uuidRegex.test(id)) {
        return res.status(400).json({ error: 'Invalid module ID format', code: 'BAD_REQUEST' });
      }

      const module = await configService.deleteLLMTutorialModule(id);

      if (!module) {
        return res.status(404).json({ error: 'Tutorial module not found', code: 'NOT_FOUND' });
      }

      res.json({ message: 'Tutorial module deactivated successfully' });
    } catch (error) {
      logger.error('Error deleting tutorial module:', { error: error.message });
      res.status(500).json({ error: 'Failed to delete tutorial module', code: 'OPERATION_FAILED' });
    }
  },

