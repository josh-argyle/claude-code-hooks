const tutorialService = require('../services/tutorialService');

const tutorialController = {
  async getAvailableModules(req, res) {
    try {
      const userId = req.session.userId;
      const modules = await tutorialService.getAvailableModulesForUser(userId);
      res.json(modules);
    } catch (error) {
      res.status(500).json({ error: 'Failed to retrieve available tutorial modules', code: 'OPERATION_FAILED' });
    }
  },

  async getAllModulesWithStatus(req, res) {
    try {
      const userId = req.session.userId;
      const modules = await tutorialService.getAllModulesWithStatus(userId);
      res.json(modules);
    } catch (error) {
      res.status(500).json({ error: 'Failed to retrieve tutorial modules with status', code: 'OPERATION_FAILED' });
    }
  },

  async getUserProgress(req, res) {
    try {
      const userId = req.session.userId;
      const progress = await tutorialService.getUserProgress(userId);
      res.json(progress);
    } catch (error) {
      res.status(500).json({ error: 'Failed to retrieve user tutorial progress', code: 'OPERATION_FAILED' });
    }
  },

  async startTutorial(req, res) {
    try {
      const userId = req.session.userId;
      const moduleId = parseInt(req.params.moduleId);
      const module = await tutorialService.startModule(userId, moduleId);
      res.json(module);
    } catch (error) {
      if (error.message.includes('not found') || error.message.includes('prerequisites')) {
        res.status(400).json({ error: error.message, code: 'BAD_REQUEST' });
      } else {
        res.status(500).json({ error: 'Failed to start tutorial module', code: 'OPERATION_FAILED' });
      }
    }
  },

  async completeTutorial(req, res) {
    try {
      const userId = req.session.userId;
      const moduleId = parseInt(req.params.moduleId);
      const newlyAvailable = await tutorialService.completeModule(userId, moduleId);
      res.json({ message: 'Tutorial completed successfully', newlyAvailable });
    } catch (error) {
      res.status(500).json({ error: 'Failed to complete tutorial module', code: 'OPERATION_FAILED' });
    }
  },

  async getCurrentTutorial(req, res) {
    try {
      const userId = req.session.userId;
      const tutorial = await tutorialService.getCurrentTutorial(userId);
      res.json(tutorial);
    } catch (error) {
      res.status(500).json({ error: 'Failed to retrieve current tutorial', code: 'OPERATION_FAILED' });
    }
  },

  async getUserTutorialState(req, res) {
    try {
      const userId = req.session.userId;
      const state = await tutorialService.getUserTutorialState(userId);
      res.json(state);
    } catch (error) {
      res.status(500).json({ error: 'Failed to retrieve tutorial state', code: 'OPERATION_FAILED' });
    }
  }
};

module.exports = tutorialController;
