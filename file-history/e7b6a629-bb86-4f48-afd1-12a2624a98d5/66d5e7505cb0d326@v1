const authService = require('../services/authService');
const { getCurrentProfitCentreFromAssignments } = require('../utils/sessionUtils');

const login = async (req, res) => {
  try {
    const { username, password } = req.body;

    if (!username || !password) {
      return res.status(400).json({ error: 'Username and password are required', code: 'MISSING_FIELDS' });
    }

    const user = await authService.authenticateUser(username, password);

    if (!user) {
      return res.status(401).json({ error: 'Invalid credentials', code: 'INVALID_CREDENTIALS' });
    }

    // Get current profit centre from assignments (same logic as middleware)
    const currentProfitCentreData = await getCurrentProfitCentreFromAssignments(user.user_id);

    req.session.userId = user.user_id;
    req.session.username = user.username;
    req.session.roles = user.roles;
    req.session.profit_centre = currentProfitCentreData.profit_centre;
    req.session.profit_centre_locale = currentProfitCentreData.locale;
    req.session.first_name = user.users_contacts?.first_name;
    req.session.surname = user.users_contacts?.surname;

    // Explicitly save session to ensure it's persisted before response
    req.session.save((err) => {
      if (err) {
        return res.status(500).json({ error: 'Session save failed', code: 'INTERNAL_ERROR' });
      }

      res.json({
        message: 'Login successful',
        user: {
          user_id: user.user_id,
          username: user.username,
          profit_centre: currentProfitCentreData.profit_centre,
          roles: user.roles
        }
      });
    });
  } catch (error) {
    res.status(500).json({ error: 'Internal server error', code: 'INTERNAL_ERROR' });
  }
};

const logout = async (req, res) => {
  try {
    req.session.destroy((err) => {
      if (err) {
        return res.status(500).json({ error: 'Could not log out', code: 'INTERNAL_ERROR' });
      }
      res.json({ message: 'Logout successful' });
    });
  } catch (error) {
    res.status(500).json({ error: 'Internal server error', code: 'INTERNAL_ERROR' });
  }
};

const getSession = async (req, res) => {
  try {
    if (!req.session.userId) {
      return res.status(401).json({ error: 'Not authenticated', code: 'AUTH_REQUIRED' });
    }

    res.json({
      user: {
        user_id: req.session.userId,
        username: req.session.username,
        roles: req.session.roles || [],
        profit_centre: req.session.profit_centre
      }
    });
  } catch (error) {
    res.status(500).json({ error: 'Internal server error', code: 'INTERNAL_ERROR' });
  }
};

module.exports = {
  login,
  logout,
  getSession
};
