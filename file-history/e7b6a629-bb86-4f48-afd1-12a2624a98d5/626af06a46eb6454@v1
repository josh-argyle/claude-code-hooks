const createNcrReport = async (req, res) => {
  try {
    if (!req.session.userId) {
      return res.status(401).json({ error: 'User not authenticated', code: 'AUTH_REQUIRED' });
    }

    const userId = req.session.userId;
    const ncrData = req.body;

    // Handle multiple select values - split comma-separated strings into arrays
    if (ncrData.involved_users && typeof ncrData.involved_users === 'string') {
      ncrData.involved_users = ncrData.involved_users.split(',').filter(id => id.trim());
    }

    // Handle company multi-selects the same way
    if (ncrData.supplier_involved && typeof ncrData.supplier_involved === 'string') {
      ncrData.supplier_involved = ncrData.supplier_involved.split(',').filter(id => id.trim());
    }

    if (ncrData.main_contractor_involved && typeof ncrData.main_contractor_involved === 'string') {
      ncrData.main_contractor_involved = ncrData.main_contractor_involved.split(',').filter(id => id.trim());
    }

    if (ncrData.consultant_involved && typeof ncrData.consultant_involved === 'string') {
      ncrData.consultant_involved = ncrData.consultant_involved.split(',').filter(id => id.trim());
    }

    const newNcrReport = await ncrService.createNcrReport(userId, ncrData);
    res.status(201).json(newNcrReport);
  } catch (error) {
    logger.error('Create NCR error:', { error: error.message });
    res.status(500).json({ error: 'Failed to create NCR report', code: 'OPERATION_FAILED' });
  }
};

const downloadClosedNcrCsv = async (req, res) => {
  try {
    const closedReports = await ncrService.getClosedNcrReports();
    const csvData = ncrService.convertToCSV(closedReports);

    res.setHeader('Content-Type', 'text/csv');
    res.setHeader('Content-Disposition', 'attachment; filename="closed-ncr-reports.csv"');
    res.send(csvData);
  } catch (error) {
    res.status(500).json({ error: 'Failed to download closed NCR reports', code: 'OPERATION_FAILED' });
  }
};

