const updateNcrReport = async (req, res) => {
  try {
    if (!req.session.userId) {
      return res.status(401).json({ error: 'User not authenticated', code: 'AUTH_REQUIRED' });
    }

    const userId = req.session.userId;
    const { ncr_report_id, ...ncrData } = req.body;

    // Handle multiple select values - split comma-separated strings into arrays
    // If the field is present but empty, it means all values should be removed
    if (typeof ncrData.involved_users === 'string') {
      ncrData.involved_users = ncrData.involved_users.trim() === ''
        ? []
        : ncrData.involved_users.split(',').filter(id => id.trim());
    }

    // Handle company multi-selects the same way
    if (typeof ncrData.supplier_involved === 'string') {
      ncrData.supplier_involved = ncrData.supplier_involved.trim() === ''
        ? []
        : ncrData.supplier_involved.split(',').filter(id => id.trim());
    }

    if (typeof ncrData.main_contractor_involved === 'string') {
      ncrData.main_contractor_involved = ncrData.main_contractor_involved.trim() === ''
        ? []
        : ncrData.main_contractor_involved.split(',').filter(id => id.trim());
    }

    if (typeof ncrData.consultant_involved === 'string') {
      ncrData.consultant_involved = ncrData.consultant_involved.trim() === ''
        ? []
        : ncrData.consultant_involved.split(',').filter(id => id.trim());
    }

    const updatedNcrReport = await ncrService.updateNcrReport(ncr_report_id, userId, ncrData);
    res.json(updatedNcrReport);
  } catch (error) {
    logger.error('Update NCR error:', { error: error.message });
    res.status(500).json({ error: 'Failed to update NCR report', code: 'OPERATION_FAILED' });
  }
};

