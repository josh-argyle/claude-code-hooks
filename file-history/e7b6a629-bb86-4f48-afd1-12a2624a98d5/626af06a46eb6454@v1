const deleteNcrImage = async (req, res) => {
  try {
    if (!req.session.userId) {
      return res.status(401).json({ error: 'User not authenticated', code: 'AUTH_REQUIRED' });
    }

    const { imageId } = req.params;
    const userId = req.session.userId;

    const deletedImage = await ncrService.deleteNcrImage(imageId, userId);
    res.json(deletedImage);
  } catch (error) {
    logger.error('Delete NCR image error:', { error: error.message });
    if (error.message === 'Image not found') {
      return res.status(404).json({ error: 'Image not found', code: 'NOT_FOUND' });
    }
    if (error.message === 'Unauthorized to delete this image') {
      return res.status(403).json({ error: 'Unauthorized to delete this image', code: 'ACCESS_DENIED' });
    }
    res.status(500).json({ error: 'Failed to delete image', code: 'OPERATION_FAILED' });
  }
};

