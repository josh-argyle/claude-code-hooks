};

const uploadNcrImage = async (req, res) => {
  try {
    if (!req.session.userId) {
      return res.status(401).json({ error: 'User not authenticated', code: 'AUTH_REQUIRED' });
    }

    const { id: ncrReportId } = req.params;
    const userId = req.session.userId;

    // Check if files were uploaded
    if (!req.files || req.files.length === 0) {
      return res.status(400).json({ error: 'No files uploaded', code: 'BAD_REQUEST' });
    }

    const cloudinaryService = require('../services/cloudinaryService');
    const uploadedImages = [];

    // Process each uploaded file
    for (const file of req.files) {
      // Validate file type (images only)
      if (!file.mimetype.startsWith('image/')) {
        return res.status(400).json({ error: 'Only image files are allowed', code: 'BAD_REQUEST' });
      }

      // Validate file size (5MB max)
      if (file.size > 5 * 1024 * 1024) {
        return res.status(400).json({ error: 'File size must be less than 5MB', code: 'BAD_REQUEST' });
      }

      // Upload to Cloudinary
      const cloudinaryResult = await cloudinaryService.uploadImage(file, {
        folder: 'ncr-images',
        resource_type: 'image'
      });

      // Save image metadata to database
      const imageData = {
        imageUrl: cloudinaryResult.secure_url,
        originalFilename: file.originalname,
        fileSize: file.size
      };

      const ncrImage = await ncrService.uploadNcrImage(ncrReportId, imageData, userId);
      uploadedImages.push(ncrImage);
    }

    res.status(201).json(uploadedImages);
  } catch (error) {
    logger.error('Upload NCR image error:', { error: error.message });
    res.status(500).json({ error: 'Failed to upload images', code: 'OPERATION_FAILED' });
  }
};

