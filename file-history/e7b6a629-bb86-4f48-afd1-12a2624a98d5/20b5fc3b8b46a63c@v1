const contactService = require('../services/contactService');
const logger = require('../utils/logger');

const getAllContacts = async (req, res) => {
  try {
    // Check user roles to determine which contacts to show
    const userRoles = req.session.roles || [];
    const hasManagerAccess = userRoles.includes('admin') || userRoles.includes('project_manager');

    // If user only has 'user' or 'foreman' role, show only preferred contacts
    if (!hasManagerAccess) {
      const preferredContacts = await contactService.getPreferredContacts();
      // Format preferred contacts to match the expected structure
      const formattedContacts = preferredContacts.map(contact => ({
        contact_id: contact.contact_id,
        name: contact.name,
        position: contact.position,
        email: contact.email,
        phone: null, // Not included in preferred contacts
        company: contact.company_name,
        area: null, // Not included in preferred contacts
        preferred_contact: null, // Not included in preferred contacts
        is_preferred: true,
        is_active: true
      }));
      return res.json(formattedContacts);
    }

    // For managers/admins, show all contacts as before
    const withEmail = req.query.withEmail === 'true';
    const contacts = await contactService.getAllContacts(withEmail);
    res.json(contacts);
  } catch (error) {
    res.status(500).json({ error: 'Internal server error', code: 'INTERNAL_ERROR' });
  }
};

const getUniqueCompanyNames = async (req, res) => {
  try {
    const companyNames = await contactService.getUniqueCompanyNames();
    res.json(companyNames);
  } catch (error) {
    res.status(500).json({ error: 'Internal server error', code: 'INTERNAL_ERROR' });
  }
};

const getContactById = async (req, res) => {
  try {
    const contact = await contactService.getContactById(req.params.id);
    if (!contact) {
      return res.status(404).json({ error: 'Contact not found', code: 'NOT_FOUND' });
    }
    res.json(contact);
  } catch (error) {
    if (error.message.includes('Invalid UUID format')) {
      return res.status(400).json({ error: 'Invalid contact ID format', code: 'BAD_REQUEST' });
    }
    res.status(500).json({ error: 'Internal server error', code: 'INTERNAL_ERROR' });
  }
};

const createContact = async (req, res) => {
  try {
    const contact = await contactService.createContact(req.body);
    res.status(201).json(contact);
  } catch (error) {
    logger.error('Create contact error:', { error: error.message });
    if (error.message.includes('required')) {
      res.status(400).json({ error: error.message, code: 'BAD_REQUEST' });
    } else {
      res.status(500).json({ error: 'Internal server error', code: 'INTERNAL_ERROR' });
    }
  }
};

const updateContact = async (req, res) => {
  try {
    const contact = await contactService.updateContact(req.params.id, req.body);
    if (!contact) {
      return res.status(404).json({ error: 'Contact not found', code: 'NOT_FOUND' });
    }
    res.json(contact);
  } catch (error) {
    logger.error('Update contact error:', { error: error.message });
    if (error.message.includes('Invalid UUID format')) {
      res.status(400).json({ error: 'Invalid contact ID format', code: 'BAD_REQUEST' });
    } else if (error.message.includes('required')) {
      res.status(400).json({ error: error.message, code: 'BAD_REQUEST' });
    } else {
      res.status(500).json({ error: 'Internal server error', code: 'INTERNAL_ERROR' });
    }
  }
};

const getPreferredContacts = async (req, res) => {
  try {
    const preferredContacts = await contactService.getPreferredContacts();
    res.json(preferredContacts);
  } catch (error) {
    logger.error('Get preferred contacts error:', { error: error.message });
    res.status(500).json({ error: 'Internal server error', code: 'INTERNAL_ERROR' });
  }
};

const archiveContact = async (req, res) => {
  try {
    const contact = await contactService.archiveContact(req.params.id);
    if (!contact) {
      return res.status(404).json({ error: 'Contact not found', code: 'NOT_FOUND' });
    }
    res.json({ success: true, message: 'Contact archived successfully' });
  } catch (error) {
    logger.error('Archive contact error:', { error: error.message });
    if (error.message.includes('Invalid UUID format')) {
      res.status(400).json({ error: 'Invalid contact ID format', code: 'BAD_REQUEST' });
    } else {
      res.status(500).json({ error: 'Failed to archive contact', code: 'OPERATION_FAILED' });
    }
  }
};

module.exports = {
  getAllContacts,
  getUniqueCompanyNames,
  getContactById,
  createContact,
  updateContact,
  getPreferredContacts,
  archiveContact
};
