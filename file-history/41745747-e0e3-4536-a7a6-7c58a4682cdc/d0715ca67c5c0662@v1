const { parseSystemCode } = require('../../data/services/fire-safety-systems-service');

/**
 * Check if fire safety systems require remote receiving centre connection
 * Based on paragraph 2.2.2: Types 2-7 (fire alarm and sprinkler systems) require connection
 *
 * @param {string[]} fireSafetySystems - Array of fire safety system codes
 * @returns {boolean} True if any system requires remote connection
 */
function requiresRemoteConnection(fireSafetySystems) {
  if (!fireSafetySystems || fireSafetySystems.length === 0) {
    return false;
  }

  // Check if firecell has fire alarm (Types 2-5) or sprinkler systems (Types 6-7)
  return fireSafetySystems.some(systemCode => {
    const parsed = parseSystemCode(systemCode);
    const systemType = parsed.type;

    // Types 2-7 require remote connection (fire alarm and sprinkler systems)
    return systemType >= 2 && systemType <= 7;
  });
}

/**
 * Check if a firecell qualifies for remote receiving centre exemption
 * Based on paragraph 2.2.2 exemption criteria
 *
 * @param {Object} firecell - The firecell to check for exemptions
 * @returns {boolean} True if exempt, false if connection required
 */
function checkExemption(firecell) {
  const { riskGroup, occupantLoad, escapeHeight, hasVehicleStacker, isCinemaOrTheatre } = firecell;

  switch (riskGroup) {
    case 'SM':
      // a) for risk group SM permanent accommodation and an escape height less than 10 m
      // Note: We assume permanent accommodation since transient would typically have different occupant types
      return escapeHeight < 10;

    case 'CA':
      // b) for risk group CA
      //   i) with no more than 250 occupants and an escape height of less than 4 m, and
      //   ii) the use is not a cinema or theatre
      return occupantLoad <= 250 &&
             escapeHeight < 4 &&
             (isCinemaOrTheatre === undefined || isCinemaOrTheatre === false);

    case 'WB':
      // c) for risk group WB, with no more than 100 occupants and an escape height of less than 4 m
      return occupantLoad <= 100 && escapeHeight < 4;

    case 'VP':
      // d) for risk group VP where no vehicle stackers are installed
      return hasVehicleStacker === undefined || hasVehicleStacker === false;

    case 'SI':
    case 'WS':
      // No exemptions available for SI and WS risk groups
      return false;

    default:
      // Unknown risk group, assume no exemption
      return false;
  }
}

/**
 * Evaluate remote receiving centre requirements for the entire building
 * Based on paragraph 2.2.2: Where a fire alarm or sprinkler system is required
 * there shall be a connection to a remote receiving centre, unless exemptions apply
 *
 * @param {ProjectModel} projectModel - The project model containing all firecells
 * @returns {boolean} True if remote receiving centre connection is required
 */
function evaluateRemoteReceivingCentre(projectModel) {
  // Loop through all firecells to check if any requires remote connection
  for (const firecell of projectModel.firecells) {
    // Check if firecell has systems that require remote connection
    const hasSystemsRequiringConnection = requiresRemoteConnection(firecell.fireSafetySystems);

    if (!hasSystemsRequiringConnection) {
      continue; // No relevant systems, skip this firecell
    }

    // Check if firecell qualifies for exemption based on risk group
    const isExempt = checkExemption(firecell);

    if (!isExempt) {
      return true; // If any firecell requires connection, entire building does
    }
  }

  return false; // All firecells are either exempt or don't have relevant systems
}

/**
 * Calculate compliance between required and provided remote receiving centre connection
 *
 * @param {boolean} required - Whether connection is required
 * @param {boolean|undefined} provided - Whether connection is provided (undefined if not specified)
 * @returns {Object} Compliance result with status and details
 */
function calculateRemoteReceivingCentreCompliance(required, provided) {
  // If not specified by user, we can't determine compliance
  if (provided === undefined) {
    return {
      isCompliant: null,
      status: 'unknown',
      required: required,
      provided: 'not specified',
      message: 'Remote receiving centre connection status not specified'
    };
  }

  const isCompliant = required === provided;

  let message;
  if (isCompliant) {
    message = required
      ? 'Remote receiving centre connection is required and provided'
      : 'Remote receiving centre connection is not required and not provided';
  } else {
    message = required
      ? 'Remote receiving centre connection is required but not provided'
      : 'Remote receiving centre connection is provided but not required';
  }

  return {
    isCompliant: isCompliant,
    status: isCompliant ? 'compliant' : 'non-compliant',
    required: required,
    provided: provided,
    message: message
  };
}

module.exports = {
  requiresRemoteConnection,
  checkExemption,
  evaluateRemoteReceivingCentre,
  calculateRemoteReceivingCentreCompliance
};