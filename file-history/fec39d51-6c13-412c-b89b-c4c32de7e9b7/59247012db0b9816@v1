require('dotenv').config();
const express = require('express');
const logger = require('./api/utils/logger');
const session = require('express-session');
const path = require('path');
const multer = require('multer');
const { createServer } = require('http');
const { Server } = require('socket.io');
const sessionConfig = require('./api/middleware/sessionConfig');
const updateSessionProfitCentre = require('./api/middleware/sessionUpdateMiddleware');
const navigationMiddleware = require('./api/middleware/navigationMiddleware');
const apiRouter = require('./api/routes');
const clientRoutes = require('./client/routes/clientRoutes');
const analyticsMiddleware = require('./api/middleware/analyticsMiddleware');
const requestLoggingMiddleware = require('./api/middleware/requestLoggingMiddleware');
const sanitizationMiddleware = require('./api/middleware/sanitizationMiddleware');
const { generalRateLimit } = require('./api/middleware/rateLimitMiddleware');
const { securityHeaders } = require('./api/middleware/securityHeadersMiddleware');
const packageJson = require('./package.json');

const app = express();
const PORT = process.env.PORT || 3001;

// Trust proxy headers for proper IP forwarding
// Trust proxy in production for Heroku, loopback for development
const trustProxy = process.env.TRUST_PROXY === 'true' || process.env.NODE_ENV === 'production';
app.set('trust proxy', trustProxy);

// Security headers - should be applied early
app.use(securityHeaders);

// General rate limiting - apply to all routes
app.use(generalRateLimit);

app.set('view engine', 'pug');
app.set('views', path.join(__dirname, 'views'));

// Make site name and version available to all views
app.locals.siteName = process.env.SITE_NAME || 'Contego Dashboard';
app.locals.appVersion = packageJson.version;
app.locals.devWarningMessage = process.env.DEV_WARNING_MESSAGE || null;

// Configure enhanced multer for multipart/form-data with proper validation
const upload = multer({
  storage: multer.memoryStorage(), // Store files in memory for better Cloudinary integration
  limits: {
    fileSize: 10 * 1024 * 1024, // 10MB limit per file
    files: 10 // Maximum 10 files per request
  },
  fileFilter: (req, file, cb) => {
    // Only allow image files
    if (file.mimetype.startsWith('image/')) {
      cb(null, true);
    } else {
      cb(new Error('Only image files are allowed'));
    }
  }
});

app.use(express.json({ limit: '10mb' }));
app.use(express.urlencoded({ extended: true, limit: '10mb' }));
app.use(upload.any()); // Handle multipart/form-data with enhanced validation
app.use(express.static(path.join(__dirname, 'public')));

// Session configuration will be shared with Socket.IO
const sessionMiddleware = session(sessionConfig);
app.use(sessionMiddleware);

// Request logging middleware - must be after session to get user info
app.use(requestLoggingMiddleware);

// Public routes (no authentication required) - moved before other middleware to prevent interference
const publicRoutes = require('./api/routes/publicRoutes');
app.use('/pub', publicRoutes); // Changed from /public to /pub to avoid conflict with static files

// Sanitization middleware - must be after body parsing but before routes
// Prevents XSS attacks by sanitizing all incoming data
app.use(sanitizationMiddleware());

// Analytics tracking middleware - must be after session
app.use(analyticsMiddleware);

// Navigation middleware - generates dynamic navigation based on user permissions
// Must be after session but before routes
app.use(navigationMiddleware);

app.use('/api', apiRouter);
app.use('/', updateSessionProfitCentre, clientRoutes);

// 404 catch-all middleware - must be after all route definitions
app.use((req, res) => {
  // Require authentication for all routes except /login
  if (!req.session.userId && req.path !== '/login') {
    return res.redirect('/login');
  }
  res.status(404).render('error', {
    status: 404,
    message: 'Page Not Found',
    title: 'Page Not Found'
  });
});

// Error handling middleware
app.use((err, req, res, _next) => {
  const requestId = req.requestId || Date.now().toString();
  const errorInfo = {
    requestId,
    method: req.method,
    url: req.url,
    user: req.session?.user?.username || 'anonymous',
    ip: req.ip,
    userAgent: req.headers['user-agent'],
    error: {
      message: err.message,
      stack: err.stack,
      name: err.name,
      code: err.code
    }
  };

  logger.error(`[${requestId}] Express error handler caught error:`, errorInfo);

  // Log request body for debugging (but hide sensitive data)
  if (['POST', 'PUT', 'PATCH'].includes(req.method) && req.body) {
    const bodyToLog = { ...req.body };
    if (bodyToLog.password) bodyToLog.password = '[HIDDEN]';
    if (bodyToLog.token) bodyToLog.token = '[HIDDEN]';
    logger.error(`[${requestId}] Request body at time of error:`, bodyToLog);
  }

  // Check if this is a JSON parsing error and return 400 instead of 500
  const isJsonParseError = err instanceof SyntaxError && err.status === 400 && 'body' in err;

  if (isJsonParseError) {
    return res.status(400).json({
      error: 'Invalid JSON in request body',
      code: 'BAD_REQUEST',
      requestId
    });
  }

  // In development, include stack trace in response
  const isDevelopment = process.env.NODE_ENV !== 'production';
  if (isDevelopment) {
    res.status(500).json({
      error: 'Internal server error',
      message: err.message,
      stack: err.stack,
      requestId
    });
  } else {
    res.status(500).json({
      error: 'Internal server error',
      requestId
    });
  }
});

// Create HTTP server and attach Socket.IO
const server = createServer(app);

// Configure CORS origins - support multiple domains
const allowedOrigins = process.env.ALLOWED_ORIGINS
  ? process.env.ALLOWED_ORIGINS.split(',').map(origin => origin.trim())
  : [`http://localhost:${PORT}`];

const io = new Server(server, {
  cors: {
    origin: allowedOrigins,
    methods: ['GET', 'POST'],
    credentials: true
  }
});

// Connection tracking for proper cleanup
const httpConnections = new Map();
const socketConnections = new Set();
let connectionId = 0;

// Track HTTP connections
server.on('connection', (connection) => {
  const id = ++connectionId;
  httpConnections.set(id, connection);

  connection.on('close', () => {
    httpConnections.delete(id);
  });
});

// Share session with Socket.IO
io.use((socket, next) => {
  sessionMiddleware(socket.request, {}, next);
});

// Socket.IO authentication middleware
io.use((socket, next) => {
  const session = socket.request.session;
  if (session && session.userId) {
    socket.userId = session.userId;
    socket.userRole = session.userRole;
    next();
  } else {
    next(new Error('Authentication error'));
  }
});

// Track Socket.IO connections
io.on('connection', (socket) => {
  socketConnections.add(socket);
  logger.debug(`User ${socket.userId} connected via socket ${socket.id}`);

  socket.on('disconnect', () => {
    socketConnections.delete(socket);
    logger.info(`User ${socket.userId} disconnected from socket ${socket.id}`);
  });
});

// Initialize socket manager
const socketManager = require('./api/utils/socketManager');
socketManager.init(io);

// Initialize conversation socket handlers
require('./api/sockets/conversationSocket')(io);

// Initialize notification socket handlers
require('./api/sockets/notificationSocket')(io);

// Initialize initiative socket handlers
require('./api/sockets/initiativeSocket')(io);

// Start server with retry logic for EADDRINUSE
function startServer(retryCount = 0) {
  const maxRetries = 3;
  const retryDelay = 1000;

  server.listen(PORT, '0.0.0.0', () => {
    logger.info(`Server running on port ${PORT}`);
    logger.info('Socket.IO server attached');
  });

  // Handle server startup errors
  server.on('error', (err) => {
    if (err.code === 'EADDRINUSE') {
      if (retryCount < maxRetries) {
        logger.warn(`Port ${PORT} is already in use. Retrying in ${retryDelay}ms... (attempt ${retryCount + 1}/${maxRetries})`);
        setTimeout(() => {
          server.close();
          startServer(retryCount + 1);
        }, retryDelay);
      } else {
        logger.error(`Port ${PORT} is already in use. Please free the port or use a different one.`);
        process.exit(1);
      }
    } else {
      logger.error('Server error:', err);
      process.exit(1);
    }
  });
}

// Start the server only if not in test mode
if (process.env.NODE_ENV !== 'test') {
  startServer();
}

// Graceful shutdown handling
let isShuttingDown = false;

const gracefulShutdown = (signal) => {
  if (isShuttingDown) {
    logger.warn('Shutdown already in progress, forcing exit');
    process.exit(1);
  }

  isShuttingDown = true;
  logger.info(`\nReceived ${signal}. Starting graceful shutdown...`);

  // Set a timeout to force exit - reduced to work better with nodemon
  const forceExitTimeout = setTimeout(() => {
    logger.error('Graceful shutdown timed out, forcing exit');
    process.exit(1);
  }, 2000); // Reduced from 5000ms to 2000ms for nodemon compatibility

  // Step 1: Stop accepting new connections
  server.close();

  // Step 2: Force close all active HTTP connections
  logger.info(`Closing ${httpConnections.size} HTTP connections`);
  for (const connection of httpConnections.values()) {
    connection.destroy();
  }
  httpConnections.clear();

  // Step 3: Force disconnect all Socket.IO clients
  logger.info(`Disconnecting ${socketConnections.size} Socket.IO connections`);
  for (const socket of socketConnections) {
    socket.disconnect(true); // Force disconnect
  }
  socketConnections.clear();

  // Step 4: Close Socket.IO server
  io.close((err) => {
    if (err) {
      logger.error('Error closing Socket.IO:', err);
    } else {
      logger.info('Socket.IO server closed');
    }

    // Clean up socket manager (will skip if already closed)
    if (socketManager.cleanup) {
      socketManager.cleanup();
    }

    clearTimeout(forceExitTimeout);
    logger.info('Graceful shutdown completed');

    // Exit gracefully
    process.exit(0);
  });
};

// Handle termination signals - use process.on instead of process.once
// to ensure handlers remain active after first call
process.on('SIGTERM', () => {
  if (!isShuttingDown) {
    gracefulShutdown('SIGTERM');
  }
});

process.on('SIGINT', () => {
  if (!isShuttingDown) {
    gracefulShutdown('SIGINT');
  }
});

// Handle nodemon restart - critical for proper port cleanup
process.on('SIGUSR2', () => {
  if (!isShuttingDown) {
    gracefulShutdown('SIGUSR2 (nodemon restart)');
  }
});

// Handle uncaught exceptions
process.on('uncaughtException', (err) => {
  logger.error('Uncaught Exception:', err);
  gracefulShutdown('uncaughtException');
});

process.on('unhandledRejection', (reason, promise) => {
  logger.error('Unhandled Rejection at:', promise, 'reason:', reason);
  gracefulShutdown('unhandledRejection');
});

// Export app for testing
module.exports = app;
