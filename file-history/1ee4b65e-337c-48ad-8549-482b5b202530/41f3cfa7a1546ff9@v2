extends layout

block content

  //- Fire Safety Compliance Report
  if project.reportParagraphs && project.reportParagraphs.length > 0
    article
      //- Professional Document Header
      header.document-header
        h1 Fire Safety Compliance Document
        p.document-date= documentDate

        //- Client Information Panel (only if data provided)
        if project.clientName || project.clientAddress || project.projectName
          fieldset.client-info
            legend Client Information

            if project.projectName
              p
                strong Project:
                = ' ' + project.projectName

            if project.clientName
              p
                strong Client:
                = ' ' + project.clientName

            if project.clientAddress
              p(style="white-space: pre-line;")
                strong Address:
                = ' ' + project.clientAddress

      //- Render sections with containers
      if project.reportSections
        each section in project.reportSections
          .section-container
            each paragraph in section.paragraphs
              article(data-type=paragraph.type)
                if paragraph.title
                  h3= paragraph.title

                case paragraph.type
                  when 'info'
                    p= paragraph.content

                  when 'warning'
                    aside
                      p
                        strong Warning:
                        = paragraph.content

                  when 'danger'
                    aside
                      p
                        strong DANGER:
                        = paragraph.content

                  when 'compliance'
                    p= paragraph.content.content

                  when 'requirements'
                    p= paragraph.content.content

                  when 'table'
                    table
                      thead
                        tr
                          each header in paragraph.content.headers
                            th= header
                      tbody
                        each row in paragraph.content.rows
                          tr
                            each cell in row
                              td= cell

                  when 'list'
                    if paragraph.content.listType === 'ordered'
                      ol
                        each item in paragraph.content.items
                          li= item
                    else
                      ul
                        each item in paragraph.content.items
                          li= item

                  when 'nestedList'
                    p= paragraph.content.introText
                    ul
                      each value in Object.values(paragraph.content.nestedStructure)
                        li
                          = value.parent
                          if value.children && value.children.length > 0
                            ul
                              each child in value.children
                                li= child

                  when 'code'
                    pre
                      code= paragraph.content.code

                  default
                    p= paragraph.content
      else
        //- Fallback to old flat rendering for backward compatibility
        each paragraph in project.reportParagraphs
          article(data-type=paragraph.type)
            if paragraph.title
              h3= paragraph.title

            case paragraph.type
              when 'info'
                p= paragraph.content

              when 'warning'
                aside
                  p
                    strong Warning:
                    = paragraph.content

              when 'danger'
                aside
                  p
                    strong DANGER:
                    = paragraph.content

              when 'compliance'
                p= paragraph.content.content

              when 'requirements'
                p= paragraph.content.content

              when 'table'
                table
                  thead
                    tr
                      each header in paragraph.content.headers
                        th= header
                  tbody
                    each row in paragraph.content.rows
                      tr
                        each cell in row
                          td= cell

              when 'list'
                if paragraph.content.listType === 'ordered'
                  ol
                    each item in paragraph.content.items
                      li= item
                else
                  ul
                    each item in paragraph.content.items
                      li= item

              when 'nestedList'
                p= paragraph.content.introText
                ul
                  each value in Object.values(paragraph.content.nestedStructure)
                    li
                      = value.parent
                      if value.children && value.children.length > 0
                        ul
                          each child in value.children
                            li= child

              when 'code'
                pre
                  code= paragraph.content.code

              default
                p= paragraph.content

      hr

  h2 Debug Information (Raw Data)

  h3 Remote Receiving Centre
  if project.remoteReceivingCentreCompliance
    div
      p
        strong Required:
        = project.remoteReceivingCentreCompliance.required ? 'Yes' : 'No'
      p
        strong Provided:
        = project.remoteReceivingCentreCompliance.provided === 'not specified' ? 'Not specified' : (project.remoteReceivingCentreCompliance.provided ? 'Yes' : 'No')
      p
        strong Compliance:
        - const compliance = project.remoteReceivingCentreCompliance
        - const statusColor = compliance.status === 'compliant' ? 'green' : compliance.status === 'non-compliant' ? 'red' : 'orange'
        - const statusIcon = compliance.status === 'compliant' ? '✓' : compliance.status === 'non-compliant' ? '✗' : '?'
        span(style=`color: ${statusColor}; font-weight: bold;`)
          = `${statusIcon} ${compliance.status.charAt(0).toUpperCase() + compliance.status.slice(1)}`
      p(style="font-style: italic;")
        = compliance.message
  else
    div
      p
        strong Required:
        = project.requiresRemoteReceivingCentre ? 'Yes' : 'No'
      p(style="color: orange; font-style: italic;") Compliance status not calculated

  if project.storesHazardousGoods !== undefined
    div
      p
        strong Stores Hazardous Goods:
        = project.storesHazardousGoods ? 'Yes' : 'No'

  if project.hazardousSubstancesCompliance
    h3 Hazardous Substances Compliance
    div
      p
        strong Status:
        = project.hazardousSubstancesCompliance.status
      if project.hazardousSubstancesCompliance.details
        p
          strong Details:
          = project.hazardousSubstancesCompliance.details

  h2 Firecells (#{project.firecells.length})

  each firecell, index in project.firecells
    div(style="border: 1px solid #ccc; margin: 10px 0; padding: 15px;")
      h3 Firecell #{index + 1}

      h4 Basic Information
      div
        p
          strong Risk Group:
          = firecell.riskGroup
        p
          strong Occupant Type:
          = firecell.occupantType
        p
          strong Occupant Load:
          = firecell.occupantLoad
        p
          strong Escape Height:
          = firecell.escapeHeight + 'm'
        p
          strong Is Sprinklered:
          = firecell.isSprinklered ? 'Yes' : 'No'
        p
          strong Floor Area:
          = firecell.floorArea + 'm²'

      if firecell.hasVehicleStacker !== undefined
        p
          strong Has Vehicle Stacker:
          = firecell.hasVehicleStacker ? 'Yes' : 'No'

      if firecell.isCinemaOrTheatre !== undefined
        p
          strong Is Cinema or Theatre:
          = firecell.isCinemaOrTheatre ? 'Yes' : 'No'

      // Display fire safety systems
      if firecell.fireSafetySystems
        h4 Fire Safety Systems
        div
          p
            strong Required Systems:
          ul
            each systemCode in firecell.fireSafetySystems
              li= systemCode

      // Display processed fire safety systems
      if firecell.processedFireSafetySystems
        h4 Processed Fire Safety Systems
        each processedSystem in firecell.processedFireSafetySystems
          div(style="margin: 10px 0; padding: 10px; border: 1px solid #eee;")
            p
              strong System Code:
              = processedSystem.code
            if processedSystem.type
              p
                strong Type:
                = processedSystem.type
            if processedSystem.definition
              p
                strong Description:
                = processedSystem.definition
            if processedSystem.notes && processedSystem.notes.length > 0
              p
                strong Notes:
              ul
                each note in processedSystem.notes
                  li= note

      // NEW: NZS 4515 Substitution Info
      if firecell.nzs4515SubstitutionInfo && firecell.nzs4515SubstitutionInfo.applies
        h4(style="color: #1976d2; margin-top: 20px; border-bottom: 2px solid #1976d2; padding-bottom: 5px;") NZS 4515 Sprinkler Substitution (C/AS2 Para 2.2.3)
        div(style="border: 2px solid #bbdefb; padding: 15px; background-color: #e3f2fd; border-radius: 4px; margin-top: 10px;")
          - const nzs = firecell.nzs4515SubstitutionInfo
          p
            strong Applies to this firecell:
            = ' Yes (SM education or SI care/detention)'
          p
            strong Total Building Floor Area:
            = ' ' + nzs.totalFloorArea + 'm²'
          p
            strong Within NZS 4515 Scope (≤2000m²):
            = ' ' + (nzs.withinNZS4515Scope ? 'Yes' : 'No')
          p
            strong Eligible for NZS 4515 Substitution:
            = ' ' + (nzs.eligible ? 'Yes' : 'No')

          if nzs.eligible
            p
              strong User Selected NZS 4515:
              = ' ' + (nzs.userSelectedSubstitution ? 'Yes' : 'No')

            if nzs.totalFloorArea > 500 && nzs.totalFloorArea <= 2000
              p(style="background-color: #fff3e0; padding: 10px; border-radius: 4px; margin-top: 10px; border-left: 4px solid #ff9800;")
                strong Extended Scope Requirements:
                br
                | Building exceeds 500m² basic scope. NZS 4515 Section 1.1.3.2 requires:
                ul(style="margin-top: 5px; margin-bottom: 0;")
                  li 60-minute water supply at highest design flow/pressure
                  li Fire brigade alarm
                  li Fire sprinkler inlet

            if nzs.userSelectedSubstitution
              p(style="color: #2e7d32; font-weight: bold; background-color: #c8e6c9; padding: 10px; border-radius: 4px; margin-top: 10px;")
                | ✓ NZS 4515 SUBSTITUTION APPLIED
                br
                | Type 7 sprinkler component will be replaced with NZS 4515 life protection sprinklers per C/AS2 2.2.3
          else if !nzs.withinNZS4515Scope
            p(style="color: #d32f2f; background-color: #ffebee; padding: 10px; border-radius: 4px; margin-top: 10px;")
              strong Building exceeds NZS 4515 scope
              br
              | Total floor area (#{nzs.totalFloorArea}m²) exceeds 2000m² limit.
              | Type 7 system is required.

      // NEW: Fire Safety Systems Validation
      if firecell.fireSafetySystemsValidation
        h4(style="color: #1976d2; margin-top: 20px; border-bottom: 2px solid #1976d2; padding-bottom: 5px;") Fire Safety Systems Validation
        - const validation = firecell.fireSafetySystemsValidation

        if validation.noSystemsInstalled
          div(style="border: 3px solid #d32f2f; padding: 15px; background-color: #ffebee; border-radius: 4px; margin-top: 10px;")
            p(style="color: #c62828; font-weight: bold; font-size: 1.2em;")
              | ✗ NO SYSTEMS INSTALLED
            p All required fire safety systems are missing.
        else
          div(style=`border: 3px solid ${validation.compliant ? '#2e7d32' : '#d32f2f'}; padding: 15px; background-color: ${validation.compliant ? '#e8f5e9' : '#ffebee'}; border-radius: 4px; margin-top: 10px;`)
            p(style=`color: ${validation.compliant ? '#1b5e20' : '#c62828'}; font-weight: bold; font-size: 1.2em;`)
              = validation.compliant ? '✓ COMPLIANT' : '✗ NON-COMPLIANT'
            p(style="margin-top: 10px;")= validation.details.join(' ')

          // Required Systems Table
          if validation.requiredSystems && validation.requiredSystems.length > 0
            h5(style="margin-top: 20px;") Required vs Installed Systems
            table(style="width: 100%; margin-top: 10px;")
              thead(style="background-color: #f5f5f5;")
                tr
                  th System Type
                  th Description
                  th Required
                  th Installed
                  th Status
              tbody
                each sys in validation.requiredSystems
                  tr(style=`background-color: ${sys.compliant ? '#fff' : '#ffcdd2'};`)
                    td(style="font-weight: bold;")= `Type ${sys.type}`
                    td= sys.description
                    td(style="text-align: center; color: #2e7d32;") ✓
                    td(style=`text-align: center; color: ${sys.installed ? '#2e7d32' : '#c62828'};`)
                      = sys.installed ? '✓' : '✗'
                    td(style=`font-weight: bold; color: ${sys.compliant ? '#2e7d32' : '#c62828'};`)
                      if sys.substitutedWith
                        = `✓ Compliant (via ${sys.substitutedWith})`
                      else
                        = sys.compliant ? '✓ Compliant' : '✗ MISSING'

          // Substitutions
          if validation.substitutionsApplied && validation.substitutionsApplied.length > 0
            h5(style="color: #1976d2; margin-top: 20px;") Substitutions Applied
            ul(style="background-color: #e3f2fd; padding: 15px; border-radius: 4px;")
              each sub in validation.substitutionsApplied
                li(style="color: #1565c0; font-weight: bold;")= sub

          // Missing Systems
          if validation.missingSystems && validation.missingSystems.length > 0
            h5(style="color: #c62828; margin-top: 20px;") Missing Required Systems
            ul(style="background-color: #ffebee; padding: 15px; border-radius: 4px; border: 2px solid #d32f2f;")
              each sys in validation.missingSystems
                li(style="color: #d32f2f; font-weight: bold;")
                  = `Type ${sys.type} - ${sys.description}`

          // Unnecessary Systems (informational)
          if validation.unnecessarySystems && validation.unnecessarySystems.length > 0
            h5(style="color: #666; margin-top: 20px;") Additional Systems (Not Required)
            p(style="font-style: italic; color: #666; font-size: 0.9em;")
              | The following systems are installed but not required by C/AS2.
              | This is acceptable and may provide enhanced fire protection.
            ul(style="background-color: #f5f5f5; padding: 15px; border-radius: 4px;")
              each sys in validation.unnecessarySystems
                li(style="color: #666;")= sys.description

      // Display compliance results
      if firecell.compliance
        h4 Compliance Results
        p(style="font-size: 12px; color: #666;")
          strong Debug - Available compliance data:
          = JSON.stringify(firecell.compliance)

        if firecell.compliance.fireSafetySystems
          div
            h5 Fire Safety Systems
            if firecell.compliance.fireSafetySystems.required
              div
                strong Required Systems:
                ul
                  each system in firecell.compliance.fireSafetySystems.required
                    li= system
            if firecell.compliance.fireSafetySystems.compliant !== undefined
              p
                strong Compliant:
                = firecell.compliance.fireSafetySystems.compliant ? 'Yes' : 'No'

        if firecell.compliance.firecellFloorArea
          div
            h5 Firecell Floor Area
            p
              strong Limit:
              = firecell.compliance.firecellFloorArea.limit
            p
              strong Actual:
              = firecell.floorArea + 'm²'
            p
              strong Compliant:
              = firecell.compliance.firecellFloorArea.compliant ? 'Yes' : 'No'

        if firecell.compliance.fireResistance
          div
            h5 Fire Resistance Ratings
            if firecell.compliance.fireResistance.lifeSafety
              p
                strong Life Safety Rating:
                = firecell.compliance.fireResistance.lifeSafety + ' minutes'
            if firecell.compliance.fireResistance.propertyProtection
              p
                strong Property Protection Rating:
                = firecell.compliance.fireResistance.propertyProtection + ' minutes'

        if firecell.compliance.occupantLoad
          div
            h5 Occupant Load
            if firecell.compliance.occupantLoad.calculatedLoad !== undefined
              p
                strong Calculated Load:
                = firecell.compliance.occupantLoad.calculatedLoad
            if firecell.compliance.occupantLoad.providedLoad !== undefined
              p
                strong Provided Load:
                = firecell.compliance.occupantLoad.providedLoad
            if firecell.compliance.occupantLoad.compliant !== undefined
              p
                strong Compliant:
                = firecell.compliance.occupantLoad.compliant ? 'Yes' : 'No'

  div(style="margin-top: 30px;")
    a(href="/") ← Back to Form