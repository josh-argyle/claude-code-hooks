const { expect } = require('@playwright/test');

class TenderbookPage {
  constructor(page) {
    this.page = page;

    // Page header elements
    this.pageTitle = page.locator('h1.page-title');
    this.addTenderButton = page.locator('#add-tender-btn');

    // Filter elements
    this.searchInput = page.locator('#search-input');
    this.startDateInput = page.locator('#start-date');
    this.endDateInput = page.locator('#end-date');
    this.profitCentreFilter = page.locator('#profit-centre-filter');
    this.outcomeFilter = page.locator('#outcome-filter');
    this.projectTypeFilter = page.locator('#project-type-filter');
    this.clientFilter = page.locator('#client-filter');
    this.contractorFilter = page.locator('#contractor-filter');
    this.submissionFilter = page.locator('#submission-filter');
    this.minAmountSlider = page.locator('#min-amount-slider');
    this.maxAmountSlider = page.locator('#max-amount-slider');
    this.minValueDisplay = page.locator('.min-value');
    this.maxValueDisplay = page.locator('.max-value');
    this.resetFiltersButton = page.locator('.reset-search-btn');

    // Results elements
    this.resultsCount = page.locator('#results-count');
    this.tendersTable = page.locator('#tendersTable');
    this.tendersTableBody = page.locator('#tendersTableBody');
    this.tenderRows = page.locator('#tendersTableBody .project-row');
    this.loadingRow = page.locator('.loading-row');
    this.emptyStateRow = page.locator('.empty-row');

    // Add Tender Modal elements
    this.addTenderModal = page.locator('#add-tender-modal-overlay');
    this.addTenderForm = page.locator('#add-tender-modal-form');
    this.addTenderCodeInput = page.locator('#tender-code');
    this.addProfitCentreSelect = page.locator('#profit-centre');
    this.addProjectDescriptionInput = page.locator('#project-description');
    this.addClientInput = page.locator('#client');
    this.addAreaInput = page.locator('#area');
    this.addClosingDateInput = page.locator('#closing-date');
    this.addTenderAmountInput = page.locator('#tender-amount');
    this.addOutcomeSelect = page.locator('#outcome');
    this.addProjectTypeSelect = page.locator('#project-type');
    this.addWinningCompetitorInput = page.locator('#winning-competitor');
    this.addNotesInput = page.locator('#notes');
    this.addIsSubmittedCheckbox = page.locator('#is-submitted');
    this.addContractorsInput = page.locator('#contractors');
    this.addModalSubmitButton = page.locator('#add-tender-modal-overlay .new-modal-submit');
    this.addModalCancelButton = page.locator('#add-tender-modal-overlay .new-modal-cancel');
    this.addModalCloseButton = page.locator('#add-tender-modal-overlay .new-modal-close');

    // Edit Tender Modal elements
    this.editTenderModal = page.locator('#edit-tender-modal-overlay');
    this.editTenderForm = page.locator('#edit-tender-modal-form');
    this.editTenderCodeInput = page.locator('#edit-tender-code');
    this.editProfitCentreSelect = page.locator('#edit-profit-centre');
    this.editProjectDescriptionInput = page.locator('#edit-project-description');
    this.editClientInput = page.locator('#edit-client');
    this.editAreaInput = page.locator('#edit-area');
    this.editClosingDateInput = page.locator('#edit-closing-date');
    this.editTenderAmountInput = page.locator('#edit-tender-amount');
    this.editOutcomeSelect = page.locator('#edit-outcome');
    this.editProjectTypeSelect = page.locator('#edit-project-type');
    this.editWinningCompetitorInput = page.locator('#edit-winning-competitor');
    this.editNotesInput = page.locator('#edit-notes');
    this.editIsSubmittedCheckbox = page.locator('#edit-is-submitted');
    this.editContractorsInput = page.locator('#edit-contractors');
    this.editModalSubmitButton = page.locator('#edit-tender-modal-overlay .new-modal-submit');
    this.editModalCancelButton = page.locator('#edit-tender-modal-overlay .new-modal-cancel');
    this.editModalCloseButton = page.locator('#edit-tender-modal-overlay .new-modal-close');

    // Error elements
    this.tenderCodeError = page.locator('#tender-code-error');
    this.editTenderCodeError = page.locator('#edit-tender-code-error');
    this.projectDescriptionError = page.locator('#project-description-error');
    this.editProjectDescriptionError = page.locator('#edit-project-description-error');
    this.tenderAmountError = page.locator('#tender-amount-error');
    this.editTenderAmountError = page.locator('#edit-tender-amount-error');

    // Notification elements
    this.notification = page.locator('.notification');

    // Table action buttons
    this.editTenderButtons = page.locator('.edit-tender-btn');
    this.convertTenderButtons = page.locator('.convert-tender-btn');
    this.archiveTenderButtons = page.locator('.archive-tender-btn');

    // Tender details row
    this.tenderDetailsRows = page.locator('.tender-details-row');
    this.expandIcons = page.locator('.project-expand-icon');
  }

  // Navigation methods
  async navigate() {
    await this.page.goto('/tenderbook');
  }

  async waitForPageLoad() {
    await this.page.waitForLoadState('networkidle');
    await expect(this.pageTitle).toBeVisible();
    // Wait for loading to complete
    await expect(this.loadingRow).toBeHidden({ timeout: 10000 });
    await this.page.waitForTimeout(500); // Allow for any remaining renders
  }

  // Filter methods
  async searchTenders(searchTerm) {
    await this.searchInput.fill(searchTerm);
    await this.page.waitForTimeout(500); // Debounce
  }

  async setDateRange(startDate, endDate) {
    if (startDate) {
      await this.startDateInput.fill(startDate);
    }
    if (endDate) {
      await this.endDateInput.fill(endDate);
    }
  }

  async filterByProfitCentre(profitCentre) {
    // Select by visible text instead of value since dropdowns use codes as values
    await this.profitCentreFilter.selectOption({ label: profitCentre });
  }

  async filterByOutcome(outcome) {
    await this.outcomeFilter.selectOption(outcome);
  }

  async filterByProjectType(projectType) {
    await this.projectTypeFilter.selectOption(projectType);
  }

  async filterByClient(client) {
    await this.clientFilter.selectOption(client);
  }

  async filterByContractor(contractor) {
    await this.contractorFilter.selectOption(contractor);
  }

  async filterBySubmission(submissionStatus) {
    await this.submissionFilter.selectOption(submissionStatus);
  }

  async setAmountRange(minAmount, maxAmount) {
    if (minAmount !== undefined) {
      await this.minAmountSlider.fill(minAmount.toString());
    }
    if (maxAmount !== undefined) {
      await this.maxAmountSlider.fill(maxAmount.toString());
    }
    await this.page.waitForTimeout(500); // Debounce
  }

  async resetFilters() {
    await this.resetFiltersButton.click();
    await this.waitForTableUpdate();
  }

  // Table methods
  async getResultsCount() {
    const text = await this.resultsCount.textContent();
    const matches = text.match(/(\d+) tender/);
    return matches ? parseInt(matches[1]) : 0;
  }

  async getTenderByCode(tenderCode) {
    return this.tenderRows.filter({ has: this.page.locator(`td:nth-child(2):has-text("${tenderCode}")`) });
  }

  async getTenderData(tenderCode) {
    const row = await this.getTenderByCode(tenderCode);
    const cells = await row.locator('td').all();

    if (cells.length < 8) return null;

    return {
      code: (await cells[1].textContent()).trim(),
      description: (await cells[2].textContent()).trim(),
      client: (await cells[3].textContent()).trim(),
      profitCentre: (await cells[4].textContent()).trim(),
      closingDate: (await cells[5].textContent()).trim(),
      amount: (await cells[6].textContent()).trim(),
      outcome: (await cells[7].textContent()).trim()
    };
  }

  async clickTenderRow(tenderCode) {
    const row = await this.getTenderByCode(tenderCode);
    await row.click();
  }

  async expandTenderDetails(tenderCode) {
    const row = await this.getTenderByCode(tenderCode);
    // Click on the row to trigger expansion (avoid clicking action buttons)
    await row.locator('td:first-child').click();
    await this.page.waitForTimeout(500);
  }

  async isTenderDetailsExpanded(tenderCode) {
    const row = await this.getTenderByCode(tenderCode);
    const nextRow = row.locator('+ tr.tender-details-row');

    // Check if the next row exists and has the tender-details-row class
    const nextRowCount = await nextRow.count();
    if (nextRowCount === 0) {
      return false;
    }

    return await nextRow.isVisible();
  }

  // Action methods
  async clickEditTender(tenderCode) {
    const row = await this.getTenderByCode(tenderCode);
    const editButton = row.locator('.edit-tender-btn');
    await editButton.click();
  }

  async clickArchiveTender(tenderCode) {
    const row = await this.getTenderByCode(tenderCode);
    const archiveButton = row.locator('.archive-tender-btn');
    await archiveButton.click();
  }

  async clickConvertTender(tenderCode) {
    const row = await this.getTenderByCode(tenderCode);
    const convertButton = row.locator('.convert-tender-btn');
    await convertButton.click();
  }

  // Modal methods
  async openAddTenderModal() {
    await this.addTenderButton.click();
    await expect(this.addTenderModal).toBeVisible({ timeout: 5000 });
    await this.page.waitForTimeout(1000); // Wait for initialization
  }

  async waitForEditModalToOpen() {
    await expect(this.editTenderModal).toBeVisible({ timeout: 5000 });
    await this.page.waitForTimeout(1000); // Wait for data to populate
  }

  async closeModal(modalType = 'add') {
    const closeButton = modalType === 'add' ? this.addModalCloseButton : this.editModalCloseButton;
    await closeButton.click();
    const modal = modalType === 'add' ? this.addTenderModal : this.editTenderModal;
    await expect(modal).toBeHidden({ timeout: 5000 });
  }

  async cancelModal(modalType = 'add') {
    const cancelButton = modalType === 'add' ? this.addModalCancelButton : this.editModalCancelButton;
    await cancelButton.click();
    const modal = modalType === 'add' ? this.addTenderModal : this.editTenderModal;
    await expect(modal).toBeHidden({ timeout: 5000 });
  }

  // Form filling methods
  async fillAddTenderForm(tenderData) {
    if (tenderData.tenderCode) {
      await this.addTenderCodeInput.fill(tenderData.tenderCode);
    }
    if (tenderData.profitCentre) {
      await this.addProfitCentreSelect.selectOption({ label: tenderData.profitCentre });
    }
    if (tenderData.projectDescription) {
      await this.addProjectDescriptionInput.fill(tenderData.projectDescription);
    }
    if (tenderData.client) {
      // For search-select, we need to properly interact with the dropdown
      await this.addClientInput.click(); // Focus and open dropdown
      await this.page.waitForTimeout(500);

      await this.addClientInput.fill(tenderData.client); // Type to filter
      await this.page.waitForTimeout(500);

      // Click the first matching option in the dropdown
      const dropdown = this.page.locator('#client-dropdown');
      const firstOption = dropdown.locator('.search-dropdown-option').first();

      if (await firstOption.isVisible()) {
        await firstOption.click();
      } else {
        // If no match found, clear the field (client_id will be null)
        await this.addClientInput.clear();
      }

      await this.page.waitForTimeout(300);
    }
    if (tenderData.area) {
      await this.addAreaInput.fill(tenderData.area);
    }
    if (tenderData.closingDate) {
      await this.addClosingDateInput.fill(tenderData.closingDate);
    }
    if (tenderData.tenderAmount) {
      await this.addTenderAmountInput.fill(tenderData.tenderAmount.toString());
    }
    if (tenderData.outcome) {
      await this.addOutcomeSelect.selectOption(tenderData.outcome);
    }
    if (tenderData.projectType) {
      await this.addProjectTypeSelect.selectOption(tenderData.projectType);
    }
    if (tenderData.winningCompetitor) {
      // For search-select, we need to properly interact with the dropdown
      await this.addWinningCompetitorInput.click(); // Focus and open dropdown
      await this.page.waitForTimeout(500);

      await this.addWinningCompetitorInput.fill(tenderData.winningCompetitor); // Type to filter
      await this.page.waitForTimeout(500);

      // Click the first matching option in the dropdown
      const dropdown = this.page.locator('#winning-competitor-dropdown');
      const firstOption = dropdown.locator('.search-dropdown-option').first();

      if (await firstOption.isVisible()) {
        await firstOption.click();
      } else {
        // If no match found, clear the field (winning_competitor_id will be null)
        await this.addWinningCompetitorInput.clear();
      }

      await this.page.waitForTimeout(300);
    }
    if (tenderData.notes) {
      await this.addNotesInput.fill(tenderData.notes);
    }
    if (tenderData.isSubmitted) {
      await this.addIsSubmittedCheckbox.check();
    }
  }

  async fillEditTenderForm(tenderData) {
    if (tenderData.profitCentre !== undefined) {
      await this.editProfitCentreSelect.selectOption({ label: tenderData.profitCentre });
    }
    if (tenderData.projectDescription !== undefined) {
      await this.editProjectDescriptionInput.clear();
      await this.editProjectDescriptionInput.fill(tenderData.projectDescription);
    }
    if (tenderData.client !== undefined) {
      await this.editClientInput.clear();

      if (tenderData.client) {
        // For search-select, we need to properly interact with the dropdown
        await this.editClientInput.click(); // Focus and open dropdown
        await this.page.waitForTimeout(500);

        await this.editClientInput.fill(tenderData.client); // Type to filter
        await this.page.waitForTimeout(500);

        // Click the first matching option in the dropdown
        const dropdown = this.page.locator('#edit-client-dropdown');
        const firstOption = dropdown.locator('.search-dropdown-option').first();

        if (await firstOption.isVisible()) {
          await firstOption.click();
        } else {
          // If no match found, clear the field (client_id will be null)
          await this.editClientInput.clear();
        }
      }

      await this.page.waitForTimeout(300);
    }
    if (tenderData.area !== undefined) {
      await this.editAreaInput.clear();
      await this.editAreaInput.fill(tenderData.area);
    }
    if (tenderData.closingDate !== undefined) {
      await this.editClosingDateInput.fill(tenderData.closingDate);
    }
    if (tenderData.tenderAmount !== undefined) {
      await this.editTenderAmountInput.clear();
      await this.editTenderAmountInput.fill(tenderData.tenderAmount.toString());
    }
    if (tenderData.outcome !== undefined) {
      await this.editOutcomeSelect.selectOption(tenderData.outcome);
    }
    if (tenderData.projectType !== undefined) {
      await this.editProjectTypeSelect.selectOption(tenderData.projectType);
    }
    if (tenderData.winningCompetitor !== undefined) {
      await this.editWinningCompetitorInput.clear();

      if (tenderData.winningCompetitor) {
        // For search-select, we need to properly interact with the dropdown
        await this.editWinningCompetitorInput.click(); // Focus and open dropdown
        await this.page.waitForTimeout(500);

        await this.editWinningCompetitorInput.fill(tenderData.winningCompetitor); // Type to filter
        await this.page.waitForTimeout(500);

        // Click the first matching option in the dropdown
        const dropdown = this.page.locator('#edit-winning-competitor-dropdown');
        const firstOption = dropdown.locator('.search-dropdown-option').first();

        if (await firstOption.isVisible()) {
          await firstOption.click();
        } else {
          // If no match found, clear the field (winning_competitor_id will be null)
          await this.editWinningCompetitorInput.clear();
        }
      }

      await this.page.waitForTimeout(300);
    }
    if (tenderData.notes !== undefined) {
      await this.editNotesInput.clear();
      await this.editNotesInput.fill(tenderData.notes);
    }
    if (tenderData.isSubmitted !== undefined) {
      if (tenderData.isSubmitted) {
        await this.editIsSubmittedCheckbox.check();
      } else {
        await this.editIsSubmittedCheckbox.uncheck();
      }
    }
  }

  // Form submission methods
  async submitAddTender() {
    await this.addModalSubmitButton.click();
  }

  async submitEditTender() {
    await this.editModalSubmitButton.click();
  }

  // Form validation methods
  async getValidationError(fieldName, modalType = 'add') {
    const errorSelector = modalType === 'add' ? `#${fieldName}-error` : `#edit-${fieldName}-error`;
    const errorElement = this.page.locator(errorSelector);
    return await errorElement.textContent();
  }

  async hasValidationError(fieldName, modalType = 'add') {
    const errorSelector = modalType === 'add' ? `#${fieldName}-error` : `#edit-${fieldName}-error`;
    const errorElement = this.page.locator(errorSelector);

    try {
      // First check if the error element is visible
      const isVisible = await errorElement.isVisible();
      if (!isVisible) {
        return false;
      }

      // Check if it has any text content
      const errorText = await errorElement.textContent();
      if (errorText && errorText.trim() !== '') {
        return true;
      }

      // Also check if the error element has error styling classes
      const hasErrorClass = await errorElement.evaluate(el => {
        return el.classList.contains('error') ||
               el.classList.contains('field-error') ||
               el.style.display !== 'none';
      });

      return hasErrorClass;
    } catch (error) {
      // If element doesn't exist or any other error, return false
      return false;
    }
  }

  async isFieldInErrorState(fieldName, modalType = 'add') {
    const fieldSelector = modalType === 'add' ? `#${fieldName}` : `#edit-${fieldName}`;
    const field = this.page.locator(fieldSelector);
    return await field.locator('..').locator('.error').isVisible().catch(() => false);
  }

  // Contractor methods (multi-select)
  async addContractor(contractorName, _status = 'Quoting', modalType = 'add') {
    const contractorInput = modalType === 'add' ? this.addContractorsInput : this.editContractorsInput;

    // Click the multi-select input to open dropdown
    await contractorInput.click();
    await this.page.waitForTimeout(500);

    // Find and click the contractor option
    const dropdown = this.page.locator('.search-dropdown.active');
    const option = dropdown.locator(`div.search-dropdown-option:has-text("${contractorName}")`);
    await expect(option).toBeVisible({ timeout: 5000 });
    await option.click();
    await this.page.waitForTimeout(300);

    // Set the status if needed (assuming there's a status dropdown for each contractor)
    // This may need adjustment based on the actual multi-select implementation
  }

  async removeContractor(contractorName, modalType = 'add') {
    const pillsContainer = modalType === 'add'
      ? this.page.locator('#contractors').locator('..').locator('[id$="-pills"]')
      : this.page.locator('#edit-contractors').locator('..').locator('[id$="-pills"]');

    const pill = pillsContainer.locator(`.multi-select-pill:has-text("${contractorName}")`);
    const removeButton = pill.locator('.multi-select-pill-remove');
    await removeButton.click();
    await this.page.waitForTimeout(300);
  }

  async getSelectedContractors(modalType = 'add') {
    const pillsContainer = modalType === 'add'
      ? this.page.locator('#contractors').locator('..').locator('[id$="-pills"]')
      : this.page.locator('#edit-contractors').locator('..').locator('[id$="-pills"]');

    const pills = await pillsContainer.locator('.multi-select-pill > span:first-child').all();
    const contractors = [];
    for (const pill of pills) {
      const text = await pill.textContent();
      contractors.push(text.trim());
    }
    return contractors;
  }

  // Notification methods
  async waitForNotification(expectedMessage = null, expectedType = null) {
    await expect(this.notification).toBeVisible({ timeout: 10000 });

    if (expectedMessage) {
      const text = await this.notification.textContent();
      expect(text.toLowerCase()).toContain(expectedMessage.toLowerCase());
    }

    if (expectedType) {
      await expect(this.notification).toHaveClass(new RegExp(expectedType));
    }
  }

  async dismissNotification() {
    if (await this.notification.isVisible()) {
      await this.notification.click();
      await expect(this.notification).toBeHidden({ timeout: 5000 });
    }
  }

  // Helper methods
  async waitForTableUpdate() {
    await this.page.waitForLoadState('networkidle');
    await this.page.waitForTimeout(500);
  }

  async isEmpty() {
    return await this.emptyStateRow.isVisible();
  }

  async isLoading() {
    return await this.loadingRow.isVisible();
  }

  async handleConfirmationDialog(accept = true) {
    this.page.on('dialog', async dialog => {
      if (accept) {
        await dialog.accept();
      } else {
        await dialog.dismiss();
      }
    });
  }

  // Get form data for validation
  async getAddFormData() {
    return {
      tenderCode: await this.addTenderCodeInput.inputValue(),
      profitCentre: await this.addProfitCentreSelect.inputValue(),
      projectDescription: await this.addProjectDescriptionInput.inputValue(),
      client: await this.addClientInput.inputValue(),
      area: await this.addAreaInput.inputValue(),
      closingDate: await this.addClosingDateInput.inputValue(),
      tenderAmount: await this.addTenderAmountInput.inputValue(),
      outcome: await this.addOutcomeSelect.inputValue(),
      projectType: await this.addProjectTypeSelect.inputValue(),
      winningCompetitor: await this.addWinningCompetitorInput.inputValue(),
      notes: await this.addNotesInput.inputValue(),
      isSubmitted: await this.addIsSubmittedCheckbox.isChecked()
    };
  }

  async getEditFormData() {
    return {
      tenderCode: await this.editTenderCodeInput.inputValue(),
      profitCentre: await this.editProfitCentreSelect.inputValue(),
      projectDescription: await this.editProjectDescriptionInput.inputValue(),
      client: await this.editClientInput.inputValue(),
      area: await this.editAreaInput.inputValue(),
      closingDate: await this.editClosingDateInput.inputValue(),
      tenderAmount: await this.editTenderAmountInput.inputValue(),
      outcome: await this.editOutcomeSelect.inputValue(),
      projectType: await this.editProjectTypeSelect.inputValue(),
      winningCompetitor: await this.editWinningCompetitorInput.inputValue(),
      notes: await this.editNotesInput.inputValue(),
      isSubmitted: await this.editIsSubmittedCheckbox.isChecked()
    };
  }

  // Advanced filter methods
  async getFilterOptions(filterType) {
    let filterElement;
    switch (filterType) {
    case 'profitCentre':
      filterElement = this.profitCentreFilter;
      break;
    case 'outcome':
      filterElement = this.outcomeFilter;
      break;
    case 'projectType':
      filterElement = this.projectTypeFilter;
      break;
    case 'client':
      filterElement = this.clientFilter;
      break;
    case 'contractor':
      filterElement = this.contractorFilter;
      break;
    case 'submission':
      filterElement = this.submissionFilter;
      break;
    default:
      return [];
    }

    const options = await filterElement.locator('option').all();
    const optionTexts = [];
    for (const option of options) {
      const text = await option.textContent();
      optionTexts.push(text.trim());
    }
    return optionTexts;
  }

  // Get option value by text for profit centre
  async getProfitCentreValueByText(displayText) {
    const options = await this.profitCentreFilter.locator('option').all();
    for (const option of options) {
      const text = await option.textContent();
      if (text.trim() === displayText) {
        return await option.getAttribute('value');
      }
    }
    return null;
  }

  // Get modal profit centre options
  async getModalProfitCentreOptions() {
    const options = await this.addProfitCentreSelect.locator('option').all();
    const optionTexts = [];
    for (const option of options) {
      const text = await option.textContent();
      optionTexts.push(text.trim());
    }
    return optionTexts;
  }

  // Get available client options from datalist
  async getAvailableClientOptions() {
    const datalist = this.page.locator('#client-datalist');
    const options = await datalist.locator('option').all();
    const clientOptions = [];
    for (const option of options) {
      const text = await option.textContent();
      if (text && text.trim()) {
        clientOptions.push(text.trim());
      }
    }
    return clientOptions;
  }

  async getAmountRangeValues() {
    return {
      min: await this.minAmountSlider.inputValue(),
      max: await this.maxAmountSlider.inputValue(),
      minDisplay: await this.minValueDisplay.textContent(),
      maxDisplay: await this.maxValueDisplay.textContent()
    };
  }
}

module.exports = TenderbookPage;
