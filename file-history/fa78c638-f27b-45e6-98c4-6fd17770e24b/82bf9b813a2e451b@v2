const { expect } = require('@playwright/test');

class NcrHistoricalPage {
  constructor(page) {
    this.page = page;

    // Page header elements
    this.pageTitle = page.locator('h1.page-title');
    this.downloadCsvButton = page.locator('a[href="/api/ncr/closed/download"]');

    // Navigation tabs
    this.reportsTab = page.locator('.nav-tabs a[href="/ncr"]');
    this.historicalTab = page.locator('.nav-tabs').locator('text=Historical');
    this.statisticsTab = page.locator('.nav-tabs a[href="/ncr/statistics"]');

    // Filter elements
    this.reporterFilter = page.locator('#reporterFilter');
    this.projectFilter = page.locator('#projectFilter');
    this.supplierFilter = page.locator('#supplierFilter');
    this.contractorFilter = page.locator('#contractorFilter');
    this.consultantFilter = page.locator('#consultantFilter');
    this.profitCentreFilter = page.locator('#profitCentreFilter');
    this.causeFilter = page.locator('#causeFilter');
    this.levelFilter = page.locator('#levelFilter');
    this.dateFromFilter = page.locator('#dateFromFilter');
    this.dateToFilter = page.locator('#dateToFilter');
    this.clearFiltersButton = page.locator('.reset-search-btn');

    // Result display
    this.resultCount = page.locator('.result-count');

    // Table elements
    this.ncrTable = page.locator('#ncr-table');
    this.tableHeaders = page.locator('#ncr-table thead th');
    this.tableRows = page.locator('#ncr-table tbody tr.clickable-row');

    // Modal elements
    this.detailModal = page.locator('#ncr-detail-modal');
    this.modalTitle = page.locator('#ncr-detail-modal .new-modal-title');
    this.modalCloseButton = page.locator('#ncr-detail-modal .new-modal-close');

    // Modal detail fields
    this.modalProject = page.locator('#modal-project');
    this.modalReporter = page.locator('#modal-reporter');
    this.modalDateReported = page.locator('#modal-date-reported');
    this.modalLevel = page.locator('#modal-level');
    this.modalCause = page.locator('#modal-cause');
    this.modalDescription = page.locator('#modal-description');
    this.modalActionTaken = page.locator('#modal-action-taken');
    this.modalDateClosed = page.locator('#modal-date-closed');
    this.modalCloser = page.locator('#modal-closer');
    this.modalReporterProfitCentre = page.locator('#modal-reporter-profit-centre');
    this.modalSuppliers = page.locator('#modal-suppliers');
    this.modalContractors = page.locator('#modal-contractors');
    this.modalConsultants = page.locator('#modal-consultants');
    this.modalInvolvedStaff = page.locator('#modal-involved-staff');
  }

  // Navigation methods
  async navigate() {
    await this.page.goto('/ncr/historical');
  }

  async waitForPageLoad() {
    await this.page.waitForLoadState('networkidle');
    await expect(this.pageTitle).toBeVisible();
    await expect(this.ncrTable).toBeVisible();
    // Wait for any client-side filtering to complete
    await this.page.waitForTimeout(1000);
  }

  // Filter methods
  async selectReporter(reporter) {
    const initialCount = await this.getResultCountText();
    await this.reporterFilter.selectOption(reporter);
    await this.waitForFilterUpdate(initialCount);
  }

  async selectProject(project) {
    const initialCount = await this.getResultCountText();
    await this.projectFilter.selectOption(project);
    await this.waitForFilterUpdate(initialCount);
  }

  async selectSupplier(supplier) {
    const initialCount = await this.getResultCountText();
    await this.supplierFilter.selectOption(supplier);
    await this.waitForFilterUpdate(initialCount);
  }

  async selectContractor(contractor) {
    const initialCount = await this.getResultCountText();
    await this.contractorFilter.selectOption(contractor);
    await this.waitForFilterUpdate(initialCount);
  }

  async selectConsultant(consultant) {
    const initialCount = await this.getResultCountText();
    await this.consultantFilter.selectOption(consultant);
    await this.waitForFilterUpdate(initialCount);
  }

  async selectProfitCentre(profitCentre) {
    const initialCount = await this.getResultCountText();
    await this.profitCentreFilter.selectOption(profitCentre);
    await this.waitForFilterUpdate(initialCount);
  }

  async selectRootCause(cause) {
    const initialCount = await this.getResultCountText();
    await this.causeFilter.selectOption(cause);
    await this.waitForFilterUpdate(initialCount);
  }

  async selectNcrLevel(level) {
    const initialCount = await this.getResultCountText();
    await this.levelFilter.selectOption(level);
    await this.waitForFilterUpdate(initialCount);
  }

  async setDateFrom(date) {
    const initialCount = await this.getResultCountText();
    await this.dateFromFilter.fill(date);
    await this.waitForFilterUpdate(initialCount);
  }

  async setDateTo(date) {
    const initialCount = await this.getResultCountText();
    await this.dateToFilter.fill(date);
    await this.waitForFilterUpdate(initialCount);
  }

  async clearAllFilters() {
    const initialCount = await this.getResultCountText();
    await this.clearFiltersButton.click();
    await this.waitForFilterUpdate(initialCount, true);
  }

  // Table interaction methods
  async getVisibleRowCount() {
    const rows = await this.tableRows.all();
    // Filter out hidden rows (those with display: none)
    let visibleCount = 0;
    for (const row of rows) {
      const isVisible = await row.evaluate(el => el.style.display !== 'none');
      if (isVisible) visibleCount++;
    }
    return visibleCount;
  }

  async clickRow(index) {
    const rows = await this.tableRows.all();
    if (rows[index]) {
      await rows[index].click();
      await expect(this.detailModal).toBeVisible({ timeout: 5000 });
      await this.page.waitForTimeout(500); // Wait for modal animation
    }
  }

  async clickRowByNcrNumber(ncrNumber) {
    const row = this.tableRows.filter({ hasText: ncrNumber }).first();
    await row.click();
    await expect(this.detailModal).toBeVisible({ timeout: 5000 });
    await this.page.waitForTimeout(500);
  }

  async getRowData(index) {
    const allRows = await this.tableRows.all();
    // Filter to only visible rows
    const visibleRows = [];
    for (const row of allRows) {
      const isVisible = await row.evaluate(el => el.style.display !== 'none');
      if (isVisible) visibleRows.push(row);
    }

    if (visibleRows[index]) {
      const cells = await visibleRows[index].locator('td').all();
      return {
        ncrNumber: await cells[0].textContent(),
        reporter: await cells[1].textContent(),
        project: await cells[2].textContent(),
        dateReported: await cells[3].textContent(),
        level: await cells[4].textContent(),
        rootCause: await cells[5].textContent()
      };
    }
    return null;
  }

  // Modal methods
  async closeModal() {
    await this.modalCloseButton.click();
    await expect(this.detailModal).toBeHidden({ timeout: 5000 });
  }

  async getModalData() {
    await expect(this.detailModal).toBeVisible();

    return {
      title: await this.modalTitle.textContent(),
      project: await this.modalProject.textContent(),
      reporter: await this.modalReporter.textContent(),
      dateReported: await this.modalDateReported.textContent(),
      level: await this.modalLevel.textContent(),
      cause: await this.modalCause.textContent(),
      description: await this.modalDescription.textContent(),
      actionTaken: await this.modalActionTaken.textContent()
    };
  }

  async isModalFieldVisible(fieldName) {
    const fieldMap = {
      reporterProfitCentre: this.modalReporterProfitCentre,
      dateClosed: this.modalDateClosed,
      closer: this.modalCloser,
      suppliers: this.modalSuppliers,
      contractors: this.modalContractors,
      consultants: this.modalConsultants,
      involvedStaff: this.modalInvolvedStaff
    };

    const field = fieldMap[fieldName];
    return field ? await field.isVisible() : false;
  }

  // Filter validation methods
  async getFilterOptions(filterName) {
    const filterMap = {
      reporter: this.reporterFilter,
      project: this.projectFilter,
      supplier: this.supplierFilter,
      contractor: this.contractorFilter,
      consultant: this.consultantFilter,
      profitCentre: this.profitCentreFilter,
      cause: this.causeFilter,
      level: this.levelFilter
    };

    const filter = filterMap[filterName];
    if (filter) {
      const options = await filter.locator('option').all();
      const optionTexts = [];
      for (const option of options) {
        const text = await option.textContent();
        if (text && !text.startsWith('All ')) {
          optionTexts.push(text);
        }
      }
      return optionTexts;
    }
    return [];
  }

  async getSelectedFilterValue(filterName) {
    const filterMap = {
      reporter: this.reporterFilter,
      project: this.projectFilter,
      supplier: this.supplierFilter,
      contractor: this.contractorFilter,
      consultant: this.consultantFilter,
      profitCentre: this.profitCentreFilter,
      cause: this.causeFilter,
      level: this.levelFilter
    };

    const filter = filterMap[filterName];
    return filter ? await filter.inputValue() : '';
  }

  async getDateFilterValue(filterName) {
    if (filterName === 'dateFrom') {
      return await this.dateFromFilter.inputValue();
    } else if (filterName === 'dateTo') {
      return await this.dateToFilter.inputValue();
    }
    return '';
  }

  // Result count methods
  async getResultCountText() {
    return await this.resultCount.textContent();
  }

  async parseResultCount() {
    const text = await this.getResultCountText();
    if (text.includes('Showing all reports')) {
      const visibleCount = await this.getVisibleRowCount();
      return { showing: visibleCount, total: visibleCount };
    }

    const match = text.match(/Showing (\d+) of (\d+) reports/);
    if (match) {
      return { showing: parseInt(match[1]), total: parseInt(match[2]) };
    }

    // If no match, return visible count as fallback
    const visibleCount = await this.getVisibleRowCount();
    return { showing: visibleCount, total: visibleCount };
  }

  // CSV download methods
  async downloadCsv() {
    // Listen for download
    const downloadPromise = this.page.waitForEvent('download');
    await this.downloadCsvButton.click();
    const download = await downloadPromise;

    // Save file and get path
    const path = await download.path();
    return { download, path };
  }

  // Utility methods
  async isDateInNZFormat(dateString) {
    // Check if date matches DD/MM/YYYY format
    const nzDateRegex = /^\d{1,2}\/\d{1,2}\/\d{4}$/;
    return nzDateRegex.test(dateString);
  }

  async waitForTableUpdate() {
    await this.page.waitForTimeout(500); // Wait for filtering to complete
  }

  async waitForFilterUpdate(initialCountText, isClearing = false) {
    // Wait for any change event to propagate
    await this.page.waitForTimeout(300);

    try {
      // Wait for table body to stabilize (check for display style changes on rows)
      await this.page.waitForFunction(() => {
        const rows = document.querySelectorAll('#ncr-table-body .clickable-row');
        const visibleRows = Array.from(rows).filter(row =>
          row.style.display !== 'none'
        );
        return rows.length > 0; // Ensure rows exist
      }, { timeout: 3000 });

      // Additional wait for result count to update
      await this.page.waitForTimeout(200);
    } catch (e) {
      // Fallback: just wait a bit longer
      await this.page.waitForTimeout(500);
    }
  }

  async getTableColumnHeaders() {
    const headers = await this.tableHeaders.all();
    const headerTexts = [];
    for (const header of headers) {
      headerTexts.push(await header.textContent());
    }
    return headerTexts;
  }

  async verifyDefaultDateFilters() {
    const dateFrom = await this.getDateFilterValue('dateFrom');
    const dateTo = await this.getDateFilterValue('dateTo');

    // Verify dates are populated and in YYYY-MM-DD format
    const dateRegex = /^\d{4}-\d{2}-\d{2}$/;

    if (!dateRegex.test(dateFrom) || !dateRegex.test(dateTo)) {
      return false;
    }

    // Check if date range is approximately 6 months
    const fromDate = new Date(dateFrom);
    const toDate = new Date(dateTo);
    const diffMonths = (toDate.getFullYear() - fromDate.getFullYear()) * 12 +
                      (toDate.getMonth() - fromDate.getMonth());

    // Allow for some variance (5-7 months)
    return diffMonths >= 5 && diffMonths <= 7;
  }
}

module.exports = NcrHistoricalPage;
