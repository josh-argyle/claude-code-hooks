const { test, expect } = require('../../fixtures/test-with-rate-limit-reset');
const NCRStatisticsPage = require('../../page-objects/NCRStatisticsPage');
const DateUtils = require('../../../public/js/dateUtils');

test.describe('NCR Statistics Page - Permission Tests', () => {
  test.describe('Access Control', () => {
    test('should allow admin to access the page', async ({ browser }) => {
      // Use admin auth state
      const context = await browser.newContext({
        storageState: 'tests/.auth/admin.json'
      });
      const page = await context.newPage();
      const ncrStatisticsPage = new NCRStatisticsPage(page);

      await ncrStatisticsPage.navigate();

      // Admin should be able to see the page
      await expect(page).toHaveURL(/.*\/ncr\/statistics.*/);
      await expect(ncrStatisticsPage.pageTitle).toBeVisible();
      await expect(ncrStatisticsPage.pageTitle).toHaveText('NCR Statistics');

      await context.close();
    });

    test('should allow project manager to access the page', async ({ browser }) => {
      // Use project manager auth state
      const context = await browser.newContext({
        storageState: 'tests/.auth/project-manager.json'
      });
      const page = await context.newPage();
      const ncrStatisticsPage = new NCRStatisticsPage(page);

      await ncrStatisticsPage.navigate();

      // Project manager should be able to see the page
      await expect(page).toHaveURL(/.*\/ncr\/statistics.*/);
      await expect(ncrStatisticsPage.pageTitle).toBeVisible();
      await expect(ncrStatisticsPage.pageTitle).toHaveText('NCR Statistics');

      await context.close();
    });

    test('should deny access to regular user', async ({ browser }) => {
      // Use regular user auth state
      const context = await browser.newContext({
        storageState: 'tests/.auth/user.json'
      });
      const page = await context.newPage();

      // Try to navigate to the page
      const response = await page.goto('/ncr/statistics', { waitUntil: 'networkidle' });

      // Should get 403 status
      const statusCode = response?.status();
      expect(statusCode).toBe(403);

      // Should show access denied error message
      const pageContent = await page.textContent('body');
      expect(pageContent).toContain('Access denied');
      expect(pageContent).toContain('Access denied');

      await context.close();
    });

    test('should deny access to foreman', async ({ browser }) => {
      // Use foreman auth state
      const context = await browser.newContext({
        storageState: 'tests/.auth/foreman.json'
      });
      const page = await context.newPage();

      // Try to navigate to the page
      const response = await page.goto('/ncr/statistics', { waitUntil: 'networkidle' });

      // Should get 403 status
      const statusCode = response?.status();
      expect(statusCode).toBe(403);

      // Should show access denied error message
      const pageContent = await page.textContent('body');
      expect(pageContent).toContain('Access denied');
      expect(pageContent).toContain('Access denied');

      await context.close();
    });
  });
});

test.describe('NCR Statistics Page', () => {
  let ncrStatisticsPage;

  test.beforeEach(async ({ page }) => {
    ncrStatisticsPage = new NCRStatisticsPage(page);
    await ncrStatisticsPage.navigate();
    await ncrStatisticsPage.waitForPageLoad();
  });

  test.describe('Page Load and Basic Elements', () => {
    test('should display all required page elements', async ({ page }) => {
      await ncrStatisticsPage.verifyPageElements();
      await ncrStatisticsPage.verifyStatisticsCardsVisible();
    });

    test('should have default date values populated', async ({ page }) => {
      const fromDate = await ncrStatisticsPage.getFromDate();
      const toDate = await ncrStatisticsPage.getToDate();

      // Should have some default dates set (not empty)
      expect(fromDate).not.toBe('');
      expect(toDate).not.toBe('');

      // Verify dates are in correct format (YYYY-MM-DD)
      expect(fromDate).toMatch(/^\d{4}-\d{2}-\d{2}$/);
      expect(toDate).toMatch(/^\d{4}-\d{2}-\d{2}$/);
    });
  });

  test.describe('Date Filter Functionality', () => {
    test('should update statistics when changing from date', async ({ page }) => {
      // Get initial statistics
      const initialOpenCount = await ncrStatisticsPage.getOpenReportsCount();
      const initialClosedCount = await ncrStatisticsPage.getClosedReportsCount();

      // Set from date to one year ago
      const oneYearAgo = ncrStatisticsPage.getDateOneYearAgo();
      await ncrStatisticsPage.setFromDate(oneYearAgo);
      await ncrStatisticsPage.waitForStatisticsUpdate();

      // Statistics should potentially change (depending on data)
      const newOpenCount = await ncrStatisticsPage.getOpenReportsCount();
      const newClosedCount = await ncrStatisticsPage.getClosedReportsCount();

      // Verify statistics are valid numbers
      expect(newOpenCount).toBeGreaterThanOrEqual(0);
      expect(newClosedCount).toBeGreaterThanOrEqual(0);

      // Verify counts might have changed (total should be different or individual counts)
      const totalInitial = initialOpenCount + initialClosedCount;
      const totalNew = newOpenCount + newClosedCount;
      expect(totalNew).toBeGreaterThanOrEqual(totalInitial); // Should have more or same data with wider date range

      // Verify the date was actually set
      expect(await ncrStatisticsPage.getFromDate()).toBe(oneYearAgo);

      // Verify URL contains the date parameter
      const urlParams = await ncrStatisticsPage.getURLSearchParams();
      expect(urlParams.from).toBe(oneYearAgo);
    });

    test('should update statistics when changing to date', async ({ page }) => {
      // Get initial statistics
      const initialOpenCount = await ncrStatisticsPage.getOpenReportsCount();
      const initialClosedCount = await ncrStatisticsPage.getClosedReportsCount();

      // Set to date to yesterday
      const yesterday = DateUtils.addDays(DateUtils.getCurrentDateUTC(), -1);
      const yesterdayFormatted = ncrStatisticsPage.formatDate(yesterday);

      await ncrStatisticsPage.setToDate(yesterdayFormatted);
      await ncrStatisticsPage.waitForStatisticsUpdate();

      // Get updated statistics
      const newOpenCount = await ncrStatisticsPage.getOpenReportsCount();
      const newClosedCount = await ncrStatisticsPage.getClosedReportsCount();

      // Verify statistics are valid and potentially changed
      expect(newOpenCount).toBeGreaterThanOrEqual(0);
      expect(newClosedCount).toBeGreaterThanOrEqual(0);

      // When setting to date to yesterday, we might have fewer records
      const totalInitial = initialOpenCount + initialClosedCount;
      const totalNew = newOpenCount + newClosedCount;
      expect(totalNew).toBeLessThanOrEqual(totalInitial); // Should have less or same data with narrower date range

      // Verify the date was actually set
      const actualToDate = await ncrStatisticsPage.getToDate();
      expect(actualToDate).toBe(yesterdayFormatted);

      // Verify URL contains the date parameter - it should match what was actually set
      const urlParams = await ncrStatisticsPage.getURLSearchParams();
      expect(urlParams.to).toBe(actualToDate);
    });

    test('should update URL with both date parameters', async ({ page }) => {
      const oneYearAgo = ncrStatisticsPage.getDateOneYearAgo();
      const today = ncrStatisticsPage.getDateToday();

      // Set both dates
      await ncrStatisticsPage.setFromDate(oneYearAgo);
      await ncrStatisticsPage.setToDate(today);
      await ncrStatisticsPage.waitForStatisticsUpdate();

      // Wait for URL to be updated with both parameters
      await ncrStatisticsPage.waitForURLParams({ from: oneYearAgo, to: today });

      // Verify URL contains both parameters
      const urlParams = await ncrStatisticsPage.getURLSearchParams();
      expect(urlParams.from).toBe(oneYearAgo);
      expect(urlParams.to).toBe(today);
    });
  });

  test.describe('Reset Button Functionality', () => {
    test('should clear date inputs when reset button is clicked', async ({ page }) => {
      // Set some dates first
      const oneYearAgo = ncrStatisticsPage.getDateOneYearAgo();
      const today = ncrStatisticsPage.getDateToday();

      await ncrStatisticsPage.setFromDate(oneYearAgo);
      await ncrStatisticsPage.setToDate(today);
      await ncrStatisticsPage.waitForStatisticsUpdate();

      // Verify dates are set
      expect(await ncrStatisticsPage.getFromDate()).toBe(oneYearAgo);
      expect(await ncrStatisticsPage.getToDate()).toBe(today);

      // Click reset button
      await ncrStatisticsPage.resetFilters();
      await ncrStatisticsPage.waitForStatisticsUpdate();

      // Verify dates are cleared
      expect(await ncrStatisticsPage.getFromDate()).toBe('');
      expect(await ncrStatisticsPage.getToDate()).toBe('');
    });

    test('should update statistics after reset', async ({ page }) => {
      // Set dates to a narrow range first
      const oneWeekAgo = DateUtils.addDays(DateUtils.getCurrentDateUTC(), -7);
      const oneWeekAgoFormatted = ncrStatisticsPage.formatDate(oneWeekAgo);
      const today = ncrStatisticsPage.getDateToday();

      await ncrStatisticsPage.setFromDate(oneWeekAgoFormatted);
      await ncrStatisticsPage.setToDate(today);
      await ncrStatisticsPage.waitForStatisticsUpdate();

      // Get statistics with narrow date range
      const narrowRangeClosedCount = await ncrStatisticsPage.getClosedReportsCount();

      // Reset filters
      await ncrStatisticsPage.resetFilters();
      await ncrStatisticsPage.waitForStatisticsUpdate();

      // Wait for URL to be cleared (no query params)
      await page.waitForFunction(() => {
        const url = new URL(window.location.href);
        return url.search === '' || url.search === '?';
      }, { timeout: 5000 }).catch(() => {
        // If timeout, continue - the assertion will fail if params still exist
      });

      // Statistics should update (likely showing more data)
      const resetClosedCount = await ncrStatisticsPage.getClosedReportsCount();

      // After reset, should typically have more or equal data (wider date range)
      expect(resetClosedCount).toBeGreaterThanOrEqual(narrowRangeClosedCount);

      // Verify URL parameters are removed
      const urlParams = await ncrStatisticsPage.getURLSearchParams();
      expect(urlParams.from).toBeUndefined();
      expect(urlParams.to).toBeUndefined();
    });
  });

  test.describe('Show More Buttons with Year+ Data Range', () => {
    test('should show expand buttons when date range covers more than a year', async ({ page }) => {
      // Set date range to more than a year
      const oneYearAgo = ncrStatisticsPage.getDateOneYearAgo();
      const today = ncrStatisticsPage.getDateToday();

      await ncrStatisticsPage.setFromDate(oneYearAgo);
      await ncrStatisticsPage.setToDate(today);
      await ncrStatisticsPage.waitForStatisticsUpdate();

      // Check if any cards have expand buttons (depends on data)
      const cards = [
        '.article-card:has(h3:text("Root Cause Totals"))',
        '.article-card:has(h3:text("NCR Level Totals"))',
        '.article-card:has(h3:text("Reporter Totals"))',
        '.article-card:has(h3:text("Closer Totals"))',
        '.article-card:has(h3:text("Project Totals"))',
        '.article-card:has(h3:text("Supplier Totals"))',
        '.article-card:has(h3:text("Main Contractor Totals"))',
        '.article-card:has(h3:text("Consultant Totals"))'
      ];

      // Look for at least one card with expand button
      let foundExpandButton = false;
      let testedCard = null;

      for (const cardSelector of cards) {
        if (await ncrStatisticsPage.hasExpandButton(cardSelector)) {
          foundExpandButton = true;
          testedCard = cardSelector;

          // Test expand functionality
          const buttonText = await ncrStatisticsPage.getExpandButtonText(cardSelector);
          expect(buttonText).toMatch(/Show \d+ more/);

          // Click to expand
          await ncrStatisticsPage.clickExpandButton(cardSelector);
          expect(await ncrStatisticsPage.isExpanded(cardSelector)).toBe(true);

          // Button text should change to "Show less"
          const expandedButtonText = await ncrStatisticsPage.getExpandButtonText(cardSelector);
          expect(expandedButtonText).toBe('Show less');

          // Click to collapse
          await ncrStatisticsPage.clickExpandButton(cardSelector);
          expect(await ncrStatisticsPage.isExpanded(cardSelector)).toBe(false);

          // Button text should change back
          const collapsedButtonText = await ncrStatisticsPage.getExpandButtonText(cardSelector);
          expect(collapsedButtonText).toMatch(/Show \d+ more/);

          break; // Only test one card that has the expand button
        }
      }

      // If no expand button found, verify it's due to insufficient data
      if (!foundExpandButton) {
        // Check that all cards have ≤8 items (expected behavior with limited test data)
        for (const cardSelector of cards) {
          const items = await ncrStatisticsPage.getStatCardItems(cardSelector);
          // All visible items should be ≤8 since no expand button is present
          const visibleItems = items.filter(item => item.label && item.label.trim() !== '');
          expect(visibleItems.length).toBeLessThanOrEqual(8);
        }

        // Log that the test passed but with insufficient data
        console.log('✓ No expand buttons found - all categories have ≤8 items (expected with current test data)');
        console.log('  This is valid behavior. Expand functionality would be tested with larger datasets.');
      } else {
        // Log which card was tested
        console.log(`✓ Expand button tested successfully on card: ${testedCard}`);
      }
    });
  });

  test.describe('Stat Item Click Navigation', () => {
    test('should navigate to historical page with filters when clicking stat items', async ({ page }) => {
      // Set specific date range first
      const oneYearAgo = ncrStatisticsPage.getDateOneYearAgo();
      const today = ncrStatisticsPage.getDateToday();

      await ncrStatisticsPage.setFromDate(oneYearAgo);
      await ncrStatisticsPage.setToDate(today);
      await ncrStatisticsPage.waitForStatisticsUpdate();

      // Test different types of stat items
      const cardsToTest = [
        { selector: '.article-card:has(h3:text("Root Cause Totals"))', expectedFilter: 'causeFilter' },
        { selector: '.article-card:has(h3:text("NCR Level Totals"))', expectedFilter: 'levelFilter' },
        { selector: '.article-card:has(h3:text("Reporter Totals"))', expectedFilter: 'reporterFilter' }
      ];

      for (const { selector, expectedFilter } of cardsToTest) {
        // Navigate back to statistics page
        await ncrStatisticsPage.navigate();
        await ncrStatisticsPage.waitForPageLoad();

        // Set date range again
        await ncrStatisticsPage.setFromDate(oneYearAgo);
        await ncrStatisticsPage.setToDate(today);
        await ncrStatisticsPage.waitForStatisticsUpdate();

        // Check if this card has clickable items
        const items = await ncrStatisticsPage.getStatCardItems(selector);
        const clickableItems = items.filter(item => item.clickable);

        if (clickableItems.length > 0) {
          // Click the first clickable item
          const { filterValue } = await ncrStatisticsPage.clickFirstStatItemInCard(selector);

          // Wait for navigation
          await page.waitForURL(/.*\/ncr\/historical.*/);

          // Verify we're on the historical page
          expect(page.url()).toContain('/ncr/historical');

          // Verify URL contains the expected filter parameters
          const url = new URL(page.url());
          const params = Object.fromEntries(url.searchParams.entries());

          // Should have date filters
          expect(params.dateFromFilter).toBe(oneYearAgo);
          expect(params.dateToFilter).toBe(today);

          // Should have the specific filter
          expect(params[expectedFilter]).toBe(filterValue);

          break; // Only test one successful navigation
        }
      }
    });

    test('should preserve date filters when navigating to historical page', async ({ page }) => {
      // Set specific dates
      const twoMonthsAgo = DateUtils.addMonths(new Date(), -2);
      const twoMonthsAgoFormatted = ncrStatisticsPage.formatDate(twoMonthsAgo);
      const oneMonthAgo = ncrStatisticsPage.getDateOneMonthAgo();

      await ncrStatisticsPage.setFromDate(twoMonthsAgoFormatted);
      await ncrStatisticsPage.setToDate(oneMonthAgo);
      await ncrStatisticsPage.waitForStatisticsUpdate();

      // Find any clickable stat item and click it
      const clickableItems = await page.locator('.stat-item.clickable').all();

      if (clickableItems.length > 0) {
        // Click the first clickable item
        await clickableItems[0].click();

        // Wait for navigation
        await page.waitForURL(/.*\/ncr\/historical.*/);

        // Verify URL contains our specific date range
        const url = new URL(page.url());
        const params = Object.fromEntries(url.searchParams.entries());

        expect(params.dateFromFilter).toBe(twoMonthsAgoFormatted);
        expect(params.dateToFilter).toBe(oneMonthAgo);
      }
    });
  });

  test.describe('Time to Close Summary', () => {
    test('should display time to close statistics', async ({ page }) => {
      // Set date range to get some data
      const oneYearAgo = ncrStatisticsPage.getDateOneYearAgo();
      const today = ncrStatisticsPage.getDateToday();

      await ncrStatisticsPage.setFromDate(oneYearAgo);
      await ncrStatisticsPage.setToDate(today);
      await ncrStatisticsPage.waitForStatisticsUpdate();

      // Get items from time to close card
      const timeToCloseItems = await ncrStatisticsPage.getStatCardItems('.article-card:has(h3:text("Time to Close Summary"))');

      // Should have standard time summary items
      const expectedLabels = ['Average Days', 'Max Days', 'Min Days', 'Total Reports'];
      const actualLabels = timeToCloseItems.map(item => item.label);

      expectedLabels.forEach(label => {
        expect(actualLabels).toContain(label);
      });

      // Values should be numeric strings
      timeToCloseItems.forEach(item => {
        expect(item.value).toMatch(/^\d+$/);
      });
    });
  });
});
