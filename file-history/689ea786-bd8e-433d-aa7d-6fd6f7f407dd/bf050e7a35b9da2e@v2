/**
 * Report Builder
 * Orchestrates paragraph generation for fire safety compliance reports
 * Calls generators in sequence and assembles complete report
 */

// Standard blocks (disclaimer, introduction, legal requirements)
const { generateComplianceParagraphs: generateDisclaimer } = require('./processors/standard/disclaimer-generator');
const { generateComplianceParagraphs: generateIntroduction } = require('./processors/standard/introduction-generator');
const { generateComplianceParagraphs: generateLegalRequirements } = require('./processors/standard/legal-requirements-generator');

// Calculated compliance blocks
const { generateComplianceParagraphs: generateHazardousSubstancesCompliance } = require('./processors/hazardous-substances/compliance-generator');
const { generateComplianceParagraphs: generateOccupantLoadCompliance } = require('./processors/occupant-load/compliance-generator');
const { generateComplianceParagraphs: generateFirecellsCompliance } = require('./processors/firecells/compliance-generator');
const { generateComplianceParagraphs: generateFireSafetySystemsCompliance } = require('./processors/fire-safety-systems/compliance-generator');
const { generateComplianceParagraphs: generateFireResistanceCompliance } = require('./processors/fire-resistance/compliance-generator');

/**
 * Build a fire safety compliance report
 * @param {ProjectModel} projectModel - The complete project model with all calculated data
 * @param {string} documentType - Type of document to generate (default: 'fire-report')
 * @returns {ProjectModel} The project model with reportParagraphs array populated
 */
function buildReport(projectModel, documentType = 'fire-report') {
  const paragraphs = [];

  // 1. STANDARD SECTIONS (Always included at beginning)

  // Disclaimer
  paragraphs.push(...generateDisclaimer(projectModel));

  // Introduction
  paragraphs.push(...generateIntroduction(projectModel));

  // Legal Requirements
  paragraphs.push(...generateLegalRequirements(projectModel));

  // 2. CALCULATED COMPLIANCE SECTIONS

  // Hazardous Substances
  if (projectModel.storesHazardousGoods !== undefined) {
    paragraphs.push(...generateHazardousSubstancesCompliance(projectModel));
  }

  // Occupant Load
  if (projectModel.firecells && projectModel.firecells.length > 0) {
    paragraphs.push(...generateOccupantLoadCompliance(projectModel));
  }

  // Firecells
  if (projectModel.firecells && projectModel.firecells.length > 0) {
    paragraphs.push(...generateFirecellsCompliance(projectModel));
  }

  // Fire Safety Systems
  if (projectModel.firecells && projectModel.firecells.length > 0) {
    paragraphs.push(...generateFireSafetySystemsCompliance(projectModel));
  }

  // Fire Resistance Ratings
  if (projectModel.fireResistanceCalculations) {
    paragraphs.push(...generateFireResistanceCompliance(projectModel, projectModel.fireResistanceCalculations));
  }

  // Store paragraphs in project model
  projectModel.reportParagraphs = paragraphs;

  // Group paragraphs into sections based on titles
  projectModel.reportSections = groupIntoSections(paragraphs);

  return projectModel;
}

/**
 * Group flat array of paragraphs into sections
 * Paragraphs with non-empty titles start new sections
 * Paragraphs with empty titles are added to the current section
 * @param {Array} paragraphs - Flat array of paragraph objects
 * @returns {Array} Array of section objects with sectionTitle and paragraphs array
 */
function groupIntoSections(paragraphs) {
  const sections = [];
  let currentSection = null;

  paragraphs.forEach(para => {
    // Any paragraph with a non-empty title starts a new section
    if (para.title && para.title.trim() !== '') {
      currentSection = {
        sectionTitle: para.title,
        paragraphs: [para]
      };
      sections.push(currentSection);
    } else {
      // Empty title means continuation of current section
      if (currentSection) {
        currentSection.paragraphs.push(para);
      }
    }
  });

  return sections;
}

module.exports = { buildReport };