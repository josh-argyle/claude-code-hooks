    // Reset selections if hidden
    const scopeSelect = nzs4515Div.querySelector('.nzs-4515-scope-select');
    if (scopeSelect) scopeSelect.value = '';
    const choiceDiv = nzs4515Div.querySelector('.nzs-4515-substitution-choice');
    if (choiceDiv) choiceDiv.style.display = 'none';
  }
}

// NEW: Toggle NZS 4515 substitution choice based on scope
function setupNZS4515ScopeListeners() {
  document.querySelectorAll('.nzs-4515-scope-select').forEach(select => {
    select.addEventListener('change', function() {
      const firecellDiv = this.closest('.firecell-item');
