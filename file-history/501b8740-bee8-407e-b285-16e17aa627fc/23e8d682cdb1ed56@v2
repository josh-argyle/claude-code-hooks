/**
 * Calculate total building floor area across all firecells
 * Used for NZS 4515 scope validation (Para 2.2.3)
 * @returns {number} Total floor area in square meters
 */
getTotalFloorArea() {
  return this.firecells.reduce((sum, fc) => sum + (fc.floorArea || 0), 0);
}

/**
 * Check if building is within NZS 4515 scope
 * NZS 4515 basic scope: ≤500m² (Section 1.1.3.1)
 * NZS 4515 extended scope: ≤2000m² (Section 1.1.3.2) - requires 60-min supply, fire brigade alarm, sprinkler inlet
 * @returns {boolean} True if total floor area ≤ 2000m² (extended scope limit)
 */
isWithinNZS4515Scope() {
  return this.getTotalFloorArea() <= 2000;
}
