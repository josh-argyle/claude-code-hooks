const {
  createRequirementsParagraph,
  createInfoParagraph,
  createTableParagraph,
  createWarningParagraph,
} = require('../../utilities/paragraph-builder');

/**
 * TEXT constants with professional fire safety language
 * Firecell construction and separation requirements per C/AS2
 */
const TEXT = {
  overview: {
    content: "Firecell boundaries shall be constructed to provide fire resistance and prevent fire spread between separate fire compartments. All construction shall comply with C/AS2 requirements for fire separations, penetrations, and door closures."
  },

  fire_separation: (frr) =>
    `Fire separating walls and floors between firecells shall provide a fire resistance rating of not less than ${frr} minutes in accordance with C/AS2 Table 3.1. All fire separations shall extend continuously from floor to the underside of the floor or roof above, with no gaps or unsealed penetrations that could compromise the fire resistance rating.`,

  fire_separation_general: {
    content: "Fire separating elements between firecells shall be constructed to achieve the required fire resistance ratings for both structural adequacy and integrity. Separations shall be designed and constructed using fire-rated materials and assemblies that have been tested and certified to meet the specified performance criteria.",
    priority: 'high'
  },

  construction_requirements: {
    content: "Firecell boundaries shall be constructed of materials and assemblies capable of achieving the required fire resistance ratings. All construction shall follow tested and certified systems, with appropriate detailing at junctions, corners, and changes of direction. Wall and floor assemblies shall maintain fire resistance through their full extent, including areas of service penetrations.",
    priority: 'high'
  },

  penetrations_firestopping: {
    content: "All service penetrations through firecell boundaries (including pipes, ducts, cables, and conduits) shall be protected with approved firestopping systems that maintain the fire resistance rating of the separation. Firestopping shall be installed by competent persons in accordance with tested and certified systems. Each penetration shall be documented and certified to ensure compliance.",
    priority: 'high'
  },

  door_closures: {
    content: "All doors in firecell separations shall be fire-rated to match or exceed the fire resistance rating of the wall in which they are installed, up to a maximum requirement of 60 minutes per C/AS2. Fire doors shall be fitted with self-closing devices that ensure the door returns to the fully closed position after use. Door hardware, seals, and frames shall be compatible with the fire rating and shall not compromise the door's performance.",
    priority: 'high'
  },

  floor_area_limits: {
    title: "Firecell Floor Area Compliance",
    table_headers: ['Firecell', 'Risk Group', 'Sprinklered', 'Floor Area (m²)', 'Area Limit (m²)', 'Status'],
    priority: 'high'
  },

  floor_area_exceeded: (actual, limit, firecellNum) =>
    `Firecell ${firecellNum} floor area of ${actual}m² exceeds the C/AS2 Table 2.1 limit of ${limit}m². To achieve compliance, the design shall be modified to either: (a) reduce the firecell floor area by subdivision with additional fire separations, (b) install automatic fire sprinkler protection throughout the firecell in accordance with C/AS2 requirements, or (c) seek approval for an alternative solution that demonstrates equivalent fire safety performance.`,

  junctions_intersections: {
    content: "All junctions and intersections of firecell separations (wall-to-wall, wall-to-floor, wall-to-roof) shall be detailed and constructed to maintain the required fire resistance rating. Special attention shall be given to corners, changes in direction, and connections to structural elements. Construction details shall follow tested configurations or be certified by fire testing.",
    priority: 'standard'
  },

  external_walls: {
    content: "Where firecell boundaries coincide with external walls, the external wall construction shall meet both the internal firecell separation requirements and any external fire spread requirements specified in C/AS2. Particular attention shall be given to preventing fire spread via external cladding systems and cavities.",
    priority: 'standard'
  },

  verification_certification: {
    content: "All firecell construction shall be verified through the building consent process. Producer statements (PS1 for design, PS3 for construction review, PS4 for construction) shall be provided by appropriately qualified persons for all fire-rated construction elements. Documentation shall demonstrate that the constructed firecells achieve the required fire resistance ratings and comply with C/AS2 requirements.",
    priority: 'standard'
  },

  maintenance_inspection: {
    content: "Firecell integrity shall be maintained throughout the building's operational life. Any alterations, additions, or maintenance work that affects firecell boundaries shall maintain the required fire resistance ratings. Building owners shall ensure that firecell separations are not compromised by subsequent building modifications or tenant fit-outs.",
    priority: 'low'
  },

  special_spaces: {
    title: "Special Space Requirements",
    vehicle_stacker: "Where firecells contain vehicle stackers, additional fire safety provisions shall be provided as specified in C/AS2. These provisions shall address the unique fire risks associated with vehicle storage including ventilation, fire detection, and suppression systems appropriate to the hazard.",
    cinema_theatre: "Where firecells contain cinema or theatre spaces, seating layouts and egress provisions shall comply with C/AS2 requirements for places of assembly. Special attention shall be given to escape route arrangements, travel distances, and audience safety during evacuation.",
    priority: 'high'
  }
};

/**
 * Generate requirements paragraphs for firecells
 * @param {Object} projectModel - The complete project model with all data
 * @param {Object} calculations - Fire resistance calculations (if available)
 * @returns {Array} Array of paragraph objects
 */
function generateRequirementsParagraphs(projectModel, calculations) {
  const paragraphs = [];

  // Overview
  paragraphs.push(
    createInfoParagraph(
      'Firecell Construction Requirements',
      TEXT.overview.content
    )
  );

  // Fire separation requirements (high priority)
  if (calculations && calculations.life) {
    paragraphs.push(
      createRequirementsParagraph(
        'Fire Separation Construction',
        TEXT.fire_separation(calculations.life),
        'high'
      )
    );
  } else {
    paragraphs.push(
      createRequirementsParagraph(
        'Fire Separation Construction',
        TEXT.fire_separation_general.content,
        TEXT.fire_separation_general.priority
      )
    );
  }

  // Construction requirements
  paragraphs.push(
    createRequirementsParagraph(
      'Firecell Boundary Construction',
      TEXT.construction_requirements.content,
      TEXT.construction_requirements.priority
    )
  );

  // Penetrations and firestopping
  paragraphs.push(
    createRequirementsParagraph(
      'Service Penetrations and Firestopping',
      TEXT.penetrations_firestopping.content,
      TEXT.penetrations_firestopping.priority
    )
  );

  // Door closures
  paragraphs.push(
    createRequirementsParagraph(
      'Fire Doors in Firecell Separations',
      TEXT.door_closures.content,
      TEXT.door_closures.priority
    )
  );

  // Floor area compliance table and warnings
  if (projectModel.firecells && projectModel.firecells.length > 0) {
    const headers = TEXT.floor_area_limits.table_headers;
    const rows = [];
    const nonCompliantFirecells = [];

    projectModel.firecells.forEach((firecell, index) => {
      const floorArea = firecell.floorArea || 0;
      const compliance = firecell.firecellCompliance;
      const effectiveLimit = compliance?.effectiveLimit || 'N/A';
      const isCompliant = compliance?.isCompliant;
      const status = isCompliant ? '✓ Compliant' : '✗ EXCEEDS LIMIT';

      rows.push([
        `Firecell ${index + 1}`,
        firecell.riskGroup || 'Not specified',
        firecell.isSprinklered ? 'Yes' : 'No',
        floorArea.toString(),
        effectiveLimit.toString(),
        status
      ]);

      // Track non-compliant firecells for detailed warnings
      if (isCompliant === false) {
        nonCompliantFirecells.push({
          num: index + 1,
          actual: floorArea,
          limit: effectiveLimit
        });
      }
    });

    paragraphs.push(
      createTableParagraph(
        TEXT.floor_area_limits.title,
        headers,
        rows
      )
    );

    // Add detailed warning paragraphs for non-compliant firecells
    nonCompliantFirecells.forEach(fc => {
      paragraphs.push(
        createWarningParagraph(
          `Firecell ${fc.num} - Floor Area Non-Compliance`,
          TEXT.floor_area_exceeded(fc.actual, fc.limit, fc.num)
        )
      );
    });
  }

  // Junctions and intersections
  paragraphs.push(
    createRequirementsParagraph(
      'Junctions and Intersections',
      TEXT.junctions_intersections.content,
      TEXT.junctions_intersections.priority
    )
  );

  // External walls
  paragraphs.push(
    createRequirementsParagraph(
      'External Wall Considerations',
      TEXT.external_walls.content,
      TEXT.external_walls.priority
    )
  );

  // Special space requirements (if applicable)
  if (projectModel.firecells && projectModel.firecells.length > 0) {
    const hasVehicleStacker = projectModel.firecells.some(fc => fc.isVehicleStacker === true);
    const hasCinemaTheatre = projectModel.firecells.some(fc => fc.isCinemaOrTheatre === true);

    if (hasVehicleStacker) {
      paragraphs.push(
        createRequirementsParagraph(
          TEXT.special_spaces.title + ' - Vehicle Stacker',
          TEXT.special_spaces.vehicle_stacker,
          TEXT.special_spaces.priority
        )
      );
    }

    if (hasCinemaTheatre) {
      paragraphs.push(
        createRequirementsParagraph(
          TEXT.special_spaces.title + ' - Cinema/Theatre',
          TEXT.special_spaces.cinema_theatre,
          TEXT.special_spaces.priority
        )
      );
    }
  }

  // Verification and certification
  paragraphs.push(
    createRequirementsParagraph(
      'Verification and Certification',
      TEXT.verification_certification.content,
      TEXT.verification_certification.priority
    )
  );

  // Maintenance and inspection (low priority)
  paragraphs.push(
    createRequirementsParagraph(
      'Ongoing Integrity Maintenance',
      TEXT.maintenance_inspection.content,
      TEXT.maintenance_inspection.priority
    )
  );

  return paragraphs;
}

module.exports = { generateRequirementsParagraphs };
