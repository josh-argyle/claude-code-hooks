/**
 * Generate requirements paragraphs for fire safety systems
 * @param {Object} projectModel - The complete project model with all data
 * @returns {Array} Array of paragraph objects
 */
function generateRequirementsParagraphs(projectModel) {
  const paragraphs = [];

  // Overview
  paragraphs.push(
    createInfoParagraph(
      'Fire Safety Systems Installation Requirements',
      TEXT.overview.content
    )
  );

  // Collect all unique system types across all firecells
  const systemTypesRequired = new Set();
  const firecellSystemData = [];

  if (projectModel.firecells && projectModel.firecells.length > 0) {
    projectModel.firecells.forEach((firecell, index) => {
      if (firecell.processedFireSafetySystems && firecell.processedFireSafetySystems.length > 0) {
        const systemTypes = firecell.processedFireSafetySystems.map(s => s.type);
        systemTypes.forEach(type => systemTypesRequired.add(type));

        firecellSystemData.push({
          firecellNum: index + 1,
          systems: firecell.processedFireSafetySystems
        });
      }
    });
  }

  // Generate requirements table if systems exist
  if (systemTypesRequired.size > 0) {
    const headers = ['System Type', 'Installation Standard', 'Key Requirements'];
    const rows = [];

    // Sort system types numerically
    const sortedTypes = Array.from(systemTypesRequired).sort((a, b) => a - b);

    sortedTypes.forEach(type => {
      const systemKey = `type_${type}`;
      if (TEXT.systems[systemKey]) {
        const system = TEXT.systems[systemKey];
        rows.push([
          `Type ${type}`,
          system.standard,
          system.requirement.substring(0, 150) + '...' // Truncate for table display
        ]);
      }
    });

    paragraphs.push(
      createTableParagraph(
        TEXT.table_title,
        headers,
        rows
      )
    );
  }

  // Detailed requirements for each system type (high priority first)
  const highPrioritySystems = [2, 5, 7, 9];
  const standardPrioritySystems = [1, 15, 18];

  // High priority systems
  highPrioritySystems.forEach(type => {
    if (systemTypesRequired.has(type)) {
      const systemKey = `type_${type}`;
      if (TEXT.systems[systemKey]) {
        paragraphs.push(
          createRequirementsParagraph(
            `Type ${type} Installation Requirements`,
            TEXT.systems[systemKey].requirement,
            TEXT.systems[systemKey].priority
          )
        );
      }
    }
  });

  // NZS 4515 substitution requirements (if applicable)
  if (projectModel.firecells && projectModel.firecells.length > 0) {
    const hasNZS4515Substitution = projectModel.firecells.some(fc =>
      fc.nzs4515SubstitutionInfo &&
      fc.nzs4515SubstitutionInfo.eligible &&
      fc.nzs4515SubstitutionInfo.userSelectedSubstitution
    );

    if (hasNZS4515Substitution) {
      paragraphs.push(
        createRequirementsParagraph(
          TEXT.nzs_4515_substitution.title,
          TEXT.nzs_4515_substitution.content,
          TEXT.nzs_4515_substitution.priority
        )
      );
    }
  }

  // Early childhood centre special requirements
  if (projectModel.firecells && projectModel.firecells.length > 0) {
    projectModel.firecells.forEach((firecell, index) => {
      if (firecell.riskGroup === 'CA' && firecell.isEarlyChildhoodCentre === true) {
        const compliance = firecell.fireSafetySystemsCompliance;

        // Supplementary smoke detectors (escape height ≤ 2.0m)
        if (compliance && compliance.supplementarySmokeDetectors) {
          paragraphs.push(
            createRequirementsParagraph(
              `Early Childhood Centre Requirements - Firecell ${index + 1}`,
              TEXT.early_childhood_requirements.supplementary_smoke,
              TEXT.early_childhood_requirements.priority
            )
          );
        }

        // Places of safety (escape height > 2.0m)
        if (compliance && compliance.placesOfSafety) {
          paragraphs.push(
            createRequirementsParagraph(
              `Places of Safety - Firecell ${index + 1}`,
              TEXT.early_childhood_requirements.places_of_safety,
              TEXT.early_childhood_requirements.priority
            )
          );
        }
      }
    });
  }

  // Remote receiving centre requirements
  if (projectModel.remoteReceivingCentreCompliance) {
    const rrc = projectModel.remoteReceivingCentreCompliance;
    const content = rrc.required
      ? TEXT.remote_receiving_centre.connection_required
      : TEXT.remote_receiving_centre.no_connection;

    paragraphs.push(
      createRequirementsParagraph(
        'Remote Receiving Centre Connection',
        content,
        TEXT.remote_receiving_centre.priority
      )
    );
  }

  // Standard priority systems
  standardPrioritySystems.forEach(type => {
    if (systemTypesRequired.has(type)) {
      const systemKey = `type_${type}`;
      if (TEXT.systems[systemKey]) {
        paragraphs.push(
          createRequirementsParagraph(
            `Type ${type} Installation Requirements`,
            TEXT.systems[systemKey].requirement,
            TEXT.systems[systemKey].priority
          )
        );
      }
    }
  });

  // Commissioning requirements
  if (systemTypesRequired.size > 0) {
    paragraphs.push(
      createRequirementsParagraph(
        'Commissioning and Testing',
        TEXT.commissioning.content,
        TEXT.commissioning.priority
      )
    );
  }

  // Competent installation requirements
  if (systemTypesRequired.size > 0) {
    paragraphs.push(
      createRequirementsParagraph(
        'Competent Installation',
        TEXT.competent_installation.content,
        TEXT.competent_installation.priority
      )
    );
  }

  // Maintenance requirements (low priority)
  if (systemTypesRequired.size > 0) {
    paragraphs.push(
      createRequirementsParagraph(
        'Ongoing Maintenance',
        TEXT.maintenance.content,
        TEXT.maintenance.priority
      )
    );
  }

  return paragraphs;
}

module.exports = { generateRequirementsParagraphs };
