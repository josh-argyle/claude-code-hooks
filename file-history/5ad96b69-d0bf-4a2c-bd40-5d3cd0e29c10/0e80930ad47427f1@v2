const evaluateNote2 = require('../../../../api/processors/fire-safety-systems/note-evaluators/note-2-evaluator');

describe('Note 2 Evaluator - Type 18 Hydrant System Exemption', () => {
  describe('Applicability', () => {
    test('should apply to all risk groups', () => {
      const riskGroups = ['SM', 'SI', 'CA', 'WB', 'WS', 'VP'];

      riskGroups.forEach(riskGroup => {
        const firecell = { riskGroup, escapeHeight: 20 };
        const result = evaluateNote2(firecell, {});

        expect(result.applies).toBe(true);
      });
    });
  });

  describe('Exemption Based on Escape Height', () => {
    test('should exempt when escape height is less than 25m', () => {
      const firecell = { riskGroup: 'CA', escapeHeight: 20 };
      const result = evaluateNote2(firecell, {});

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(true);
      expect(result.reason).toContain('Escape height <25m');
    });

    test('should NOT exempt when escape height is exactly 25m', () => {
      const firecell = { riskGroup: 'CA', escapeHeight: 25 };
      const result = evaluateNote2(firecell, {});

      expect(result.exempt).toBe(false);
      expect(result.reason).toBe('Type 18 hydrant system required');
    });

    test('should NOT exempt when escape height exceeds 25m', () => {
      const firecell = { riskGroup: 'CA', escapeHeight: 30 };
      const result = evaluateNote2(firecell, {});

      expect(result.exempt).toBe(false);
    });

    test('should exempt when escape height is 0', () => {
      const firecell = { riskGroup: 'VP', escapeHeight: 0 };
      const result = evaluateNote2(firecell, {});

      expect(result.exempt).toBe(true);
    });

    test('should exempt at boundary (24.9m)', () => {
      const firecell = { riskGroup: 'WB', escapeHeight: 24.9 };
      const result = evaluateNote2(firecell, {});

      expect(result.exempt).toBe(true);
    });
  });

  describe('Edge Cases', () => {
    test('should handle missing escape height as no exemption', () => {
      const firecell = { riskGroup: 'CA' };
      const result = evaluateNote2(firecell, {});

      expect(result.exempt).toBe(false);
    });

    test('should handle null escape height', () => {
      const firecell = { riskGroup: 'CA', escapeHeight: null };
      const result = evaluateNote2(firecell, {});

      expect(result.exempt).toBe(false);
    });

    test('should handle non-numeric escape height', () => {
      const firecell = { riskGroup: 'CA', escapeHeight: 'twenty' };
      const result = evaluateNote2(firecell, {});

      expect(result.exempt).toBe(false);
    });

    test('should handle negative escape height', () => {
      const firecell = { riskGroup: 'CA', escapeHeight: -5 };
      const result = evaluateNote2(firecell, {});

      expect(result.exempt).toBe(false);
    });
  });

  describe('Reason Messages', () => {
    test('should provide clear reason when exempt', () => {
      const firecell = { riskGroup: 'CA', escapeHeight: 15 };
      const result = evaluateNote2(firecell, {});

      expect(result.reason).toBe('Escape height <25m - Type 18 exempt');
    });

    test('should provide clear reason when not exempt', () => {
      const firecell = { riskGroup: 'CA', escapeHeight: 30 };
      const result = evaluateNote2(firecell, {});

      expect(result.reason).toBe('Type 18 hydrant system required');
    });
  });
});