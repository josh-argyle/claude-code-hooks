const evaluateNote1d = require('../../../../api/processors/fire-safety-systems/note-evaluators/note-1d-evaluator');

describe('Note 1d Evaluator - VP Risk Group Type 2 System Exemption', () => {
  describe('Applicability', () => {
    test('should not apply to non-VP risk groups', () => {
      const firecell = { riskGroup: 'CA' };
      const result = evaluateNote1d(firecell);

      expect(result.applies).toBe(false);
    });

    test('should apply to VP risk group', () => {
      const firecell = {
        riskGroup: 'VP',
        occupantLoad: 30,
        vehicleCount: 5
      };
      const result = evaluateNote1d(firecell);

      expect(result.applies).toBe(true);
    });
  });

  describe('Exemption - Both Conditions Met', () => {
    test('should grant exemption when both occupant and vehicle conditions met', () => {
      const firecell = {
        riskGroup: 'VP',
        occupantLoad: 49,
        vehicleCount: 9
      };
      const result = evaluateNote1d(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(true);
      expect(result.reason).toContain('<50 occupants');
      expect(result.reason).toContain('<10 vehicles');
    });

    test('should grant exemption at boundary values', () => {
      const firecell = {
        riskGroup: 'VP',
        occupantLoad: 49,
        vehicleCount: 9
      };
      const result = evaluateNote1d(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(true);
    });

    test('should handle zero values', () => {
      const firecell = {
        riskGroup: 'VP',
        occupantLoad: 0,
        vehicleCount: 0
      };
      const result = evaluateNote1d(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(true);
    });
  });

  describe('Exemption - Occupant Limit', () => {
    test('should not grant exemption when occupant load is 50 or more', () => {
      const firecell = {
        riskGroup: 'VP',
        occupantLoad: 50,
        vehicleCount: 5
      };
      const result = evaluateNote1d(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });

    test('should not grant exemption when occupant load exceeds 50', () => {
      const firecell = {
        riskGroup: 'VP',
        occupantLoad: 100,
        vehicleCount: 5
      };
      const result = evaluateNote1d(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });
  });

  describe('Exemption - Vehicle Limit', () => {
    test('should not grant exemption when vehicle count is 10 or more', () => {
      const firecell = {
        riskGroup: 'VP',
        occupantLoad: 30,
        vehicleCount: 10
      };
      const result = evaluateNote1d(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });

    test('should not grant exemption when vehicle count exceeds 10', () => {
      const firecell = {
        riskGroup: 'VP',
        occupantLoad: 30,
        vehicleCount: 20
      };
      const result = evaluateNote1d(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });
  });

  describe('Exemption - One Condition Fails', () => {
    test('should not grant exemption when occupant limit met but vehicle limit exceeded', () => {
      const firecell = {
        riskGroup: 'VP',
        occupantLoad: 40,
        vehicleCount: 15
      };
      const result = evaluateNote1d(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });

    test('should not grant exemption when vehicle limit met but occupant limit exceeded', () => {
      const firecell = {
        riskGroup: 'VP',
        occupantLoad: 60,
        vehicleCount: 5
      };
      const result = evaluateNote1d(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });
  });

  describe('Edge Cases', () => {
    test('should handle missing occupantLoad', () => {
      const firecell = {
        riskGroup: 'VP',
        vehicleCount: 5
      };
      const result = evaluateNote1d(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });

    test('should handle missing vehicleCount', () => {
      const firecell = {
        riskGroup: 'VP',
        occupantLoad: 30
      };
      const result = evaluateNote1d(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });

    test('should handle invalid occupantLoad type', () => {
      const firecell = {
        riskGroup: 'VP',
        occupantLoad: 'invalid',
        vehicleCount: 5
      };
      const result = evaluateNote1d(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });

    test('should handle invalid vehicleCount type', () => {
      const firecell = {
        riskGroup: 'VP',
        occupantLoad: 30,
        vehicleCount: 'invalid'
      };
      const result = evaluateNote1d(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });

    test('should handle negative occupantLoad', () => {
      const firecell = {
        riskGroup: 'VP',
        occupantLoad: -10,
        vehicleCount: 5
      };
      const result = evaluateNote1d(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });

    test('should handle negative vehicleCount', () => {
      const firecell = {
        riskGroup: 'VP',
        occupantLoad: 30,
        vehicleCount: -5
      };
      const result = evaluateNote1d(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });
  });

  describe('Reason Messages', () => {
    test('should provide clear reason when exemption granted', () => {
      const firecell = {
        riskGroup: 'VP',
        occupantLoad: 40,
        vehicleCount: 8
      };
      const result = evaluateNote1d(firecell);

      expect(result.reason).toBe('<50 occupants and <10 vehicles');
    });

    test('should provide clear reason when exemption not granted', () => {
      const firecell = {
        riskGroup: 'VP',
        occupantLoad: 60,
        vehicleCount: 15
      };
      const result = evaluateNote1d(firecell);

      expect(result.reason).toBe('Standard requirement - no exemption conditions met');
    });
  });
});