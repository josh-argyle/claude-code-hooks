const evaluateNote1a = require('../../../../api/processors/fire-safety-systems/note-evaluators/note-1a-evaluator');

describe('Note 1a Evaluator - SM Risk Group Type 2 System Exemption', () => {
  describe('Applicability', () => {
    test('should not apply to CA risk group', () => {
      const firecell = { riskGroup: 'CA' };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(false);
      expect(result.exempt).toBeUndefined();
      expect(result.reason).toBeUndefined();
    });

    test('should not apply to WB risk group', () => {
      const firecell = { riskGroup: 'WB' };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(false);
    });

    test('should not apply to WS risk group', () => {
      const firecell = { riskGroup: 'WS' };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(false);
    });

    test('should not apply to VP risk group', () => {
      const firecell = { riskGroup: 'VP' };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(false);
    });

    test('should not apply to SI risk group', () => {
      const firecell = { riskGroup: 'SI' };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(false);
    });

    test('should apply to SM risk group', () => {
      const firecell = { riskGroup: 'SM', escapeHeight: 5 };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBeDefined();
      expect(result.reason).toBeDefined();
    });
  });

  describe('Exemption - Bed Count', () => {
    test('should exempt when max escape route serves exactly 10 beds', () => {
      const firecell = {
        riskGroup: 'SM',
        maxEscapeRouteBeds: 10,
        escapeHeight: 8
      };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(true);
      expect(result.reason).toContain('≤10 beds');
    });

    test('should exempt when max escape route serves less than 10 beds', () => {
      const firecell = {
        riskGroup: 'SM',
        maxEscapeRouteBeds: 5,
        escapeHeight: 8
      };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(true);
      expect(result.reason).toContain('≤10 beds');
    });

    test('should NOT exempt when max escape route serves more than 10 beds', () => {
      const firecell = {
        riskGroup: 'SM',
        maxEscapeRouteBeds: 11,
        escapeHeight: 8
      };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
      expect(result.reason).toContain('no exemption');
    });

    test('should handle 0 beds as exempt', () => {
      const firecell = {
        riskGroup: 'SM',
        maxEscapeRouteBeds: 0,
        escapeHeight: 8
      };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(true);
    });
  });

  describe('Exemption - Direct Exit to Safe Place', () => {
    test('should exempt when exit directly to safe place', () => {
      const firecell = {
        riskGroup: 'SM',
        exitDirectlyToSafePlace: true,
        escapeHeight: 8
      };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(true);
      expect(result.reason).toContain('Direct exit to safe place');
    });

    test('should NOT exempt when exit does not directly go to safe place', () => {
      const firecell = {
        riskGroup: 'SM',
        exitDirectlyToSafePlace: false,
        escapeHeight: 8
      };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });
  });

  describe('Combined Exemption Conditions', () => {
    test('should exempt when EITHER bed count OR direct exit applies', () => {
      const firecell = {
        riskGroup: 'SM',
        maxEscapeRouteBeds: 5,
        exitDirectlyToSafePlace: false,
        escapeHeight: 8
      };
      const result = evaluateNote1a(firecell);

      expect(result.exempt).toBe(true);
    });

    test('should exempt when both conditions apply', () => {
      const firecell = {
        riskGroup: 'SM',
        maxEscapeRouteBeds: 8,
        exitDirectlyToSafePlace: true,
        escapeHeight: 8
      };
      const result = evaluateNote1a(firecell);

      expect(result.exempt).toBe(true);
    });
  });

  describe('Type 1 Smoke Alarms - Transient Accommodation', () => {
    test('should require Type 1 smoke alarms for SM transient with escape height < 4m', () => {
      const firecell = {
        riskGroup: 'SM',
        smOccupantType: 'transient',
        escapeHeight: 3,
        maxEscapeRouteBeds: 20 // Not exempt
      };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(true);
      expect(result.requiresType1SmokeAlarms).toBe(true);
      expect(result.reason).toContain('Type 1 smoke alarms required');
    });

    test('should require Type 1 smoke alarms for SM transient with escape height = 0', () => {
      const firecell = {
        riskGroup: 'SM',
        smOccupantType: 'transient',
        escapeHeight: 0,
        maxEscapeRouteBeds: 20
      };
      const result = evaluateNote1a(firecell);

      expect(result.requiresType1SmokeAlarms).toBe(true);
    });

    test('should NOT require Type 1 smoke alarms for SM transient with escape height >= 4m', () => {
      const firecell = {
        riskGroup: 'SM',
        smOccupantType: 'transient',
        escapeHeight: 4
      };
      const result = evaluateNote1a(firecell);

      expect(result.requiresType1SmokeAlarms).toBeUndefined();
      expect(result.reason).not.toContain('Type 1 smoke alarms');
    });

    test('should NOT require Type 1 smoke alarms for SM permanent occupancy', () => {
      const firecell = {
        riskGroup: 'SM',
        smOccupantType: 'permanent',
        escapeHeight: 2
      };
      const result = evaluateNote1a(firecell);

      expect(result.requiresType1SmokeAlarms).toBeUndefined();
    });

    test('should handle missing smOccupantType gracefully', () => {
      const firecell = {
        riskGroup: 'SM',
        escapeHeight: 2
      };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(true);
      expect(result.requiresType1SmokeAlarms).toBeUndefined();
    });
  });

  describe('Edge Cases and Missing Data', () => {
    test('should handle missing maxEscapeRouteBeds gracefully', () => {
      const firecell = {
        riskGroup: 'SM',
        escapeHeight: 8
      };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });

    test('should handle missing escapeHeight gracefully', () => {
      const firecell = {
        riskGroup: 'SM'
      };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });

    test('should handle undefined escapeHeight as high value (no Type 1 alarms)', () => {
      const firecell = {
        riskGroup: 'SM',
        smOccupantType: 'transient'
      };
      const result = evaluateNote1a(firecell);

      expect(result.requiresType1SmokeAlarms).toBeUndefined();
    });

    test('should handle negative bed count as invalid (no exemption)', () => {
      const firecell = {
        riskGroup: 'SM',
        maxEscapeRouteBeds: -5,
        escapeHeight: 8
      };
      const result = evaluateNote1a(firecell);

      expect(result.exempt).toBe(false);
    });

    test('should handle non-numeric bed count as invalid', () => {
      const firecell = {
        riskGroup: 'SM',
        maxEscapeRouteBeds: 'five',
        escapeHeight: 8
      };
      const result = evaluateNote1a(firecell);

      expect(result.exempt).toBe(false);
    });

    test('should handle null bed count', () => {
      const firecell = {
        riskGroup: 'SM',
        maxEscapeRouteBeds: null,
        escapeHeight: 8
      };
      const result = evaluateNote1a(firecell);

      expect(result.exempt).toBe(false);
    });
  });

  describe('Fallback to maxEscapeRouteOccupants', () => {
    test('should use maxEscapeRouteOccupants if maxEscapeRouteBeds not provided', () => {
      const firecell = {
        riskGroup: 'SM',
        maxEscapeRouteOccupants: 8,
        escapeHeight: 8
      };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(true);
    });

    test('should prefer maxEscapeRouteBeds over maxEscapeRouteOccupants', () => {
      const firecell = {
        riskGroup: 'SM',
        maxEscapeRouteBeds: 5,
        maxEscapeRouteOccupants: 15,
        escapeHeight: 8
      };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(true); // Should use beds (5 ≤ 10)
    });
  });

  describe('Reason Messages', () => {
    test('should provide clear reason when bed exemption applies', () => {
      const firecell = {
        riskGroup: 'SM',
        maxEscapeRouteBeds: 10,
        escapeHeight: 8
      };
      const result = evaluateNote1a(firecell);

      expect(result.reason).toBe('Max escape route serves ≤10 beds');
    });

    test('should provide clear reason when direct exit exemption applies', () => {
      const firecell = {
        riskGroup: 'SM',
        exitDirectlyToSafePlace: true,
        escapeHeight: 8
      };
      const result = evaluateNote1a(firecell);

      expect(result.reason).toBe('Direct exit to safe place');
    });

    test('should provide clear reason when no exemption applies', () => {
      const firecell = {
        riskGroup: 'SM',
        maxEscapeRouteBeds: 15,
        escapeHeight: 8
      };
      const result = evaluateNote1a(firecell);

      expect(result.reason).toBe('Standard requirement - no exemption conditions met');
    });

    test('should append Type 1 smoke alarm requirement to reason', () => {
      const firecell = {
        riskGroup: 'SM',
        smOccupantType: 'transient',
        escapeHeight: 2,
        maxEscapeRouteBeds: 15
      };
      const result = evaluateNote1a(firecell);

      expect(result.reason).toContain('Standard requirement - no exemption conditions met');
      expect(result.reason).toContain('Type 1 smoke alarms required in each suite for transient accommodation');
    });
  });
});