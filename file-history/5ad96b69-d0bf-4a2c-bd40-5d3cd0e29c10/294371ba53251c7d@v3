const evaluateNote1b = require('../../../../api/processors/fire-safety-systems/note-evaluators/note-1b-evaluator');

describe('Note 1b Evaluator - CA Risk Group Type 2 System Exemption', () => {
  describe('Applicability', () => {
    test('should not apply to non-CA risk groups', () => {
      const firecell = { riskGroup: 'SM' };
      const result = evaluateNote1b(firecell, {}, []);

      expect(result.applies).toBe(false);
      expect(result.exempt).toBeUndefined();
      expect(result.reason).toBeUndefined();
    });

    test('should apply to CA risk group', () => {
      const firecell = {
        riskGroup: 'CA',
        floor: '1',
        maxEscapeRouteOccupants: 30
      };
      const result = evaluateNote1b(firecell, {}, [firecell]);

      expect(result.applies).toBe(true);
    });
  });

  describe('Single Level Requirement', () => {
    test('should grant exemption for single level CA with ≤50 occupants', () => {
      const firecell = {
        riskGroup: 'CA',
        floor: '1',
        maxEscapeRouteOccupants: 50
      };
      const allFirecells = [firecell];
      const result = evaluateNote1b(firecell, {}, allFirecells);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(true);
      expect(result.reason).toContain('single level');
      expect(result.reason).toContain('≤50');
    });

    test('should grant exemption when all CA firecells on same floor', () => {
      const firecell1 = {
        riskGroup: 'CA',
        floor: '1',
        maxEscapeRouteOccupants: 30
      };
      const firecell2 = {
        riskGroup: 'CA',
        floor: '1',
        maxEscapeRouteOccupants: 40
      };
      const allFirecells = [firecell1, firecell2];
      const result = evaluateNote1b(firecell1, {}, allFirecells);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(true);
    });

    test('should not grant exemption when CA firecells on different floors', () => {
      const firecell1 = {
        riskGroup: 'CA',
        floor: '1',
        maxEscapeRouteOccupants: 30
      };
      const firecell2 = {
        riskGroup: 'CA',
        floor: '2',
        maxEscapeRouteOccupants: 40
      };
      const allFirecells = [firecell1, firecell2];
      const result = evaluateNote1b(firecell1, {}, allFirecells);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
      expect(result.reason).toBe('Type 2 required');
    });

    test('should treat missing floor data as multi-level', () => {
      const firecell1 = {
        riskGroup: 'CA',
        floor: '1',
        maxEscapeRouteOccupants: 30
      };
      const firecell2 = {
        riskGroup: 'CA',
        // Missing floor
        maxEscapeRouteOccupants: 40
      };
      const allFirecells = [firecell1, firecell2];
      const result = evaluateNote1b(firecell1, {}, allFirecells);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });

    test('should handle empty string floor as invalid', () => {
      const firecell = {
        riskGroup: 'CA',
        floor: '',
        maxEscapeRouteOccupants: 30
      };
      const allFirecells = [firecell];
      const result = evaluateNote1b(firecell, {}, allFirecells);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });

    test('should handle numeric floor values', () => {
      const firecell1 = {
        riskGroup: 'CA',
        floor: 1,
        maxEscapeRouteOccupants: 30
      };
      const firecell2 = {
        riskGroup: 'CA',
        floor: 1,
        maxEscapeRouteOccupants: 40
      };
      const allFirecells = [firecell1, firecell2];
      const result = evaluateNote1b(firecell1, {}, allFirecells);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(true);
    });
  });

  describe('Escape Route Occupant Limit', () => {
    test('should grant exemption when maxEscapeRouteOccupants is exactly 50', () => {
      const firecell = {
        riskGroup: 'CA',
        floor: '1',
        maxEscapeRouteOccupants: 50
      };
      const allFirecells = [firecell];
      const result = evaluateNote1b(firecell, {}, allFirecells);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(true);
    });

    test('should grant exemption when maxEscapeRouteOccupants is less than 50', () => {
      const firecell = {
        riskGroup: 'CA',
        floor: '1',
        maxEscapeRouteOccupants: 25
      };
      const allFirecells = [firecell];
      const result = evaluateNote1b(firecell, {}, allFirecells);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(true);
    });

    test('should not grant exemption when maxEscapeRouteOccupants exceeds 50', () => {
      const firecell = {
        riskGroup: 'CA',
        floor: '1',
        maxEscapeRouteOccupants: 51
      };
      const allFirecells = [firecell];
      const result = evaluateNote1b(firecell, {}, allFirecells);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });

    test('should handle maxEscapeRouteOccupants of 0', () => {
      const firecell = {
        riskGroup: 'CA',
        floor: '1',
        maxEscapeRouteOccupants: 0
      };
      const allFirecells = [firecell];
      const result = evaluateNote1b(firecell, {}, allFirecells);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(true);
    });

    test('should not grant exemption if ANY CA firecell exceeds 50 occupants', () => {
      const firecell1 = {
        riskGroup: 'CA',
        floor: '1',
        maxEscapeRouteOccupants: 30
      };
      const firecell2 = {
        riskGroup: 'CA',
        floor: '1',
        maxEscapeRouteOccupants: 51 // Exceeds limit
      };
      const allFirecells = [firecell1, firecell2];
      const result = evaluateNote1b(firecell1, {}, allFirecells);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });
  });

  describe('Cross-Firecell Dependencies', () => {
    test('should check only CA firecells, ignore other risk groups', () => {
      const caFirecell = {
        riskGroup: 'CA',
        floor: '1',
        maxEscapeRouteOccupants: 40
      };
      const wbFirecell = {
        riskGroup: 'WB',
        floor: '2', // Different floor but different risk group
        maxEscapeRouteOccupants: 100
      };
      const allFirecells = [caFirecell, wbFirecell];
      const result = evaluateNote1b(caFirecell, {}, allFirecells);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(true); // Should only check CA firecells
    });

    test('should require all CA firecells to meet occupant limit', () => {
      const firecell1 = {
        riskGroup: 'CA',
        floor: '1',
        maxEscapeRouteOccupants: 50
      };
      const firecell2 = {
        riskGroup: 'CA',
        floor: '1',
        maxEscapeRouteOccupants: 50
      };
      const firecell3 = {
        riskGroup: 'CA',
        floor: '1',
        maxEscapeRouteOccupants: 45
      };
      const allFirecells = [firecell1, firecell2, firecell3];
      const result = evaluateNote1b(firecell1, {}, allFirecells);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(true);
    });
  });

  describe('Edge Cases', () => {
    test('should handle empty allFirecells array', () => {
      const firecell = {
        riskGroup: 'CA',
        floor: '1',
        maxEscapeRouteOccupants: 30
      };
      const result = evaluateNote1b(firecell, {}, []);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });

    test('should handle undefined allFirecells parameter', () => {
      const firecell = {
        riskGroup: 'CA',
        floor: '1',
        maxEscapeRouteOccupants: 30
      };
      const result = evaluateNote1b(firecell, {});

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });

    test('should handle missing maxEscapeRouteOccupants', () => {
      const firecell = {
        riskGroup: 'CA',
        floor: '1'
      };
      const allFirecells = [firecell];
      const result = evaluateNote1b(firecell, {}, allFirecells);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });

    test('should handle invalid maxEscapeRouteOccupants type', () => {
      const firecell = {
        riskGroup: 'CA',
        floor: '1',
        maxEscapeRouteOccupants: 'invalid'
      };
      const allFirecells = [firecell];
      const result = evaluateNote1b(firecell, {}, allFirecells);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });

    test('should handle negative maxEscapeRouteOccupants', () => {
      const firecell = {
        riskGroup: 'CA',
        floor: '1',
        maxEscapeRouteOccupants: -10
      };
      const allFirecells = [firecell];
      const result = evaluateNote1b(firecell, {}, allFirecells);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });
  });

  describe('Reason Messages', () => {
    test('should provide clear reason when exemption granted', () => {
      const firecell = {
        riskGroup: 'CA',
        floor: '1',
        maxEscapeRouteOccupants: 40
      };
      const allFirecells = [firecell];
      const result = evaluateNote1b(firecell, {}, allFirecells);

      expect(result.reason).toBe('CA areas on single level with ≤50 escape route occupants');
    });

    test('should provide clear reason when exemption not granted', () => {
      const firecell = {
        riskGroup: 'CA',
        floor: '1',
        maxEscapeRouteOccupants: 60
      };
      const allFirecells = [firecell];
      const result = evaluateNote1b(firecell, {}, allFirecells);

      expect(result.reason).toBe('Type 2 required');
    });
  });
});