/**
 * Note 4 Evaluator - CA Early Childhood Centre Additional Requirements
 *
 * From CAS2 Table 2.2 Note 4:
 * "Early childhood centres have additional requirements as set out in Paragraph 2.2.4."
 *
 * This note applies to CA (Crowd Activities) risk group areas that are early childhood
 * centres and requires additional fire safety system requirements.
 *
 * @param {Object} firecell - Firecell configuration object
 * @param {string} firecell.riskGroup - Building risk group (must be 'CA' for this note to apply)
 * @param {boolean} [firecell.isEarlyChildhoodCentre] - Whether this CA firecell is an early childhood centre
 * @param {Object} [buildingParams] - Building-level parameters (not used for this note)
 * @returns {Object} Evaluation result
 * @returns {boolean} returns.applies - Whether this note applies to the firecell
 * @returns {boolean} [returns.requiresAdditionalSystems] - Whether additional systems are required (only if applies is true)
 * @returns {string} [returns.reason] - Human-readable explanation of the evaluation (only if applies is true)
 */
function evaluateNote4(firecell, buildingParams) {
  // Handle null/undefined firecell parameter
  if (!firecell || typeof firecell !== 'object') {
    return { applies: false };
  }

  // Note 4 only applies to CA (Crowd Activities) risk group areas that are early childhood centres
  if (firecell.riskGroup !== 'CA' || firecell.isEarlyChildhoodCentre !== true) {
    return { applies: false };
  }

  // If we reach here, it's a CA firecell that is an early childhood centre
  return {
    applies: true,
    requiresAdditionalSystems: true,
    reason:
      'Early childhood centre - refer to Paragraph 2.2.4 for additional requirements',
  };
}

module.exports = evaluateNote4;