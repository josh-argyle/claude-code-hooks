const evaluateNote3 = require('../../../../api/processors/fire-safety-systems/note-evaluators/note-3-evaluator');

describe('Note 3 Evaluator - SI Dual Water Supply Requirement', () => {
  describe('Applicability', () => {
    test('should not apply to non-SI risk groups', () => {
      const firecell = { riskGroup: 'SM' };
      const result = evaluateNote3(firecell, {});

      expect(result.applies).toBe(false);
      expect(result.requiresDualSupply).toBeUndefined();
    });

    test('should apply to SI risk group', () => {
      const firecell = {
        riskGroup: 'SI',
        hospitalCareDetentionCount: 50
      };
      const result = evaluateNote3(firecell, {});

      expect(result.applies).toBe(true);
    });
  });

  describe('Dual Water Supply Requirement', () => {
    test('should require dual supply when >100 people in care/detention', () => {
      const firecell = {
        riskGroup: 'SI',
        hospitalCareDetentionCount: 101
      };
      const result = evaluateNote3(firecell, {});

      expect(result.applies).toBe(true);
      expect(result.requiresDualSupply).toBe(true);
      expect(result.reason).toContain('>100 people');
      expect(result.reason).toContain('dual water supply required');
    });

    test('should require dual supply when exactly 101 people', () => {
      const firecell = {
        riskGroup: 'SI',
        hospitalCareDetentionCount: 101
      };
      const result = evaluateNote3(firecell, {});

      expect(result.applies).toBe(true);
      expect(result.requiresDualSupply).toBe(true);
    });

    test('should require dual supply for large care/detention facilities', () => {
      const firecell = {
        riskGroup: 'SI',
        hospitalCareDetentionCount: 500
      };
      const result = evaluateNote3(firecell, {});

      expect(result.applies).toBe(true);
      expect(result.requiresDualSupply).toBe(true);
    });
  });

  describe('Standard Supply Acceptable', () => {
    test('should not require dual supply when exactly 100 people', () => {
      const firecell = {
        riskGroup: 'SI',
        hospitalCareDetentionCount: 100
      };
      const result = evaluateNote3(firecell, {});

      expect(result.applies).toBe(true);
      expect(result.requiresDualSupply).toBe(false);
      expect(result.reason).toContain('Standard sprinkler supply acceptable');
    });

    test('should not require dual supply when less than 100 people', () => {
      const firecell = {
        riskGroup: 'SI',
        hospitalCareDetentionCount: 50
      };
      const result = evaluateNote3(firecell, {});

      expect(result.applies).toBe(true);
      expect(result.requiresDualSupply).toBe(false);
    });

    test('should not require dual supply when 0 people', () => {
      const firecell = {
        riskGroup: 'SI',
        hospitalCareDetentionCount: 0
      };
      const result = evaluateNote3(firecell, {});

      expect(result.applies).toBe(true);
      expect(result.requiresDualSupply).toBe(false);
    });
  });

  describe('Edge Cases', () => {
    test('should handle missing hospitalCareDetentionCount', () => {
      const firecell = {
        riskGroup: 'SI'
      };
      const result = evaluateNote3(firecell, {});

      expect(result.applies).toBe(true);
      expect(result.requiresDualSupply).toBe(false);
    });

    test('should handle invalid hospitalCareDetentionCount type', () => {
      const firecell = {
        riskGroup: 'SI',
        hospitalCareDetentionCount: 'invalid'
      };
      const result = evaluateNote3(firecell, {});

      expect(result.applies).toBe(true);
      expect(result.requiresDualSupply).toBe(false);
    });

    test('should handle negative hospitalCareDetentionCount', () => {
      const firecell = {
        riskGroup: 'SI',
        hospitalCareDetentionCount: -50
      };
      const result = evaluateNote3(firecell, {});

      expect(result.applies).toBe(true);
      expect(result.requiresDualSupply).toBe(false);
    });

    test('should handle Infinity', () => {
      const firecell = {
        riskGroup: 'SI',
        hospitalCareDetentionCount: Infinity
      };
      const result = evaluateNote3(firecell, {});

      expect(result.applies).toBe(true);
      expect(result.requiresDualSupply).toBe(false);
    });
  });

  describe('Reason Messages', () => {
    test('should provide clear reason when dual supply required', () => {
      const firecell = {
        riskGroup: 'SI',
        hospitalCareDetentionCount: 150
      };
      const result = evaluateNote3(firecell, {});

      expect(result.reason).toBe('>100 people in care/detention - dual water supply required');
    });

    test('should provide clear reason when standard supply acceptable', () => {
      const firecell = {
        riskGroup: 'SI',
        hospitalCareDetentionCount: 75
      };
      const result = evaluateNote3(firecell, {});

      expect(result.reason).toBe('Standard sprinkler supply acceptable');
    });
  });
});