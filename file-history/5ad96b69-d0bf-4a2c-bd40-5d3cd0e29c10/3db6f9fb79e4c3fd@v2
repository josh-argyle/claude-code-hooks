/**
 * Note 6 Evaluator - WB Storage Height Limitations per Table 1.1
 *
 * From CAS2 Table 2.2 Note 6:
 * "See limitations in Table 1.1"
 *
 * This note applies to WB (Warehouse/Bulk goods) risk group and enforces
 * storage height limitations as defined in CAS2 Table 1.1. The limitations
 * include maximum storage heights and floor area constraints based on
 * occupant load and activity types.
 *
 * CAS2 Table 1.1 WB Storage Height Limitations:
 * - ≤3.0m: No restrictions
 * - >3.0m to 5.0m: Floor area restrictions apply
 * - >5.0m to 8.0m: Maximum 4200m² floor area
 * - >8.0m: Not permitted (apex limit)
 *
 * @param {Object} firecell - Firecell configuration object
 * @param {string} firecell.riskGroup - Building risk group (must be 'WB' for this note to apply)
 * @param {number} [firecell.maxStorageHeight] - Maximum storage height in metres
 * @param {number} [firecell.totalFloorArea] - Total floor area in m² (required for storage >5m)
 * @param {Object} [buildingParams] - Building-level parameters (not used for this note)
 * @returns {Object} Evaluation result
 * @returns {boolean} returns.applies - Whether this note applies to the firecell
 * @returns {boolean} [returns.compliant] - Whether the firecell meets storage height limitations (only if applies is true)
 * @returns {string} [returns.reason] - Human-readable explanation of the evaluation (only if applies is true)
 */
function evaluateNote6(firecell) {
  // Note 6 only applies to WB (Warehouse/Bulk goods) risk group
  if (firecell.riskGroup !== 'WB') {
    return { applies: false };
  }

  // Handle missing or invalid storage height - assume compliance
  if (
    firecell.maxStorageHeight === null ||
    firecell.maxStorageHeight === undefined
  ) {
    return {
      applies: true,
      compliant: true,
      reason: 'No storage height specified - assumes compliance with Table 1.1',
    };
  }

  // Validate storage height is a valid number
  if (
    typeof firecell.maxStorageHeight !== 'number' ||
    !isFinite(firecell.maxStorageHeight) ||
    firecell.maxStorageHeight < 0
  ) {
    return {
      applies: true,
      compliant: false,
      reason:
        'Invalid storage height data - cannot validate Table 1.1 compliance',
    };
  }

  const storageHeight = firecell.maxStorageHeight;

  // Storage height ≤ 3.0m: No restrictions
  if (storageHeight <= 3.0) {
    return {
      applies: true,
      compliant: true,
      reason: `Storage height ${storageHeight.toFixed(1)}m complies with Table 1.1 WB limitations`,
    };
  }

  // Storage height > 8.0m: Exceeds apex limit
  if (storageHeight > 8.0) {
    return {
      applies: true,
      compliant: false,
      reason: `Storage height ${storageHeight.toFixed(1)}m exceeds Table 1.1 WB limitations (max 8.0m apex)`,
    };
  }

  // Storage height 3.0m < h ≤ 5.0m: Generally permitted
  if (storageHeight <= 5.0) {
    return {
      applies: true,
      compliant: true,
      reason: `Storage height ${storageHeight.toFixed(1)}m complies with Table 1.1 WB limitations`,
    };
  }

  // Storage height > 5.0m: Requires floor area validation
  // Check if floor area data is available
  if (firecell.totalFloorArea === null || firecell.totalFloorArea === undefined) {
    return {
      applies: true,
      compliant: false,
      reason:
        'Storage >5.0m requires floor area data for Table 1.1 compliance check',
    };
  }

  // Validate floor area is a valid number
  if (
    typeof firecell.totalFloorArea !== 'number' ||
    !isFinite(firecell.totalFloorArea) ||
    firecell.totalFloorArea < 0
  ) {
    return {
      applies: true,
      compliant: false,
      reason: 'Invalid floor area data - cannot validate Table 1.1 compliance',
    };
  }

  const floorArea = firecell.totalFloorArea;

  // Storage height 5.0m < h ≤ 8.0m: Maximum 4200m² floor area
  if (storageHeight <= 8.0) {
    if (floorArea <= 4200) {
      return {
        applies: true,
        compliant: true,
        reason: `Storage height ${storageHeight.toFixed(1)}m complies with Table 1.1 WB limitations`,
      };
    } else {
      return {
        applies: true,
        compliant: false,
        reason: `Storage height ${storageHeight.toFixed(1)}m with area ${floorArea}m² exceeds Table 1.1 WB limitations`,
      };
    }
  }

  // This should not be reached due to earlier checks, but included for completeness
  return {
    applies: true,
    compliant: false,
    reason: `Storage height ${storageHeight.toFixed(1)}m exceeds Table 1.1 WB limitations`,
  };
}

module.exports = evaluateNote6;