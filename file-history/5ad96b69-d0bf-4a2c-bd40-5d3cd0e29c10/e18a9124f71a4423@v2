/**
 * Note 5 Evaluator - CA/WB Challenging Smoke Environment Type 4 Substitute
 *
 * From CAS2 Table 2.2 Note 5:
 * "Type 4 system may be substituted with Type 6 system or Type 3 system with
 * supplementary fire detection where the environment is challenging for smoke detection."
 *
 * This note applies to CA (Crowd Activities) and WB (Warehouse/Storage) risk groups
 * and allows substitution of Type 4 smoke detection systems in challenging environments.
 *
 * @param {Object} firecell - Firecell configuration object
 * @param {string} firecell.riskGroup - Building risk group (must be 'CA' or 'WB' for this note to apply)
 * @param {boolean} [firecell.challengingSmokeEnvironment] - Whether the environment is challenging for smoke detection
 * @param {Object} [buildingParams] - Building-level parameters (not used for this note)
 * @returns {Object} Evaluation result
 * @returns {boolean} returns.applies - Whether this note applies to the firecell
 * @returns {boolean} [returns.substitute] - Whether Type 4 substitute is allowed (only if applies is true)
 * @returns {string} [returns.reason] - Human-readable explanation of the evaluation (only if applies is true)
 */
function evaluateNote5(firecell, buildingParams) {
  // Handle null/undefined firecell parameter
  if (!firecell || typeof firecell !== 'object') {
    return { applies: false };
  }

  // Note 5 only applies to CA (Crowd Activities) and WB (Warehouse/Storage) risk groups
  if (!['CA', 'WB'].includes(firecell.riskGroup)) {
    return { applies: false };
  }

  // Check challenging smoke environment condition - must be exactly boolean true
  const substitute = firecell.challengingSmokeEnvironment === true;

  // Generate appropriate reason message
  const reason = substitute
    ? 'Challenging smoke environment - Type 4 may be substituted with Type 6 or Type 3 + supplementary'
    : 'Standard smoke detection acceptable';

  return {
    applies: true,
    substitute,
    reason,
  };
}

module.exports = evaluateNote5;