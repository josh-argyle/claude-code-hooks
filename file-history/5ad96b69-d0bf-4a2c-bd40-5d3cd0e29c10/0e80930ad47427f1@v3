const evaluateNote2 = require('../../../../api/processors/fire-safety-systems/note-evaluators/note-2-evaluator');

describe('Note 2 Evaluator - Type 18 Hydrant System Exemption', () => {
  describe('Applicability', () => {
    test('should apply to all risk groups', () => {
      const riskGroups = ['SM', 'SI', 'CA', 'WB', 'WS', 'VP'];

      riskGroups.forEach(riskGroup => {
        const firecell = { riskGroup };
        const result = evaluateNote2(firecell, {});

        expect(result.applies).toBe(true);
      });
    });

    test('should always return applies:true regardless of risk group', () => {
      const firecell = { riskGroup: 'INVALID' };
      const result = evaluateNote2(firecell, {});

      expect(result.applies).toBe(true);
    });
  });

  describe('Exemption - Both Conditions Met', () => {
    test('should grant exemption when both FENZ conditions met', () => {
      const firecell = { riskGroup: 'CA' };
      const projectModel = {
        fenzAccessHeightUnder15m: true,
        fenzHoseRunUnder75m: true
      };
      const result = evaluateNote2(firecell, projectModel);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(true);
      expect(result.reason).toContain('FENZ access <15m');
      expect(result.reason).toContain('hose run <75m');
    });
  });

  describe('Exemption - FENZ Access Height', () => {
    test('should not grant exemption when only access height condition met', () => {
      const firecell = { riskGroup: 'CA' };
      const projectModel = {
        fenzAccessHeightUnder15m: true,
        fenzHoseRunUnder75m: false
      };
      const result = evaluateNote2(firecell, projectModel);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });

    test('should not grant exemption when access height condition not met', () => {
      const firecell = { riskGroup: 'CA' };
      const projectModel = {
        fenzAccessHeightUnder15m: false,
        fenzHoseRunUnder75m: true
      };
      const result = evaluateNote2(firecell, projectModel);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });
  });

  describe('Exemption - FENZ Hose Run Distance', () => {
    test('should not grant exemption when only hose run condition met', () => {
      const firecell = { riskGroup: 'CA' };
      const projectModel = {
        fenzAccessHeightUnder15m: false,
        fenzHoseRunUnder75m: true
      };
      const result = evaluateNote2(firecell, projectModel);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });

    test('should not grant exemption when hose run condition not met', () => {
      const firecell = { riskGroup: 'CA' };
      const projectModel = {
        fenzAccessHeightUnder15m: true,
        fenzHoseRunUnder75m: false
      };
      const result = evaluateNote2(firecell, projectModel);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });
  });

  describe('Edge Cases', () => {
    test('should handle missing projectModel parameter', () => {
      const firecell = { riskGroup: 'CA' };
      const result = evaluateNote2(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
      expect(result.reason).toBe('Type 18 hydrant system required');
    });

    test('should handle empty projectModel object', () => {
      const firecell = { riskGroup: 'CA' };
      const result = evaluateNote2(firecell, {});

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });

    test('should handle null projectModel', () => {
      const firecell = { riskGroup: 'CA' };
      const result = evaluateNote2(firecell, null);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });

    test('should handle missing fenzAccessHeightUnder25m', () => {
      const firecell = { riskGroup: 'CA' };
      const projectModel = {
        fenzHoseRunUnder75m: true
      };
      const result = evaluateNote2(firecell, projectModel);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });

    test('should handle missing fenzHoseRunUnder75m', () => {
      const firecell = { riskGroup: 'CA' };
      const projectModel = {
        fenzAccessHeightUnder15m: true
      };
      const result = evaluateNote2(firecell, projectModel);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });

    test('should require exact boolean true values', () => {
      const firecell = { riskGroup: 'CA' };
      const projectModel = {
        fenzAccessHeightUnder15m: 'true', // String not boolean
        fenzHoseRunUnder75m: 1 // Number not boolean
      };
      const result = evaluateNote2(firecell, projectModel);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });
  });

  describe('Reason Messages', () => {
    test('should provide clear reason when exemption granted', () => {
      const firecell = { riskGroup: 'CA' };
      const projectModel = {
        fenzAccessHeightUnder15m: true,
        fenzHoseRunUnder75m: true
      };
      const result = evaluateNote2(firecell, projectModel);

      expect(result.reason).toBe('FENZ access <15m and hose run <75m - Type 18 exempt');
    });

    test('should provide clear reason when exemption not granted', () => {
      const firecell = { riskGroup: 'CA' };
      const projectModel = {
        fenzAccessHeightUnder15m: false,
        fenzHoseRunUnder75m: false
      };
      const result = evaluateNote2(firecell, projectModel);

      expect(result.reason).toBe('Type 18 hydrant system required');
    });
  });

  describe('Universal Application', () => {
    test('should exempt all risk groups when conditions met', () => {
      const riskGroups = ['SM', 'SI', 'CA', 'WB', 'WS', 'VP'];
      const projectModel = {
        fenzAccessHeightUnder15m: true,
        fenzHoseRunUnder75m: true
      };

      riskGroups.forEach(riskGroup => {
        const firecell = { riskGroup };
        const result = evaluateNote2(firecell, projectModel);

        expect(result.applies).toBe(true);
        expect(result.exempt).toBe(true);
      });
    });

    test('should require all risk groups when conditions not met', () => {
      const riskGroups = ['SM', 'SI', 'CA', 'WB', 'WS', 'VP'];
      const projectModel = {
        fenzAccessHeightUnder15m: false,
        fenzHoseRunUnder75m: false
      };

      riskGroups.forEach(riskGroup => {
        const firecell = { riskGroup };
        const result = evaluateNote2(firecell, projectModel);

        expect(result.applies).toBe(true);
        expect(result.exempt).toBe(false);
      });
    });
  });
});