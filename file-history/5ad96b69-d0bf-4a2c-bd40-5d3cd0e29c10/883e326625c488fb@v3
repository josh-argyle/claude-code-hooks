/**
 * Note 1a Evaluator - SM Risk Group Type 2 System Exemption
 *
 * From CAS2 Table 2.2 Note 1a:
 * "This system is not required where: a) For risk group SM, if the escape routes
 * serve no more than 10 beds, or where the exit doors from sleeping area firecells
 * open directly into a safe place or external safe path. For risk group SM transient
 * accommodation, where a Type 5 system is not required, each suite shall be provided
 * with Type 1 smoke alarms."
 *
 * @param {Object} firecell - Firecell configuration object
 * @param {string} firecell.riskGroup - Building risk group (must be 'SM' for this note to apply)
 * @param {string} [firecell.smOccupantType] - Occupant type (permanent, transient, education, care or detention)
 * @param {number} [firecell.escapeHeight] - Escape height in meters
 * @param {number} [firecell.maxEscapeRouteBeds] - Maximum number of beds served by largest escape route (SM-specific)
 * @param {number} [firecell.maxEscapeRouteOccupants] - Maximum number of occupants served by largest escape route (backward compatibility)
 * @param {boolean} [firecell.exitDirectlyToSafePlace] - Whether exit doors open directly to safe place/external safe path
 * @returns {Object} Evaluation result
 * @returns {boolean} returns.applies - Whether this note applies to the firecell
 * @returns {boolean} [returns.exempt] - Whether the firecell is exempt from Type 2 system (only if applies is true)
 * @returns {boolean} [returns.requiresType1SmokeAlarms] - Whether Type 1 smoke alarms are required in each suite (SM transient only)
 * @returns {string} [returns.reason] - Human-readable explanation of the evaluation (only if applies is true)
 */
function evaluateNote1a(firecell) {
  // Note 1a only applies to SM (Accommodation) risk group
  if (firecell.riskGroup !== 'SM') {
    return { applies: false };
  }

  // Check exemption conditions - prioritize SM-specific beds parameter
  const bedCount =
    firecell.maxEscapeRouteBeds !== undefined
      ? firecell.maxEscapeRouteBeds
      : firecell.maxEscapeRouteOccupants;

  const bedExemption =
    typeof bedCount === 'number' && bedCount >= 0 && bedCount <= 10;

  const directExitExemption = firecell.exitDirectlyToSafePlace === true;

  // Determine if firecell is exempt from Type 2 system
  const exempt = bedExemption || directExitExemption;

  // Check if Type 1 smoke alarms are required for transient accommodation
  // Type 5 is not required when escape height < 4m (from CAS2 Table 2.2)
  // For SM transient at escape height 0, table shows "51a" meaning Type 5 with note 1a
  // Type 5 is required at escape height ≥ 4m
  const isTransient = firecell.smOccupantType === 'transient';
  const escapeHeight =
    typeof firecell.escapeHeight === 'number' ? firecell.escapeHeight : 999;
  const type5NotRequired = escapeHeight < 4;
  const requiresType1SmokeAlarms = isTransient && type5NotRequired && exempt;

  // Generate appropriate reason message
  let reason;
  if (bedExemption) {
    reason = 'Max escape route serves ≤10 beds';
  } else if (directExitExemption) {
    reason = 'Direct exit to safe place';
  } else {
    reason = 'Standard requirement - no exemption conditions met';
  }

  // Add Type 1 smoke alarm requirement to reason if applicable
  if (requiresType1SmokeAlarms) {
    reason +=
      ' - Type 1 smoke alarms required in each suite for transient accommodation';
  }

  const result = {
    applies: true,
    exempt,
    reason,
  };

  // Only add requiresType1SmokeAlarms if it's true
  if (requiresType1SmokeAlarms) {
    result.requiresType1SmokeAlarms = true;
  }

  return result;
}

module.exports = evaluateNote1a;