    function populateAddUserRoles() {
      const container = document.getElementById('add-roles-container');
      if (container) {
        container.innerHTML = '';

        // Find the 'user' role to set as default
        const userRole = allRoles.find(role => role.role_name === 'user');

        allRoles.forEach(role => {
          const radioDiv = document.createElement('div');
          // Check the 'user' role by default
          const isChecked = role.role_id === userRole?.role_id ? 'checked' : '';
          radioDiv.innerHTML = `
            <label class="floating-radio" for="add-role-${role.role_id}">
              <div class="radio-container">
                <input type="radio" id="add-role-${role.role_id}" value="${role.role_id}" name="add_user_role" ${isChecked}>
                ${Icons.getIcon('check-circle', {class: 'radio-icon'})}
              </div>
              <span class="radio-label">${role.role_name} - ${role.role_description || ''}</span>
            </label>
          `;

          container.appendChild(radioDiv);
        });
      }
    }
    
    // Setup modal handlers for close buttons
    function setupModalHandlers() {
      // Handle modal close and cancel buttons
      document.addEventListener('click', function(e) {
        if (e.target.classList.contains('modal-close') || e.target.classList.contains('modal-cancel')) {
          const modal = e.target.closest('.modal');
          if (modal) {
            modal.classList.remove('active');
          }
        }
        
        // Handle clicking outside modal content to close
        if (e.target.classList.contains('modal-overlay')) {
          const modal = e.target.closest('.modal');
          if (modal) {
            modal.classList.remove('active');
          }
        }
      });
    }
    
    // Handle add user form submission
    function setupAddUserFormHandler() {
      const addUserForm = document.getElementById('add-user-modal-form');
      if (addUserForm) {
        addUserForm.addEventListener('submit', function(e) {
          e.preventDefault();
          
          // Validate password
          const password = document.getElementById('add-password').value;
          if (password.length < 8) {
            showNotification('Password must be at least 8 characters long', 'error');
            return;
          }
          
          // Validate required fields
          const defaultProfitCentre = document.getElementById('add-default-profit-centre').value;
          
          if (!defaultProfitCentre) {
            showNotification('Default Profit Centre is required', 'error');
            return;
          }
          
          // Collect form data
          const userData = {
            username: document.getElementById('add-username').value,
            password: password,
            default_profit_centre: defaultProfitCentre,
            is_active: document.getElementById('add-active').checked
          };
          
          // Remove undefined values
          Object.keys(userData).forEach(key => {
            if (userData[key] === undefined || userData[key] === '') {
              delete userData[key];
            }
          });
          
          const contactData = {};
          const firstName = document.getElementById('add-first-name').value;
          const surname = document.getElementById('add-surname').value;
          const position = document.getElementById('add-position').value;
          const phone = document.getElementById('add-phone').value;
          const email = document.getElementById('add-email').value;
          
          // Only include non-empty contact values
          if (firstName) contactData.first_name = firstName;
          if (surname) contactData.surname = surname;
          if (position) contactData.position = position;
          if (phone) contactData.phone = phone;
          if (email) contactData.email = email;
          
          // Collect selected role, default to 'user' role if none selected
          const selectedRole = document.querySelector('input[name="add_user_role"]:checked');
          let roleIds = selectedRole ? [selectedRole.value] : [];

          // Fallback to 'user' role if no role is selected
          if (roleIds.length === 0) {
            const userRole = allRoles.find(role => role.role_name === 'user');
            if (userRole) {
              roleIds = [userRole.role_id];
            }
          }
          
          // Add workbench user ID if provided
          const workbenchId = document.getElementById('add-workbench-id').value;
          if (workbenchId && workbenchId.trim()) {
            userData.workbench_user_id = workbenchId.trim();
          }
          
          // Create request body
          const requestBody = {
            userData: userData,
            contactData: Object.keys(contactData).length > 0 ? contactData : undefined,
            role_ids: roleIds
          };
          
          // Submit to API
          fetch('/api/users/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(requestBody)
          })
          .then(response => {
            if (response.ok) {
              return response.json();
            } else {
              return response.json().then(err => Promise.reject(err));
            }
          })
          .then(data => {
            showNotification('User created successfully', 'success');
            
            // Close modal
            document.getElementById('add-user-modal').classList.remove('active');
            
            // Add new user to the list
            allUsers.push(data);
            renderUsersList(allUsers);
            
            // Clear form
            addUserForm.reset();
          })
          .catch(error => {
            logger.error('Error creating user:', error);
            showNotification(error.error || 'Error creating user', 'error');
          });
        });
      }
    }

    function setupWorkbenchImportHandlers() {
      // Handle "Create Account from Workbench" button
      document.getElementById('import-from-workbench-btn').addEventListener('click', function() {
        importFromWorkbench();
      });

      // Handle "Create Account Manually" button
      document.getElementById('create-manually-btn').addEventListener('click', function() {
