    function importFromWorkbench() {
      const personId = document.getElementById('workbench-person-id').value;

      if (!personId || !personId.trim()) {
        showNotification('Please enter a Workbench Person ID', 'error');
        return;
      }

      // Show loading state
      const importBtn = document.getElementById('import-from-workbench-btn');
      const originalText = importBtn.textContent;
      importBtn.textContent = 'Loading...';
      importBtn.disabled = true;

      // First check if this Workbench ID is already in use
      checkWorkbenchIdExists(personId)
        .then(exists => {
          if (exists) {
            throw new Error(`Workbench Person ID ${personId} is already associated with an existing user account.`);
          }

          // If not exists, fetch person details from Workbench
          return fetch(`/api/workbench-people/${personId}`);
        })
        .then(response => {
          if (!response.ok) {
            if (response.status === 404) {
              throw new Error('Person not found in Workbench');
            } else if (response.status === 403) {
              throw new Error('Access denied. Admin permissions required.');
            } else {
              throw new Error('Failed to fetch person details');
            }
          }
          return response.json();
        })
        .then(person => {
          // Pre-fill form with Workbench data and disable fields
          prefillFormWithWorkbenchData(person, true);

          // Show the form
          showManualCreateForm();

          showNotification('Successfully imported person data from Workbench', 'success');
        })
        .catch(error => {
          logger.error('Error importing from Workbench:', error);
          showNotification(error.message || 'Error importing from Workbench', 'error');
        })
        .finally(() => {
          // Reset button state
          importBtn.textContent = originalText;
          importBtn.disabled = false;
        });
    }

    function prefillFormWithWorkbenchData(person, disableFields = false) {
      // Generate username from email if available
      if (person.emailAddress) {
        const username = person.emailAddress.split('@')[0];
        const usernameField = document.getElementById('add-username');
        usernameField.value = username;
        if (disableFields) {
          usernameField.disabled = true;
          usernameField.style.backgroundColor = 'var(--gray-100)';
        }
      }

      // Fill contact information
      if (person.firstName) {
        const firstNameField = document.getElementById('add-first-name');
        firstNameField.value = person.firstName;
        if (disableFields) {
          firstNameField.disabled = true;
          firstNameField.style.backgroundColor = 'var(--gray-100)';
        }
      }
      if (person.surname) {
        const surnameField = document.getElementById('add-surname');
        surnameField.value = person.surname;
        if (disableFields) {
          surnameField.disabled = true;
          surnameField.style.backgroundColor = 'var(--gray-100)';
        }
      }
      if (person.emailAddress) {
        const emailField = document.getElementById('add-email');
        emailField.value = person.emailAddress;
        if (disableFields) {
          emailField.disabled = true;
          emailField.style.backgroundColor = 'var(--gray-100)';
        }
      }
      if (person.mobilePhone) {
        const phoneField = document.getElementById('add-phone');
        phoneField.value = person.mobilePhone;
        if (disableFields) {
          phoneField.disabled = true;
          phoneField.style.backgroundColor = 'var(--gray-100)';
        }
      }
      if (person.jobTitle) {
        const positionField = document.getElementById('add-position');
        positionField.value = person.jobTitle;
        if (disableFields) {
          positionField.disabled = true;
          positionField.style.backgroundColor = 'var(--gray-100)';
        }
      }

      // Set the Workbench User ID (always disabled when importing)
      if (person.personId) {
        const workbenchIdField = document.getElementById('add-workbench-id');
        workbenchIdField.value = person.personId;
        if (disableFields) {
          workbenchIdField.disabled = true;
          workbenchIdField.style.backgroundColor = 'var(--gray-100)';
        }
      }
    }

    function checkWorkbenchIdExists(personId) {
      // Check if any existing user has this workbench_user_id
      const existingUser = allUsers.find(user => user.workbench_user_id === personId);
      return Promise.resolve(!!existingUser);
    }

    function showManualCreateForm() {
      // Reset field states to enabled
      resetFormFieldStates();

      // Hide selection screen
      document.getElementById('add-user-selection').style.display = 'none';

      // Show form content
      document.getElementById('add-user-form-content').classList.remove('hidden');

      // Focus on username field
      setTimeout(() => {
        document.getElementById('add-username').focus();
      }, 100);
    }

    function resetFormFieldStates() {
      // Re-enable all fields and reset their styling (for manual create)
      const fieldsToReset = [
        'add-username', 'add-first-name', 'add-surname',
        'add-email', 'add-phone', 'add-position', 'add-workbench-id'
      ];

      fieldsToReset.forEach(fieldId => {
        const field = document.getElementById(fieldId);
        if (field) {
          field.disabled = false;
          field.style.backgroundColor = '';
        }
      });
    }
