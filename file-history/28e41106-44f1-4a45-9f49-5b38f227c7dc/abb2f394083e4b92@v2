extends layout
include includes/modal
include includes/floating-input
include includes/search-select
include includes/floating-checkbox
include includes/floating-radio

block pageHeader
  .page-header
    h1.page-title User Management
    .page-actions
      button#add-user-btn.btn.btn-primary Add User
      a.btn.btn-secondary(href="/admin") Back to Admin Panel

block content
  .content-container
    .users-layout
      // Left Panel - Users List
      .users-sidebar
        .users-sidebar-header
          .users-search
            +floating-input({type: 'text', name: 'users-search', placeholder: 'Search users...', id: 'users-search', autocomplete: 'off'})
        .users-sidebar-content
          #users-list.users-list
            .users-loading Loading users...

      // Right Panel - User Details
      .users-main
        .users-main-header
          h3
            +icon('user-cog', 'me-2')
            | User Details
        .users-main-content
          #user-placeholder.user-placeholder
            +icon('user-circle')
            h4 Select a User
            p Choose a user from the left panel to view and edit their details.
          
          #user-details.user-details.hidden
            #user-form.user-form
              .form-section
                h4 Basic Information
                .form-row
                  .form-col
                    +floating-input({type: 'text', name: 'username', placeholder: 'Username', id: 'user-username', classes: 'auto-save-field', disabled: true})
                  .form-col
                    +floating-checkbox({name: 'is_active', placeholder: 'Account Active', id: 'user-active', classes: 'auto-save-field'})
                .form-row
                  .form-col
                    +floating-input({type: 'select', name: 'default_profit_centre', placeholder: 'Default Profit Centre', id: 'user-default-profit-centre', classes: 'auto-save-field'})
                      option(value="1120") Dunedin
                      option(value="1320") Christchurch
                      option(value="2120") Queenstown
                      option(value="3120") Taranaki
                  .form-col
                    .form-note(style="padding: 1rem;")
                      small Note: Current profit centre is managed via Staff Profit Centres page
              
              .form-section
                h4 Contact Information
                .form-row
                  .form-col
                    +floating-input({type: 'text', name: 'first_name', placeholder: 'First Name', id: 'user-first-name', classes: 'auto-save-field'})
                  .form-col
                    +floating-input({type: 'text', name: 'surname', placeholder: 'Surname', id: 'user-surname', classes: 'auto-save-field'})
                .form-row
                  .form-col
                    +floating-input({type: 'email', name: 'email', placeholder: 'Email', id: 'user-email', classes: 'auto-save-field'})
                  .form-col
                    +floating-input({type: 'tel', name: 'phone', placeholder: 'Phone', id: 'user-phone', classes: 'auto-save-field'})
                .form-row
                  .form-col
                    +floating-input({type: 'text', name: 'position', placeholder: 'Position', id: 'user-position', classes: 'auto-save-field'})
              
              .form-section
                h4 Roles & Permissions
                #roles-container.roles-container
                  p Loading roles...
              
              .form-section
                h4 Workbench Settings
                .form-row
                  .form-col
                    +floating-input({type: 'text', name: 'workbench_user_id', placeholder: 'Workbench User ID', id: 'user-workbench-id', classes: 'auto-save-field'})
                  .form-col
                    +floating-input({type: 'number', name: 'po_limit', placeholder: 'Purchase Order Limit ($)', id: 'user-po-limit', classes: 'auto-save-field', step: '0.01', max: '99999.99', min: '0'})
              
              .form-section
                h4 Password
                +floating-input({type: 'password', name: 'new_password', placeholder: 'New Password', id: 'user-new-password'})
                button#change-password-btn.btn.btn-primary Change Password

  // Add User Modal
  +modal('add-user-modal', 'Add New User', '/api/users/', 'POST')
    // Initial selection screen
    #add-user-selection.add-user-selection
      .form-section
        h4 Import from Workbench
        .form-row
          .form-col
            +floating-input({type: 'text', name: 'workbench_person_id', placeholder: 'Workbench Person ID', id: 'workbench-person-id'})
          .form-col-auto
            button#import-from-workbench-btn.btn.btn-primary(type="button") Import

        .or-divider
          span OR

        .form-row
          .form-col
            button#create-manually-btn.btn.btn-secondary.btn-block(type="button") Create Account Manually

    // Existing form (initially hidden)
    #add-user-form-content.add-user-form-content.hidden
      .form-section
        h4 Basic Information
        .form-row
          .form-col
            +floating-input({type: 'text', name: 'username', placeholder: 'Username *', id: 'add-username', required: true})
          .form-col
            +floating-checkbox({name: 'is_active', placeholder: 'Account Active', id: 'add-active', checked: true})
        .form-row
          .form-col
            +floating-input({type: 'select', name: 'default_profit_centre', placeholder: 'Default Profit Centre *', id: 'add-default-profit-centre', required: true})
              option(value="1120") Dunedin
              option(value="1320") Christchurch
              option(value="2120") Queenstown
              option(value="3120") Taranaki
          .form-col
            .form-note(style="padding: 1rem;")
              small Note: Assign current profit centre via Staff Profit Centres page after user creation

      .form-section
        h4 Contact Information
        .form-row
          .form-col
            +floating-input({type: 'text', name: 'first_name', placeholder: 'First Name', id: 'add-first-name'})
          .form-col
            +floating-input({type: 'text', name: 'surname', placeholder: 'Surname', id: 'add-surname'})
        .form-row
          .form-col
            +floating-input({type: 'email', name: 'email', placeholder: 'Email', id: 'add-email'})
          .form-col
            +floating-input({type: 'tel', name: 'phone', placeholder: 'Phone', id: 'add-phone'})
        .form-row
          .form-col
            +floating-input({type: 'text', name: 'position', placeholder: 'Position', id: 'add-position'})

      .form-section
        h4 Roles & Permissions
        #add-roles-container.roles-container
          p Loading roles...

      .form-section
        h4 System Settings
        .form-row
          .form-col
            +floating-input({type: 'text', name: 'workbench_user_id', placeholder: 'Workbench User ID', id: 'add-workbench-id'})

      .form-section
        h4 Password
        +floating-input({type: 'password', name: 'password', placeholder: 'Password * (min 8 chars)', id: 'add-password', required: true})

  style.
    .users-layout {
      display: flex;
      gap: var(--spacing-xl);
    }
    
    .users-sidebar {
      flex: 0 0 280px;
      background: var(--white);
      border: var(--border-width-thin) solid var(--border-color);
      border-radius: var(--border-radius-md);
    }
    
    .users-sidebar-header {
      padding: var(--spacing-lg);
      border-bottom: var(--border-width-thin) solid var(--border-color);
      background: var(--gray-100);
    }
    
    .users-list {
    }
    
    .users-loading {
      padding: var(--spacing-xl);
      text-align: center;
      color: var(--text-muted);
    }
    
    .user-item {
      padding: var(--spacing-md) var(--spacing-lg);
      border-bottom: var(--border-width-thin) solid var(--border-color-light);
      cursor: pointer;
      transition: var(--transition-fast);
      border-left: 3px solid transparent;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    
    .user-item:hover {
      background: var(--hover-bg);
      border-left-color: var(--primary);
    }
    
    .user-item.active {
      background: var(--primary);
      color: var(--white);
      border-left-color: var(--primary-active);
    }
    
    .user-item.active:hover {
      background: var(--primary-hover);
    }
    
    .user-item-info {
      flex: 1;
    }
    
    .user-item-name {
      font-weight: 600;
      margin-bottom: var(--spacing-xs);
    }
    
    .user-item-details {
      font-size: var(--font-size-sm);
      opacity: 0.8;
    }
    
    .user-item-status {
      flex-shrink: 0;
    }
    
    .user-status {
      font-size: var(--font-size-xs);
      padding: 2px 6px;
      border-radius: var(--border-radius-sm);
    }
    
    .user-status.active {
      background: var(--success);
      color: var(--white);
    }
    
    .user-status.inactive {
      background: var(--gray-400);
      color: var(--white);
    }
    
    .users-main {
      flex: 1;
      background: var(--white);
      border: var(--border-width-thin) solid var(--border-color);
      border-radius: var(--border-radius-md);
      display: flex;
      flex-direction: column;
    }
    
    .users-main-header {
      padding: var(--spacing-lg);
      border-bottom: var(--border-width-thin) solid var(--border-color);
      background: var(--gray-100);
    }
    
    .users-main-header h3 {
      margin: 0;
      font-size: var(--font-size-base);
      font-weight: 600;
      color: var(--text-primary);
    }
    
    .users-main-content {
      flex: 1;
      padding: var(--spacing-lg);
    }
    
    .user-placeholder {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: var(--text-muted);
      height: 300px;
    }
    
    .user-placeholder i {
      font-size: var(--font-size-2xl);
      margin-bottom: var(--spacing-lg);
    }
    
    .user-placeholder h4 {
      margin: 0 0 var(--spacing-sm) 0;
      color: var(--text-primary);
    }
    
    .user-placeholder p {
      margin: 0;
    }
    
    .user-form {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-xl);
    }
    
    .form-section {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-md);
    }
    
    .form-section h4 {
      margin: 0 0 var(--spacing-md) 0;
      font-size: var(--font-size-base);
      font-weight: 600;
      color: var(--text-primary);
      border-bottom: var(--border-width-thin) solid var(--border-color-light);
      padding-bottom: var(--spacing-sm);
    }
    
    .roles-container {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-sm);
    }
    
    .form-row {
      display: flex;
      gap: var(--spacing-md);
      align-items: flex-start;
    }
    
    .form-col {
      flex: 1;
      min-width: 0;
    }
    
    .form-col:only-child {
      flex: none;
      width: 50%;
    }

    .add-user-selection .form-section {
      margin-bottom: var(--spacing-lg);
      padding: var(--spacing-lg);
      background: var(--gray-50);
      border: var(--border-width-thin) solid var(--border-color-light);
      border-radius: var(--border-radius-md);
      max-width: 400px;
      margin-left: auto;
      margin-right: auto;
    }

    .add-user-selection .form-section h4 {
      margin: 0 0 var(--spacing-md) 0;
      color: var(--text-primary);
      font-weight: 600;
    }

    .form-col-auto {
      flex: 0 0 auto;
      margin-left: var(--spacing-md);
    }

    .or-divider {
      text-align: center;
      margin: 0;
      padding: 0;
    }

    .or-divider span {
      color: var(--text-muted);
      font-weight: 600;
      font-size: var(--font-size-sm);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .btn-block {
      width: 100%;
    }

    .add-user-selection .form-row:last-child {
      text-align: center;
      display: flex;
    }

    /* Remove number input arrows */
    input[type="number"]::-webkit-outer-spin-button,
    input[type="number"]::-webkit-inner-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }

    input[type="number"] {
      -moz-appearance: textfield;
    }

    .add-user-form-content.hidden {
      display: none;
    }

    .add-user-form-content {
      padding: var(--spacing-lg);
    }

    @media (max-width: 768px) {
      .users-layout {
        flex-direction: column;
        gap: var(--spacing-lg);
      }
      
      .users-sidebar {
        flex: none;
      }
      
      .form-row {
        flex-direction: column;
        gap: var(--spacing-sm);
      }
      
      .form-col:only-child {
        width: 100%;
      }
    }
  script.
    let allUsers = [];
    let allRoles = [];
    let allProfitCentres = [];
    let selectedUserId = null;
    let saveTimeout = null;
    
    document.addEventListener('DOMContentLoaded', function() {
      // Load initial data
      Promise.all([
        fetch('/api/users').then(r => r.json()),
        fetch('/api/users/roles').then(r => r.json()),
        fetch('/api/users/profit-centres').then(r => r.json())
      ]).then(([users, roles, profitCentres]) => {
        allUsers = users;
        allRoles = roles;
        allProfitCentres = profitCentres;
        
        renderUsersList(allUsers);
        setupSearch();
        setupAutoSave();
        // Basic select elements for profit centres
      }).catch(error => {
        logger.error('Error loading data:', error);
        showNotification('Error loading users', 'error');
        document.getElementById('users-list').innerHTML = 
          '<div class="users-loading">Unable to load users</div>';
      });
      
      // Add user button
      document.getElementById('add-user-btn').addEventListener('click', function() {
        openAddUserModal();
      });
      
      // Change password button
      document.getElementById('change-password-btn').addEventListener('click', function() {
        changePassword();
      });
      
      // Setup add user form submission handler
      setupAddUserFormHandler();

      // Setup modal close handlers
      setupModalHandlers();

      // Setup Workbench import handlers
      setupWorkbenchImportHandlers();
    });
    
    function renderUsersList(users) {
      const usersList = document.getElementById('users-list');
      
      if (users.length === 0) {
        showNotification('No users found', 'info');
        usersList.innerHTML = '<div class="users-loading">No users to display</div>';
        return;
      }
      
      // Sort users: active first, then inactive, alphabetical within each group
      const sortedUsers = users.sort((a, b) => {
        // First sort by active status (active users first)
        if (a.is_active !== b.is_active) {
          return b.is_active ? 1 : -1; // Active (true) comes before inactive (false)
        }
        
        // Then sort alphabetically by full name or username
        const nameA = (a.full_name || a.username || '').toLowerCase();
        const nameB = (b.full_name || b.username || '').toLowerCase();
        return nameA.localeCompare(nameB);
      });
      
      let html = '';
      sortedUsers.forEach(user => {
        const fullName = user.full_name || user.username;
        const statusClass = user.is_active ? 'active' : 'inactive';
        const statusText = user.is_active ? 'Active' : 'Inactive';
        
        html += `
          <div class="user-item" data-user-id="${user.user_id}">
            <div class="user-item-info">
              <div class="user-item-name">${fullName}</div>
              <div class="user-item-details">${user.username}</div>
            </div>
            <div class="user-item-status">
              <span class="user-status ${statusClass}">${statusText}</span>
            </div>
          </div>
        `;
      });
      
      usersList.innerHTML = html;
      
      // Add click handlers
      usersList.querySelectorAll('.user-item').forEach(item => {
        item.addEventListener('click', function() {
          const userId = this.getAttribute('data-user-id');
          selectUser(userId);
        });
      });
    }
    
    function setupSearch() {
      // The floating-input mixin creates an input with the provided id
      const searchInput = document.getElementById('users-search');
      
      if (searchInput) {
        searchInput.addEventListener('input', function() {
          const searchTerm = this.value.toLowerCase();
          
          const filtered = allUsers.filter(user => {
            return (user.username && user.username.toLowerCase().includes(searchTerm)) ||
                   (user.full_name && user.full_name.toLowerCase().includes(searchTerm)) ||
                   (user.email && user.email.toLowerCase().includes(searchTerm));
          });
          
          renderUsersList(filtered);
        });
      }
    }
    
    function selectUser(userId) {
      selectedUserId = userId;
      
      // Update active state
      document.querySelectorAll('.user-item').forEach(item => {
        item.classList.remove('active');
      });
      document.querySelector(`[data-user-id="${userId}"]`).classList.add('active');
      
      // Hide placeholder and show user details
      document.getElementById('user-placeholder').style.display = 'none';
      const userDetails = document.getElementById('user-details');
      userDetails.classList.remove('hidden');
      userDetails.style.display = 'block';
      
      // Load user details
      loadUserDetails(userId);
    }
    
    function loadUserDetails(userId) {
      fetch(`/api/users/${userId}/full`)
        .then(response => response.json())
        .then(user => {
          populateUserForm(user);
        })
        .catch(error => {
          logger.error('Error loading user details:', error);
          showNotification('Error loading user details', 'error');
        });
    }
    
    function populateUserForm(user) {
      
      // Basic Information
      document.getElementById('user-username').value = user.username || '';
      
      // Set profit centre value directly
      if (user.default_profit_centre) {
        document.getElementById('user-default-profit-centre').value = user.default_profit_centre;
      }
      
      document.getElementById('user-active').checked = user.is_active || false;
      
      // Contact Information
      const contacts = user.users_contacts || {};
      document.getElementById('user-first-name').value = contacts.first_name || '';
      document.getElementById('user-surname').value = contacts.surname || '';
      document.getElementById('user-position').value = contacts.position || '';
      document.getElementById('user-phone').value = contacts.phone || '';
      document.getElementById('user-email').value = contacts.email || '';
      
      // Roles
      populateRolesRadioButtons();
      const userRoleIds = user.users_roles ? user.users_roles.map(ur => ur.role_id) : [];
      setTimeout(() => {
        // For single role selection, select the first role if user has any roles
        if (userRoleIds.length > 0) {
          const firstRoleId = userRoleIds[0];
          const radioButton = document.querySelector(`#roles-container input[type="radio"][value="${firstRoleId}"]`);
          if (radioButton) {
            radioButton.checked = true;
          }
        }
      }, 100);
      
      // System Settings - Fix: workbench data is directly on user object, not nested
      document.getElementById('user-workbench-id').value = user.workbench_user_id || '';
      
      // Purchase Order Limits
      const poLimit = user.workbench_data_user_purchase_order_limits;
      const poLimitField = document.getElementById('user-po-limit');
      
      if (poLimit) {
        poLimitField.value = poLimit.limit_amount || '';
      } else {
        poLimitField.value = '';
      }
      
      // Check user role for permission to edit PO limits
      // We need to get current user's role to determine permissions
      fetch('/api/users/current')
        .then(response => response.json())
        .then(currentUser => {
          // Check if current user has only 'user' role
          const userRoles = currentUser.users_roles || [];
          const hasOnlyUserRole = userRoles.length === 1 && userRoles[0].role?.role_name === 'user';
          
          if (hasOnlyUserRole) {
            poLimitField.disabled = true;
            poLimitField.classList.add('read-only');
            poLimitField.style.backgroundColor = 'var(--gray-100)';
            poLimitField.style.cursor = 'not-allowed';
          } else {
            poLimitField.disabled = false;
            poLimitField.classList.remove('read-only');
            poLimitField.style.backgroundColor = '';
            poLimitField.style.cursor = '';
          }
        })
        .catch(error => {
          logger.error('Error checking user permissions:', error);
          // Default to read-only if we can't determine permissions
          poLimitField.disabled = true;
        });
      
      // Clear password field
      document.getElementById('user-new-password').value = '';
    }
    
    function setupAutoSave() {
      // Set up debounced auto-save for all form fields
      // Find all inputs within elements that have auto-save-field class
      const autoSaveFields = document.querySelectorAll(
        '#user-username, #user-default-profit-centre, ' +
        '#user-active, #user-first-name, #user-surname, #user-email, ' +
        '#user-phone, #user-position, #user-workbench-id, #user-po-limit'
      );
      
      autoSaveFields.forEach(field => {
        field.addEventListener('input', debounceAutoSave);
        field.addEventListener('change', debounceAutoSave);
      });
      
      // Handle radio button changes separately
      document.addEventListener('change', function(e) {
        if (e.target.matches('#roles-container input[type="radio"]')) {
          debounceAutoSave();
        }
      });
    }
    
    function debounceAutoSave() {
      if (!selectedUserId) return;
      
      // Clear existing timeout
      if (saveTimeout) {
        clearTimeout(saveTimeout);
      }
      
      // Show saving indicator using global system
      showSaveStatus('user-form', 'saving');
      
      // Set new timeout
      saveTimeout = setTimeout(() => {
        autoSaveUser();
      }, 1000); // 1 second debounce
    }
    
    function autoSaveUser() {
      if (!selectedUserId) return;
      
      // Collect form data separated by API endpoint
      const basicData = {
        username: document.getElementById('user-username').value,
        is_active: document.getElementById('user-active').checked
      };
      
      // Only add default_profit_centre if it has a valid value
      const defaultPC = document.getElementById('user-default-profit-centre').value;
      if (defaultPC && defaultPC.trim()) {
        basicData.default_profit_centre = defaultPC;
      }
      
      const contactData = {};
      const firstName = document.getElementById('user-first-name').value;
      const surname = document.getElementById('user-surname').value;
      const position = document.getElementById('user-position').value;
      const phone = document.getElementById('user-phone').value;
      const email = document.getElementById('user-email').value;
      
      // Only include non-empty values
      if (firstName) contactData.first_name = firstName;
      if (surname) contactData.surname = surname;
      if (position) contactData.position = position;
      if (phone) contactData.phone = phone;
      if (email) contactData.email = email;
      
      const workbenchData = {
        workbench_user_id: document.getElementById('user-workbench-id').value,
        is_active: true
      };
      
      // Collect selected role (single selection)
      const selectedRoles = [];
      const selectedRadio = document.querySelector('#roles-container input[type="radio"]:checked');
      if (selectedRadio) {
        selectedRoles.push(selectedRadio.value);
      }
      const roleData = { role_ids: selectedRoles };
      
      // Make multiple API calls in parallel
      const promises = [
        fetch(`/api/users/${selectedUserId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(basicData)
        })
      ];
      
      // Only add contacts API call if there's contact data to update
      if (Object.keys(contactData).length > 0) {
        promises.push(
          fetch(`/api/users/${selectedUserId}/contacts`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(contactData)
          })
        );
      }
      
      // Always update roles (even if empty, to clear roles if needed)
      promises.push(
        fetch(`/api/users/${selectedUserId}/roles`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(roleData)
        })
      );
      
      // Only add workbench API call if workbench_user_id has a value
      if (workbenchData.workbench_user_id && workbenchData.workbench_user_id.trim()) {
        promises.push(
          fetch(`/api/users/${selectedUserId}/workbench`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(workbenchData)
          })
        );
      }
      
      // Handle purchase order limit if user has permission and field is not disabled
      const poLimitField = document.getElementById('user-po-limit');
      const poLimitValue = poLimitField.value;
      if (!poLimitField.disabled && poLimitValue !== '') {
        const numericLimit = parseFloat(poLimitValue);
        if (isNaN(numericLimit) || numericLimit < 0 || numericLimit > 99999.99) {
          // Show error and prevent save
          showSaveStatus('user-form', 'error');
          showNotification('Purchase Order Limit must be between $0 and $99,999.99', 'error');
          setTimeout(() => {
            clearSaveStatus('user-form');
          }, 3000);
          return; // Exit early, don't save anything
        }
        promises.push(
          fetch(`/api/users/${selectedUserId}/purchase-order-limit`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ limit_amount: numericLimit })
          })
        );
      }
      
      Promise.all(promises)
        .then(responses => {
          // Check if all responses are OK
          const allSuccessful = responses.every(response => response.ok);
          
          if (allSuccessful) {
            showSaveStatus('user-form', 'saved');
            // Clear status after 2 seconds
            setTimeout(() => {
              clearSaveStatus('user-form');
            }, 2000);
          } else {
            throw new Error('One or more save operations failed');
          }
        })
        .catch(error => {
          logger.error('Error auto-saving user:', error);
          showSaveStatus('user-form', 'error');
          showNotification('Error saving user data', 'error');
          
          // Clear error status after 3 seconds
          setTimeout(() => {
            clearSaveStatus('user-form');
          }, 3000);
        });
    }
    
    function changePassword() {
      const newPassword = document.getElementById('user-new-password').value;
      
      if (!newPassword) {
        showNotification('Please enter a new password', 'error');
        return;
      }
      
      if (newPassword.length < 8) {
        showNotification('Password must be at least 8 characters long', 'error');
        return;
      }
      
      if (!selectedUserId) {
        showNotification('No user selected', 'error');
        return;
      }
      
      // API call to change password
      fetch(`/api/users/${selectedUserId}/password`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password: newPassword })
      })
      .then(response => {
        if (response.ok) {
          return response.json();
        } else {
          return response.json().then(err => Promise.reject(err));
        }
      })
      .then(data => {
        showNotification('Password changed successfully', 'success');
        // Clear password field
        document.getElementById('user-new-password').value = '';
      })
      .catch(error => {
        logger.error('Error changing password:', error);
        showNotification(error.error || 'Error changing password', 'error');
      });
    }
    
