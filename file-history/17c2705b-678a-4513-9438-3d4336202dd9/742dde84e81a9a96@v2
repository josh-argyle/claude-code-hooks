/**
 * Note 10 Evaluator - VP Minimum Type 3 Requirement
 *
 * From CAS2 Table 2.2 Note 10:
 * "If risk group VP is within a building that is protected with an automatic fire alarm system,
 * the risk group VP firecell must have at the minimum a Type 3 system."
 *
 * This note applies to VP (Vehicle Parking) risk group and requires a minimum Type 3
 * system when OTHER firecells in the building have automatic fire alarm systems (Types 3, 4, 5, or 7).
 * This creates a cross-firecell dependency where VP requirements are influenced by other firecells' systems.
 *
 * @param {Object} firecell - Firecell configuration object
 * @param {string} firecell.riskGroup - Building risk group (must be 'VP' for this note to apply)
 * @param {Array<string>} [firecell.fireSafetySystems] - Fire safety system codes present in this firecell
 * @param {Object} [projectModel] - Project-level parameters (not used for this note)
 * @param {Array<Object>} [allFirecells=[]] - All firecells in the building for cross-firecell analysis
 * @returns {Object} Evaluation result
 * @returns {boolean} returns.applies - Whether this note applies to the firecell
 * @returns {boolean} [returns.requiresMinType3] - Whether minimum Type 3 system is required (only if applies is true)
 * @returns {boolean} [returns.compliant] - Whether the firecell meets Type 3 minimum requirement (only if applies is true)
 * @returns {string} [returns.reason] - Human-readable explanation of the evaluation (only if applies is true)
 */
function evaluateNote10(firecell, projectModel, allFirecells = []) {
  // Note 10 only applies to VP (Vehicle Parking) risk group
  if (firecell.riskGroup !== 'VP') {
    return { applies: false };
  }

  // Check if OTHER firecells in the building (non-VP) have AUTOMATIC fire alarm systems
  // Automatic fire alarm system types: 3 (heat), 4 (smoke), 5 (modified), 7 (sprinkler+smoke)
  // NOTE: Type 2 (manual) is excluded - Note 10 requires automatic systems only
  const fireAlarmTypes = ['3', '4', '5', '7'];

  const otherFirecellsHaveFireAlarm = allFirecells.some(otherFirecell => {
    // Skip current firecell and other VP firecells
    if (otherFirecell === firecell || otherFirecell.riskGroup === 'VP') {
      return false;
    }

    // Check if this firecell has fire alarm systems
    const otherFirecellSystems = Array.isArray(otherFirecell.fireSafetySystems)
      ? otherFirecell.fireSafetySystems
      : [];

    // Check for system codes - handle both plain numbers and codes with notes (e.g., "2^1a")
    return otherFirecellSystems.some(systemCode => {
      // Extract the system type number from codes like "2^1a" or "2"
      const typeMatch = String(systemCode).match(/^(\d+)/);
      const systemType = typeMatch ? typeMatch[1] : null;
      return fireAlarmTypes.includes(systemType);
    });
  });

  // If no other firecells have fire alarms, VP doesn't need Type 3
  if (!otherFirecellsHaveFireAlarm) {
    return {
      applies: true,
      requiresMinType3: false,
      compliant: true,
      reason: 'No other firecells have fire alarm systems - no Type 3 requirement',
    };
  }

  // Other firecells have fire alarms, so VP requires minimum Type 3
  // Check if current VP firecell meets the Type 3 minimum requirement
  const currentSystems = Array.isArray(firecell.fireSafetySystems)
    ? firecell.fireSafetySystems
    : [];

  // Type 3 or higher fire alarm systems (3, 4, 5, 7 all meet or exceed Type 3)
  const meetsType3Minimum = currentSystems.some(systemCode => {
    const typeMatch = String(systemCode).match(/^(\d+)/);
    const systemType = typeMatch ? typeMatch[1] : null;
    return ['3', '4', '5', '7'].includes(systemType);
  });

  return {
    applies: true,
    requiresMinType3: true,
    compliant: meetsType3Minimum,
    reason: 'Building has fire alarm systems - minimum Type 3 required',
  };
}

module.exports = evaluateNote10;