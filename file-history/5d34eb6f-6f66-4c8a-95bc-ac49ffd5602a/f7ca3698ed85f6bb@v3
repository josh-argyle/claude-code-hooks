const { test, expect } = require('@playwright/test');

test.describe('NZS 4515 Sprinkler Substitution & System Validation', () => {

  test('Scenario 1: SM Education with NZS 4515 (within scope, substitution applied)', async ({ page }) => {
    await page.goto('/');

    // Confirm no complex features
    await page.check('#confirmedNoComplexFeatures');
    await page.fill('#projectName', 'Test Project');
    await page.fill('#clientName', 'Test Client');
    await page.fill('#clientAddress', 'Test Address');

    // Select SM risk group
    await page.selectOption('select[name="firecells[0][riskGroup]"]', 'SM');

    // Select Educational Accommodation
    await page.selectOption('select[name="firecells[0][sleepingOccupantType]"]', 'education');

    // Verify NZS 4515 option appears
    await expect(page.locator('.nzs-4515-option')).toBeVisible();

    // Fill in firecell data
    await page.fill('input[name="firecells[0][floorArea]"]', '1500');
    await page.fill('input[name="firecells[0][escapeHeight]"]', '12');
    await page.selectOption('select[name="firecells[0][isSprinklered]"]', 'true');
    await page.selectOption('select[name="firecells[0][floor]"]', 'G');
    await page.fill('input[name="firecells[0][occupantLoad]"]', '40');
    await page.fill('input[name="firecells[0][numberOfEscapeRoutes]"]', '2');
    await page.fill('input[name="firecells[0][maxEscapeRouteBeds]"]', '20');

    // Select NZS 4515 scope
    await page.selectOption('select[name="isWithinNZS4515Scope"]', 'true');

    // Verify substitution checkbox appears
    await expect(page.locator('.nzs-4515-substitution-choice')).toBeVisible();

    // Check NZS 4515 substitution
    await page.check('input[name="firecells[0][usesNZS4515Sprinklers]"]');

    // Select installed systems using chip-based selector (NZS-4515, 9, 18)
    await page.selectOption('.firecell-item[data-index="0"] .installed-systems-select', 'NZS-4515');
    await page.waitForSelector('.firecell-item[data-index="0"] .fire-safety-chips-container div[data-value="NZS-4515"]');
    await page.selectOption('.firecell-item[data-index="0"] .installed-systems-select', '9');
    await page.waitForSelector('.firecell-item[data-index="0"] .fire-safety-chips-container div[data-value="9"]');
    await page.selectOption('.firecell-item[data-index="0"] .installed-systems-select', '18');
    await page.waitForSelector('.firecell-item[data-index="0"] .fire-safety-chips-container div[data-value="18"]');

    // Submit form
    await page.click('button[type="submit"]');

    // Wait for results page to load
    await page.waitForURL(/\/results\/\d+/);
    await expect(page.locator('h2').first()).toContainText('Fire Safety Compliance Report');

    // Verify NZS 4515 section appears (may be in report paragraphs or debug section)
    await expect(page.getByText('NZS 4515 Sprinkler Substitution').first()).toBeVisible();
    await expect(page.getByText('1500m²').first()).toBeVisible();

    // Verify scope check (report paragraph or debug section)
    await expect(page.getByText(/within NZS 4515 scope/i).first()).toBeVisible();

    // Verify extended scope note (1500 > 500)
    await expect(page.getByText(/60-minute water supply/i).first()).toBeVisible();

    // Verify substitution applied (debug section)
    await expect(page.getByText('NZS 4515 SUBSTITUTION APPLIED').first()).toBeVisible();

    // Verify validation shows compliant
    await expect(page.getByText('Fire Safety Systems Validation').first()).toBeVisible();
    await expect(page.getByText('✓ COMPLIANT').first()).toBeVisible();

    // Verify table shows Type 7 substituted
    await expect(page.getByText('Type 7').first()).toBeVisible();
    await expect(page.getByText(/Compliant.*via.*NZS-4515/i).first()).toBeVisible();
  });

  test('Scenario 2: SM Education exceeding scope (>2000m², Type 7 required)', async ({ page }) => {
    await page.goto('/');

    await page.check('#confirmedNoComplexFeatures');
    await page.fill('#projectName', 'Test Project');
    await page.fill('#clientName', 'Test Client');
    await page.fill('#clientAddress', 'Test Address');

    await page.selectOption('select[name="firecells[0][riskGroup]"]', 'SM');
    await page.selectOption('select[name="firecells[0][sleepingOccupantType]"]', 'education');

    await page.fill('input[name="firecells[0][floorArea]"]', '2500');
    await page.fill('input[name="firecells[0][escapeHeight]"]', '12');
    await page.selectOption('select[name="firecells[0][isSprinklered]"]', 'true');
    await page.selectOption('select[name="firecells[0][floor]"]', 'G');
    await page.fill('input[name="firecells[0][occupantLoad]"]', '60');
    await page.fill('input[name="firecells[0][numberOfEscapeRoutes]"]', '2');
    await page.fill('input[name="firecells[0][maxEscapeRouteBeds]"]', '30');

    // Select out of scope
    await page.selectOption('select[name="isWithinNZS4515Scope"]', 'false');

    // Verify substitution checkbox does NOT appear
    await expect(page.locator('.nzs-4515-substitution-choice')).not.toBeVisible();

    // Select installed systems using chip-based selector (7, 9, 18)
    await page.selectOption('.firecell-item[data-index="0"] .installed-systems-select', '7');
    await page.waitForSelector('.firecell-item[data-index="0"] .fire-safety-chips-container div[data-value="7"]');
    await page.selectOption('.firecell-item[data-index="0"] .installed-systems-select', '9');
    await page.waitForSelector('.firecell-item[data-index="0"] .fire-safety-chips-container div[data-value="9"]');
    await page.selectOption('.firecell-item[data-index="0"] .installed-systems-select', '18');
    await page.waitForSelector('.firecell-item[data-index="0"] .fire-safety-chips-container div[data-value="18"]');

    await page.click('button[type="submit"]');

    // Wait for results page to load
    await page.waitForURL(/\/results\/\d+/);
    await expect(page.locator('h2').first()).toContainText('Fire Safety Compliance Report');

    // Verify exceeds scope message
    await expect(page.getByText(/exceeds NZS 4515 scope/i).first()).toBeVisible();
    await expect(page.getByText('2500m²').first()).toBeVisible();
    await expect(page.getByText(/2000m² limit/i).first()).toBeVisible();

    // Verify validation compliant (Type 7 installed)
    await expect(page.getByText('✓ COMPLIANT').first()).toBeVisible();
  });

  test('Scenario 3: Missing required systems (non-compliant)', async ({ page }) => {
    await page.goto('/');

    await page.check('#confirmedNoComplexFeatures');
    await page.fill('#projectName', 'Test Project');
    await page.fill('#clientName', 'Test Client');
    await page.fill('#clientAddress', 'Test Address');

    await page.selectOption('select[name="firecells[0][riskGroup]"]', 'CA');
    await page.selectOption('select[name="firecells[0][occupantType]"]', 'Space with loose seating');

    await page.fill('input[name="firecells[0][floorArea]"]', '400');
    await page.fill('input[name="firecells[0][escapeHeight]"]', '5');
    await page.selectOption('select[name="firecells[0][isSprinklered]"]', 'false');
    await page.selectOption('select[name="firecells[0][floor]"]', 'G');
    await page.fill('input[name="firecells[0][numberOfEscapeRoutes]"]', '2');
    await page.fill('input[name="firecells[0][maxEscapeRouteOccupants]"]', '150');

    // Intentionally omit Type 9 - only install 4 and 18 using chip-based selector
    await page.selectOption('.firecell-item[data-index="0"] .installed-systems-select', '4');
    await page.waitForSelector('.firecell-item[data-index="0"] .fire-safety-chips-container div[data-value="4"]');
    await page.selectOption('.firecell-item[data-index="0"] .installed-systems-select', '18');
    await page.waitForSelector('.firecell-item[data-index="0"] .fire-safety-chips-container div[data-value="18"]');

    await page.click('button[type="submit"]');

    // Wait for results page to load
    await page.waitForURL(/\/results\/\d+/);
    await expect(page.locator('h2').first()).toContainText('Fire Safety Compliance Report');

    // Verify non-compliant status
    await expect(page.getByText('✗ NON-COMPLIANT').first()).toBeVisible();
    await expect(page.getByText(/required system.*missing/i).first()).toBeVisible();

    // Verify table shows Type 9 missing
    await expect(page.getByText('Type 9').first()).toBeVisible();
    await expect(page.getByText('✗ MISSING').first()).toBeVisible();

    // Verify missing systems section
    await expect(page.getByText('Missing Required Systems').first()).toBeVisible();
    await expect(page.getByText(/Type 9.*Smoke control/i).first()).toBeVisible();
  });

  test('Scenario 4: No systems installed (danger state)', async ({ page }) => {
    await page.goto('/');

    await page.check('#confirmedNoComplexFeatures');
    await page.fill('#projectName', 'Test Project');
    await page.fill('#clientName', 'Test Client');
    await page.fill('#clientAddress', 'Test Address');

    await page.selectOption('select[name="firecells[0][riskGroup]"]', 'WB');
    await page.selectOption('select[name="firecells[0][occupantType]"]', 'Office spaces');

    await page.fill('input[name="firecells[0][floorArea]"]', '800');
    await page.fill('input[name="firecells[0][escapeHeight]"]', '3');
    await page.selectOption('select[name="firecells[0][isSprinklered]"]', 'false');
    await page.selectOption('select[name="firecells[0][floor]"]', 'G');
    await page.fill('input[name="firecells[0][numberOfEscapeRoutes]"]', '2');
    await page.fill('input[name="firecells[0][maxEscapeRouteOccupants]"]', '40');

    // Select "No systems installed" using chip-based selector
    await page.selectOption('.firecell-item[data-index="0"] .installed-systems-select', 'none');
    await page.waitForSelector('.firecell-item[data-index="0"] .fire-safety-chips-container div[data-value="none"]');

    await page.click('button[type="submit"]');

    // Wait for results page to load
    await page.waitForURL(/\/results\/\d+/);
    await expect(page.locator('h2').first()).toContainText('Fire Safety Compliance Report');

    // Verify danger state
    await expect(page.getByText('✗ NO SYSTEMS INSTALLED').first()).toBeVisible();
    await expect(page.getByText(/All required fire safety systems are missing/i).first()).toBeVisible();
  });

  test('Scenario 5: SI Care/Detention with NZS 4515', async ({ page }) => {
    await page.goto('/');

    await page.check('#confirmedNoComplexFeatures');
    await page.fill('#projectName', 'Test Project');
    await page.fill('#clientName', 'Test Client');
    await page.fill('#clientAddress', 'Test Address');

    await page.selectOption('select[name="firecells[0][riskGroup]"]', 'SI');
    await page.selectOption('select[name="firecells[0][sleepingOccupantType]"]', 'careOrDetention');

    // Verify NZS 4515 option appears for SI
    await expect(page.locator('.nzs-4515-option')).toBeVisible();

    await page.fill('input[name="firecells[0][floorArea]"]', '1800');
    await page.fill('input[name="firecells[0][escapeHeight]"]', '8');
    await page.selectOption('select[name="firecells[0][isSprinklered]"]', 'true');
    await page.selectOption('select[name="firecells[0][floor]"]', 'G');
    await page.fill('input[name="firecells[0][occupantLoad]"]', '50');
    await page.fill('input[name="firecells[0][numberOfEscapeRoutes]"]', '2');
    await page.fill('input[name="firecells[0][maxEscapeRouteBeds]"]', '25');

    await page.selectOption('select[name="isWithinNZS4515Scope"]', 'true');
    await page.check('input[name="firecells[0][usesNZS4515Sprinklers]"]');

    // SI typically requires Type 15 (fire service lift) in addition - use chip-based selector
    await page.selectOption('.firecell-item[data-index="0"] .installed-systems-select', 'NZS-4515');
    await page.waitForSelector('.firecell-item[data-index="0"] .fire-safety-chips-container div[data-value="NZS-4515"]');
    await page.selectOption('.firecell-item[data-index="0"] .installed-systems-select', '9');
    await page.waitForSelector('.firecell-item[data-index="0"] .fire-safety-chips-container div[data-value="9"]');
    await page.selectOption('.firecell-item[data-index="0"] .installed-systems-select', '15');
    await page.waitForSelector('.firecell-item[data-index="0"] .fire-safety-chips-container div[data-value="15"]');
    await page.selectOption('.firecell-item[data-index="0"] .installed-systems-select', '18');
    await page.waitForSelector('.firecell-item[data-index="0"] .fire-safety-chips-container div[data-value="18"]');

    await page.click('button[type="submit"]');

    // Wait for results page to load
    await page.waitForURL(/\/results\/\d+/);
    await expect(page.locator('h2').first()).toContainText('Fire Safety Compliance Report');

    // Verify NZS 4515 section displays for SI
    await expect(page.getByText('NZS 4515 Sprinkler Substitution').first()).toBeVisible();
    await expect(page.getByText('1800m²').first()).toBeVisible();
    await expect(page.getByText('NZS 4515 SUBSTITUTION APPLIED').first()).toBeVisible();

    // Verify compliant
    await expect(page.getByText('✓ COMPLIANT').first()).toBeVisible();
  });

  test('Scenario 6: Multi-firecell total area calculation', async ({ page }) => {
    await page.goto('/');

    await page.check('#confirmedNoComplexFeatures');
    await page.fill('#projectName', 'Test Project');
    await page.fill('#clientName', 'Test Client');
    await page.fill('#clientAddress', 'Test Address');

    // Set number of floors for multi-firecell building
    await page.fill('#numberOfFloorsAboveGround', '2');

    // Firecell 1: SM Education
    await page.selectOption('select[name="firecells[0][riskGroup]"]', 'SM');
    await page.selectOption('select[name="firecells[0][sleepingOccupantType]"]', 'education');
    await page.fill('input[name="firecells[0][floorArea]"]', '800');
    await page.fill('input[name="firecells[0][escapeHeight]"]', '10');
    await page.selectOption('select[name="firecells[0][isSprinklered]"]', 'true');
    await page.selectOption('select[name="firecells[0][floor]"]', 'G');
    await page.fill('input[name="firecells[0][occupantLoad]"]', '30');
    await page.fill('input[name="firecells[0][numberOfEscapeRoutes]"]', '2');
    await page.fill('input[name="firecells[0][maxEscapeRouteBeds]"]', '15');
    await page.selectOption('select[name="isWithinNZS4515Scope"]', 'true');
    await page.check('input[name="firecells[0][usesNZS4515Sprinklers]"]');

    // Add fire safety systems using chip-based selector (firecell 1)
    await page.selectOption('.firecell-item[data-index="0"] .installed-systems-select', 'NZS-4515');
    await page.waitForSelector('.firecell-item[data-index="0"] .fire-safety-chips-container div[data-value="NZS-4515"]');
    await page.selectOption('.firecell-item[data-index="0"] .installed-systems-select', '9');
    await page.waitForSelector('.firecell-item[data-index="0"] .fire-safety-chips-container div[data-value="9"]');
    await page.selectOption('.firecell-item[data-index="0"] .installed-systems-select', '18');
    await page.waitForSelector('.firecell-item[data-index="0"] .fire-safety-chips-container div[data-value="18"]');

    // Add Firecell 2
    await page.click('#addFirecell');
    // Wait for firecell 2 elements to be ready
    await page.waitForSelector('select[name="firecells[1][riskGroup]"]', { state: 'visible' });

    await page.selectOption('select[name="firecells[1][riskGroup]"]', 'CA');
    await page.selectOption('select[name="firecells[1][occupantType]"]', 'Classrooms');
    await page.fill('input[name="firecells[1][floorArea]"]', '600');
    await page.fill('input[name="firecells[1][escapeHeight]"]', '5');
    await page.selectOption('select[name="firecells[1][isSprinklered]"]', 'false');
    await page.selectOption('select[name="firecells[1][floor]"]', '1');
    await page.fill('input[name="firecells[1][numberOfEscapeRoutes]"]', '2');
    await page.fill('input[name="firecells[1][maxEscapeRouteOccupants]"]', '150');

    // Add fire safety systems using chip-based selector (firecell 2)
    await page.selectOption('.firecell-item[data-index="1"] .installed-systems-select', '4');
    await page.waitForSelector('.firecell-item[data-index="1"] .fire-safety-chips-container div[data-value="4"]');
    await page.selectOption('.firecell-item[data-index="1"] .installed-systems-select', '9');
    await page.waitForSelector('.firecell-item[data-index="1"] .fire-safety-chips-container div[data-value="9"]');
    await page.selectOption('.firecell-item[data-index="1"] .installed-systems-select', '18');
    await page.waitForSelector('.firecell-item[data-index="1"] .fire-safety-chips-container div[data-value="18"]');

    // Add Firecell 3
    await page.click('#addFirecell');
    // Wait for firecell 3 elements to be ready
    await page.waitForSelector('select[name="firecells[2][riskGroup]"]', { state: 'visible' });

    await page.selectOption('select[name="firecells[2][riskGroup]"]', 'WB');
    await page.selectOption('select[name="firecells[2][occupantType]"]', 'Office spaces');
    await page.fill('input[name="firecells[2][floorArea]"]', '400');
    await page.fill('input[name="firecells[2][escapeHeight]"]', '3');
    await page.selectOption('select[name="firecells[2][isSprinklered]"]', 'false');
    await page.selectOption('select[name="firecells[2][floor]"]', '2');
    await page.fill('input[name="firecells[2][numberOfEscapeRoutes]"]', '2');
    await page.fill('input[name="firecells[2][maxEscapeRouteOccupants]"]', '40');

    // Add fire safety systems using chip-based selector (firecell 3)
    await page.selectOption('.firecell-item[data-index="2"] .installed-systems-select', '2');
    await page.waitForSelector('.firecell-item[data-index="2"] .fire-safety-chips-container div[data-value="2"]');
    await page.selectOption('.firecell-item[data-index="2"] .installed-systems-select', '18');
    await page.waitForSelector('.firecell-item[data-index="2"] .fire-safety-chips-container div[data-value="18"]');

    await page.click('button[type="submit"]');

    // Wait for results page to load
    await page.waitForURL(/\/results\/\d+/);
    await expect(page.locator('h2').first()).toContainText('Fire Safety Compliance Report');

    // Verify total area calculation (800 + 600 + 400 = 1800m²)
    await expect(page.getByText('1800m²').first()).toBeVisible();
    await expect(page.getByText(/within NZS 4515 scope/i).first()).toBeVisible();
    await expect(page.getByText('NZS 4515 SUBSTITUTION APPLIED').first()).toBeVisible();

    // Verify all 3 firecells show validation (appears in both report paragraphs and debug section)
    // Each firecell has validation in 2 places: report paragraph (h3) and debug section (h4)
    // 3 firecells × 2 locations = 6 total instances
    const validationSections = page.getByText('Fire Safety Systems Validation');
    await expect(validationSections).toHaveCount(6);
  });
});
