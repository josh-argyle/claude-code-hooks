const { generateComplianceParagraphs } = require('../../../../api/processors/standard/introduction-generator');
const ProjectModel = require('../../../../api/models/project-model');

describe('Introduction Generator', () => {
  test('should return array of paragraphs', () => {
    const projectModel = new ProjectModel();
    projectModel.projectName = 'Test Building Project';

    const result = generateComplianceParagraphs(projectModel);

    expect(Array.isArray(result)).toBe(true);
    expect(result.length).toBeGreaterThan(0);
  });

  test('should include introduction title', () => {
    const projectModel = new ProjectModel();
    projectModel.projectName = 'Test Building Project';

    const result = generateComplianceParagraphs(projectModel);

    const intro = result.find(p => p.title && p.title.includes('Introduction'));
    expect(intro).toBeDefined();
  });

  test('should include project name in content', () => {
    const projectModel = new ProjectModel();
    projectModel.projectName = 'Test Building Project';

    const result = generateComplianceParagraphs(projectModel);

    const hasProjectName = result.some(p =>
      (typeof p.content === 'string' && p.content.includes('Test Building Project'))
    );
    expect(hasProjectName).toBe(true);
  });

  test('should include C/AS2 references', () => {
    const projectModel = new ProjectModel();
    projectModel.projectName = 'Test Building Project';

    const result = generateComplianceParagraphs(projectModel);

    const hasCAS2Reference = result.some(p =>
      (typeof p.content === 'string' && p.content.includes('C/AS2'))
    );
    expect(hasCAS2Reference).toBe(true);
  });

  test('should include New Zealand Building Code reference', () => {
    const projectModel = new ProjectModel();
    projectModel.projectName = 'Test Building Project';

    const result = generateComplianceParagraphs(projectModel);

    const hasNZBC = result.some(p =>
      (typeof p.content === 'string' && p.content.includes('New Zealand Building Code'))
    );
    expect(hasNZBC).toBe(true);
  });

  test('should handle missing project name gracefully', () => {
    const projectModel = new ProjectModel();
    // projectName not set

    const result = generateComplianceParagraphs(projectModel);

    expect(Array.isArray(result)).toBe(true);
    expect(result.length).toBeGreaterThan(0);
  });

  test('all paragraphs should have required structure', () => {
    const projectModel = new ProjectModel();
    projectModel.projectName = 'Test Building Project';

    const result = generateComplianceParagraphs(projectModel);

    result.forEach(paragraph => {
      expect(paragraph).toHaveProperty('title');
      expect(paragraph).toHaveProperty('type');
      expect(paragraph).toHaveProperty('content');
      expect(paragraph).toHaveProperty('timestamp');
    });
  });
});