const { generateComplianceParagraphs } = require('../../../../api/processors/occupant-load/compliance-generator');
const ProjectModel = require('../../../../api/models/project-model');

describe('Occupant Load Compliance Generator', () => {
  test('should return array of paragraphs', () => {
    const projectModel = new ProjectModel();
    projectModel.addFirecell({
      riskGroup: 'WB',
      occupantType: 'Office spaces',
      occupantLoad: 50,
      escapeHeight: 8,
      isSprinklered: false,
      floorArea: 500
    });

    const result = generateComplianceParagraphs(projectModel);

    expect(Array.isArray(result)).toBe(true);
    expect(result.length).toBeGreaterThan(0);
  });

  test('should include C/AS2 intro paragraph', () => {
    const projectModel = new ProjectModel();
    projectModel.addFirecell({
      riskGroup: 'WB',
      occupantType: 'Office spaces',
      occupantLoad: 50,
      escapeHeight: 8,
      isSprinklered: false,
      floorArea: 500
    });

    const result = generateComplianceParagraphs(projectModel);

    const intro = result.find(p => p.type === 'info');
    expect(intro).toBeDefined();
    expect(intro.content).toContain('C/AS2');
    expect(intro.content).toContain('occupant');
  });

  test('should create table with firecell occupant loads', () => {
    const projectModel = new ProjectModel();
    projectModel.addFirecell({
      riskGroup: 'WB',
      occupantType: 'Office spaces',
      occupantLoad: 50,
      escapeHeight: 8,
      isSprinklered: false,
      floorArea: 500
    });
    projectModel.addFirecell({
      riskGroup: 'CA',
      occupantType: 'Mall areas used for assembly uses',
      occupantLoad: 100,
      escapeHeight: 5,
      isSprinklered: true,
      floorArea: 300
    });

    const result = generateComplianceParagraphs(projectModel);

    const table = result.find(p => p.type === 'table');
    expect(table).toBeDefined();
    expect(table.content.headers).toContain('Firecell');
    expect(table.content.headers).toContain('Occupant Load');
    expect(table.content.rows.length).toBe(2);
  });

  test('should include total occupant load summary', () => {
    const projectModel = new ProjectModel();
    projectModel.addFirecell({
      riskGroup: 'WB',
      occupantType: 'Office spaces',
      occupantLoad: 50,
      escapeHeight: 8,
      isSprinklered: false,
      floorArea: 500
    });
    projectModel.addFirecell({
      riskGroup: 'CA',
      occupantType: 'Mall areas used for assembly uses',
      occupantLoad: 100,
      escapeHeight: 5,
      isSprinklered: true,
      floorArea: 300
    });

    const result = generateComplianceParagraphs(projectModel);

    const summary = result.find(p => p.type === 'compliance');
    expect(summary).toBeDefined();
    expect(summary.content.content).toContain('150');
    expect(summary.content.content).toContain('total occupant load');
  });

  test('should handle empty firecells array', () => {
    const projectModel = new ProjectModel();

    const result = generateComplianceParagraphs(projectModel);

    expect(Array.isArray(result)).toBe(true);
    // Should still have intro paragraph
    expect(result.length).toBeGreaterThan(0);
  });

  test('all paragraphs should have required structure', () => {
    const projectModel = new ProjectModel();
    projectModel.addFirecell({
      riskGroup: 'WB',
      occupantType: 'Office spaces',
      occupantLoad: 50,
      escapeHeight: 8,
      isSprinklered: false,
      floorArea: 500
    });

    const result = generateComplianceParagraphs(projectModel);

    result.forEach(paragraph => {
      expect(paragraph).toHaveProperty('title');
      expect(paragraph).toHaveProperty('type');
      expect(paragraph).toHaveProperty('content');
      expect(paragraph).toHaveProperty('timestamp');
    });
  });

  test('table should include risk group, occupant type and floor area', () => {
    const projectModel = new ProjectModel();
    projectModel.addFirecell({
      riskGroup: 'WB',
      occupantType: 'Office spaces',
      occupantLoad: 50,
      escapeHeight: 8,
      isSprinklered: false,
      floorArea: 500
    });

    const result = generateComplianceParagraphs(projectModel);

    const table = result.find(p => p.type === 'table');
    expect(table.content.headers).toContain('Risk Group');
    expect(table.content.headers).toContain('Occupant Type');
    expect(table.content.headers).toContain('Floor Area (m²)');
    expect(table.content.rows[0]).toContain('WB');
    expect(table.content.rows[0]).toContain('Office spaces');
    expect(table.content.rows[0]).toContain('500');
  });
});