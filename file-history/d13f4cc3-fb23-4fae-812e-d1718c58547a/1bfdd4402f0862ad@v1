const {
  createTableParagraph,
  createRequirementsParagraph,
} = require('../../utilities/paragraph-builder');

/**
 * Generate requirements paragraphs for fire resistance feature
 * @param {Object} reportProject - Report project model
 * @param {Object} calculations - Fire resistance calculations
 * @returns {Array} Array of paragraph objects
 */
function generateRequirementsParagraphs(reportProject, calculations) {
  const paragraphs = [];

  // 1. Requirements table
  const headers = ['Building Element', 'Required Life Safety Rating', 'Required Property Rating'];
  const rows = [
    ['Structural Elements', `${calculations.life} minutes`, `${calculations.property} minutes`]
  ];

  // Add exitway requirements if present
  if (calculations.exitwayFRR) {
    rows.push(['Exitways', `${calculations.exitwayFRR} minutes`, `${calculations.exitwayFRR} minutes`]);
  } else {
    rows.push(['Exitways', 'As per structural elements', 'As per structural elements']);
  }

  paragraphs.push(
    createTableParagraph('Fire Resistance Requirements', headers, rows)
  );

  // 2. Design requirements
  const riskGroup = reportProject.primaryRiskGroup || reportProject.buildingRiskGroup;

  paragraphs.push(
    createRequirementsParagraph(
      'Structural Fire Resistance',
      `All structural elements shall provide fire resistance ratings of not less than ${calculations.life} minutes for life safety and ${calculations.property} minutes for property protection in accordance with CAS2 Table 3.1 for risk group ${riskGroup}.`,
      'high'
    )
  );

  // 3. Implementation requirements
  paragraphs.push(
    createRequirementsParagraph(
      'Fire Rating Implementation',
      'Fire resistance ratings shall be achieved through appropriate construction methods and materials. All fire-rated assemblies shall be tested and certified in accordance with relevant New Zealand standards.',
      'standard'
    )
  );

  // 4. Add exitway specific requirements if applicable
  if (calculations.exitwayFRR && calculations.exitwayNote) {
    paragraphs.push(
      createRequirementsParagraph(
        'Exitway Fire Resistance',
        `Exitways shall provide enhanced fire resistance ratings of ${calculations.exitwayFRR} minutes due to escape height exceeding 10 metres. This applies to all load-bearing and fire-separating elements forming part of the exitway.`,
        'high'
      )
    );
  }

  // 5. Add special conditions if applicable
  if (calculations.applicableNotes && calculations.applicableNotes.length > 0) {
    const noteText = calculations.applicableNotes.includes('2')
      ? 'Special consideration shall be given to boundary distance and storage height requirements as per CAS2 Table 3.1 Note 2.'
      : 'Design shall comply with all applicable notes in CAS2 Table 3.1.';

    paragraphs.push(
      createRequirementsParagraph(
        'Special Requirements',
        noteText,
        'standard'
      )
    );
  }

  return paragraphs;
}

module.exports = { generateRequirementsParagraphs };