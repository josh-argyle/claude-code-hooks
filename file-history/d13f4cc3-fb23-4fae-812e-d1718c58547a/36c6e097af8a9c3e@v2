const {
  createInfoParagraph,
} = require('../../utilities/paragraph-builder');

/**
 * TEXT constants with professional introduction language
 * Adapted from reference documents for fire safety reports
 */
const TEXT = {
  SECTION_TITLE: "Introduction",

  purpose: (projectName) => {
    const name = projectName || 'the building';
    return `This report identifies and specifies the minimum fire safety measures necessary for ${name} to demonstrate full compliance with the New Zealand Building Codes specifically pertaining to fire safety, as required by the relevant sections of the Building Act (C/AS2).`;
  },

  performance_strategy: {
    content: "This Fire Engineering Assessment presents a performance-based strategy detailing the functional requirements for all fire safety systems in accordance with New Zealand Building Code standards (C/AS2). For complete understanding, this document must be reviewed together with the associated fire safety drawings."
  },

  consultant_coordination: {
    content: "This document serves as a performance-based guide rather than a direct \"For Construction\" specification (C/AS2). It is intended to inform the work of other project team members including Architectural, Structural, and Building Services consultants as they develop their designs, specifications and drawings. We expect that all relevant consultants have thoroughly reviewed this report, understood how the specified fire safety requirements impact their respective scopes of work, and appropriately integrated these fire safety provisions into their technical documentation."
  }
};

/**
 * Generate compliance paragraphs for introduction
 * @param {ProjectModel} projectModel - The complete project model
 * @returns {Array} Array of paragraph objects
 */
function generateComplianceParagraphs(projectModel) {
  const paragraphs = [];

  // Purpose
  paragraphs.push(
    createInfoParagraph(
      TEXT.SECTION_TITLE,
      TEXT.purpose(projectModel.projectName)
    )
  );

  // Performance Strategy
  paragraphs.push(
    createInfoParagraph(
      'Performance-Based Strategy',
      TEXT.performance_strategy.content
    )
  );

  // Consultant Coordination
  paragraphs.push(
    createInfoParagraph(
      'Consultant Coordination',
      TEXT.consultant_coordination.content
    )
  );

  return paragraphs;
}

module.exports = { generateComplianceParagraphs };