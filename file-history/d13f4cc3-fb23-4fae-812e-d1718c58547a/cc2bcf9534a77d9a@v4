const {
  createTextParagraph,
} = require('../../utilities/paragraph-builder');

/**
 * TEXT constants with professional disclaimer language
 * Adapted from reference documents for fire safety reports
 */
const TEXT = {
  SECTION_TITLE: "Disclaimer",

  client_authorization: {
    content: "This document and accompanying materials have been exclusively developed for the intended Client in accordance with their specified requirements (C/AS2). SpeciFire does not authorize the use of this report by any third party without our explicit written permission. We expressly disclaim all responsibility and liability to any person or entity other than our contracted Client who may access or rely on this document. This report represents the professional opinion of SpeciFire as an organization, and individual authors bear no personal liability for its contents or application."
  },

  property_protection: {
    content: "The New Zealand Building Code primarily focuses on life safety rather than property preservation (C/AS2). This design addresses property protection only to the extent required for Building Code compliance, unless additional safeguards were explicitly requested by the client. Without supplementary protective measures beyond code requirements, significant property damage remains possible in the event of a fire. Building owners should understand that regulatory compliance alone may not prevent substantial financial loss."
  },

  understanding: {
    content: "It is expected that all recipients have thoroughly reviewed and understood the contents of these documents (C/AS2). If you have any questions about interpretation or meaning of any part of this documentation, please contact SpeciFire directly. SpeciFire cannot accept responsibility for misinterpretation by others. Submission of this Fire Engineering Strategy document for Building Consent Authority approval indicates complete understanding and acceptance of all conditions stated above."
  }
};

/**
 * Generate compliance paragraphs for disclaimer
 * @param {ProjectModel} projectModel - The complete project model
 * @returns {Array} Array of paragraph objects
 */
function generateComplianceParagraphs(projectModel) {
  const paragraphs = [];

  // First paragraph with section title
  paragraphs.push(
    createTextParagraph(
      TEXT.SECTION_TITLE,
      TEXT.client_authorization.content
    )
  );

  // Additional body paragraphs without titles
  paragraphs.push(
    createTextParagraph(
      '',
      TEXT.property_protection.content
    )
  );

  paragraphs.push(
    createTextParagraph(
      '',
      TEXT.understanding.content
    )
  );

  return paragraphs;
}

module.exports = { generateComplianceParagraphs };