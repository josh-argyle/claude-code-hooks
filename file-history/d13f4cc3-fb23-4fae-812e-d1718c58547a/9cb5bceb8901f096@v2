const { generateComplianceParagraphs } = require('../../../../api/processors/hazardous-substances/compliance-generator');
const ProjectModel = require('../../../../api/models/project-model');

describe('Hazardous Substances Compliance Generator', () => {
  test('should return array of paragraphs', () => {
    const projectModel = new ProjectModel();
    projectModel.storesHazardousGoods = false;

    const result = generateComplianceParagraphs(projectModel);

    expect(Array.isArray(result)).toBe(true);
  });

  test('should include C/AS2 regulatory notice', () => {
    const projectModel = new ProjectModel();
    projectModel.storesHazardousGoods = false;

    const result = generateComplianceParagraphs(projectModel);

    const notice = result.find(p => p.type === 'info');
    expect(notice).toBeDefined();
    expect(notice.content).toContain('C/AS2');
    expect(notice.content).toContain('NZBC Clause F3');
  });

  test('should include acknowledgment when stores hazardous goods', () => {
    const projectModel = new ProjectModel();
    projectModel.storesHazardousGoods = true;

    const result = generateComplianceParagraphs(projectModel);

    const info = result.find(p => p.type === 'info');
    expect(info).toBeDefined();
    expect(info.content).toContain('store, use or process hazardous substances');
    expect(info.content).toContain('client acknowledges');
  });

  test('should include acknowledgment when does not store hazardous goods', () => {
    const projectModel = new ProjectModel();
    projectModel.storesHazardousGoods = false;

    const result = generateComplianceParagraphs(projectModel);

    const info = result.find(p => p.type === 'info');
    expect(info).toBeDefined();
    expect(info.content).toContain('will not be used to store, use or process hazardous substances');
    expect(info.content).toContain('client acknowledges');
  });

  test('should handle undefined storesHazardousGoods', () => {
    const projectModel = new ProjectModel();

    const result = generateComplianceParagraphs(projectModel);

    // Should only include regulatory notice without acknowledgment
    expect(result.length).toBe(1);
    const notice = result.find(p => p.type === 'info');
    expect(notice).toBeDefined();
    expect(notice.content).toContain('C/AS2');
    expect(notice.content).not.toContain('client acknowledges');
  });

  test('should include professional fire safety language', () => {
    const projectModel = new ProjectModel();
    projectModel.storesHazardousGoods = false;

    const result = generateComplianceParagraphs(projectModel);

    const notice = result.find(p => p.type === 'info');
    expect(notice.content).toContain('Hazardous Substances and New Organisms Act 1996');
    expect(notice.content).toContain('Health and Safety at Work');
  });

  test('all paragraphs should have required structure', () => {
    const projectModel = new ProjectModel();
    projectModel.storesHazardousGoods = true;

    const result = generateComplianceParagraphs(projectModel);

    result.forEach(paragraph => {
      expect(paragraph).toHaveProperty('title');
      expect(paragraph).toHaveProperty('type');
      expect(paragraph).toHaveProperty('content');
      expect(paragraph).toHaveProperty('timestamp');
    });
  });
});