**Compliance Generator Implementation**:
```javascript
function generateComplianceParagraphs(projectModel) {
    const paragraphs = [];

    // Introduction
    paragraphs.push(
        createInfoParagraph(
            TEXT.SECTION_TITLE,
            TEXT.intro.content
        )
    );

    // Table of required systems per firecell
    if (projectModel.firecells && projectModel.firecells.length > 0) {
        const headers = ['Firecell', 'Risk Group', 'Required Systems', 'System Descriptions'];
        const rows = [];

        projectModel.firecells.forEach((firecell, index) => {
            const systems = firecell.fireSafetySystems || [];
            const descriptions = firecell.processedFireSafetySystems
                ? firecell.processedFireSafetySystems.map(s => s.description || s.code).join(', ')
                : systems.join(', ');

            rows.push([
                `Firecell ${index + 1}`,
                firecell.riskGroup,
                systems.join(', '),
                descriptions
            ]);
        });

        paragraphs.push(
            createTableParagraph(
                'Required Fire Safety Systems (C/AS2 Table 2.2)',
                headers,
                rows
            )
        );
    }

    // Remote receiving centre
    if (projectModel.remoteReceivingCentreCompliance) {
        const compliance = projectModel.remoteReceivingCentreCompliance;
        const statusText = compliance.required
            ? TEXT.remote_receiving_centre.required
            : TEXT.remote_receiving_centre.not_required(projectModel.escapeHeight || 0);

        paragraphs.push(
            createComplianceParagraph(
                'Remote Receiving Centre',
                statusText,
                compliance.status
            )
        );
    }

    return paragraphs;
}
```

#### 2.3 Occupant Load Generators

**Files**:
- `api/processors/occupant-load/compliance-generator.js`
- `api/processors/occupant-load/requirements-generator.js`

**TEXT Content**:
```javascript
const TEXT = {
    SECTION_TITLE: "Occupant Load Assessment",

    intro: {
        content: "Occupant loads have been calculated in accordance with C/AS2 requirements using the occupant density factors specified for each space type."
    },

    summary: (totalLoad) => `The total occupant load for the planned building is ${totalLoad} people.`,

    table_title: "Calculated Occupant Loads by Firecell"
};
```

**Compliance Generator Implementation**:
```javascript
function generateComplianceParagraphs(projectModel) {
    const paragraphs = [];

    paragraphs.push(
        createInfoParagraph(
            TEXT.SECTION_TITLE,
            TEXT.intro.content
        )
    );

    // Table of occupant loads per firecell
    if (projectModel.firecells && projectModel.firecells.length > 0) {
        const headers = ['Firecell', 'Occupant Type', 'Floor Area (m²)', 'Occupant Load'];
        const rows = [];
        let totalLoad = 0;

        projectModel.firecells.forEach((firecell, index) => {
            const load = firecell.occupantLoad || 0;
            totalLoad += load;

            rows.push([
                `Firecell ${index + 1}`,
                firecell.occupantType || 'Not specified',
                (firecell.floorArea || 0).toString(),
                load.toString()
            ]);
        });

        paragraphs.push(
            createTableParagraph(
                TEXT.table_title,
                headers,
                rows
            )
        );

        // Summary
        paragraphs.push(
            createComplianceParagraph(
                'Total Occupant Load',
                TEXT.summary(totalLoad),
                'info'
            )
        );
    }

    return paragraphs;
}
```

#### 2.4 Firecells Generators

**Files**:
- `api/processors/firecells/compliance-generator.js`
- `api/processors/firecells/requirements-generator.js`

**TEXT Content**:
```javascript
const TEXT = {
    SECTION_TITLE: "Firecell Configuration and Compliance",

    intro: {
        content: "The building is divided into firecells as specified in C/AS2. Each firecell has been assessed for floor area limitations and compliance with relevant requirements."
    },

    table_title: "Firecell Summary",

    floor_area_compliance: {
        compliant: (limit) => `Firecell floor area is within the ${limit}m² limit specified in C/AS2 Table 2.1.`,
        non_compliant: (actual, limit) => `Firecell floor area of ${actual}m² exceeds the ${limit}m² limit specified in C/AS2 Table 2.1.`
    }
};
```

**Compliance Generator Implementation**:
```javascript
function generateComplianceParagraphs(projectModel) {
    const paragraphs = [];

    paragraphs.push(
        createInfoParagraph(
            TEXT.SECTION_TITLE,
            TEXT.intro.content
        )
    );

    // Table of firecells
    if (projectModel.firecells && projectModel.firecells.length > 0) {
        const headers = ['Firecell', 'Risk Group', 'Sprinklered', 'Floor Area (m²)', 'Floor Area Compliance'];
        const rows = [];

        projectModel.firecells.forEach((firecell, index) => {
            const floorAreaLimit = firecell.compliance?.firecellFloorArea?.limit || 'N/A';
            const compliant = firecell.compliance?.firecellFloorArea?.compliant;
            const complianceStatus = compliant ? '✓ Compliant' : '✗ Non-compliant';

            rows.push([
                `Firecell ${index + 1}`,
                firecell.riskGroup,
                firecell.isSprinklered ? 'Yes' : 'No',
                (firecell.floorArea || 0).toString(),
                complianceStatus
            ]);

            // Add individual compliance paragraph for each firecell with issues
            if (compliant === false) {
                paragraphs.push(
                    createWarningParagraph(
                        `Firecell ${index + 1} Floor Area`,
                        TEXT.floor_area_compliance.non_compliant(firecell.floorArea, floorAreaLimit)
                    )
                );
            }
        });

        paragraphs.push(
            createTableParagraph(
                TEXT.table_title,
                headers,
                rows
            )
        );
    }

    return paragraphs;
}
```

