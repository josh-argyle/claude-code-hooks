const { expect } = require('@playwright/test');

class AdminUsersPage {
  constructor(page) {
    this.page = page;

    // Page header elements
    this.pageTitle = page.locator('h1.page-title');
    this.addUserButton = page.locator('#add-user-btn');
    this.backToAdminButton = page.locator('a.btn.btn-secondary[href="/admin"]');

    // Users sidebar elements
    this.usersSearch = page.locator('#users-search');
    this.usersList = page.locator('#users-list');
    this.usersLoading = page.locator('.users-loading');
    this.userItems = page.locator('.user-item');

    // User details panel
    this.userPlaceholder = page.locator('#user-placeholder');
    this.userDetails = page.locator('#user-details');
    this.userForm = page.locator('#user-form');

    // User form fields
    this.usernameInput = page.locator('#user-username');
    this.activeCheckbox = page.locator('#user-active');
    this.defaultProfitCentreSelect = page.locator('#user-default-profit-centre');
    this.firstNameInput = page.locator('#user-first-name');
    this.surnameInput = page.locator('#user-surname');
    this.emailInput = page.locator('#user-email');
    this.phoneInput = page.locator('#user-phone');
    this.positionInput = page.locator('#user-position');
    this.workbenchIdInput = page.locator('#user-workbench-id');
    this.newPasswordInput = page.locator('#user-new-password');
    this.changePasswordButton = page.locator('#change-password-btn');

    // Roles container
    this.rolesContainer = page.locator('#roles-container');
    this.roleRadioButtons = page.locator('#roles-container input[type="radio"]');

    // Add User Modal elements
    this.addUserModal = page.locator('#add-user-modal');
    this.addUserForm = page.locator('#add-user-modal-form');
    this.addUsernameInput = page.locator('#add-username');
    this.addActiveCheckbox = page.locator('#add-active');
    this.addDefaultProfitCentreSelect = page.locator('#add-default-profit-centre');
    this.addFirstNameInput = page.locator('#add-first-name');
    this.addSurnameInput = page.locator('#add-surname');
    this.addEmailInput = page.locator('#add-email');
    this.addPhoneInput = page.locator('#add-phone');
    this.addPositionInput = page.locator('#add-position');
    this.addWorkbenchIdInput = page.locator('#add-workbench-id');
    this.addPasswordInput = page.locator('#add-password');
    this.addRolesContainer = page.locator('#add-roles-container');
    this.addRoleRadioButtons = page.locator('#add-roles-container input[type="radio"]');
    this.addModalSubmitButton = page.locator('#add-user-modal .modal-submit');
    this.addModalCancelButton = page.locator('#add-user-modal .modal-cancel');
    this.addModalCloseButton = page.locator('#add-user-modal .modal-close');

    // Notification elements
    this.notification = page.locator('.notification');
    this.saveStatus = page.locator('.save-status');
  }

  // Navigation methods
  async navigate() {
    await this.page.goto('/admin/users');
  }

  async waitForPageLoad() {
    await this.page.waitForLoadState('networkidle');
    await expect(this.pageTitle).toBeVisible();
    await expect(this.pageTitle).toHaveText('User Management');

    // Wait for users to load
    try {
      await this.usersLoading.waitFor({ state: 'hidden', timeout: 10000 });
    } catch {
      // Users might load so fast that loading never appears
    }

    await expect(this.usersList).toBeVisible();
    await this.page.waitForTimeout(1000); // Allow for initial data loading
  }

  // Permission checking methods
  async isAccessDenied() {
    try {
      const errorMessage = this.page.locator('text=Access denied');
      await errorMessage.waitFor({ state: 'visible', timeout: 5000 });
      return true;
    } catch {
      return false;
    }
  }

  async isOnLoginPage() {
    return this.page.url().includes('/login');
  }

  // User search and selection methods
  async searchUsers(searchTerm) {
    await this.usersSearch.fill(searchTerm);
    await this.page.waitForTimeout(500); // Debounce
  }

  async getVisibleUserCount() {
    const userItems = await this.userItems.all();
    return userItems.length;
  }

  async selectUserByUsername(username) {
    // SAFETY CHECK: Prevent selecting critical system users
    const protectedUsers = ['admin', 'root', 'system', 'administrator'];
    if (protectedUsers.some(protectedUser => username.toLowerCase().includes(protectedUser))) {
      throw new Error(`SAFETY: Cannot select protected user "${username}" for testing. Tests should only modify temporary test users.`);
    }

    const userItem = this.page.locator(`.user-item:has-text("${username}")`);
    await userItem.click();

    // Wait for user details to load
    await expect(this.userPlaceholder).toBeHidden();
    await expect(this.userDetails).toBeVisible();
    await this.page.waitForTimeout(1000); // Allow for data loading
  }

  async selectUserByIndex(index) {
    // WARNING: This method should ONLY be used for read-only operations
    // NEVER use this for tests that modify user data
    // Always create temporary test users for modification tests
    console.warn('WARNING: selectUserByIndex should only be used for read-only operations. Use temporary test users for modifications.');

    const userItem = this.userItems.nth(index);
    await userItem.click();

    // Wait for user details to load
    await expect(this.userPlaceholder).toBeHidden();
    await expect(this.userDetails).toBeVisible();
    await this.page.waitForTimeout(1000); // Allow for data loading
  }

  async getSelectedUsername() {
    return await this.usernameInput.inputValue();
  }

  // User details editing methods
  async updateFirstName(firstName) {
    await this.firstNameInput.fill(firstName);
    await this.firstNameInput.blur();
    await this.waitForAutoSave();
  }

  async updateSurname(surname) {
    await this.surnameInput.fill(surname);
    await this.surnameInput.blur();
    await this.waitForAutoSave();
  }

  async updateEmail(email) {
    await this.emailInput.fill(email);
    await this.emailInput.blur();
    await this.waitForAutoSave();
  }

  async updatePhone(phone) {
    await this.phoneInput.fill(phone);
    await this.phoneInput.blur();
    await this.waitForAutoSave();
  }

  async updatePosition(position) {
    await this.positionInput.fill(position);
    await this.positionInput.blur();
    await this.waitForAutoSave();
  }

  async updateActiveStatus(isActive) {
    if (isActive) {
      await this.activeCheckbox.check();
    } else {
      await this.activeCheckbox.uncheck();
    }
    await this.waitForAutoSave();
  }

  async updateRole(roleName) {
    const roleRadio = this.page.locator(`#roles-container input[type="radio"] + span:has-text("${roleName}") + input`);
    await roleRadio.check();
    await this.waitForAutoSave();
  }

  async updateWorkbenchId(workbenchId) {
    await this.workbenchIdInput.fill(workbenchId);
    await this.workbenchIdInput.blur();
    await this.waitForAutoSave();
  }

  // Password change methods
  async changePassword(newPassword) {
    await this.newPasswordInput.fill(newPassword);
    await this.changePasswordButton.click();
  }

  // Auto-save handling
  async waitForAutoSave() {
    // Wait for save debounce (1 second) plus small buffer
    await this.page.waitForTimeout(1500);

    // Check for save status indicators
    try {
      await this.page.waitForSelector('.save-status.saved', { timeout: 3000 });
      // Wait a bit for it to clear
      await this.page.waitForTimeout(500);
    } catch {
      // If no save status indicator, just wait for network to settle
      try {
        await this.page.waitForLoadState('networkidle', { timeout: 3000 });
      } catch {
        // If network idle fails, just wait a bit more
        await this.page.waitForTimeout(1000);
      }
    }
  }

  // Add user modal methods
  async openAddUserModal() {
    await this.addUserButton.click();
    await expect(this.addUserModal).toBeVisible({ timeout: 10000 });

    // The modal now has a two-step process. First it shows selection options,
    // then we need to click "Create Account Manually" to see the form
    await this.page.waitForTimeout(500); // Wait for modal animation

    // Click "Create Account Manually" button to proceed to the actual form
    const createManuallyBtn = this.page.locator('#create-manually-btn');
    await expect(createManuallyBtn).toBeVisible({ timeout: 10000 });
    await createManuallyBtn.click();

    // Now the form content should be visible
    const formContent = this.page.locator('#add-user-form-content');
    await expect(formContent).toBeVisible({ timeout: 10000 });

    // For E2E tests, manually populate the roles if they're not loaded
    await this.page.evaluate(() => {
      // Check if roles are loaded
      if (!window.allRoles || window.allRoles.length === 0) {
        console.log('Roles not loaded, manually setting test roles...');
        // Set test roles for E2E tests
        window.allRoles = [
          { role_id: '1', role_name: 'admin', role_description: 'Admin' },
          { role_id: '2', role_name: 'user', role_description: 'User' },
          { role_id: '3', role_name: 'project_manager', role_description: 'Project Manager' },
          { role_id: '4', role_name: 'foreman', role_description: 'Foreman' }
        ];

        // Trigger the modal population manually
        if (typeof populateAddUserRoles === 'function') {
          populateAddUserRoles();
        }
      }
    });

    // Wait for the username input to be visible and populated
    await expect(this.addUsernameInput).toBeVisible({ timeout: 10000 });

    await this.page.waitForTimeout(500); // Wait for roles to populate
  }

  async fillAddUserForm(userData) {
    if (userData.username) {
      await this.addUsernameInput.fill(userData.username);
    }

    if (userData.password) {
      await this.addPasswordInput.fill(userData.password);
    }

    if (userData.defaultProfitCentre) {
      // Wait for the dropdown to be fully loaded and visible
      await expect(this.addDefaultProfitCentreSelect).toBeVisible();
      await this.page.waitForTimeout(500); // Allow options to load

      // Handle string values directly - ensure we use the numeric code
      let value = userData.defaultProfitCentre.toString();

      // Map text values to numeric codes if needed
      const profitCentreMapping = {
        Dunedin: '1120',
        Christchurch: '1320',
        Queenstown: '2120',
        Taranaki: '3120',
        Auckland: '1120' // Default fallback
      };

      // If the value is a text name, convert it to the numeric code
      if (profitCentreMapping[value]) {
        value = profitCentreMapping[value];
      }

      await this.addDefaultProfitCentreSelect.selectOption({ value });
    }

    if (Object.hasOwn(userData, 'isActive')) {
      if (userData.isActive) {
        await this.addActiveCheckbox.check();
      } else {
        await this.addActiveCheckbox.uncheck();
      }
    }

    if (userData.firstName) {
      await this.addFirstNameInput.fill(userData.firstName);
    }

    if (userData.surname) {
      await this.addSurnameInput.fill(userData.surname);
    }

    if (userData.email) {
      await this.addEmailInput.fill(userData.email);
    }

    if (userData.phone) {
      await this.addPhoneInput.fill(userData.phone);
    }

    if (userData.position) {
      await this.addPositionInput.fill(userData.position);
    }

    if (userData.workbenchId) {
      await this.addWorkbenchIdInput.fill(userData.workbenchId);
    }

    if (userData.role) {
      try {
        // Find the radio button by looking for the label containing the role text
        const roleRadio = this.page.locator(`#add-roles-container label:has-text("${userData.role}") input[type="radio"]`);
        await expect(roleRadio).toBeVisible({ timeout: 5000 });
        await roleRadio.check();

        // Verify the role is selected
        await expect(roleRadio).toBeChecked();
      } catch (error) {
        console.warn(`Role "${userData.role}" not found or could not be selected:`, error.message);
        // Continue with form submission without role selection
      }
    }
  }

  async submitAddUserForm() {
    // Wait for any potential form validation to complete
    await this.page.waitForTimeout(1000);

    // Ensure the submit button is enabled and visible
    await expect(this.addModalSubmitButton).toBeEnabled();
    await expect(this.addModalSubmitButton).toBeVisible();

    // Click the submit button
    await this.addModalSubmitButton.click();
  }

  async cancelAddUserModal() {
    await this.addModalCancelButton.click();
  }

  async closeAddUserModal() {
    await this.addModalCloseButton.click();
  }

  // Data extraction methods
  async getUserFormData() {
    return {
      username: await this.usernameInput.inputValue(),
      isActive: await this.activeCheckbox.isChecked(),
      defaultProfitCentre: await this.defaultProfitCentreSelect.inputValue().catch(() => ''),
      firstName: await this.firstNameInput.inputValue(),
      surname: await this.surnameInput.inputValue(),
      email: await this.emailInput.inputValue(),
      phone: await this.phoneInput.inputValue(),
      position: await this.positionInput.inputValue(),
      workbenchId: await this.workbenchIdInput.inputValue()
    };
  }

  async getSelectedRole() {
    const selectedRadio = await this.page.locator('#roles-container input[type="radio"]:checked').first();
    if (await selectedRadio.count() > 0) {
      const roleLabel = await selectedRadio.locator('+ span').textContent();
      return roleLabel.trim();
    }
    return null;
  }

  async getUserByUsername(username) {
    const userItem = this.page.locator(`.user-item:has-text("${username}")`);
    if (await userItem.count() > 0) {
      const nameElement = userItem.locator('.user-item-name');
      const detailsElement = userItem.locator('.user-item-details');
      const statusElement = userItem.locator('.user-status');

      return {
        name: await nameElement.textContent(),
        username: await detailsElement.textContent(),
        status: await statusElement.textContent()
      };
    }
    return null;
  }

  async getAllVisibleUsers() {
    const users = [];
    const userItems = await this.userItems.all();

    for (const item of userItems) {
      const nameElement = item.locator('.user-item-name');
      const detailsElement = item.locator('.user-item-details');
      const statusElement = item.locator('.user-status');

      users.push({
        name: await nameElement.textContent(),
        username: await detailsElement.textContent(),
        status: await statusElement.textContent()
      });
    }

    return users;
  }

  // Notification and status methods
  async waitForNotification(expectedMessage = null, type = null) {
    await expect(this.notification).toBeVisible({ timeout: 10000 });

    if (expectedMessage) {
      const text = await this.notification.textContent();
      expect(text.toLowerCase()).toContain(expectedMessage.toLowerCase());
    }

    if (type) {
      await expect(this.notification).toHaveClass(new RegExp(type));
    }
  }

  async dismissNotification() {
    if (await this.notification.isVisible()) {
      await this.notification.click();
      await expect(this.notification).toBeHidden({ timeout: 5000 });
    }
  }

  // Utility methods for authentication tests
  async logout() {
    // Navigate to logout endpoint or clear session
    await this.page.goto('/api/auth/logout');
    await this.page.waitForLoadState('networkidle');
  }

  async loginAs(username, password) {
    await this.page.goto('/login');
    await this.page.fill('input[name="username"]', username);
    await this.page.fill('input[name="password"]', password);
    await this.page.click('button[type="submit"]');

    // Wait for redirect after login
    await this.page.waitForURL((url) => !url.pathname.includes('/login'), {
      timeout: 10000
    });
  }

  // Cleanup methods
  async deleteUserByUsername(username) {
    // This would require implementing user deletion functionality
    // For now, we'll assume users are marked as inactive rather than deleted
    await this.selectUserByUsername(username);
    await this.updateActiveStatus(false);
  }
}

module.exports = AdminUsersPage;
