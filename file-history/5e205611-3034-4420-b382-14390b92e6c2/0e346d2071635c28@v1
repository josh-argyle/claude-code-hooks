  async collapseAnalyticsPanel() {
    const isExpanded = await this.graphsPanel.evaluate(el => el.classList.contains('expanded'));
    if (isExpanded) {
      await this.graphsPanel.locator('.panel-header').click();
      await expect(this.graphsPanel).toHaveClass(/collapsed/);
    }
  }

  async expandDataEntryPanel() {
    const isCollapsed = await this.dataEntryPanel.evaluate(el => el.classList.contains('collapsed'));
    if (isCollapsed) {
      await this.dataEntryPanel.click();
      await expect(this.dataEntryPanel).toHaveClass(/expanded/, { timeout: 10000 });
      await this.page.waitForTimeout(500);
    }
  }

  async expandBreakdownPanel() {
    const isCollapsed = await this.breakdownPanel.evaluate(el => el.classList.contains('collapsed'));
    if (isCollapsed) {
      await this.breakdownPanel.click();
      await expect(this.breakdownPanel).toHaveClass(/expanded/, { timeout: 10000 });
      await this.page.waitForTimeout(500);
    }
  }

  async expandProjectsPanel() {
    const isCollapsed = await this.projectsPanel.evaluate(el => el.classList.contains('collapsed'));
    if (isCollapsed) {
      await this.projectsPanel.click();
      await expect(this.projectsPanel).toHaveClass(/expanded/, { timeout: 10000 });
      await this.page.waitForTimeout(500);
    }
