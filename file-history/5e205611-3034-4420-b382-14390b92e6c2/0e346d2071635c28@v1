  // Chart methods
  async waitForChartsToLoad() {
    // First ensure the Analytics panel is expanded
    await this.expandAnalyticsPanel();

    // Debug: Check what's happening with charts after expansion
    const debugInfo = await this.page.evaluate(() => {
      return {
        chartsObject: !!window.charts,
        chartKeys: window.charts ? Object.keys(window.charts) : [],
        chartsInitialized: window.chartsInitialized,
        profitCentreGraphsData: !!window.profitCentreGraphsData,
        chartJsLoaded: typeof Chart !== 'undefined',
        dailyCapacityChartExists: !!document.getElementById('dailyCapacityChart'),
        canvasHasChart: !!(document.getElementById('dailyCapacityChart') && Chart.getChart && Chart.getChart(document.getElementById('dailyCapacityChart')))
      };
    });
    console.log('Chart debug info after expansion:', debugInfo);

    // Wait for loading states to disappear (max 10 seconds)
    await Promise.race([
      this.page.waitForFunction(
        () => {
          const loadingElements = [
            document.getElementById('dailyCapacityLoading'),
            document.getElementById('weeklyCapacityLoading'),
            document.getElementById('foremanWorkloadLoading'),
            document.getElementById('profitCentreAllocatedLoading'),
            document.getElementById('profitCentreUnallocatedLoading')
          ];
          // All loading elements should be hidden
          return loadingElements.every(el => !el || el.style.display === 'none' || el.classList.contains('hidden'));
        },
        { timeout: 10000 }
      ).catch(() => console.log('Loading states still visible after 10s')),
      this.page.waitForTimeout(10000)
    ]);

    // Check if charts are visible
    const chartsVisible = await Promise.all([
      this.dailyCapacityChart.isVisible(),
      this.weeklyCapacityChart.isVisible(),
      this.foremanWorkloadChart.isVisible(),
      this.profitCentreAllocatedChart.isVisible(),
      this.profitCentreUnallocatedChart.isVisible()
    ]);

    // Wait for charts to be populated in window.charts
    await this.page.waitForFunction(
      () => {
        // Check if window.charts exists and has at least one chart
        if (!window.charts) return false;

        const requiredCharts = ['dailyCapacity', 'weeklyCapacity', 'foremanWorkload',
          'profitCentreAllocated', 'profitCentreUnallocated'];

        // Check if at least some charts are present
        const chartsFound = requiredCharts.filter(chartKey =>
          window.charts[chartKey] && window.charts[chartKey].data
        );

        // Also check if chartsInitialized flag is set
        return chartsFound.length > 0 || window.chartsInitialized === true;
      },
      { timeout: 15000 }
    ).catch(() => {
      // If charts aren't initialized via window.charts, that's okay
      // The getChartData method will try other methods
      console.log('Charts not found in window.charts after 15s, will try alternative methods');
    });

    // Final check of chart state
    const finalState = await this.page.evaluate(() => {
      return {
        chartKeys: window.charts ? Object.keys(window.charts) : [],
        chartsInitialized: window.chartsInitialized
      };
    });
    console.log('Final chart state:', finalState);

    // Return whether all charts are visible
    return chartsVisible.every(visible => visible);
  }

  async getChartData(chartId) {
    return await this.page.evaluate((id) => {
      // Try multiple ways to get the chart instance
      const canvas = document.getElementById(id);
      if (!canvas) return null;

      // Method 1: Try Chart.getChart (if Chart.js properly tracks it)
      if (typeof Chart !== 'undefined' && Chart.getChart) {
        const chartFromRegistry = Chart.getChart(canvas);
        if (chartFromRegistry) {
          return {
            labels: chartFromRegistry.data.labels,
            datasets: chartFromRegistry.data.datasets.map(dataset => ({
              label: dataset.label,
              data: [...dataset.data], // Create copy of array
              backgroundColor: dataset.backgroundColor,
              borderColor: dataset.borderColor
            }))
          };
        }
      }

      // Method 2: Check if charts are stored in window.charts object
      if (window.charts) {
        // Map canvas ID to chart property name
        const chartMap = {
          dailyCapacityChart: 'dailyCapacity',
          weeklyCapacityChart: 'weeklyCapacity',
          foremanWorkloadChart: 'foremanWorkload',
          profitCentreAllocatedChart: 'profitCentreAllocated',
          profitCentreUnallocatedChart: 'profitCentreUnallocated'
        };

        const chartKey = chartMap[id];
        if (chartKey && window.charts[chartKey]) {
          const chart = window.charts[chartKey];
          return {
            labels: chart.data.labels,
            datasets: chart.data.datasets.map(dataset => ({
              label: dataset.label,
              data: [...dataset.data], // Create copy of array
              backgroundColor: dataset.backgroundColor,
              borderColor: dataset.borderColor
            }))
          };
        }
      }

      // Method 3: Check if chart is stored as a property on the canvas element
      if (canvas.chart) {
        return {
          labels: canvas.chart.data.labels,
          datasets: canvas.chart.data.datasets.map(dataset => ({
            label: dataset.label,
            data: [...dataset.data], // Create copy of array
            backgroundColor: dataset.backgroundColor,
            borderColor: dataset.borderColor
          }))
        };
      }

      return null;
    }, chartId);
  }

  // Data extraction methods
  async getProjectsTableData() {
    await this.expandProjectsPanel();

    const projects = [];
    const rows = await this.projectRows.all();

    for (const row of rows) {
      const projectCode = await row.getAttribute('data-project-code');
      if (!projectCode) continue;

      // Get project info
      const projectInfo = await row.locator('.project-info-column').textContent();
      const [_, ...descParts] = projectInfo.split('\n').map(s => s.trim()).filter(s => s);

      // Get foreman
      const foremanSelect = row.locator('.foreman-select');
      const foremanId = await foremanSelect.inputValue();
      const foremanName = await foremanSelect.locator('option:checked').textContent();

      // Get all labour values
      const labourData = {};
      const fields = ['mon_am', 'mon_pm', 'tue_am', 'tue_pm', 'wed_am', 'wed_pm',
        'thu_am', 'thu_pm', 'fri_am', 'fri_pm', 'sat'];

      for (const field of fields) {
        const input = row.locator(`input[data-field="${field}"]`);
        const value = await input.inputValue();
        labourData[field] = parseFloat(value) || 0;
      }

      projects.push({
        projectCode,
        description: descParts.join(' '),
        foremanId,
        foremanName: foremanName?.trim(),
        labourData
      });
    }

    return projects;
  }

  async getStaffAvailabilityData() {
    await this.expandDataEntryPanel();

    const staffAvailable = parseFloat(await this.staffAvailableInput.inputValue()) || 0;
    const hrsPerWorkDay = parseFloat(await this.hrsPerWorkDayInput.inputValue()) || 8.0;

    return {
      staff_available: staffAvailable,
      hrs_per_work_day: hrsPerWorkDay
    };
  }

  async getProfitCentreData() {
    await this.expandDataEntryPanel();

    const data = {};

    // Get contractors data
    const contractorInput = this.contractorAvailabilityList.locator('input').first();
    if (await contractorInput.isVisible()) {
      data.contractors = {};
      const fields = ['mon_am', 'mon_pm', 'tue_am', 'tue_pm', 'wed_am', 'wed_pm',
        'thu_am', 'thu_pm', 'fri_am', 'fri_pm', 'sat'];

      for (const field of fields) {
        const input = this.contractorAvailabilityList.locator(`input[data-field="${field}"]`);
        if (await input.isVisible()) {
          const value = await input.inputValue();
          data.contractors[field] = parseFloat(value) || 0;
        }
      }
    }

    return data;
  }

  // Calculation methods
  async calculateExpectedDailyCapacity() {
    const projects = await this.getProjectsTableData();
    const staffData = await this.getStaffAvailabilityData();

    const dailySlots = ['mon_am', 'mon_pm', 'tue_am', 'tue_pm', 'wed_am', 'wed_pm',
      'thu_am', 'thu_pm', 'fri_am', 'fri_pm'];

    const allocated = [];
    const available = [];

    for (const slot of dailySlots) {
      // Sum allocated hours from all projects
      const allocatedHours = projects.reduce((sum, project) =>
        sum + (project.labourData[slot] || 0), 0
      );

      // Calculate available hours (half day for AM/PM slots)
      const availableHours = staffData.staff_available * (staffData.hrs_per_work_day / 2);

      allocated.push(allocatedHours);
      available.push(availableHours);
    }

    return { allocated, available };
  }

