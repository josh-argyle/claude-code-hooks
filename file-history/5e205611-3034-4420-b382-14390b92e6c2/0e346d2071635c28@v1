  }

  async calculateExpectedForemanWorkload() {
    const projects = await this.getProjectsTableData();

    const partDaySlots = ['mon_am', 'mon_pm', 'tue_am', 'tue_pm', 'wed_am', 'wed_pm',
      'thu_am', 'thu_pm', 'fri_am', 'fri_pm'];

    // Group projects by foreman
    const foremanAllocations = {};

    for (const project of projects) {
      if (!project.foremanId || !project.foremanName) continue;

      if (!foremanAllocations[project.foremanId]) {
        foremanAllocations[project.foremanId] = {
          name: project.foremanName,
          partDayHours: {}
        };
        // Initialize all slots to 0
        for (const slot of partDaySlots) {
          foremanAllocations[project.foremanId].partDayHours[slot] = 0;
        }
      }

      // Add project hours to foreman totals
      for (const slot of partDaySlots) {
        foremanAllocations[project.foremanId].partDayHours[slot] +=
          project.labourData[slot] || 0;
      }
    }

    // Calculate totals per part day
    const partDayTotals = {};
    for (const slot of partDaySlots) {
      partDayTotals[slot] = Object.values(foremanAllocations).reduce((sum, foreman) =>
        sum + (foreman.partDayHours[slot] || 0), 0
      );
    }

    // Convert to percentages for each foreman
    const foremanList = Object.values(foremanAllocations);
    const datasets = foremanList.map(foreman => {
      const data = partDaySlots.map(slot => {
        const hours = foreman.partDayHours[slot] || 0;
        const total = partDayTotals[slot];
        return total > 0 ? (hours / total) * 100 : 0;
      });

      return {
        name: foreman.name,
        data
      };
    });

    return {
      partDayLabels: ['Mon AM', 'Mon PM', 'Tue AM', 'Tue PM', 'Wed AM', 'Wed PM',
        'Thu AM', 'Thu PM', 'Fri AM', 'Fri PM'],
      datasets
    };
  }

  // Data modification methods
  async updateLabourHours(projectCode, field, value) {
    await this.expandProjectsPanel();

    const input = this.page.locator(`tr[data-project-code="${projectCode}"] input[data-field="${field}"]`);
    await input.fill(value.toString());
    await input.blur(); // Trigger save

    // Wait for save to complete
    await this.waitForAutoSave(input);
  }

  async updateStaffAvailability(field, value) {
    await this.expandDataEntryPanel();

    const input = field === 'staff_available' ? this.staffAvailableInput : this.hrsPerWorkDayInput;
    await input.fill(value.toString());
    await input.blur(); // Trigger save

    // Wait for save to complete
    await this.waitForAutoSave(input);
  }

  async waitForAutoSave(element) {
    // Look for save status indicators
    const elementId = await element.getAttribute('id');
    if (elementId) {
      try {
        // Wait for saved status to appear
        await this.page.waitForSelector('.save-status.saved', { timeout: 10000 });
      } catch {
        // If no save status indicator, just wait a bit
        await this.page.waitForTimeout(2000);
      }
    } else {
      await this.page.waitForTimeout(2000);
    }

    // Wait for any network requests to complete
    await this.page.waitForLoadState('networkidle', { timeout: 10000 });
  }

