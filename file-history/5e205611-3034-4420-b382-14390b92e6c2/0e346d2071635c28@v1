  async waitForPageLoad() {
    await this.page.waitForLoadState('networkidle');
    await expect(this.pageTitle).toBeVisible({ timeout: 10000 });
    // Wait for initial data to load
    await this.page.waitForTimeout(1000);
  }

  // Permission checking methods
  async isAccessDenied() {
    try {
      await this.accessDeniedMessage.waitFor({ state: 'visible', timeout: 5000 });
      return true;
    } catch {
      return false;
    }
  }

  async getErrorMessage() {
    if (await this.errorMessage.isVisible()) {
      return await this.errorMessage.textContent();
    }
    return null;
  }

  async isOnLoginPage() {
    return this.page.url().includes('/login');
  }

  // Panel interaction methods
  async expandAnalyticsPanel() {
    // Check if panel is collapsed
    const isCollapsed = await this.graphsPanel.evaluate(el => el.classList.contains('collapsed'));
    if (isCollapsed) {
      await this.graphsPanel.click();
      await expect(this.graphsPanel).toHaveClass(/expanded/, { timeout: 10000 });

      // Force chart initialization if needed
      const initResult = await this.page.evaluate(() => {
        const result = {
          loadGraphsDataExists: typeof loadGraphsData === 'function',
          chartsInitialized: window.chartsInitialized,
          called: false
        };

        // If loadGraphsData function exists and charts aren't initialized, call it
        if (typeof window.loadGraphsData === 'function' && !window.chartsInitialized) {
          console.log('Forcing loadGraphsData call');
          try {
            window.loadGraphsData();
            result.called = true;
          } catch (error) {
            result.error = error.message;
          }
        }
        return result;
      });
      console.log('Init result:', initResult);

      // Wait for network requests to complete after expanding
      await this.page.waitForLoadState('networkidle', { timeout: 10000 });
      // Wait longer for chart rendering after API call
      await this.page.waitForTimeout(5000);
