const { processRemoteReceivingCentre } = require('../../../api/processors/remote-receiving-centre/orchestrator');
const ProjectModel = require('../../../api/models/project-model');

describe('Remote Receiving Centre Processor', () => {
  let projectModel;

  beforeEach(() => {
    projectModel = new ProjectModel();
  });

  describe('Systems requiring remote receiving centre', () => {
    test('should require connection for Type 2 (manual fire alarm)', () => {
      projectModel.addFirecell({
        riskGroup: 'WB',
        occupantType: 'Office spaces',
        occupantLoad: 200, // Over exemption limit
        escapeHeight: 8,
        isSprinklered: false,
        floorArea: 1000
      });

      // Simulate orchestrator setting fire safety systems
      projectModel.firecells[0].fireSafetySystems = ['2', '18^2'];

      processRemoteReceivingCentre(projectModel);

      expect(projectModel.requiresRemoteReceivingCentre).toBe(true);
    });

    test('should require connection for Type 3 (automatic heat detectors)', () => {
      projectModel.addFirecell({
        riskGroup: 'WB',
        occupantType: 'Office spaces',
        occupantLoad: 200,
        escapeHeight: 8,
        isSprinklered: false,
        floorArea: 1000
      });

      projectModel.firecells[0].fireSafetySystems = ['3', '18^2'];

      processRemoteReceivingCentre(projectModel);

      expect(projectModel.requiresRemoteReceivingCentre).toBe(true);
    });

    test('should require connection for Type 4 (automatic smoke detectors)', () => {
      projectModel.addFirecell({
        riskGroup: 'CA',
        occupantType: 'Office spaces',
        occupantLoad: 300, // Over exemption limit
        escapeHeight: 8,
        isSprinklered: false,
        floorArea: 1000
      });

      projectModel.firecells[0].fireSafetySystems = ['4^5', '18^2'];

      processRemoteReceivingCentre(projectModel);

      expect(projectModel.requiresRemoteReceivingCentre).toBe(true);
    });

    test('should require connection for Type 5 (modified smoke detection)', () => {
      projectModel.addFirecell({
        riskGroup: 'SM',
        occupantType: 'Office spaces',
        occupantLoad: 50,
        escapeHeight: 15, // Over exemption limit
        isSprinklered: false,
        floorArea: 400
      });

      projectModel.firecells[0].fireSafetySystems = ['5', '15', '18^2'];

      processRemoteReceivingCentre(projectModel);

      expect(projectModel.requiresRemoteReceivingCentre).toBe(true);
    });

    test('should require connection for Type 6 (sprinkler with manual call points)', () => {
      projectModel.addFirecell({
        riskGroup: 'SI',
        occupantType: 'Office spaces',
        occupantLoad: 50,
        escapeHeight: 8,
        isSprinklered: true,
        floorArea: 400
      });

      projectModel.firecells[0].fireSafetySystems = ['6', '18^2'];

      processRemoteReceivingCentre(projectModel);

      expect(projectModel.requiresRemoteReceivingCentre).toBe(true);
    });

    test('should require connection for Type 7 (sprinkler with smoke detectors)', () => {
      projectModel.addFirecell({
        riskGroup: 'SI',
        occupantType: 'Office spaces',
        occupantLoad: 50,
        escapeHeight: 8,
        isSprinklered: true,
        floorArea: 400
      });

      projectModel.firecells[0].fireSafetySystems = ['7', '9', '18^2'];

      processRemoteReceivingCentre(projectModel);

      expect(projectModel.requiresRemoteReceivingCentre).toBe(true);
    });
  });

  describe('Systems NOT requiring remote receiving centre', () => {
    test('should not require connection for Type 1 (domestic smoke alarm)', () => {
      projectModel.addFirecell({
        riskGroup: 'SM',
        occupantType: 'Office spaces',
        occupantLoad: 30,
        escapeHeight: 5,
        isSprinklered: false,
        floorArea: 400
      });

      projectModel.firecells[0].fireSafetySystems = ['1', '18^2'];

      processRemoteReceivingCentre(projectModel);

      expect(projectModel.requiresRemoteReceivingCentre).toBe(false);
    });

    test('should not require connection for Type 8+ systems only', () => {
      projectModel.addFirecell({
        riskGroup: 'WB',
        occupantType: 'Office spaces',
        occupantLoad: 150,
        escapeHeight: 8,
        isSprinklered: false,
        floorArea: 1000
      });

      projectModel.firecells[0].fireSafetySystems = ['9', '15', '18^2'];

      processRemoteReceivingCentre(projectModel);

      expect(projectModel.requiresRemoteReceivingCentre).toBe(false);
    });
  });

  describe('SM Risk Group exemptions', () => {
    test('should exempt SM permanent accommodation under 10m escape height', () => {
      projectModel.addFirecell({
        riskGroup: 'SM',
        occupantType: 'Office spaces',
        occupantLoad: 50,
        escapeHeight: 9, // Under 10m
        isSprinklered: false,
        floorArea: 400
      });

      projectModel.firecells[0].fireSafetySystems = ['5', '18^2'];

      processRemoteReceivingCentre(projectModel);

      expect(projectModel.requiresRemoteReceivingCentre).toBe(false);
    });

    test('should require connection for SM permanent accommodation at 10m escape height', () => {
      projectModel.addFirecell({
        riskGroup: 'SM',
        occupantType: 'Office spaces',
        occupantLoad: 50,
        escapeHeight: 10, // At threshold
        isSprinklered: false,
        floorArea: 400
      });

      projectModel.firecells[0].fireSafetySystems = ['5', '18^2'];

      processRemoteReceivingCentre(projectModel);

      expect(projectModel.requiresRemoteReceivingCentre).toBe(true);
    });
  });

  describe('CA Risk Group exemptions', () => {
    test('should exempt CA with ≤250 occupants, <4m escape height, not cinema/theatre', () => {
      projectModel.addFirecell({
        riskGroup: 'CA',
        occupantType: 'Office spaces',
        occupantLoad: 250, // At threshold
        escapeHeight: 3.9, // Under 4m
        isSprinklered: false,
        floorArea: 1000,
        isCinemaOrTheatre: false
      });

      projectModel.firecells[0].fireSafetySystems = ['4^5', '18^2'];

      processRemoteReceivingCentre(projectModel);

      expect(projectModel.requiresRemoteReceivingCentre).toBe(false);
    });

    test('should require connection for CA with >250 occupants', () => {
      projectModel.addFirecell({
        riskGroup: 'CA',
        occupantType: 'Office spaces',
        occupantLoad: 251, // Over threshold
        escapeHeight: 3,
        isSprinklered: false,
        floorArea: 1000,
        isCinemaOrTheatre: false
      });

      projectModel.firecells[0].fireSafetySystems = ['4^5', '18^2'];

      processRemoteReceivingCentre(projectModel);

      expect(projectModel.requiresRemoteReceivingCentre).toBe(true);
    });

    test('should require connection for CA with ≥4m escape height', () => {
      projectModel.addFirecell({
        riskGroup: 'CA',
        occupantType: 'Office spaces',
        occupantLoad: 200,
        escapeHeight: 4, // At threshold
        isSprinklered: false,
        floorArea: 1000,
        isCinemaOrTheatre: false
      });

      projectModel.firecells[0].fireSafetySystems = ['4^5', '18^2'];

      processRemoteReceivingCentre(projectModel);

      expect(projectModel.requiresRemoteReceivingCentre).toBe(true);
    });

    test('should require connection for CA cinema/theatre even if under thresholds', () => {
      projectModel.addFirecell({
        riskGroup: 'CA',
        occupantType: 'Office spaces',
        occupantLoad: 200,
        escapeHeight: 3,
        isSprinklered: false,
        floorArea: 1000,
        isCinemaOrTheatre: true // Cinema or theatre
      });

      projectModel.firecells[0].fireSafetySystems = ['4^5', '18^2'];

      processRemoteReceivingCentre(projectModel);

      expect(projectModel.requiresRemoteReceivingCentre).toBe(true);
    });
  });

  describe('WB Risk Group exemptions', () => {
    test('should exempt WB with ≤100 occupants and <4m escape height', () => {
      projectModel.addFirecell({
        riskGroup: 'WB',
        occupantType: 'Office spaces',
        occupantLoad: 100, // At threshold
        escapeHeight: 3.9, // Under 4m
        isSprinklered: false,
        floorArea: 1000
      });

      projectModel.firecells[0].fireSafetySystems = ['4^5', '18^2'];

      processRemoteReceivingCentre(projectModel);

      expect(projectModel.requiresRemoteReceivingCentre).toBe(false);
    });

    test('should require connection for WB with >100 occupants', () => {
      projectModel.addFirecell({
        riskGroup: 'WB',
        occupantType: 'Office spaces',
        occupantLoad: 101, // Over threshold
        escapeHeight: 3,
        isSprinklered: false,
        floorArea: 1000
      });

      projectModel.firecells[0].fireSafetySystems = ['4^5', '18^2'];

      processRemoteReceivingCentre(projectModel);

      expect(projectModel.requiresRemoteReceivingCentre).toBe(true);
    });

    test('should require connection for WB with ≥4m escape height', () => {
      projectModel.addFirecell({
        riskGroup: 'WB',
        occupantType: 'Office spaces',
        occupantLoad: 80,
        escapeHeight: 4, // At threshold
        isSprinklered: false,
        floorArea: 1000
      });

      projectModel.firecells[0].fireSafetySystems = ['4^5', '18^2'];

      processRemoteReceivingCentre(projectModel);

      expect(projectModel.requiresRemoteReceivingCentre).toBe(true);
    });
  });

  describe('VP Risk Group exemptions', () => {
    test('should exempt VP with no vehicle stackers', () => {
      projectModel.addFirecell({
        riskGroup: 'VP',
        occupantType: 'Parking buildings, garages',
        occupantLoad: 50,
        escapeHeight: 8,
        isSprinklered: false,
        floorArea: 5000,
        hasVehicleStacker: false
      });

      projectModel.firecells[0].fireSafetySystems = ['3^2', '18^2'];

      processRemoteReceivingCentre(projectModel);

      expect(projectModel.requiresRemoteReceivingCentre).toBe(false);
    });

    test('should require connection for VP with vehicle stackers', () => {
      projectModel.addFirecell({
        riskGroup: 'VP',
        occupantType: 'Parking buildings, garages',
        occupantLoad: 50,
        escapeHeight: 8,
        isSprinklered: false,
        floorArea: 5000,
        hasVehicleStacker: true
      });

      projectModel.firecells[0].fireSafetySystems = ['3^2', '18^2'];

      processRemoteReceivingCentre(projectModel);

      expect(projectModel.requiresRemoteReceivingCentre).toBe(true);
    });
  });

  describe('SI and WS Risk Groups (no exemptions)', () => {
    test('should always require connection for SI with alarm/sprinkler systems', () => {
      projectModel.addFirecell({
        riskGroup: 'SI',
        occupantType: 'Office spaces',
        occupantLoad: 50,
        escapeHeight: 5,
        isSprinklered: true,
        floorArea: 400
      });

      projectModel.firecells[0].fireSafetySystems = ['7^3', '9', '18^2'];

      processRemoteReceivingCentre(projectModel);

      expect(projectModel.requiresRemoteReceivingCentre).toBe(true);
    });

    test('should always require connection for WS with alarm/sprinkler systems', () => {
      projectModel.addFirecell({
        riskGroup: 'WS',
        occupantType: 'Bulk storage including racks and shelves',
        occupantLoad: 20,
        escapeHeight: 8,
        isSprinklered: true,
        floorArea: 2000
      });

      projectModel.firecells[0].fireSafetySystems = ['6', '18^2'];

      processRemoteReceivingCentre(projectModel);

      expect(projectModel.requiresRemoteReceivingCentre).toBe(true);
    });
  });

  describe('Multiple firecells scenarios', () => {
    test('should require connection if ANY firecell needs it', () => {
      // First firecell - exempt
      projectModel.addFirecell({
        riskGroup: 'SM',
        occupantType: 'Office spaces',
        occupantLoad: 50,
        escapeHeight: 8, // Under 10m, should be exempt
        isSprinklered: false,
        floorArea: 400
      });

      // Second firecell - requires connection
      projectModel.addFirecell({
        riskGroup: 'WB',
        occupantType: 'Office spaces',
        occupantLoad: 150, // Over exemption limit
        escapeHeight: 8,
        isSprinklered: false,
        floorArea: 1000
      });

      projectModel.firecells[0].fireSafetySystems = ['5', '18^2'];
      projectModel.firecells[1].fireSafetySystems = ['4^5', '18^2'];

      processRemoteReceivingCentre(projectModel);

      expect(projectModel.requiresRemoteReceivingCentre).toBe(true);
    });

    test('should not require connection if ALL firecells are exempt', () => {
      // First firecell - exempt
      projectModel.addFirecell({
        riskGroup: 'SM',
        occupantType: 'Office spaces',
        occupantLoad: 50,
        escapeHeight: 8, // Under 10m
        isSprinklered: false,
        floorArea: 400
      });

      // Second firecell - also exempt
      projectModel.addFirecell({
        riskGroup: 'WB',
        occupantType: 'Office spaces',
        occupantLoad: 80, // Under exemption limit
        escapeHeight: 3, // Under 4m
        isSprinklered: false,
        floorArea: 1000
      });

      projectModel.firecells[0].fireSafetySystems = ['5', '18^2'];
      projectModel.firecells[1].fireSafetySystems = ['4^5', '18^2'];

      processRemoteReceivingCentre(projectModel);

      expect(projectModel.requiresRemoteReceivingCentre).toBe(false);
    });

    test('should not require connection if no firecells have alarm/sprinkler systems', () => {
      projectModel.addFirecell({
        riskGroup: 'SM',
        occupantType: 'Office spaces',
        occupantLoad: 50,
        escapeHeight: 15, // Would require if had alarm system
        isSprinklered: false,
        floorArea: 400
      });

      // Only has non-alarm systems
      projectModel.firecells[0].fireSafetySystems = ['1', '18^2'];

      processRemoteReceivingCentre(projectModel);

      expect(projectModel.requiresRemoteReceivingCentre).toBe(false);
    });
  });

  // Note: Supplementary systems exemption (2.2.2(e)) would need to be implemented
  // once we have a way to identify which systems are supplementary vs required
  // describe('Supplementary systems exemption', () => {
  //   test('should not require connection for supplementary systems only', () => {
  //     // Implementation depends on how supplementary systems are identified
  //   });
  // });
});