    async function loadWorkCentres(projectCode) {
      const workCentreSelect = document.getElementById('work-centre');
      
      // Show loading state
      workCentreSelect.innerHTML = '<option value="">Loading work centres...</option>';
      workCentreSelect.disabled = true;
      
      try {
        // Get the appropriate staff ID for the API call
        let staffId = window.loggedInAccountId;
        if (timesheetState.isTeamMode && timesheetState.selectedEmployees.length > 0) {
          // In team mode, use the first selected employee for work centre lookup
          staffId = timesheetState.selectedEmployees[0].id;
        }

        const url = `/api/timesheets/work-centres?project_code=${encodeURIComponent(projectCode)}&staff_id=${staffId}`;
        const response = await fetch(url);
        
        if (!response.ok) {
          const errorData = await response.json();
          if (errorData.error === 'no_workbench_mapping') {
            throw new Error('Account not connected to Workbench');
          }
          throw new Error(errorData.message || 'Failed to load work centres');
        }

        const workCentres = await response.json();
        timesheetState.workCentreOptions = workCentres;

        // Update dropdown with fetched work centres
        if (workCentres.length > 0) {
          workCentreSelect.innerHTML = '<option value="">Select Work Centre</option>' +
            workCentres.map(option => 
              `<option value="${option.work_centre}">${option.work_centre} - ${option.description}</option>`
            ).join('');
          workCentreSelect.disabled = false;
        } else {
          workCentreSelect.innerHTML = '<option value="">No work centres available</option>';
          workCentreSelect.disabled = true;
        }
      } catch (error) {
        logger.error('Error loading work centres:', error);
        workCentreSelect.innerHTML = '<option value="">Error loading work centres</option>';
        workCentreSelect.disabled = true;
        
        if (error.message.includes('Workbench')) {
          showNotification('Unable to load work centres: ' + error.message, 'error');
        }
      }

      updateAddButtonState();
    }

