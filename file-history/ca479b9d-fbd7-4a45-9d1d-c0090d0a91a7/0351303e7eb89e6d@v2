        loadingIndicator.classList.remove('hidden');
        entriesContent.classList.add('hidden');
        return;
      }

      loadingIndicator.classList.add('hidden');
      entriesContent.classList.remove('hidden');

      if (timesheetState.entries.length === 0) {
        noEntries.classList.remove('hidden');
        entriesList.classList.add('hidden');
        entriesTitle.classList.add('hidden');
        daySummary.classList.add('hidden');
      } else {
        noEntries.classList.add('hidden');
        entriesList.classList.remove('hidden');
        entriesTitle.classList.remove('hidden');
        entriesTitle.textContent = `Entries for ${getDayName(timesheetState.currentDate)}`;

        // Group entries by employee in team mode
        let entriesHTML = '';

        if (timesheetState.isTeamMode) {
          // Group entries by employee
          const entriesByEmployee = {};
          timesheetState.entries.forEach(entry => {
            const employeeKey = entry.employee_id || 'unknown';
            if (!entriesByEmployee[employeeKey]) {
              entriesByEmployee[employeeKey] = {
                name: entry.employee_name || getEmployeeName(employeeKey),
                entries: [],
                totalHours: 0
              };
            }
            entriesByEmployee[employeeKey].entries.push(entry);
            entriesByEmployee[employeeKey].totalHours += parseFloat(entry.hours) || 0;
          });

          // Sort employees by name
          const sortedEmployees = Object.keys(entriesByEmployee).sort((a, b) => {
            const nameA = entriesByEmployee[a].name.toLowerCase();
            const nameB = entriesByEmployee[b].name.toLowerCase();
            return nameA.localeCompare(nameB);
          });

          // Render grouped entries
          sortedEmployees.forEach(employeeId => {
            const group = entriesByEmployee[employeeId];

            // Add employee header
            entriesHTML += `
              <div class="employee-group-header">
                <span>${group.name}</span>
                <span class="employee-hours-total">${group.totalHours.toFixed(2)}h</span>
              </div>
            `;

            // Add entries for this employee
            group.entries.forEach(entry => {
              entriesHTML += `
                <div class="time-entry ${entry._optimistic ? 'optimistic-entry' : ''}" data-entry-id="${entry.id}">
                  <div class="entry-content">
                    <div class="entry-header">
                      <div class="project-info">
                        <span class="project-number">${entry.project_description || entry.project_code}</span>
                        <span class="work-center">${entry.activity_code || entry.work_centre}</span>
                        <span class="time-info editable" data-entry-id="${entry.id}">
                          ${convertToHoursMinutes(entry.hours, false)}
                          ${entry._optimistic ? `<span class="optimistic-indicator" title="Saving...">${Icons.getIcon('loader-2')}</span>` : ''}
                        </span>
                      </div>
                    </div>
                    <button class="btn-icon" data-entry-id="${entry.id}" title="Delete entry" ${entry._optimistic ? 'disabled' : ''}>
                      ${Icons.getIcon('trash-2')}
                    </button>
                  </div>
                </div>
              `;
            });
          });
        } else {
          // Personal mode - render entries normally
          entriesHTML = timesheetState.entries.map(entry => `
            <div class="time-entry ${entry._optimistic ? 'optimistic-entry' : ''}" data-entry-id="${entry.id}">
              <div class="entry-content">
                <div class="entry-header">
                  <div class="project-info">
                    <span class="project-number">${entry.project_description || entry.project_code}</span>
                    <span class="work-center">${entry.activity_code || entry.work_centre}</span>
                    <span class="time-info editable" data-entry-id="${entry.id}">
                      ${convertToHoursMinutes(entry.hours, false)}
                      ${entry._optimistic ? `<span class="optimistic-indicator" title="Saving...">${Icons.getIcon('loader-2')}</span>` : ''}
                    </span>
                  </div>
                </div>
                <button class="btn-icon" data-entry-id="${entry.id}" title="Delete entry" ${entry._optimistic ? 'disabled' : ''}>
                  ${Icons.getIcon('trash-2')}
                </button>
              </div>
            </div>
          `).join('');
        }

        entriesList.innerHTML = entriesHTML;

        // Add event listeners to entries
        entriesList.querySelectorAll('.btn-icon').forEach(btn => {
          btn.addEventListener('click', function() {
            const entryId = this.getAttribute('data-entry-id');
            deleteEntry(entryId);
          });
        });

        entriesList.querySelectorAll('.time-info.editable').forEach(span => {
          span.addEventListener('click', function() {
            const entryId = this.getAttribute('data-entry-id');
            startEditing(entryId);
          });
        });

        // Update total hours with warning logic
        const hoursWarning = document.getElementById('hours-warning');

        if (timesheetState.isTeamMode) {
          // In team mode, show total for all selected employees
          const total = timesheetState.entries.reduce((sum, entry) => sum + (parseFloat(entry.hours) || 0), 0);
          totalHours.textContent = convertToHoursMinutes(total, false);

          // Check if any individual employee exceeds 24 hours
          let hasWarning = false;
          for (const employee of timesheetState.selectedEmployees) {
            const employeeTotal = calculateDailyHours(employee.id);
            if (employeeTotal > 24) {
              hasWarning = true;
              break;
            }
          }

          if (hasWarning) {
            totalHours.classList.add('warning');
            hoursWarning.classList.add('active');
          } else {
            totalHours.classList.remove('warning');
            hoursWarning.classList.remove('active');
          }

          // Show summary in team mode too
          daySummary.classList.remove('hidden');
        } else {
          // Personal mode - calculate total for current user only
          const currentUserId = window.loggedInAccountId;
          const total = currentUserId ? calculateDailyHours(currentUserId) : 0;
          totalHours.textContent = convertToHoursMinutes(total, false);

          if (total > 24) {
            totalHours.classList.add('warning');
            hoursWarning.classList.add('active');
          } else {
            totalHours.classList.remove('warning');
            hoursWarning.classList.remove('active');
          }

          daySummary.classList.remove('hidden');
        }
      }
    }

    function updateAddButtonState() {
      const addBtn = document.getElementById('add-entry-btn');
      const projectSearch = document.getElementById('project-search');
      const workCentre = document.getElementById('work-centre');
