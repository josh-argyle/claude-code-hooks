  script.
    // Pass server data to JavaScript
    window.projectData = !{JSON.stringify(projects || [])};
    window.loggedInAccountId = !{JSON.stringify(userId || null)};
    window.currentUserName = !{JSON.stringify(userName || 'Me')};
    window.selectedDate = !{JSON.stringify(selectedDate || null)};
    window.staff = !{JSON.stringify(staff || [])};
    window.isForeman = !{JSON.stringify((roles || []).includes('foreman') || (roles || []).includes('project_manager') || (roles || []).includes('admin'))};

    // Global state management
    const timesheetState = {
      currentDate: new Date(),
      isTeamMode: false,
      selectedEmployees: [],
      entries: [],
      userTimesheets: [],
      daySubmitted: false,
      isLoadingEntries: false,
      isLoadingEmployees: false,
      isSaving: false,
      isDeletingEntry: null,
      editingEntryId: null,
      originalHoursBackup: null,
      projectData: window.projectData || [],
      employees: window.staff || [],
      selectedProject: null,
      workCentreOptions: []
    };

    // Helper functions
    function parseDateString(dateString) {
      if (!dateString) return new Date();
      const parts = dateString.split('/');
      if (parts.length === 3) {
        const day = parseInt(parts[0], 10);
        const month = parseInt(parts[1], 10) - 1;
        let year = parseInt(parts[2], 10);
        if (year < 100) {
          year += 2000;
        }
        const d = new Date(year, month, day);
        if (d.getFullYear() === year && d.getMonth() === month && d.getDate() === day) {
          return d;
        }
      }
      return new Date();
    }

    function formatDateForDisplay(date) {
      if (!date) return '';
      // Using DateUtils.formatNZDate for consistency, though format is slightly different
      return DateUtils.formatNZDate(date);
    }

    function formatDateForSubmission(date) {
      return DateUtils.formatDateForAPI(date);
    }

    function formatShortDate(date) {
      return DateUtils.formatShortDate(date);
    }

    function getDayName(date) {
      return DateUtils.formatDayName(date);
    }

    function convertToHoursMinutes(decimalHours, useParens = true) {
      const numHours = parseFloat(decimalHours);
      if (isNaN(numHours)) return useParens ? '(0h)' : '0h';

      const hours = Math.floor(numHours);
      let minutes = Math.round((numHours - hours) * 60);

      if (minutes === 60) {
        minutes = 0;
        const displayHours = hours + 1;
        const format = `${displayHours} hour${displayHours !== 1 ? 's' : ''}`;
        return useParens ? `(${format})` : format;
      }

      let format = '';
      if (hours > 0) {
        format += `${hours} hour${hours !== 1 ? 's' : ''}`;
      }

      if (minutes > 0) {
        if (hours > 0) format += ' ';
        format += `${minutes} minute${minutes !== 1 ? 's' : ''}`;
      }

      if (format === '') {
        format = '0 hours';
      }

      return useParens ? `(${format})` : format;
    }

    function formatTimeValue(value) {
      if (value === null || value === undefined) return '';
      let stringValue = String(value).trim();
      if (stringValue === '') return '';
      let cleanValue = stringValue.replace(/[^\d.]/g, '');
      const parts = cleanValue.split('.');
      if (parts.length > 2) cleanValue = parts[0] + '.' + parts.slice(1).join('');
      if (cleanValue === '' || cleanValue === '.') return '';
      const numericValue = parseFloat(cleanValue);
      if (isNaN(numericValue) || numericValue < 0) return '';
      return (Math.round(numericValue / 0.25) * 0.25).toFixed(2);
    }

    function getEmployeeName(employeeId) {
      const employee = timesheetState.employees.find(emp => String(emp.user_id) === String(employeeId));
      return employee ? employee.full_name : `User ID: ${employeeId}`;
    }

    function calculateDailyHours(employeeId) {
      // Calculate total hours for a specific employee on the current day
      // Include both saved entries and optimistic (pending) entries
      return timesheetState.entries
        .filter(entry => String(entry.employee_id) === String(employeeId))
        .reduce((total, entry) => total + (parseFloat(entry.hours) || 0), 0);
    }

    function validateDailyLimit(newHours, employeeIds) {
      // Check if adding newHours would exceed 24 hours for any employee
      const hoursToAdd = parseFloat(newHours);
      if (isNaN(hoursToAdd) || hoursToAdd <= 0) {
        return { valid: false, reason: 'Invalid hours value' };
      }

      for (const employeeId of employeeIds) {
        const currentHours = calculateDailyHours(employeeId);
        const totalAfterAdd = currentHours + hoursToAdd;

        if (totalAfterAdd > 24) {
          const employeeName = getEmployeeName(employeeId);
          const remainingHours = Math.max(0, 24 - currentHours);
          return {
            valid: false,
            reason: `Adding ${hoursToAdd} hours would exceed 24-hour daily limit for ${employeeName}. Current: ${currentHours.toFixed(2)}h, Maximum additional: ${remainingHours.toFixed(2)}h`
          };
        }
      }

      return { valid: true };
    }

    // DOM update functions
    function updateDateDisplay() {
      document.getElementById('day-name').textContent = getDayName(timesheetState.currentDate);
      document.getElementById('date-display').textContent = formatShortDate(timesheetState.currentDate);
    }

    function updateModeToggle() {
      const modeToggleBtn = document.getElementById('mode-toggle-btn');
      const teamSelection = document.getElementById('team-selection');
      const daySummary = document.getElementById('day-summary');

      if (window.isForeman) {
        modeToggleBtn.classList.remove('hidden');
        
        if (timesheetState.isTeamMode) {
          modeToggleBtn.innerHTML = `
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="m22 21-2-2"></path>
              <path d="m16 16 2 2"></path>
            </svg>
            Team Mode
          `;
          teamSelection.classList.add('active');
          daySummary.classList.add('hidden');
        } else {
          modeToggleBtn.innerHTML = `
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            Personal Mode
          `;
          teamSelection.classList.remove('active');
          if (timesheetState.entries.length > 0) {
            daySummary.classList.remove('hidden');
          }
        }
      }
    }

    function updateSelectedEmployees() {
      const container = document.getElementById('selected-employees');
      if (timesheetState.selectedEmployees.length === 0) {
        container.innerHTML = '<span>No one selected</span>';
      } else {
        container.innerHTML = timesheetState.selectedEmployees.map(emp => 
          `<span class="selected-name">${emp.name}</span>`
        ).join('');
      }
    }

    // Optimistic update helper functions
    function createOptimisticEntry(employee, projectCode, projectDescription, workCentre, hours, entryDate) {
      return {
        id: `temp-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`,
        project_code: projectCode,
        project_description: projectDescription,
        work_centre: workCentre,
        hours: parseFloat(hours),
        employee_id: employee.id,
        employee_name: employee.name,
        entry_date: entryDate,
        _optimistic: true,
        _optimisticType: 'add'
      };
    }

    function addOptimisticEntries(newEntries) {
      timesheetState.entries.push(...newEntries);
      renderEntries();
    }

    function removeOptimisticEntries(entriesToRemove) {
      entriesToRemove.forEach(entryToRemove => {
        const index = timesheetState.entries.findIndex(e => e.id === entryToRemove.id);
        if (index !== -1) {
          timesheetState.entries.splice(index, 1);
        }
      });
      renderEntries();
    }

    function updateOptimisticEntry(entryId, updates) {
      const entry = timesheetState.entries.find(e => e.id === entryId);
      if (entry) {
        Object.assign(entry, updates);
        entry._optimistic = true;
        entry._optimisticType = 'edit';
        renderEntries();
      }
      return entry;
    }

    function removeOptimisticEntry(entryId) {
      const entryIndex = timesheetState.entries.findIndex(e => e.id === entryId);
      if (entryIndex !== -1) {
        const entry = timesheetState.entries.splice(entryIndex, 1)[0];
        renderEntries();
        return { entry, index: entryIndex };
      }
      return null;
    }

    function restoreEntry(entry, index) {
      timesheetState.entries.splice(index, 0, entry);
      renderEntries();
    }

    function updateOptimisticEntryId(tempId, realId) {
      const entry = timesheetState.entries.find(e => e.id === tempId);
      if (entry) {
        entry.id = realId;
        renderEntries();
      }
    }

    function clearOptimisticFlags(entryId) {
      const entry = timesheetState.entries.find(e => e.id === entryId);
      if (entry) {
        delete entry._optimistic;
        delete entry._optimisticType;
        renderEntries();
      }
    }

