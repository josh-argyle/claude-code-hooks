    // API functions
    async function loadEntriesForDay() {
      timesheetState.isLoadingEntries = true;
      renderEntries();

      try {
        let staffIdsToQuery = [];
        if (timesheetState.isTeamMode) {
          if (timesheetState.selectedEmployees.length > 0) {
            staffIdsToQuery = timesheetState.selectedEmployees.map(e => e.id);
          } else {
            timesheetState.entries = [];
            timesheetState.isLoadingEntries = false;
            renderEntries();
            return;
          }
        } else {
          if (window.loggedInAccountId) {
            staffIdsToQuery = [window.loggedInAccountId];
          } else {
            timesheetState.entries = [];
            timesheetState.isLoadingEntries = false;
            renderEntries();
            return;
          }
        }

        const dateStr = formatDateForSubmission(timesheetState.currentDate);
        const url = `/api/timesheets/entries?date=${dateStr}&staff_ids=${staffIdsToQuery.join(',')}`;

        const response = await fetch(url);
        if (!response.ok) {
          const errorData = await response.json();
          if (errorData.error === 'no_workbench_mapping') {
            throw new Error('Your account isn\'t set up to connect to Workbench and needs to be connected');
          }
          throw new Error(errorData.message || 'Failed to load entries');
        }

        const data = await response.json();
        timesheetState.entries = [];
        
        if (data.entries && Array.isArray(data.entries)) {
          data.entries.forEach(userEntryData => {
            const employeeName = getEmployeeName(userEntryData.id);
            userEntryData.entries.forEach(entry => {
              timesheetState.entries.push({
                ...entry,
                hours: parseFloat(entry.hours) || 0,
                employee_id: userEntryData.id,
                employee_name: employeeName
              });
            });
          });
        }

        timesheetState.daySubmitted = data.completed || false;
      } catch (error) {
        logger.error('Error loading entries:', error);
        timesheetState.entries = [];
        if (error.message.includes('Workbench')) {
          showNotification(error.message, 'error');
        }
      } finally {
        timesheetState.isLoadingEntries = false;
        renderEntries();
      }
    }

    async function addEntry() {
      if (timesheetState.isSaving) return;

      // Immediately disable button and set saving state to prevent double-clicks
      timesheetState.isSaving = true;
      updateAddButtonState();

      const hoursInput = document.getElementById('hours');
      const workCentreSelect = document.getElementById('work-centre');

      const hours = parseFloat(hoursInput.value);
      if (!timesheetState.selectedProject || !workCentreSelect.value || !hours || hours <= 0) {
        showNotification('Project, Work Centre, and valid positive Hours are required.', 'error');
        timesheetState.isSaving = false;
        updateAddButtonState();
        return;
      }

      let employeesToProcess = [];
      if (timesheetState.isTeamMode) {
        if (timesheetState.selectedEmployees.length > 0) {
          employeesToProcess = [...timesheetState.selectedEmployees];
        } else {
          showNotification('Please select at least one employee in team mode.', 'error');
          timesheetState.isSaving = false;
          updateAddButtonState();
          return;
        }
      } else {
        if (window.loggedInAccountId) {
          employeesToProcess = [{ id: window.loggedInAccountId, name: window.currentUserName || 'Me' }];
        } else {
          showNotification('Logged-in user ID not available.', 'error');
          timesheetState.isSaving = false;
          updateAddButtonState();
          return;
        }
      }

      // Validate 24-hour daily limit before proceeding
      const employeeIds = employeesToProcess.map(emp => emp.id);
      const limitValidation = validateDailyLimit(hours, employeeIds);
      if (!limitValidation.valid) {
        showNotification(limitValidation.reason, 'error');
        timesheetState.isSaving = false;
        updateAddButtonState();
        return;
      }

      const formattedDate = formatDateForSubmission(timesheetState.currentDate);

      // Store form values before clearing form (needed for API calls later)
      const selectedProjectCode = timesheetState.selectedProject.project_code;
      const selectedProjectDescription = timesheetState.selectedProject.description;
      const selectedWorkCentreCode = workCentreSelect.value;
      
      // Get full work centre display text for optimistic entries
      const selectedWorkCentreOption = workCentreSelect.options[workCentreSelect.selectedIndex];
      const selectedWorkCentreDisplay = selectedWorkCentreOption ? selectedWorkCentreOption.text : selectedWorkCentreCode;

      // Create optimistic entries immediately
      const optimisticEntries = employeesToProcess.map(employee => 
        createOptimisticEntry(
          employee, 
          selectedProjectCode,
          selectedProjectDescription,
          selectedWorkCentreDisplay,
          hours,
          formattedDate
        )
      );

      // Add to UI immediately and clear form
      addOptimisticEntries(optimisticEntries);
      clearForm();
      
      // Track existing real IDs before making any API calls
      const existingRealIds = timesheetState.entries
        .filter(e => !e.id.toString().startsWith('temp-'))
        .map(e => e.id.toString());
      
      try {
        // Make API calls in background
        const apiResults = []; // Collect all API responses
        
        for (const employee of employeesToProcess) {
          const entryData = {
            project_code: selectedProjectCode,
            work_centre: selectedWorkCentreCode,
            hours: hours,
            entry_date: formattedDate
          };

          const requestBody = {
            staff_id: employee.id,
            date: formattedDate,
            entries: [entryData]
          };

          const response = await fetch('/api/timesheets/modify-line', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(requestBody)
          });

          if (!response.ok) {
            const err = await response.json();
            if (err.error === 'no_workbench_mapping') {
              throw new Error('Account not connected to Workbench');
            }
            throw new Error(err.message || 'Failed to save entry');
          }

          const result = await response.json();
          if (!result.success) {
            throw new Error(result.message || 'Failed to save entry');
          }
          
          // Store result with employee info for processing after all API calls
          const employeeIndex = employeesToProcess.indexOf(employee);
          apiResults.push({ 
            result, 
            employee, 
            optimisticEntry: optimisticEntries[employeeIndex] 
          });
        }

        // Success: Update IDs with real IDs from server responses
        apiResults.forEach(({ result, employee, optimisticEntry }) => {
          logger.debug('API response result:', result); // Debug: see response structure
          
          // Extract new JobTranIds from the Workbench response
          if (result.result && result.result.Rows) {
            // Find all NEW JobTranIds that weren't in our list before
            const newJobTranIds = result.result.Rows
              .map(row => row.Key.JobTranId.toString())
              .filter(id => !existingRealIds.includes(id));
            
            logger.debug('Found new JobTranIds:', newJobTranIds);
            logger.debug('Looking for optimistic entry:', optimisticEntry.id);
            
            // If we found new IDs, use the first one for this entry
            // (This assumes single entry additions, which is the case here)
            if (newJobTranIds.length > 0) {
              const realId = newJobTranIds[0];
              logger.debug(`Updating temp ID ${optimisticEntry.id} to real ID ${realId}`);
              updateOptimisticEntryId(optimisticEntry.id, realId);
              clearOptimisticFlags(realId);
              
              // Add this new ID to our tracking list for subsequent API calls
              existingRealIds.push(realId);
            } else {
              logger.warn('No new JobTranIds found in response');
              // Just clear optimistic flags without updating ID
              clearOptimisticFlags(optimisticEntry.id);
            }
          } else {
            logger.warn('Unexpected response structure:', result);
            // Just clear optimistic flags without updating ID
            clearOptimisticFlags(optimisticEntry.id);
          }
        });

      } catch (error) {
        logger.error('Error adding entry:', error);
        
        // Rollback: Remove optimistic entries
        removeOptimisticEntries(optimisticEntries);
        
        showNotification(`Failed to add entry: ${error.message}`, 'error');
      } finally {
        timesheetState.isSaving = false;
        updateAddButtonState();
      }
    }

    async function deleteEntry(entryId) {
      if (timesheetState.isSaving || timesheetState.isDeletingEntry) return;
      
      const entry = timesheetState.entries.find(e => e.id === entryId);
      if (!entry) return;

      // Check if this is a temp ID that hasn't been saved yet
      if (entryId.toString().startsWith('temp-')) {
        showNotification('Please wait for the entry to save before deleting', 'info');
        return;
      }

      showConfirmationDialog('Are you sure you want to delete this entry?', () => {
        performDeleteEntry(entryId, entry);
      });
    }

    async function performDeleteEntry(entryId, entry) {
      // Prevent deletion while saving (with temp ID)
      if (timesheetState.isSaving) {
        showNotification('Please wait for entries to finish saving before deleting', 'info');
        return;
      }

      // Optimistically remove from UI immediately
      const removedEntry = removeOptimisticEntry(entryId);
      if (!removedEntry) return;

      timesheetState.isDeletingEntry = entryId;

      try {
        // Skip API call for optimistic entries that haven't been saved yet
        if (entry._optimistic) {
          // Entry was never saved to Workbench, just remove from UI
          return;
        }

        // Extract work centre code from full description (handles both formats)
        const workCentreCode = entry.work_centre.includes(' - ') 
          ? entry.work_centre.split(' - ')[0] 
          : entry.work_centre;

        const delPayload = {
          id: entry.id,
          project_code: entry.project_code,
          work_centre: workCentreCode,
          hours: entry.hours,
          entry_date: entry.entry_date,
          delete: true
        };

        const requestBody = {
          staff_id: entry.employee_id,
          date: formatDateForSubmission(timesheetState.currentDate),
          entries: [delPayload]
        };

        const response = await fetch('/api/timesheets/modify-line', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(requestBody)
        });

        if (!response.ok) {
          const err = await response.json();
          throw new Error(err.message || 'Failed to delete entry');
        }

        const result = await response.json();
        if (!result.success) {
          throw new Error(result.message || 'Failed to delete entry');
        }

        // Success - entry stays deleted

      } catch (error) {
        logger.error('Error deleting entry:', error);
        
        // Rollback: Restore the entry
        restoreEntry(removedEntry.entry, removedEntry.index);
        
        showNotification(`Failed to delete: ${error.message}`, 'error');
      } finally {
        timesheetState.isDeletingEntry = null;
      }
    }

    function startEditing(entryId) {
      // Check if this is a temp ID that hasn't been saved yet
      if (entryId.toString().startsWith('temp-')) {
        showNotification('Please wait for the entry to save before editing', 'info');
        return;
      }
      
      // Simplified editing - would need more implementation for inline editing
      const entry = timesheetState.entries.find(e => e.id === entryId);
      if (!entry) return;
      
      showInputDialog('Enter new hours:', entry.hours.toString(), (value) => {
        const newHours = parseFloat(value);
        if (!isNaN(newHours) && newHours > 0) {
          editEntry(entryId, newHours);
        } else {
          showNotification('Please enter a valid number of hours', 'error');
        }
      });
    }

    async function editEntry(entryId, newHours) {
      const entry = timesheetState.entries.find(e => e.id === entryId);
      if (!entry) return;

      const originalHours = entry.hours;

      // Update UI immediately with optimistic change
      updateOptimisticEntry(entryId, { hours: newHours });

      try {
        // Skip API call for optimistic entries that haven't been saved yet
        if (entry._optimistic && entry._optimisticType === 'add') {
          // Entry is still pending, just update locally
          clearOptimisticFlags(entryId);
          return;
        }

        const payload = {
          id: entry.id,
          project_code: entry.project_code,
          work_centre: entry.work_centre,
          hours: newHours,
          entry_date: entry.entry_date
        };

        const requestBody = {
          staff_id: entry.employee_id,
          date: formatDateForSubmission(timesheetState.currentDate),
          entries: [payload]
        };

        const response = await fetch('/api/timesheets/modify-line', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(requestBody)
        });

        if (!response.ok) {
          const err = await response.json();
          throw new Error(err.message || 'Failed to update entry');
        }

        const result = await response.json();
        if (!result.success) {
          throw new Error(result.message || 'Failed to update entry');
        }

        // Success: Clear optimistic flags
        clearOptimisticFlags(entryId);

      } catch (error) {
        logger.error('Error editing entry:', error);
        
        // Rollback: Restore original hours
        updateOptimisticEntry(entryId, { hours: originalHours });
        clearOptimisticFlags(entryId);
        
        showNotification(`Failed to update: ${error.message}`, 'error');
      }
    }

    // Event handlers
    function setupEventListeners() {
      // Mode toggle
      document.getElementById('mode-toggle-btn').addEventListener('click', function() {
        timesheetState.isTeamMode = !timesheetState.isTeamMode;
        updateModeToggle();
        
        if (!timesheetState.isTeamMode) {
          timesheetState.selectedEmployees = [];
          updateSelectedEmployees();
        } else {
          // Auto-select current user when switching to team mode
          if (window.loggedInAccountId && timesheetState.employees.length > 0) {
            const currentUser = timesheetState.employees.find(emp => String(emp.user_id) === String(window.loggedInAccountId));
            if (currentUser && !timesheetState.selectedEmployees.some(e => e.id === currentUser.user_id)) {
              timesheetState.selectedEmployees = [{ id: currentUser.user_id, name: currentUser.full_name }];
              updateSelectedEmployees();
              renderEmployeeList();
            }
          }
        }
        
        loadEntriesForDay();
      });

      // Employee selection toggle
      document.getElementById('select-team-btn').addEventListener('click', function() {
        const selector = document.getElementById('employee-selector');
        selector.classList.toggle('active');
        this.textContent = selector.classList.contains('active') ? 'Close' : 'Select Employees';
      });

      // Select all employees
      document.getElementById('select-all-btn').addEventListener('click', function() {
        timesheetState.selectedEmployees = timesheetState.employees.map(emp => ({
          id: emp.user_id,
          name: emp.full_name
        }));
        updateSelectedEmployees();
        renderEmployeeList();
        loadEntriesForDay();
      });

      // Clear employee selection
      document.getElementById('clear-all-btn').addEventListener('click', function() {
        timesheetState.selectedEmployees = [];
        updateSelectedEmployees();
        renderEmployeeList();
        loadEntriesForDay();
      });

      // Day navigation
      document.getElementById('prev-day-btn').addEventListener('click', function() {
        timesheetState.currentDate = new Date(timesheetState.currentDate.getTime() - (24 * 60 * 60 * 1000));
        updateDateDisplay();
        loadEntriesForDay();
      });

      document.getElementById('next-day-btn').addEventListener('click', function() {
        timesheetState.currentDate = new Date(timesheetState.currentDate.getTime() + (24 * 60 * 60 * 1000));
        updateDateDisplay();
        loadEntriesForDay();
      });

      // Project search - connect to work centre loading
      const projectSearch = document.getElementById('project-search');
      projectSearch.addEventListener('change', function() {
        const searchValue = this.value;
        if (searchValue) {
          // Find the project by the display value (project_code - description)
          const project = timesheetState.projectData.find(p => {
            const displayValue = `${p.project_code} - ${p.description}`;
            return displayValue === searchValue || p.project_code === searchValue;
          });
          if (project) {
            selectProject(project);
          } else {
            timesheetState.selectedProject = null;
          }
        } else {
          timesheetState.selectedProject = null;
        }
        updateAddButtonState();
      });

      // Hours input
      const hoursInput = document.getElementById('hours');
      hoursInput.addEventListener('input', function() {
        const timeDisplay = document.getElementById('time-format-display');
        const newHours = parseFloat(this.value);

        if (this.value && newHours > 0) {
          // Calculate what the total would be for each affected employee
          let employeesToCheck = [];
          if (timesheetState.isTeamMode) {
            employeesToCheck = timesheetState.selectedEmployees.map(e => ({ id: e.id, name: e.name }));
          } else if (window.loggedInAccountId) {
            employeesToCheck = [{ id: window.loggedInAccountId, name: window.currentUserName || 'Me' }];
          }

          if (employeesToCheck.length > 0) {
            // Calculate prospective totals
            const totalsInfo = employeesToCheck.map(emp => {
              const currentHours = calculateDailyHours(emp.id);
              const prospectiveTotal = currentHours + newHours;
              return {
                name: emp.name,
                current: currentHours,
                total: prospectiveTotal,
                exceeds: prospectiveTotal > 24
              };
            });

            // Build display text
            if (timesheetState.isTeamMode && employeesToCheck.length > 0) {
              // Team mode: show each employee's prospective total
              const displayLines = totalsInfo.map(info => {
                const totalText = `${info.name}: ${info.total.toFixed(2)}h total`;
                return info.exceeds ? `${totalText} ⚠️ EXCEEDS 24h!` : totalText;
              });
              timeDisplay.innerHTML = displayLines.join('<br>');

              // Add warning styling if any exceed
              if (totalsInfo.some(info => info.exceeds)) {
                timeDisplay.style.color = 'var(--error)';
                timeDisplay.style.fontWeight = '600';
              } else {
                timeDisplay.style.color = 'var(--text-secondary)';
                timeDisplay.style.fontWeight = 'normal';
              }
            } else {
              // Personal mode: show single total
              const info = totalsInfo[0];
              if (info) {
                const totalText = `Total will be: ${info.total.toFixed(2)} hours`;
                timeDisplay.textContent = info.exceeds ? `${totalText} - EXCEEDS 24h LIMIT!` : totalText;

                if (info.exceeds) {
                  timeDisplay.style.color = 'var(--error)';
                  timeDisplay.style.fontWeight = '600';
                } else {
                  timeDisplay.style.color = 'var(--text-secondary)';
                  timeDisplay.style.fontWeight = 'normal';
                }
              }
            }
          } else {
            // No employees selected, just show conversion
            timeDisplay.textContent = convertToHoursMinutes(this.value);
            timeDisplay.style.color = 'var(--text-secondary)';
            timeDisplay.style.fontWeight = 'normal';
          }
        } else {
          timeDisplay.textContent = '';
          timeDisplay.style.color = 'var(--text-secondary)';
          timeDisplay.style.fontWeight = 'normal';
        }
        updateAddButtonState();
      });

      hoursInput.addEventListener('blur', function() {
        this.value = formatTimeValue(this.value);
        updateAddButtonState();
      });

      hoursInput.addEventListener('keyup', function(e) {
        if (e.key === 'Enter') {
          addEntry();
        }
      });

      // Work centre selection
      document.getElementById('work-centre').addEventListener('change', function() {
        updateAddButtonState();
      });

      // Add entry button
      document.getElementById('add-entry-btn').addEventListener('click', addEntry);

    }

    // Initialize application
    function initializeApp() {
      // Initialize date
      if (window.selectedDate) {
        timesheetState.currentDate = parseDateString(window.selectedDate);
      }

      // Initialize employees for team mode
      if (window.staff && Array.isArray(window.staff)) {
        timesheetState.employees = window.staff;
        timesheetState.isLoadingEmployees = false; // Set to false since we have the data
        logger.debug('Initialized employees from window.staff:', timesheetState.employees);
      } else {
        logger.debug('No staff data found in window.staff:', window.staff);
        timesheetState.isLoadingEmployees = false; // Set to false even if no data
      }

      // Ensure current user is in employee list
      if (window.loggedInAccountId && !timesheetState.employees.some(e => String(e.user_id) === String(window.loggedInAccountId))) {
        if (window.currentUserName && window.currentUserName !== 'Me') {
          timesheetState.employees.push({
            user_id: window.loggedInAccountId,
            full_name: window.currentUserName
          });
          logger.debug('Added current user to employees list:', window.currentUserName);
        }
      }

      // Initialize SearchSelectManager with project data
      logger.debug('Project data initialization:', {
        hasProjectData: !!timesheetState.projectData,
        projectCount: timesheetState.projectData ? timesheetState.projectData.length : 0,
        projects: timesheetState.projectData
      });
      
      if (timesheetState.projectData && timesheetState.projectData.length > 0) {
        // Populate datalist for backwards compatibility
        const datalist = document.getElementById('project-search-datalist');
        if (datalist) {
          datalist.innerHTML = '';
          timesheetState.projectData.forEach(project => {
            const option = document.createElement('option');
            const label = `${project.project_code} - ${project.description}`;
            option.value = label;
            option.textContent = label;
            datalist.appendChild(option);
          });
          logger.debug('Populated datalist with', timesheetState.projectData.length, 'projects');
        }

        // Set options for SearchSelectManager
        const projectOptions = timesheetState.projectData.map(project => ({
          label: `${project.project_code} - ${project.description}`,
          value: `${project.project_code} - ${project.description}`
        }));
        
        // Ensure SearchSelectManager is initialized and set options
        if (typeof SearchSelectManager !== 'undefined') {
          logger.debug('Setting SearchSelectManager options:', projectOptions.length, 'options');
          SearchSelectManager.setOptions('project-search', projectOptions);
        } else {
          logger.error('SearchSelectManager not available');
        }
      } else {
        logger.debug('No project data available for initialization');
      }

      // Setup UI
      updateDateDisplay();
      updateModeToggle();
      renderEmployeeList();
      
      // Setup event listeners
      setupEventListeners();

      // Load initial data
      loadEntriesForDay();
    }

    // Start when DOM is ready
    document.addEventListener('DOMContentLoaded', function() {
      // Initialize SearchSelectManager first
      if (typeof SearchSelectManager !== 'undefined') {
        SearchSelectManager.autoInit();
      }
      
      // Then initialize the app
      initializeApp();
    });