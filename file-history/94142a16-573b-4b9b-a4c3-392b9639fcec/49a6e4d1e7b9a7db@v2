## Implementation Plan

### Phase 1: Frontend - Dynamic Label Switching

#### A. Add Label Update Function (`/public/js/form.js`)

**Location**: After line 91 (between utility functions and addFirecell())

```javascript
/**
 * Updates the Occupant Load label based on risk group
 * SM/SI risk groups use "Bed Spaces" per CAS2 Table 1.2
 * Other risk groups use "Occupant Load"
 */
function updateOccupantLoadLabel(firecellElement, riskGroup) {
  // Find the occupant load input and its label
  const occupantLoadInput = firecellElement.querySelector('input[name*="occupantLoad"]');
  if (!occupantLoadInput) return;

  // Find the label (could be in different positions depending on when firecell was created)
  const parentDiv = occupantLoadInput.closest('div');
  const label = parentDiv ? parentDiv.querySelector('label') : null;

  if (!label) return;

  // Update label text and tooltip based on risk group
  if (riskGroup === 'SM' || riskGroup === 'SI') {
    label.textContent = 'Bed Spaces:';
    occupantLoadInput.setAttribute('title',
      'Number of beds (accounts for staff and visitors per CAS2 1.4.5)');
    occupantLoadInput.setAttribute('placeholder', 'e.g., 10 beds');
  } else {
    label.textContent = 'Occupant Load:';
    occupantLoadInput.setAttribute('title', 'Number of occupants');
    occupantLoadInput.setAttribute('placeholder', 'e.g., 50 people');
  }
}
```

#### B. Integrate Label Updates into Existing Functions

**1. Modify `toggleConditionalFields()` function** (line ~310):

```javascript
function toggleConditionalFields(selectElement) {
  const firecell = selectElement.closest('.firecell-item');
  const vpFields = firecell.querySelector('.vp-only');
  const caFields = firecell.querySelector('.ca-only');

  // Hide all conditional fields first
  if (vpFields) vpFields.style.display = 'none';
  if (caFields) caFields.style.display = 'none';

  // Show relevant fields based on risk group
  if (selectElement.value === 'VP' && vpFields) {
    vpFields.style.display = 'block';
  } else if (selectElement.value === 'CA' && caFields) {
    caFields.style.display = 'block';
  }

  // ADD THIS: Update occupant load label based on risk group
  updateOccupantLoadLabel(firecell, selectElement.value);
}
```

