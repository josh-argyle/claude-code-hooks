const getInstallerUsers = async (req, res) => {
  try {
    const currentUserId = req.session.userId;
    const currentProfitCentre = req.session.profit_centre;

    if (!currentUserId) {
      return res.status(401).json({ error: 'User not authenticated', code: 'AUTH_REQUIRED' });
    }

    if (!currentProfitCentre) {
      return res.status(400).json({ error: 'User profit centre not found in session', code: 'NOT_FOUND' });
    }

    // Get users with 'user' role in current user's profit centre, but exclude supervisory roles
    // This ensures we only get field workers/installers, not supervisors who also have 'user' role
    const users = await userService.getUsersByRoles(
      ['user'],
      [currentProfitCentre],
      { excludeRoles: ['foreman', 'project_manager', 'admin'], onlyActive: true, includeRoleDetails: true }
    );
    res.json(users);
  } catch (error) {
    logger.error('Error in getInstallerUsers controller:', { error: error.message });
    res.status(500).json({ error: 'Internal server error', code: 'INTERNAL_ERROR' });
  }
};

const switchUser = async (req, res) => {
  try {
    const { targetUserId } = req.body;
    const currentUserId = req.session.userId;
    const originalUserId = req.session.originalUserId || currentUserId;

    if (!currentUserId) {
      return res.status(401).json({ error: 'User not authenticated', code: 'AUTH_REQUIRED' });
    }

    // Check if original user has admin role and username 'admin'
    const originalUser = await userService.getUserByIdFull(originalUserId);
    if (!originalUser) {
      return res.status(404).json({ error: 'Original user not found', code: 'NOT_FOUND' });
    }

    const hasAdminRole = originalUser.users_roles.some(ur => ur.role.role_name === 'admin');
    const isAdminUsername = originalUser.username === 'admin';
    if (!hasAdminRole || !isAdminUsername) {
      return res.status(403).json({ error: 'Only the admin user can switch accounts', code: 'ACCESS_DENIED' });
    }

    // Handle switching back to original admin
    if (targetUserId === 'original') {
      const adminUser = await userService.getUserByIdFull(originalUserId);
      if (!adminUser) {
        return res.status(404).json({ error: 'Original admin user not found', code: 'NOT_FOUND' });
      }

      req.session.userId = originalUserId;
      req.session.username = adminUser.username;
      req.session.roles = adminUser.users_roles.map(ur => ur.role.role_name);
      delete req.session.originalUserId;
      // Keep adminUserList for future switches

      return res.json({ message: 'Switched back to original admin user' });
    }

    // Get target user
    const targetUser = await userService.getUserByIdFull(targetUserId);
    if (!targetUser) {
      return res.status(404).json({ error: 'Target user not found', code: 'NOT_FOUND' });
    }

    // Cache user list if not already cached (for admin switching)
    if (!req.session.adminUserList) {
      const allUsers = await userService.getUsersByRoles([], [], {
        allRoles: true,
        includeEmail: true,
        includeStatus: true,
        includeRoleDetails: false // Keep as comma-separated string like original getAllUsers
      });
      req.session.adminUserList = allUsers;
    }

    // Switch to target user
    req.session.originalUserId = originalUserId;
    req.session.userId = targetUser.user_id;
    req.session.username = targetUser.username;
    req.session.roles = targetUser.users_roles.map(ur => ur.role.role_name);
    // Keep adminUserList for switching back

    res.json({ message: 'User switched successfully' });
  } catch (error) {
    logger.error('Error in switchUser controller:', { error: error.message });
    res.status(500).json({ error: 'Internal server error', code: 'INTERNAL_ERROR' });
  }
};

