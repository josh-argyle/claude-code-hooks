const updateUserPurchaseOrderLimit = async (req, res) => {
  try {
    const { id } = req.params;
    const { limit_amount } = req.body;
    const setByUserId = req.session.userId;

    // Validate limit_amount
    if (limit_amount === null || limit_amount === undefined) {
      return res.status(400).json({ error: 'Limit amount is required', code: 'BAD_REQUEST' });
    }

    const numericLimit = parseFloat(limit_amount);
    if (isNaN(numericLimit) || numericLimit < 0 || numericLimit > 99999.99) {
      return res.status(400).json({ error: 'Limit amount must be between 0 and 99,999.99', code: 'BAD_REQUEST' });
    }

    const updatedLimit = await userService.updateUserPurchaseOrderLimit(id, numericLimit, setByUserId);
    res.json(updatedLimit);
  } catch (error) {
    logger.error('Error in updateUserPurchaseOrderLimit controller:', { error: error.message });
    if (error.message === 'User does not have a workbench user ID') {
      return res.status(400).json({ error: 'User does not have a workbench user ID', code: 'BAD_REQUEST' });
    }
    res.status(500).json({ error: 'Internal server error', code: 'INTERNAL_ERROR' });
  }
};

