const updateUserPassword = async (req, res) => {
  try {
    const { id } = req.params;
    const { password } = req.body;

    if (!password) {
      return res.status(400).json({ error: 'Password is required', code: 'BAD_REQUEST' });
    }

    if (password.length < 8) {
      return res.status(400).json({ error: 'Password must be at least 8 characters long', code: 'BAD_REQUEST' });
    }

    // Hash the password
    const hashedPassword = await bcrypt.hash(password, 10);

    const updatedUser = await userService.updateUserPassword(id, hashedPassword);
    res.json({ message: 'Password updated successfully', user_id: updatedUser.user_id });
  } catch (error) {
    logger.error('Error in updateUserPassword controller:', { error: error.message });
    res.status(500).json({ error: 'Internal server error', code: 'INTERNAL_ERROR' });
  }
};

const createUser = async (req, res) => {
  try {
    const { userData, contactData, role_ids } = req.body;
    const assignedBy = req.session.userId;

    if (!userData || !userData.username || !userData.password) {
      return res.status(400).json({ error: 'username and password are required', code: 'MISSING_FIELDS' });
    }

    if (userData.password.length < 8) {
      return res.status(400).json({ error: 'Password must be at least 8 characters long', code: 'BAD_REQUEST' });
    }

    // Hash password before creating user
    userData.password = await bcrypt.hash(userData.password, 10);

    const newUser = await userService.createUser(userData, contactData, role_ids, assignedBy);
    res.status(201).json(newUser);
  } catch (error) {
    logger.error('Error in createUser controller:', { error: error.message });
    if (error.code === 'P2002') {
      return res.status(400).json({ error: 'Username already exists', code: 'BAD_REQUEST' });
    }
    res.status(500).json({ error: 'Internal server error', code: 'INTERNAL_ERROR' });
  }
};

