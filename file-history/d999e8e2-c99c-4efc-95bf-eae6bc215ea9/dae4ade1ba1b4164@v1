const userService = require('../services/userService');
const bcrypt = require('bcryptjs');
const logger = require('../utils/logger');

const getUser = async (req, res) => {
  try {
    const { id } = req.params;
    const user = await userService.getUserById(id);

    if (!user) {
      return res.status(404).json({ error: 'User not found', code: 'NOT_FOUND' });
    }

    res.json(user);
  } catch (error) {
    res.status(500).json({ error: 'Internal server error', code: 'INTERNAL_ERROR' });
  }
};

const getAllUsers = async (req, res) => {
  try {
    // Check if this is an admin or a switched user who needs user list for switching back
    const originalUserId = req.session.originalUserId;
    const userRoles = req.session.roles || [];

    // Allow if user is admin OR if they are a switched user (has originalUserId)
    const isAdmin = userRoles.includes('admin');
    const isSwitchedUser = !!originalUserId;

    if (!isAdmin && !isSwitchedUser) {
      return res.status(403).json({ error: 'Access denied', code: 'ACCESS_DENIED' });
    }

    // For switched users, check if we have cached user list in session
    if (isSwitchedUser && req.session.adminUserList) {
      return res.json(req.session.adminUserList);
    }

    // Get users and cache them in session for future switches
    const users = await userService.getUsersByRoles([], [], {
      allRoles: true,
      includeEmail: true,
      includeStatus: true,
      includeRoleDetails: false // Keep as comma-separated string like original getAllUsers
    });

    // Cache the user list in session if this is an admin action
    if (isAdmin) {
      req.session.adminUserList = users;
    }

    res.json(users);
  } catch (error) {
    res.status(500).json({ error: 'Internal server error', code: 'INTERNAL_ERROR' });
  }
};

