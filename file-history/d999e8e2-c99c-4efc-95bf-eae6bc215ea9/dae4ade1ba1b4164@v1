const updateUser = async (req, res) => {
  try {
    const { id } = req.params;
    const { username, default_profit_centre, is_active } = req.body;

    // Debug logging
    logger.debug('Update user request:', {
      id,
      default_profit_centre,
      type: typeof default_profit_centre,
      length: default_profit_centre ? default_profit_centre.length : 0
    });

    const userData = {};
    if (username) userData.username = username;

    // Only add default_profit_centre if it's a non-empty string
    // profit_centre is no longer updatable - managed via staff_profit_centre_assignments
    if (default_profit_centre &&
        typeof default_profit_centre === 'string' &&
        default_profit_centre.trim() !== '') {
      // Validate the profit centre exists
      const validProfitCentres = await userService.getAllProfitCentres();
      const trimmedPC = default_profit_centre.trim();
      const isValid = validProfitCentres.some(pc => pc.profit_centre_code === trimmedPC);

      if (isValid) {
        userData.default_profit_centre = trimmedPC;
      } else {
        logger.warn(`Invalid profit centre code: "${trimmedPC}"`);
        // Don't add invalid profit centre to update
      }
    }

    if (typeof is_active === 'boolean') userData.is_active = is_active;

    const updatedUser = await userService.updateUser(id, userData);
    res.json(updatedUser);
  } catch (error) {
    logger.error('Error in updateUser controller:', { error: error.message });
    if (error.code === 'P2002') {
      return res.status(400).json({ error: 'Username already exists', code: 'BAD_REQUEST' });
    }
    res.status(500).json({ error: 'Internal server error', code: 'INTERNAL_ERROR' });
  }
};

