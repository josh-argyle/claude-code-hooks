/**
 * ESLint Rule: no-services-in-client-routes
 *
 * Prevents client routes from calling services directly and enforces proper
 * MVC architecture where client routes should only call controllers.
 *
 * Patterns detected:
 * - Service imports in client route files
 * - Service method calls (serviceObject.methodName())
 * - Direct service calls that violate architectural separation
 *
 * Proper architecture:
 * Client Routes → Controllers → Services → Database
 *
 * Not allowed:
 * Client Routes → Services → Database
 */

module.exports = {
  meta: {
    type: 'problem',
    docs: {
      description: 'Prevent client routes from calling services directly - should use controllers instead',
      category: 'Architectural Violations',
      recommended: true
    },
    fixable: null,
    schema: [
      {
        type: 'object',
        properties: {
          allowedExceptions: {
            type: 'array',
            items: { type: 'string' },
            description: 'Array of service names that are temporarily allowed (for gradual migration)'
          }
        },
        additionalProperties: false
      }
    ]
  },

  create(context) {
    const options = context.options[0] || {};
    const allowedExceptions = options.allowedExceptions || [];
    const filename = context.getFilename();

    // Only apply this rule to client route files
    const isClientRouteFile = filename.includes('/client/routes/') ||
                              filename.includes('\\client\\routes\\');

    if (!isClientRouteFile) {
      return {}; // Skip checking for non-client route files
    }

    const serviceImports = new Set();
    const serviceVariables = new Set();

    // Helper functions
    function looksLikeServiceCall(objectName, methodName) {
      // Service naming patterns
      const servicePatterns = [
        /Service$/, // ends with 'Service'
        /^[a-z]+Service$/ // camelCase ending with 'Service'
      ];

      // Method patterns that suggest service calls
      const serviceMethodPatterns = [
        /^get/, // getUsers, getData, etc.
        /^create/, // createUser, createData, etc.
        /^update/, // updateUser, updateData, etc.
        /^delete/, // deleteUser, deleteData, etc.
        /^fetch/, // fetchData, fetchUsers, etc.
        /^find/ // findUser, findAll, etc.
      ];

      const isServiceObject = servicePatterns.some(pattern => pattern.test(objectName));
      const isServiceMethod = serviceMethodPatterns.some(pattern => pattern.test(methodName));

      // Exclude common non-service objects
      const excludedObjects = ['req', 'res', 'router', 'app', 'express', 'logger', 'console'];

      return isServiceObject || (isServiceMethod && !excludedObjects.includes(objectName));
    }

    function isAllowedServiceCall(objectName, methodName) {
      // Temporary exceptions for certain patterns that might be acceptable
      // This can be configured via the allowedExceptions option

      // For example, utility services might be OK temporarily
      const utilityServices = ['dateUtils', 'logger', 'permissionHelper'];

      return utilityServices.includes(objectName);
    }

    return {
      // Detect service imports
      ImportDeclaration(node) {
        if (node.source.value.includes('/services/')) {
          const defaultImport = node.specifiers.find(spec => spec.type === 'ImportDefaultSpecifier');
          if (defaultImport) {
            serviceImports.add(defaultImport.local.name);
          }
        }
      },

      // Detect service requires
      VariableDeclarator(node) {
        // Check for service requires
        if (
          node.init &&
          node.init.type === 'CallExpression' &&
          node.init.callee.name === 'require' &&
          node.init.arguments.length === 1 &&
          node.init.arguments[0].type === 'Literal' &&
          node.init.arguments[0].value.includes('/services/')
        ) {
          const servicePath = node.init.arguments[0].value;
          const serviceName = servicePath.split('/').pop();

          // Extract variable name
          if (node.id.type === 'Identifier') {
            serviceImports.add(node.id.name);
            serviceVariables.add(node.id.name);

            context.report({
              node,
              message: `Client routes should not import services directly. '${serviceName}' should be accessed through a controller. Consider creating a controller method instead.`,
              data: { serviceName, variableName: node.id.name }
            });
          }
        }
      },

      // Detect service method calls
      CallExpression(node) {
        // Check for service method calls (e.g., serviceObject.methodName())
        if (
          node.callee.type === 'MemberExpression' &&
          node.callee.object.type === 'Identifier'
        ) {
          const objectName = node.callee.object.name;
          const methodName = node.callee.property.name;

          // Check if this is a known service object
          if (serviceImports.has(objectName) && !allowedExceptions.includes(objectName)) {
            // Special exceptions for certain patterns
            const isAllowedPattern = isAllowedServiceCall(objectName, methodName);

            if (!isAllowedPattern) {
              context.report({
                node,
                message: `Client routes should not call service methods directly. '${objectName}.${methodName}()' violates MVC architecture. Create a controller method instead.`,
                data: { serviceName: objectName, methodName }
              });
            }
          }

          // Also catch service calls by pattern (even if import wasn't detected)
          if (looksLikeServiceCall(objectName, methodName) && !allowedExceptions.includes(objectName)) {
            context.report({
              node,
              message: `Potential service call detected: '${objectName}.${methodName}()'. Client routes should only call controllers, not services directly.`,
              data: { serviceName: objectName, methodName }
            });
          }
        }

        // Check for await service calls
        if (
          node.callee.type === 'MemberExpression' &&
          node.callee.object.type === 'Identifier'
        ) {
          const objectName = node.callee.object.name;
          const methodName = node.callee.property.name;

          // Look for common service patterns
          if (looksLikeServiceCall(objectName, methodName)) {
            const parent = node.parent;
            if (parent && parent.type === 'AwaitExpression') {
              context.report({
                node: parent,
                message: `Async service call detected: 'await ${objectName}.${methodName}()'. Client routes should delegate to controllers for business logic.`,
                data: { serviceName: objectName, methodName }
              });
            }
          }
        }
      }
    };
  }
};
