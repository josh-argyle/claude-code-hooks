{
  "env": {
    "browser": true,
    "node": true,
    "es2021": true
  },
  "extends": [
    "standard"
  ],
  "plugins": [],
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "rules": {
    "indent": ["error", 2],
    "quotes": ["error", "single"],
    "semi": ["error", "always"],
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-console": "off",
    "comma-dangle": ["error", "never"],
    "space-before-function-paren": ["error", {
      "anonymous": "always",
      "named": "never",
      "asyncArrow": "always"
    }],
    "no-restricted-syntax": [
      "error",
      {
        "selector": "CallExpression[callee.object.type='Identifier'][callee.property.name=/^(setFullYear|setMonth|setDate|setHours|setMinutes|setSeconds|setUTCFullYear|setUTCMonth|setUTCDate|setUTCHours|setUTCMinutes|setUTCSeconds)$/]",
        "message": "Avoid custom date manipulation. Use dateUtils.js utilities instead for consistent date handling."
      },
      {
        "selector": "CallExpression[callee.object.type='Identifier'][callee.property.name='toLocaleDateString']",
        "message": "Avoid custom date formatting. Use standardized formatting utilities from dateUtils.js."
      },
      {
        "selector": "CallExpression[callee.object.type='Identifier'][callee.property.name='toISOString']",
        "message": "Consider using dateUtils.js for consistent date formatting across the application."
      },
      {
        "selector": "CallExpression[callee.property.name='setMonth'] > BinaryExpression[operator=/^[+\\-]$/]",
        "message": "Manual date arithmetic detected. Use dateUtils.js utilities for date calculations to avoid timezone issues."
      },
      {
        "selector": "Literal[value=/.*<svg.*/]",
        "message": "Inline SVG string detected. Use Icons.getIcon('icon-name') instead for consistency and performance."
      },
      {
        "selector": "AssignmentExpression[left.property.name='innerHTML'] > Literal[value=/.*<svg.*/]",
        "message": "SVG in innerHTML detected. Use Icons.getIcon('icon-name') for better performance."
      },
      {
        "selector": "Literal[value=/.*data-lucide.*/]",
        "message": "Legacy Lucide data-lucide attribute detected. Use Icons.getIcon('icon-name') or +icon('icon-name') in templates."
      },
      {
        "selector": "CallExpression[callee.property.name='createElement'][arguments.0.value='svg']",
        "message": "Custom SVG element creation detected. Consider using Icons.getIcon() for standard icons."
      },
      {
        "selector": "Program > Comment[value=/^\\s*global\\s+/]",
        "message": "Do not use /* global */ comments. Add global variables to .eslintrc.json instead."
      },
      {
        "selector": "Literal[value=/style\\s*=\\s*[\"'][^\"']*(?:background|color|border|padding|font|margin|width|height)[^\"']*[\"']/]",
        "message": "Inline button styling detected. Use standardized button classes from refactor-buttons.css instead."
      },
      {
        "selector": "NewExpression[callee.name='PrismaClient']",
        "message": "Direct PrismaClient instantiation is not allowed. Use the singleton from '../utils/prisma.js' to prevent connection pool exhaustion."
      },
      {
        "selector": "VariableDeclarator[init.type='NewExpression'][init.callee.name='PrismaClient']",
        "message": "Direct PrismaClient instantiation detected. Replace with: const prisma = require('../utils/prisma');"
      },
      {
        "selector": "IfStatement[test.type='CallExpression'][test.callee.object.name='socketManager'][test.callee.property.name='isInitialized'] VariableDeclarator[init.type='CallExpression'][init.callee.object.name='socketManager'][init.callee.property.name='getIO']",
        "message": "Verbose socket emission pattern detected. Use socketManager.emit() or socketManager.emitToRoom() helper methods instead."
      },
      {
        "selector": "CallExpression[callee.object.type='CallExpression'][callee.object.callee.object.name='io'][callee.object.callee.property.name='to'][callee.property.name='emit']",
        "message": "Direct io.to().emit() usage detected. Use socketManager.emitToRoom(room, event, data) instead."
      },
      {
        "selector": "CallExpression[callee.object.name='io'][callee.property.name='emit']",
        "message": "Direct io.emit() usage detected. Use socketManager.emit(event, data) for global broadcasts."
      },
      {
        "selector": "FunctionDeclaration[id.name=/^(show|open|close|create|init|toggle|display|hide)Modal$/i]",
        "message": "Custom modal function detected. Use openNewModal/closeNewModal from the standard modal system instead."
      },
      {
        "selector": "VariableDeclarator[id.name=/^(show|open|close|create|init|toggle|display|hide)Modal$/i][init.type='FunctionExpression']",
        "message": "Custom modal function detected. Use openNewModal/closeNewModal from the standard modal system instead."
      },
      {
        "selector": "MethodDefinition[key.name=/^(show|open|close|create|init|toggle|display|hide)Modal$/i]",
        "message": "Custom modal method detected. Use openNewModal/closeNewModal from the standard modal system instead."
      },
      {
        "selector": "Property[method=true][key.name=/^(show|open|close|create|init|toggle|display|hide)Modal$/i]",
        "message": "Custom modal method detected. Use openNewModal/closeNewModal from the standard modal system instead."
      },
      {
        "selector": "Property[value.type='FunctionExpression'][key.name=/^(show|open|close|create|init|toggle|display|hide)Modal$/i]",
        "message": "Custom modal method detected. Use openNewModal/closeNewModal from the standard modal system instead."
      },
      {
        "selector": "Property[value.type='ArrowFunctionExpression'][key.name=/^(show|open|close|create|init|toggle|display|hide)Modal$/i]",
        "message": "Custom modal method detected. Use openNewModal/closeNewModal from the standard modal system instead."
      },
      {
        "selector": "CallExpression[callee.object.name='console'][callee.property.name='log']",
        "message": "Use logger from 'api/utils/logger' instead. Example: const logger = require('../utils/logger'); logger.info('message');"
      },
      {
        "selector": "CallExpression[callee.object.name='console'][callee.property.name='error']",
        "message": "Use logger from 'api/utils/logger' instead. Example: const logger = require('../utils/logger'); logger.error('message');"
      },
      {
        "selector": "CallExpression[callee.object.name='console'][callee.property.name='warn']",
        "message": "Use logger from 'api/utils/logger' instead. Example: const logger = require('../utils/logger'); logger.warn('message');"
      },
      {
        "selector": "CallExpression[callee.object.name='console'][callee.property.name='info']",
        "message": "Use logger from 'api/utils/logger' instead. Example: const logger = require('../utils/logger'); logger.info('message');"
      },
      {
        "selector": "CallExpression[callee.object.name='console'][callee.property.name='debug']",
        "message": "Use logger from 'api/utils/logger' instead. Example: const logger = require('../utils/logger'); logger.debug('message');"
      },
      {
        "selector": "CallExpression[callee.type='MemberExpression'][callee.property.name='json'][callee.object.type='CallExpression'][callee.object.callee.property.name='status'] > ObjectExpression[properties.length=1][properties.0.key.name='error']",
        "message": "Error responses must include both 'error' and 'code' fields. Expected format: { error: 'message', code: 'ERROR_CODE', details?: {...} }"
      }
      // TEMPORARILY DISABLED - Pagination rules
      // {
      //   "selector": "CallExpression[callee.object.name='res'][callee.property.name='json'] > Identifier[name=/^(companies|users|articles|templates|initiatives|projects|suppliers|contacts|surveys|campaigns|reports)$/]",
      //   "message": "List endpoints should return paginated responses. Expected format: res.json({ data: [...], pagination: { page, limit, total, hasNext, hasPrev } })"
      // },
      // {
      //   "selector": "CallExpression[callee.object.name='res'][callee.property.name='json'] > CallExpression[callee.object.name=/Service$/][callee.property.name=/^getAll/]",
      //   "message": "List endpoints should return paginated responses. Expected format: res.json({ data: [...], pagination: { page, limit, total, hasNext, hasPrev } })"
      // }
    ]
  },
