        }],
        "no-console": "error",
        "camelcase": "off",
        "no-restricted-syntax": [
          "error",
          {
            "selector": "VariableDeclarator[id.name='logger']",
            "message": "Logger redeclaration detected. The 'logger' is already available as a global variable - use it directly without declaration."
          },
          {
            "selector": "CallExpression[callee.object.name='console'][callee.property.name='log']",
            "message": "Use logger.info() or logger.debug() instead. The 'logger' object is globally available in frontend files."
          },
          {
            "selector": "CallExpression[callee.object.name='console'][callee.property.name='error']",
            "message": "Use logger.error() instead. The 'logger' object is globally available in frontend files."
          },
          {
            "selector": "CallExpression[callee.object.name='console'][callee.property.name='warn']",
            "message": "Use logger.warn() instead. The 'logger' object is globally available in frontend files."
          },
          {
            "selector": "CallExpression[callee.object.name='console'][callee.property.name='info']",
            "message": "Use logger.info() instead. The 'logger' object is globally available in frontend files."
          },
          {
            "selector": "CallExpression[callee.object.name='console'][callee.property.name='debug']",
            "message": "Use logger.debug() instead. The 'logger' object is globally available in frontend files."
          },
          {
            "selector": "CallExpression[callee.name='fetch']",
            "message": "Use ApiClient methods instead of direct fetch() calls. Examples: ApiClient.get(url), ApiClient.post(url, data). This ensures consistent error handling, loading states, and request management."
          },
          {
            "selector": "CallExpression[callee.object.property.name='classList'][callee.property.name='add'] > Literal[value=/^[a-z]+-[a-z]+-[a-z]+$/]",
            "message": "Multi-hyphen class names should use BEM convention. Instead of 'word-word-word', use 'block__element--modifier'. Example: 'card-header-large' → 'card__header--large'"
          },
          {
            "selector": "Literal[value=/class\\s*=\\s*[\"'][^\"']*[a-z]+-[a-z]+-[a-z]+/]",
            "message": "Multi-hyphen class names in templates should use BEM convention. Instead of 'word-word-word', use 'block__element--modifier'. Example: 'card-header-large' → 'card__header--large'"
          },
          {
            "selector": "CallExpression[callee.object.property.name='classList'][callee.property.name='add'] > Literal[value='error']",
            "message": "Consider using FormValidator.setFieldState() instead of manually adding 'error' class. Example: FormValidator.setFieldState(field, 'error', 'Error message')"
          },
          {
            "selector": "AssignmentExpression[left.property.name='innerHTML'][right.type='TemplateLiteral'] Literal[value=/.*loading.*/i]",
            "message": "Use LoadingManager.show() instead of manual loading HTML. Example: LoadingManager.show(element, { message: 'Loading...' })"
          },
          {
            "selector": "AssignmentExpression[left.property.name='innerHTML'][right.type='Literal'][right.value=/.*loading.*/i]",
            "message": "Use LoadingManager.show() instead of manual loading HTML. Example: LoadingManager.show(element, { message: 'Loading...' })"
          },
          {
            "selector": "CallExpression[callee.object.property.name='classList'][callee.property.name='add'] > Literal[value=/^(loading|spinner|is-loading)$/]",
            "message": "Use LoadingManager.show() instead of manually adding loading classes. Example: LoadingManager.show(element, options)"
          }
        ]
      }
    },
    {
      "files": ["api/**/*.js"],
      "plugins": ["local-rules"],
      "rules": {
        "camelcase": "off",
        "local-rules/require-error-code": "error"
      }
    },
    {
      "files": ["client/routes/clientRoutes.js"],
      "plugins": ["local-rules"],
      "rules": {
        "local-rules/no-services-in-client-routes": "error"
      }
    },
    {
      "files": ["api/routes/**/*.js"],
      "plugins": ["jsdoc"],
      "rules": {
        "jsdoc/require-jsdoc": ["error", {
          "require": {
            "FunctionDeclaration": false,
            "MethodDefinition": false,
            "ClassDeclaration": false,
            "ArrowFunctionExpression": false,
            "FunctionExpression": false
          },
          "contexts": [
            "CallExpression[callee.object.name='router'][callee.property.name=/^(get|post|put|delete|patch)$/]"
          ]
        }],
        "jsdoc/require-description": "off",
        "jsdoc/check-tag-names": ["error", {
          "definedTags": ["route", "access", "description"]
        }],
        "jsdoc/tag-lines": "off",
        "jsdoc/require-param": "off",
        "jsdoc/require-returns": "off",
        "jsdoc/check-values": "off"
      }
    },
    {
      "files": ["api/services/**/*.js"],
      "rules": {
        "no-restricted-syntax": [
          "warn",
          {
            "selector": "ClassDeclaration",
            "message": "Services should export individual functions, not classes. Use: module.exports = { functionName }"
          },
          {
            "selector": "ExportDefaultDeclaration",
            "message": "Use module.exports instead of export default in services"
          }
        ]
      }
    },
    {
      "files": ["api/controllers/**/*.js"],
      "rules": {
        "no-restricted-syntax": [
          "warn",
          {
            "selector": "ClassDeclaration",
            "message": "Controllers should be object literals. Use: const controllerName = { methods }; module.exports = controllerName;"
          },
          {
            "selector": "ExportDefaultDeclaration",
            "message": "Use module.exports instead of export default in controllers"
