      "files": ["public/js/icons.js", "docs/**/*.js", "eslint-plugin-local-rules.js", "api/utils/prisma.js", "api/utils/logger.js", "api/scripts/**/*.js", "api/sockets/**/*.js", "api/utils/socketManager.js", "api/services/notificationService.js"],
      "rules": {
        "no-restricted-syntax": "off"
      }
    },
