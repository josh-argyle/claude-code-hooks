          {
            "selector": "CallExpression[callee.object.name='res'][callee.property.name='status'][arguments.0.value=500] ~ CallExpression[callee.property.name='json'] > ObjectExpression > Property[key.name='error'][value.type='Literal'][value.value='Internal server error']",
            "message": "Use specific error messages with codes. Example: { error: 'Database connection failed', code: 'DB_CONNECTION_ERROR', details: {...} }"
          }
        ]
      }
    },
