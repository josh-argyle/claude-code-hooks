#!/usr/bin/env node
require('dotenv').config();

// ===== EXISTING IMPORTS - REUSE EVERYTHING =====
const { getTimesheetsForUser } = require('../../api/workbench/facades/timesheetsFacade');
const { getUsersByRoles } = require('../../api/services/userService');
const NotificationService = require('../../api/services/notificationService');
const prisma = require('../../api/utils/prisma');
const { getCurrentDateUTC, endOfDay, addDays } = require('../../public/js/dateUtils');
const logger = require('../../api/utils/logger');

// ===== CONFIGURATION =====
const CONFIG = {
  title: 'Submit Your Timesheet',
  message: 'Please submit your timesheet for this week by tonight.',
  link: '/timesheet-history'
};

// ===== MAIN LOGIC =====
async function runTimesheetReminders() {
  logger.info('Starting timesheet reminder job');

  try {
    // 1. Get all active users with Workbench mapping
    const users = await getUsersByRoles(
      [], // Empty roles array
      [], // Empty profit centres
      {
        allRoles: true,      // Get all users regardless of role
        onlyActive: true,    // Only active users
        includeEmail: true   // Include email for notifications
      }
    );

    // Filter to only users with Workbench mapping
    const eligibleUsers = users.filter(u => u.workbench_user_id);

    logger.info(`Found ${eligibleUsers.length} eligible users with Workbench mapping`);

    // 2. Check each user for existing pending todos (avoid duplicates)
    const existingTodos = await prisma.notifications_recipients.findMany({
      where: {
        user_id: { in: eligibleUsers.map(u => u.user_id) },
        is_actionable: true,
        is_completed: false
      },
      include: {
        notification: true
      }
    });

    const usersWithPendingTodos = new Set(
      existingTodos
        .filter(t => t.notification && t.notification.title === CONFIG.title)
        .map(t => t.user_id)
    );

    // 3. Check each user's timesheet completion status
    const incompleteUsers = [];

    for (const user of eligibleUsers) {
      // Skip if user already has a pending todo
      if (usersWithPendingTodos.has(user.user_id)) {
        logger.debug(`User ${user.user_id} already has pending timesheet todo, skipping`);
        continue;
      }

      try {
        const timesheets = await getTimesheetsForUser(user.workbench_user_id);

        // Check most recent timesheet (current week)
        if (!timesheets || timesheets.length === 0 || !timesheets[0].Completed) {
          incompleteUsers.push(user);
        }
      } catch (error) {
        logger.error(`Failed to check timesheet for user ${user.user_id}:`, error.message);
        // On error, assume incomplete (better to send reminder)
        incompleteUsers.push(user);
      }
    }

    logger.info(`Found ${incompleteUsers.length} users with incomplete timesheets needing reminders`);

    // 4. Calculate due date (next Sunday at 11:59pm NZDT)
    const today = getCurrentDateUTC();
    const dayOfWeek = today.getUTCDay(); // 0=Sunday
    const daysUntilSunday = dayOfWeek === 0 ? 0 : 7 - dayOfWeek;
    const nextSunday = addDays(today, daysUntilSunday);
    const dueDate = endOfDay(nextSunday);

    // 5. Create TODO for each user with incomplete timesheet
    let successCount = 0;
    let errorCount = 0;

    for (const user of incompleteUsers) {
      try {
        // Create todo notification with link
        const todo = await NotificationService.createTodo(
          user.user_id,     // created by (system)
          CONFIG.title,
          CONFIG.message,
          dueDate,
          user.user_id      // assigned to
        );

        // Update the notification data to include link
        await prisma.notifications.update({
          where: { notification_id: todo.notification_id },
          data: {
            data: {
              link: CONFIG.link,
              created_by: 'system',
              reminder_type: 'timesheet'
            }
          }
        });

        successCount++;
      } catch (error) {
        logger.error(`Failed to create todo for user ${user.user_id}:`, error);
        errorCount++;
      }
    }

    // 6. Log results
    logger.info('Timesheet reminder job complete', {
      totalEligible: eligibleUsers.length,
      usersWithPendingTodos: usersWithPendingTodos.size,
      incompleteUsers: incompleteUsers.length,
      todosCreated: successCount,
      errors: errorCount
    });

    process.exit(0);
  } catch (error) {
    logger.error('Timesheet reminder job failed:', error);
    process.exit(1);
  }
}

// Run the job
runTimesheetReminders();
