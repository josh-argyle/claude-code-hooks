### Conditional Field Display (UX Enhancement)

**Problem:** Boundary distance question only applies to WB/VP unsprinklered buildings

**Solution:** Conditionally show/hide field based on firecell data

**JavaScript in `public/js/form.js`:**

```javascript
function updateBoundaryDistanceVisibility() {
  const firecells = document.querySelectorAll('.firecell-item');
  let needsBoundaryQuestion = false;

  firecells.forEach(firecell => {
    const riskGroup = firecell.querySelector('[name$="[riskGroup]"]')?.value;
    const isSprinklered = firecell.querySelector('[name$="[isSprinklered]"]')?.value === 'true';
    const floorArea = parseFloat(firecell.querySelector('[name$="[floorArea]"]')?.value) || 0;

    // Check if this firecell triggers boundary distance question
    if (['WB', 'VP'].includes(riskGroup) && !isSprinklered && floorArea >= 5000) {
      needsBoundaryQuestion = true;
    }
  });

  const boundaryField = document.getElementById('distanceFromBoundary15mOrMore')?.closest('div');
  if (boundaryField) {
    boundaryField.style.display = needsBoundaryQuestion ? 'block' : 'none';

    // Update required attribute
    const select = document.getElementById('distanceFromBoundary15mOrMore');
    if (select) {
      select.required = needsBoundaryQuestion;
    }
  }
}

// Call on page load and when relevant fields change
document.addEventListener('DOMContentLoaded', updateBoundaryDistanceVisibility);
// Add event listeners to firecell fields (riskGroup, isSprinklered, floorArea)
```

**Benefits:**
- Reduces form clutter for buildings that don't need it
- Makes it clear when boundary distance matters
- Improves user experience

