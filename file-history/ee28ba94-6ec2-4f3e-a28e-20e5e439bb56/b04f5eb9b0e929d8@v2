const ProjectModel = require('../../../api/models/project-model');

describe('ProjectModel', () => {
  let project;

  beforeEach(() => {
    project = new ProjectModel();
  });

  describe('Constructor', () => {
    test('should initialize with empty firecells array', () => {
      expect(project.firecells).toEqual([]);
      expect(project.getFirecellCount()).toBe(0);
    });

    test('should initialize requiresRemoteReceivingCentre to false', () => {
      expect(project.requiresRemoteReceivingCentre).toBe(false);
    });
  });

  describe('addFirecell', () => {
    test('should add valid firecell and return index', () => {
      const firecellData = {
        riskGroup: 'CA',
        occupantType: 'Office spaces',
        occupantLoad: 150.5,
        escapeHeight: 8.0,
        isSprinklered: true,
        floorArea: 1000
      };

      const index = project.addFirecell(firecellData);

      expect(index).toBe(0);
      expect(project.getFirecellCount()).toBe(1);
      expect(project.getFirecell(0)).toEqual({
        ...firecellData,
        compliance: {}
      });
    });

    test('should throw error for invalid risk group', () => {
      const firecellData = {
        riskGroup: 'INVALID',
        occupantType: 'Office spaces',
        occupantLoad: 150,
        escapeHeight: 8,
        isSprinklered: true,
        floorArea: 1000
      };

      expect(() => project.addFirecell(firecellData))
        .toThrow('Invalid risk group. Must be one of: SM, SI, CA, WB, WS, VP');
    });

    test('should throw error for invalid occupant type', () => {
      const firecellData = {
        riskGroup: 'CA',
        occupantType: 'Invalid Activity',
        occupantLoad: 150,
        escapeHeight: 8,
        isSprinklered: true,
        floorArea: 1000
      };

      expect(() => project.addFirecell(firecellData))
        .toThrow('Invalid occupant type: Invalid Activity');
    });

    test('should throw error for negative occupant load', () => {
      const firecellData = {
        riskGroup: 'CA',
        occupantType: 'Office spaces',
        occupantLoad: -10,
        escapeHeight: 8,
        isSprinklered: true,
        floorArea: 1000
      };

      expect(() => project.addFirecell(firecellData))
        .toThrow('Occupant load is required and must be a non-negative number');
    });

    test('should throw error for invalid escape height', () => {
      const firecellData = {
        riskGroup: 'CA',
        occupantType: 'Office spaces',
        occupantLoad: 150,
        escapeHeight: -5,
        isSprinklered: true,
        floorArea: 1000
      };

      expect(() => project.addFirecell(firecellData))
        .toThrow('Escape height is required and must be a non-negative number');
    });

    test('should throw error for non-boolean isSprinklered', () => {
      const firecellData = {
        riskGroup: 'CA',
        occupantType: 'Office spaces',
        occupantLoad: 150,
        escapeHeight: 8,
        isSprinklered: 'yes',
        floorArea: 1000
      };

      expect(() => project.addFirecell(firecellData))
        .toThrow('isSprinklered is required and must be a boolean');
    });

    test('should throw error for missing floor area', () => {
      const firecellData = {
        riskGroup: 'CA',
        occupantType: 'Office spaces',
        occupantLoad: 150,
        escapeHeight: 8,
        isSprinklered: true
      };

      expect(() => project.addFirecell(firecellData))
        .toThrow('Floor area is required and must be a positive number');
    });

    test('should throw error for invalid floor area', () => {
      const firecellData = {
        riskGroup: 'CA',
        occupantType: 'Office spaces',
        occupantLoad: 150,
        escapeHeight: 8,
        isSprinklered: true,
        floorArea: -100
      };

      expect(() => project.addFirecell(firecellData))
        .toThrow('Floor area is required and must be a positive number');
    });
  });

  describe('removeFirecell', () => {
    beforeEach(() => {
      project.addFirecell({
        riskGroup: 'CA',
        occupantType: 'Office spaces',
        occupantLoad: 150,
        escapeHeight: 8,
        isSprinklered: true,
        floorArea: 1000
      });
      project.addFirecell({
        riskGroup: 'WB',
        occupantType: 'Workrooms, workshops',
        occupantLoad: 75,
        escapeHeight: 5,
        isSprinklered: false,
        floorArea: 500
      });
    });

    test('should remove firecell and return it', () => {
      const removed = project.removeFirecell(0);

      expect(removed.riskGroup).toBe('CA');
      expect(project.getFirecellCount()).toBe(1);
      expect(project.getFirecell(0).riskGroup).toBe('WB');
    });

    test('should throw error for invalid index', () => {
      expect(() => project.removeFirecell(-1))
        .toThrow('Invalid firecell index');
      expect(() => project.removeFirecell(10))
        .toThrow('Invalid firecell index');
    });
  });

  describe('updateFirecell', () => {
    beforeEach(() => {
      project.addFirecell({
        riskGroup: 'CA',
        occupantType: 'Office spaces',
        occupantLoad: 150,
        escapeHeight: 8,
        isSprinklered: true,
        floorArea: 1000
      });
    });

    test('should update firecell properties', () => {
      const updates = {
        occupantLoad: 200,
        isSprinklered: false,
        floorArea: 1000
      };

      const updated = project.updateFirecell(0, updates);

      expect(updated.occupantLoad).toBe(200);
      expect(updated.isSprinklered).toBe(false);
      expect(updated.riskGroup).toBe('CA');
      expect(updated.occupantType).toBe('Office spaces');
    });

    test('should validate updated data', () => {
      const updates = {
        riskGroup: 'INVALID'
      };

      expect(() => project.updateFirecell(0, updates))
        .toThrow('Invalid risk group');
    });

    test('should throw error for invalid index', () => {
      expect(() => project.updateFirecell(-1, {}))
        .toThrow('Invalid firecell index');
    });
  });

  describe('getFirecell', () => {
    beforeEach(() => {
      project.addFirecell({
        riskGroup: 'CA',
        occupantType: 'Office spaces',
        occupantLoad: 150,
        escapeHeight: 8,
        isSprinklered: true,
        floorArea: 1000
      });
    });

    test('should return firecell by index', () => {
      const firecell = project.getFirecell(0);
      expect(firecell.riskGroup).toBe('CA');
    });

    test('should throw error for invalid index', () => {
      expect(() => project.getFirecell(-1))
        .toThrow('Invalid firecell index');
      expect(() => project.getFirecell(10))
        .toThrow('Invalid firecell index');
    });
  });

  describe('getAllFirecells', () => {
    test('should return copy of all firecells', () => {
      project.addFirecell({
        riskGroup: 'CA',
        occupantType: 'Office spaces',
        occupantLoad: 150,
        escapeHeight: 8,
        isSprinklered: true,
        floorArea: 1000
      });

      const allFirecells = project.getAllFirecells();

      expect(allFirecells).toHaveLength(1);
      expect(allFirecells[0].riskGroup).toBe('CA');

      // Should be a copy, not the original array
      expect(allFirecells).not.toBe(project.firecells);
    });
  });

  describe('validateFirecell', () => {
    test('should validate all risk groups', () => {
      const validRiskGroups = ['SM', 'SI', 'CA', 'WB', 'WS', 'VP'];

      validRiskGroups.forEach(riskGroup => {
        const firecellData = {
          riskGroup,
          occupantType: 'Office spaces',
          occupantLoad: 100,
          escapeHeight: 5,
          isSprinklered: false,
          floorArea: 1000
        };

        expect(() => project.validateFirecell(firecellData)).not.toThrow();
      });
    });

    test('should accept decimal values for occupant load', () => {
      const firecellData = {
        riskGroup: 'CA',
        occupantType: 'Office spaces',
        occupantLoad: 150.75,
        escapeHeight: 8.5,
        isSprinklered: true,
        floorArea: 1000
      };

      const validated = project.validateFirecell(firecellData);
      expect(validated.occupantLoad).toBe(150.75);
      expect(validated.escapeHeight).toBe(8.5);
    });

    test('should accept zero occupant load', () => {
      const firecellData = {
        riskGroup: 'WS',
        occupantType: 'Bulk storage including racks and shelves',
        occupantLoad: 0,
        escapeHeight: 6,
        isSprinklered: false,
        floorArea: 1000
      };

      expect(() => project.validateFirecell(firecellData)).not.toThrow();
    });

    test('should accept optional hasVehicleStacker for VP risk group', () => {
      const firecellData = {
        riskGroup: 'VP',
        occupantType: 'Parking buildings, garages',
        occupantLoad: 50,
        escapeHeight: 8,
        isSprinklered: false,
        floorArea: 5000,
        hasVehicleStacker: true
      };

      const validated = project.validateFirecell(firecellData);
      expect(validated.hasVehicleStacker).toBe(true);
    });

    test('should accept optional isCinemaOrTheatre for CA risk group', () => {
      const firecellData = {
        riskGroup: 'CA',
        occupantType: 'Office spaces',
        occupantLoad: 200,
        escapeHeight: 5,
        isSprinklered: false,
        floorArea: 1000,
        isCinemaOrTheatre: true
      };

      const validated = project.validateFirecell(firecellData);
      expect(validated.isCinemaOrTheatre).toBe(true);
    });

    test('should validate hasVehicleStacker is boolean when provided for VP', () => {
      const firecellData = {
        riskGroup: 'VP',
        occupantType: 'Parking buildings, garages',
        occupantLoad: 50,
        escapeHeight: 8,
        isSprinklered: false,
        floorArea: 5000,
        hasVehicleStacker: 'yes' // Invalid type
      };

      expect(() => project.validateFirecell(firecellData))
        .toThrow('hasVehicleStacker must be a boolean when provided');
    });

    test('should validate isCinemaOrTheatre is boolean when provided for CA', () => {
      const firecellData = {
        riskGroup: 'CA',
        occupantType: 'Office spaces',
        occupantLoad: 200,
        escapeHeight: 5,
        isSprinklered: false,
        floorArea: 1000,
        isCinemaOrTheatre: 'yes' // Invalid type
      };

      expect(() => project.validateFirecell(firecellData))
        .toThrow('isCinemaOrTheatre must be a boolean when provided');
    });

    test('should ignore hasVehicleStacker for non-VP risk groups', () => {
      const firecellData = {
        riskGroup: 'CA',
        occupantType: 'Office spaces',
        occupantLoad: 200,
        escapeHeight: 5,
        isSprinklered: false,
        floorArea: 1000,
        hasVehicleStacker: true
      };

      const validated = project.validateFirecell(firecellData);
      expect(validated.hasVehicleStacker).toBeUndefined();
    });

    test('should ignore isCinemaOrTheatre for non-CA risk groups', () => {
      const firecellData = {
        riskGroup: 'WB',
        occupantType: 'Office spaces',
        occupantLoad: 200,
        escapeHeight: 5,
        isSprinklered: false,
        floorArea: 1000,
        isCinemaOrTheatre: true
      };

      const validated = project.validateFirecell(firecellData);
      expect(validated.isCinemaOrTheatre).toBeUndefined();
    });
  });
});