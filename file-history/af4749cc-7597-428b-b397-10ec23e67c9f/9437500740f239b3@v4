const prisma = require('../utils/prisma');
const notificationService = require('./notificationService');
const logger = require('../utils/logger');

/**
 * Get all feedback reports
 * @param {Object} filters - Optional filters for status
 * @returns {Promise<Array>} Array of feedback reports
 */
const getAllFeedback = async (filters = {}) => {
  const where = {};

  if (filters.status) {
    where.status = filters.status;
  }

  return await prisma.feedback_reports.findMany({
    where,
    include: {
      user: {
        select: {
          username: true,
          users_contacts: {
            select: {
              first_name: true,
              surname: true
            }
          }
        }
      }
    },
    orderBy: [
      {
        status: 'asc' // active before inactive
      },
      {
        created_at: 'desc'
      }
    ]
  });
};

/**
 * Create a new feedback report
 * @param {Object} feedbackData - The feedback data
 * @returns {Promise<Object>} Created feedback report
 */
const createFeedback = async (feedbackData) => {
  const { userId, username, firstName, surname, feedback, isAnonymous } = feedbackData;

  // Use full name if available, otherwise fallback to username
  let displayName = username;
  if (!isAnonymous && firstName && surname) {
    displayName = `${firstName} ${surname}`.trim();
  } else if (!isAnonymous && (firstName || surname)) {
    displayName = `${firstName || ''} ${surname || ''}`.trim();
  }

  const newFeedback = await prisma.feedback_reports.create({
    data: {
      user_id: userId,
      username: isAnonymous ? 'Anonymous' : displayName,
      feedback,
      is_anonymous: isAnonymous,
      status: 'active'
    }
  });

  // Send notification to admin about new bug report
  try {
    // Get admin user
    const adminUser = await prisma.users.findUnique({
      where: { username: 'admin' },
      select: { user_id: true }
    });

    if (adminUser) {
      // Create feedback preview (first 200 characters)
      const feedbackPreview = feedback.length > 200
        ? feedback.substring(0, 200) + '...'
        : feedback;

      // Create notification to admin
      await notificationService.createNotification(
        'bug_feedback',
        newFeedback.feedback_id,
        'bug_report_submitted',
        'New Bug Report',
        `Bug report from ${displayName}: ${feedbackPreview}`,
        {
          feedback_id: newFeedback.feedback_id,
          reporter_user_id: userId,
          reporter_name: displayName,
          is_anonymous: isAnonymous,
          feedback_preview: feedbackPreview
        },
        [adminUser.user_id],
        '/bug-feedback'
      );

      logger.info('Bug report notification sent to admin', {
        feedback_id: newFeedback.feedback_id,
        reporter: displayName
      });
    } else {
      logger.warn('Admin user not found, bug report notification not sent');
    }
  } catch (error) {
    // CRITICAL: Log error but don't fail the feedback creation
    logger.error('Failed to send bug report notification to admin:', {
      error: error.message,
      feedback_id: newFeedback.feedback_id
    });
  }

  return newFeedback;
};

/**
 * Update feedback status
 * @param {string} feedbackId - The feedback ID
 * @param {string} status - New status (active/inactive)
 * @returns {Promise<Object>} Updated feedback report
 */
const updateFeedbackStatus = async (feedbackId, status) => {
  return await prisma.feedback_reports.update({
    where: {
      feedback_id: feedbackId
    },
    data: {
      status
    }
  });
};

/**
 * Respond to a feedback report (sends notification to reporter)
 * @param {string} feedbackId - The feedback ID
 * @param {string} responderId - The user responding (admin)
 * @param {string} responseMessage - The response message
 * @returns {Promise<Object>} Success result
 */
const respondToFeedback = async (feedbackId, responderId, responseMessage) => {
  // Get feedback details and verify it exists
  const feedback = await prisma.feedback_reports.findUnique({
    where: { feedback_id: feedbackId },
    select: {
      user_id: true,
      username: true,
      feedback: true,
      is_anonymous: true
    }
  });

  if (!feedback) {
    throw new Error('Feedback report not found');
  }

  if (!feedback.user_id) {
    throw new Error('Feedback report has no associated user');
  }

  // Send notification to reporter
  try {
    // Create feedback preview
    const feedbackPreview = feedback.feedback.length > 200
      ? feedback.feedback.substring(0, 200) + '...'
      : feedback.feedback;

    await notificationService.createNotification(
      'bug_feedback_response',
      feedbackId,
      'bug_report_response',
      'Response to Your Bug Report',
      responseMessage,
      {
        feedback_id: feedbackId,
        responder_user_id: responderId,
        original_feedback_preview: feedbackPreview,
        response_timestamp: new Date().toISOString()
      },
      [feedback.user_id],
      '/bug-feedback'
    );

    logger.info('Bug report response sent', {
      feedback_id: feedbackId,
      reporter_user_id: feedback.user_id,
      responder_user_id: responderId
    });

    return { success: true };
  } catch (error) {
    logger.error('Failed to send bug report response notification:', {
      error: error.message,
      feedback_id: feedbackId
    });
    throw error;
  }
};

module.exports = {
  getAllFeedback,
  createFeedback,
  updateFeedbackStatus,
  respondToFeedback
};
