/**
 * Enhanced Vue 3 Notifications Panel Component
 * Supports both panel (floating) and inline display modes
 */

// Use the global logger instance from logger.js

const { createApp: createNotificationApp, ref: notificationRef, computed: notificationComputed, onMounted: notificationOnMounted, onUnmounted: notificationOnUnmounted, nextTick: notificationNextTick } = Vue;

const NotificationApp = {
  props: {
    mode: {
      type: String,
      default: 'panel'
    },
    showOnlyUnread: {
      type: Boolean,
      default: false
    },
    autoRefresh: {
      type: Boolean,
      default: false
    },
    position: {
      type: String,
      default: 'right'
    },
    showFilters: {
      type: Boolean,
      default: true
    }
  },
  template: `
    <div v-if="mode === 'inline'" class="notifications-inline-container">
      <!-- Filter Tabs for inline mode -->
      <div v-if="showFilters" class="notification-filters">
        <button
          v-for="filter in filters"
          :key="filter.value"
          class="filter-tab"
          :class="{ active: currentFilter === filter.value }"
          @click="setFilter(filter.value)"
        >
          {{ filter.label }}
          <span v-if="filter.count" class="filter-count">{{ filter.count }}</span>
        </button>
      </div>

      <!-- Inline Content -->
      <div class="notification-inline-content" ref="notificationListContainer">
        <!-- Loading State -->
        <div v-if="loading" class="loading-container">
          <div class="loading-spinner"></div>
        </div>

        <!-- Empty State -->
        <div v-else-if="filteredNotifications.length === 0" class="empty-state">
          <span v-html="Icons.getIcon('bell', { size: '48', color: '#ccc' })"></span>
          <p>{{ emptyStateMessage }}</p>
        </div>

        <!-- Notifications -->
        <div v-else class="notifications-container">
          <NotificationItem
            v-for="item in filteredNotifications"
            :key="item.uniqueKey"
            :item="item"
            @mark-read="handleMarkRead"
            @mark-complete="handleMarkComplete"
            @delete="handleDelete"
          />
        </div>
      </div>
    </div>

    <div v-else class="notifications-panel-container" :class="{ active: panelOpen }">
      <!-- Notification Bell Icon -->
      <button class="notification-bell-btn" :class="{ 'notification-pulse': bellAnimating }" @click="togglePanel" :title="unreadCount > 0 ? unreadCount + ' unread notifications' : 'Notifications'">
        <span v-html="Icons.getIcon('bell', { size: '20' })"></span>
        <span v-if="unreadCount > 0" class="notification-badge">{{ unreadCount > 99 ? '99+' : unreadCount }}</span>
        <span class="notification-ripple" v-if="bellAnimating"></span>
        <span class="notification-ripple ripple-2" v-if="bellAnimating"></span>
      </button>

      <!-- Panel Overlay -->
      <div v-if="panelOpen" class="notification-panel-overlay" @click="closePanel"></div>

      <!-- Notification Panel -->
      <div class="notification-panel" :class="{ active: panelOpen }">
        <div class="notification-panel-header">
          <h3>Notifications</h3>
          <div class="notification-header-actions">
            <button v-if="unreadCount > 0" class="btn-text mark-all-read-btn" @click="markAllAsRead">
              Mark all read
            </button>
            <button class="btn-icon close-btn" @click="closePanel">
              <span v-html="Icons.getIcon('x', { size: '20' })"></span>
            </button>
          </div>
        </div>

        <!-- Filter Tabs -->
        <div v-if="showFilters" class="notification-filters">
          <button
            v-for="filter in filters"
            :key="filter.value"
            class="filter-tab"
            :class="{ active: currentFilter === filter.value }"
            @click="setFilter(filter.value)"
          >
            {{ filter.label }}
            <span v-if="filter.count" class="filter-count">{{ filter.count }}</span>
          </button>
        </div>

        <!-- Notifications List -->
        <div class="notification-list" ref="notificationListContainer">
          <!-- Loading State -->
          <div v-if="loading" class="loading-container">
            <div class="loading-spinner"></div>
          </div>

          <!-- Empty State -->
          <div v-else-if="filteredNotifications.length === 0" class="empty-state">
            <span v-html="Icons.getIcon('bell', { size: '48', color: '#ccc' })"></span>
            <p>{{ emptyStateMessage }}</p>
          </div>

          <!-- Notifications -->
          <div v-else class="notifications-container">
            <NotificationItem
              v-for="item in filteredNotifications"
              :key="item.uniqueKey"
              :item="item"
              @mark-read="handleMarkRead"
              @mark-complete="handleMarkComplete"
              @delete="handleDelete"
            />
          </div>
        </div>
      </div>
    </div>
  `,

  setup(props) {
    // State
    const panelOpen = notificationRef(false);
    const loading = notificationRef(true);
    const notifications = notificationRef([]);
    const todos = notificationRef([]);
    const currentFilter = notificationRef('all');
    const socket = notificationRef(null);
    const notificationListContainer = notificationRef(null);
    const bellAnimating = notificationRef(false);
    let refreshInterval = null;

    // Computed
    const unreadCount = notificationComputed(() => {
      const unreadNotifications = notifications.value.filter(n => !n.is_read).length;
      const incompleteTodos = todos.value.filter(t => !t.is_completed).length;
      return unreadNotifications + incompleteTodos;
    });

    const allItems = notificationComputed(() => {
      // Combine notifications and todos with a type flag
      const notificationItems = notifications.value.map(n => ({
        ...n,
        type: 'notification',
        uniqueKey: `notif-${n.notification.notification_id}`,
        sortDate: new Date(n.notification.created_at),
        isUnread: !n.is_read
      }));

      const todoItems = todos.value.map(t => ({
        ...t,
        type: 'todo',
        uniqueKey: `todo-${t.notification.notification_id}`,
        sortDate: new Date(t.notification.created_at),
        isUnread: !t.is_completed
      }));

      const combined = [...notificationItems, ...todoItems];

      // Sort: unread first, then by date (newest first)
      return combined.sort((a, b) => {
        // First, sort by read/unread status (unread first)
        if (a.isUnread !== b.isUnread) {
          return a.isUnread ? -1 : 1;
        }
        // Then sort by date (newest first)
        return b.sortDate - a.sortDate;
      });
    });

    const filteredNotifications = notificationComputed(() => {
      switch (currentFilter.value) {
      case 'unread':
        return allItems.value.filter(item => {
          if (item.type === 'notification') return !item.is_read;
          if (item.type === 'todo') return !item.is_completed;
          return false;
        });
      case 'todos':
        return allItems.value.filter(item => item.type === 'todo');
      case 'notifications':
        return allItems.value.filter(item => item.type === 'notification');
      default:
        return allItems.value;
      }
    });

    const filters = notificationComputed(() => [
      {
        label: 'All',
        value: 'all',
        count: allItems.value.length
      },
      {
        label: 'Unread',
        value: 'unread',
        count: unreadCount.value
      },
      {
        label: 'Notifications',
        value: 'notifications',
        count: notifications.value.length
      },
      {
        label: 'Todos',
        value: 'todos',
        count: todos.value.length
      }
    ]);

    const emptyStateMessage = notificationComputed(() => {
      switch (currentFilter.value) {
      case 'unread':
        return 'No unread notifications';
      case 'notifications':
        return 'No notifications';
      case 'todos':
        return 'No todos';
      default:
        return 'No notifications or todos';
      }
    });

    // Methods
    const togglePanel = () => {
      panelOpen.value = !panelOpen.value;
      if (panelOpen.value) {
        document.body.style.overflow = 'hidden';
        loadNotifications(); // Refresh when opening
      } else {
        document.body.style.overflow = '';
      }
    };

    const closePanel = () => {
      panelOpen.value = false;
      document.body.style.overflow = '';
    };

    const setFilter = (filter) => {
      currentFilter.value = filter;
    };

    const loadNotifications = async () => {
      try {
        // Panel mode (drawer): ALWAYS get ALL items for filtering
        // Inline mode: respect showOnlyUnread flag
        const includeRead = props.mode === 'panel' ? true : !props.showOnlyUnread;
        const includeCompleted = props.mode === 'panel' ? true : !props.showOnlyUnread;

        // Fetch notifications
        const notifResponse = await fetch(`/api/notifications/?includeRead=${includeRead}`, {
          credentials: 'include'
        });
        if (notifResponse.ok) {
          const data = await notifResponse.json();
          notifications.value = data;
          logger.debug('Loaded notifications:', data.length, 'items');
        }

        // Fetch todos
        const todoResponse = await fetch(`/api/notifications/todos?includeCompleted=${includeCompleted}`, {
          credentials: 'include'
        });
        if (todoResponse.ok) {
          const data = await todoResponse.json();
          todos.value = data;
          logger.debug('Loaded todos:', data.length, 'items');
        }
      } catch (error) {
        logger.error('Failed to load notifications:', error);
      } finally {
        loading.value = false;
        // Update mobile badge after loading notifications
        updateMobileBadge();
      }
    };

    const handleMarkRead = async (item) => {
      if (item.type !== 'notification' || item.is_read) return;

      try {
        const response = await fetch(`/api/notifications/${item.notification.notification_id}/read`, {
          method: 'PUT',
          credentials: 'include'
        });

        if (response.ok) {
          // Update the actual notification in the notifications array
          const notification = notifications.value.find(n =>
            n.notification.notification_id === item.notification.notification_id
          );
          if (notification) {
            notification.is_read = true;
          }

          // Emit socket event to update other instances
          if (socket.value) {
            socket.value.emit('notification:mark-read', {
              notificationId: item.notification.notification_id
            });
          }
          // Update mobile badge
          updateMobileBadge();
        }
      } catch (error) {
        logger.error('Failed to mark notification as read:', error);
      }
    };

    const handleMarkComplete = async (item) => {
      if (item.type !== 'todo') return;

      // Find the current todo state BEFORE making the API call
      const todoIndex = todos.value.findIndex(t =>
        t.notification.notification_id === item.notification.notification_id
      );

      if (todoIndex === -1) {
        logger.warn('Todo not found in array:', item.notification.notification_id);
        return;
      }

      const currentTodo = todos.value[todoIndex];
      const newCompletedStatus = !currentTodo.is_completed;

      // Determine endpoint based on CURRENT state, not the stale item.is_completed
      const endpoint = currentTodo.is_completed
        ? `/api/notifications/todos/${item.notification.notification_id}/incomplete`
        : `/api/notifications/todos/${item.notification.notification_id}/complete`;

      logger.debug('Marking todo:', {
        notificationId: item.notification.notification_id,
        currentStatus: currentTodo.is_completed,
        targetStatus: newCompletedStatus,
        endpoint
      });

      try {
        const response = await fetch(endpoint, {
          method: 'PUT',
          credentials: 'include'
        });

        if (response.ok) {
          logger.debug('Server responded OK, updating local state');

          // Force Vue reactivity by replacing the entire object in the array
          todos.value[todoIndex] = {
            ...currentTodo,
            is_completed: newCompletedStatus
          };

          // Emit socket event to update other instances
          if (socket.value) {
            socket.value.emit(newCompletedStatus ? 'todo:mark-complete' : 'todo:mark-incomplete', {
              notification_id: item.notification.notification_id
            });
          }

          // Update mobile badge
          updateMobileBadge();

          logger.debug('Todo update complete');
        } else {
          logger.error('Failed to update todo on server:', response.status);
        }
      } catch (error) {
        logger.error('Failed to update todo status:', error);
      }
    };

    const handleDelete = async (item) => {
      try {
        const response = await fetch(`/api/notifications/${item.notification.notification_id}`, {
          method: 'DELETE',
          credentials: 'include'
        });

        if (response.ok) {
          // Remove from appropriate array
          if (item.type === 'notification') {
            const index = notifications.value.findIndex(n =>
              n.notification.notification_id === item.notification.notification_id
            );
            if (index !== -1) notifications.value.splice(index, 1);
          } else {
            const index = todos.value.findIndex(t =>
              t.notification.notification_id === item.notification.notification_id
            );
            if (index !== -1) todos.value.splice(index, 1);
          }

          // Emit socket event to update other instances
          if (socket.value) {
            socket.value.emit('notification:delete', {
              notificationId: item.notification.notification_id
            });
          }
        }
      } catch (error) {
        logger.error('Failed to delete item:', error);
      }
    };

    // Update mobile header notification badge
    const updateMobileBadge = () => {
      const mobileBadge = document.getElementById('mobile-notification-badge');
      if (mobileBadge) {
        const count = unreadCount.value;
        if (count > 0) {
          mobileBadge.textContent = count > 99 ? '99+' : count.toString();
          mobileBadge.style.display = 'inline';
        } else {
          mobileBadge.style.display = 'none';
        }
      }
    };

    const markAllAsRead = async () => {
      try {
        const response = await fetch('/api/notifications/mark-all-read', {
          method: 'PUT',
          credentials: 'include'
        });

        if (response.ok) {
          // Mark all notifications as read
          notifications.value.forEach(n => {
            n.is_read = true;
          });
          // Mark all todos as completed
          todos.value.forEach(t => {
            t.is_completed = true;
          });

          // Emit socket event to update other instances
          if (socket.value) {
            socket.value.emit('notification:mark-all-read');
          }
          // Update mobile badge
          updateMobileBadge();
        }
      } catch (error) {
        logger.error('Failed to mark all as read:', error);
      }
    };

    const initializeSocket = () => {
      if (typeof window.io === 'undefined') {
        logger.warn('Socket.IO not available');
        return;
      }

      socket.value = window.io({
        transports: ['websocket', 'polling']
      });

      socket.value.on('connect', () => {
        logger.debug('Connected to notification socket');
        socket.value.emit('join-notifications');
      });

      socket.value.on('new-notification', handleNewNotification);
      socket.value.on('notification:read', (data) => updateNotificationStatus(data.notificationId, 'read'));
      socket.value.on('notification:deleted', (data) => removeNotification(data.notificationId));
      socket.value.on('todo-completed', (data) => updateTodoStatus(data.notification_id, true));
      socket.value.on('todo-incomplete', (data) => updateTodoStatus(data.notification_id, false));
      socket.value.on('notification:all-read', () => {
        // Mark all notifications as read
        notifications.value.forEach(n => {
          n.is_read = true;
        });
        // Mark all todos as completed
        todos.value.forEach(t => {
          t.is_completed = true;
        });
        logger.debug('All notifications marked as read');
      });
      socket.value.on('unread-count', (data) => {
        logger.debug('Unread count updated:', data.count);
      });

      socket.value.on('disconnect', () => {
        logger.debug('Disconnected from notification socket');
      });
    };

    const triggerBellAnimation = () => {
      bellAnimating.value = true;
      setTimeout(() => {
        bellAnimating.value = false;
      }, 2000);
    };

    const handleNewNotification = (data) => {
      // Show browser notification if allowed (only in panel mode)
      if (props.mode === 'panel') {
        showBrowserNotification(data.title, data.message);
      }

      // Trigger bell animation (only in panel mode)
      if (props.mode === 'panel') {
        triggerBellAnimation();
      }

      // Check if this is a todo (entity_type === 'user_todo' or notification_type === 'todo')
      const isTodo = data.entity_type === 'user_todo' || data.notification_type === 'todo';

      // Create the notification/todo object
      const newItem = {
        notification: {
          notification_id: data.notification_id,
          title: data.title,
          message: data.message,
          created_at: data.created_at,
          entity_type: data.entity_type,
          notification_type: data.notification_type,
          data: data.data
        },
        is_read: false,
        is_actionable: isTodo,
        is_completed: false
      };

      // Add to appropriate array
      if (isTodo) {
        // Add to todos array
        todos.value.unshift(newItem);
      } else {
        // Add to notifications array
        notifications.value.unshift(newItem);
      }

      // If panel is open, scroll to top
      if (panelOpen.value && notificationListContainer.value) {
        notificationNextTick(() => {
          notificationListContainer.value.scrollTop = 0;
        });
      }
    };

    const updateNotificationStatus = (notificationId, status) => {
      const notification = notifications.value.find(n =>
        n.notification.notification_id === notificationId
      );
      if (notification) {
        notification.is_read = status === 'read';
      }
    };

    const updateTodoStatus = (notificationId, isCompleted) => {
      const todo = todos.value.find(t =>
        t.notification.notification_id === notificationId
      );
      if (todo) {
        todo.is_completed = isCompleted;
      }
    };

    const removeNotification = (notificationId) => {
      // Remove from notifications
      const notifIndex = notifications.value.findIndex(n =>
        n.notification.notification_id === notificationId
      );
      if (notifIndex !== -1) {
        notifications.value.splice(notifIndex, 1);
      }

      // Remove from todos
      const todoIndex = todos.value.findIndex(t =>
        t.notification.notification_id === notificationId
      );
      if (todoIndex !== -1) {
        todos.value.splice(todoIndex, 1);
      }
    };

    const showBrowserNotification = (title, message) => {
      if ('Notification' in window && Notification.permission === 'granted') {
        // eslint-disable-next-line no-new
        new Notification(title, {
          body: message,
          icon: '/favicon.ico',
          tag: 'notification-update'
        });
      }
    };

    const cleanupSocket = () => {
      if (socket.value) {
        socket.value.emit('leave-notifications');
        socket.value.disconnect();
        socket.value = null;
      }
    };

    // Lifecycle
    notificationOnMounted(() => {
      // Load initial notifications
      loadNotifications();

      // Initialize socket for real-time updates
      initializeSocket();

      // Request notification permission if not granted (only in panel mode)
      if (props.mode === 'panel' && 'Notification' in window && Notification.permission === 'default') {
        Notification.requestPermission();
      }

      // Set up auto-refresh for inline mode
      if (props.mode === 'inline' && props.autoRefresh) {
        refreshInterval = setInterval(() => {
          loadNotifications();
        }, 30000); // Refresh every 30 seconds
      }
    });

    notificationOnUnmounted(() => {
      // Cleanup socket connection
      cleanupSocket();

      // Clear refresh interval if set
      if (refreshInterval) {
        clearInterval(refreshInterval);
      }
    });

    return {
      // Props
      mode: props.mode,

      // State
      panelOpen,
      loading,
      currentFilter,
      notificationListContainer,
      bellAnimating,

      // Computed
      unreadCount,
      filteredNotifications,
      filters,
      emptyStateMessage,

      // Methods
      togglePanel,
      closePanel,
      setFilter,
      handleMarkRead,
      handleMarkComplete,
      handleDelete,
      markAllAsRead,

      // Icons
      Icons: window.Icons
    };
  }
};

// Copy the NotificationItem component from the original file
const NotificationItem = {
  props: {
    item: {
      type: Object,
      required: true
    }
  },
  emits: ['mark-read', 'mark-complete', 'delete'],
  setup() {
    return {
      Icons: window.Icons
    };
  },
  template: `
    <div class="notification-item" :class="{ unread: isUnread, todo: isTodo, completed: isCompleted }">
      <div class="notification-icon">
        <span v-if="isTodo" v-html="Icons.getIcon('check-circle', { size: '20', color: item.is_completed ? 'var(--success)' : 'var(--text-secondary)' })"></span>
        <span v-else v-html="getNotificationIcon()"></span>
      </div>

      <div class="notification-content">
        <div class="notification-header">
          <h4 class="notification-title">{{ item.notification.title }}</h4>
          <span class="notification-time">{{ formatTime(item.notification.created_at) }}</span>
        </div>
        <p class="notification-message">{{ item.notification.message }}</p>

        <!-- Todo specific: Due date -->
        <div v-if="isTodo && item.notification.data && item.notification.data.due_date" class="notification-due-date">
          <span v-html="Icons.getIcon('calendar', { size: '14' })"></span>
          Due: {{ formatDueDate(item.notification.data.due_date) }}
        </div>

        <!-- Entity link -->
        <a v-if="entityLink" :href="entityLink" class="notification-link">
          View {{ item.notification.entity_type }}
          <span v-html="Icons.getIcon('arrow-right', { size: '14' })"></span>
        </a>
      </div>

      <div class="notification-actions">
        <button v-if="isTodo"
                class="btn-icon"
                :title="item.is_completed ? 'Mark incomplete' : 'Mark complete'"
                @click="$emit('mark-complete', item)">
          <span v-html="Icons.getIcon(item.is_completed ? 'x' : 'check', { size: '16' })"></span>
        </button>
        <button v-else-if="!item.is_read"
                class="btn-icon"
                title="Mark as read"
                @click="$emit('mark-read', item)">
          <span v-html="Icons.getIcon('check', { size: '16' })"></span>
        </button>
        <button class="btn-icon"
                title="Delete"
                @click="$emit('delete', item)">
          <span v-html="Icons.getIcon('trash-2', { size: '16' })"></span>
        </button>
      </div>
    </div>
  `,

  computed: {
    isTodo() {
      return this.item.type === 'todo';
    },

    isUnread() {
      if (this.isTodo) {
        return !this.item.is_completed;
      }
      return !this.item.is_read;
    },

    isCompleted() {
      if (this.isTodo) {
        return this.item.is_completed;
      }
      return this.item.is_read;
    },

    entityLink() {
      const { entity_type, data } = this.item.notification;
      if (!data || !data.entity_id) return null;

      // Map entity types to their routes
      const routeMap = {
        initiative: `/initiatives/${data.entity_id}`,
        project: `/projects/${data.entity_id}`,
        task: `/tasks/${data.entity_id}`,
        ncr: `/ncr/${data.entity_id}`,
        tender: `/tenders/${data.entity_id}`
      };

      return routeMap[entity_type] || null;
    }
  },

  methods: {
    getNotificationIcon() {
      const typeIconMap = {
        create: 'plus',
        update: 'edit',
        delete: 'trash-2',
        status: 'flag',
        assign: 'user-plus',
        comment: 'message-circle',
        mention: 'at-sign',
        deadline: 'clock',
        approval: 'check-circle',
        alert: 'alert-triangle'
      };

      const iconName = typeIconMap[this.item.notification.notification_type] || 'bell';
      return Icons.getIcon(iconName, { size: '20' });
    },

    formatTime(timestamp) {
      const date = new Date(timestamp);
      const now = new Date();
      const diff = now - date;

      // Less than 1 minute
      if (diff < 60000) return 'Just now';

      // Less than 1 hour
      if (diff < 3600000) {
        const minutes = Math.floor(diff / 60000);
        return `${minutes} minute${minutes > 1 ? 's' : ''} ago`;
      }

      // Less than 24 hours
      if (diff < 86400000) {
        const hours = Math.floor(diff / 3600000);
        return `${hours} hour${hours > 1 ? 's' : ''} ago`;
      }

      // Less than 7 days
      if (diff < 604800000) {
        const days = Math.floor(diff / 86400000);
        return `${days} day${days > 1 ? 's' : ''} ago`;
      }

      // Default to date
      return date.toLocaleDateString();
    },

    formatDueDate(dueDate) {
      const date = new Date(dueDate);
      const now = new Date();
      const diff = date - now;

      // Overdue
      if (diff < 0) {
        const days = Math.abs(Math.floor(diff / 86400000));
        return `Overdue by ${days} day${days > 1 ? 's' : ''}`;
      }

      // Due today
      if (diff < 86400000) {
        return 'Today';
      }

      // Due tomorrow
      if (diff < 172800000) {
        return 'Tomorrow';
      }

      // Due within a week
      if (diff < 604800000) {
        const days = Math.floor(diff / 86400000);
        return `In ${days} days`;
      }

      // Default to date
      return date.toLocaleDateString();
    }
  }
};

// Initialize Vue app when DOM is loaded
document.addEventListener('DOMContentLoaded', () => {
  // Wait a tick to ensure all scripts are loaded
  setTimeout(() => {
    // Ensure Icons is available
    if (!window.Icons) {
      logger.error('Icons system not loaded. Make sure icons.js is included before notifications-vue.js');
      return;
    }

    // Find all notification mount points
    let appElements = document.querySelectorAll('.notifications-vue-mount');

    // If no mount points exist, create default panel
    if (appElements.length === 0) {
      const appElement = document.createElement('div');
      appElement.id = 'notifications-vue-app';
      appElement.className = 'notifications-vue-mount';
      appElement.dataset.mode = 'panel';
      appElement.dataset.position = 'right';
      document.body.insertBefore(appElement, document.body.firstChild);
      appElements = [appElement];
    }

    // Mount a Vue app to each element
    appElements.forEach(appElement => {
      const props = {
        mode: appElement.dataset.mode || 'panel',
        showOnlyUnread: appElement.dataset.showOnlyUnread === 'true',
        autoRefresh: appElement.dataset.autoRefresh === 'true',
        position: appElement.dataset.position || 'right',
        showFilters: appElement.dataset.showFilters !== 'false'
      };

      logger.debug('Mounting notification app:', {
        id: appElement.id,
        props
      });

      const app = createNotificationApp(NotificationApp, props);

      // Register child component
      app.component('NotificationItem', NotificationItem);

      const instance = app.mount(`#${appElement.id}`);

      // Expose togglePanel method globally for mobile button
      if (!window.notificationInstances) {
        window.notificationInstances = {};
      }
      window.notificationInstances[appElement.id] = instance;
    });
  }, 0);
});
