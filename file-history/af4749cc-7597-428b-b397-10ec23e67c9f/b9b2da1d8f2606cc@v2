const feedbackService = require('../services/feedbackService');
const logger = require('../utils/logger');

/**
 * Get all feedback reports (admin only)
 */
const getAllFeedback = async (req, res) => {
  try {
    const { status } = req.query;
    const filters = {};

    if (status) {
      filters.status = status;
    }

    const feedback = await feedbackService.getAllFeedback(filters);

    // Format the response to use full name instead of username
    const formattedFeedback = feedback.map(item => {
      // If anonymous, keep as is
      if (item.is_anonymous) {
        return {
          ...item,
          username: 'Anonymous'
        };
      }

      // If we have user contact info, use full name
      if (item.user && item.user.users_contacts) {
        const { first_name, surname } = item.user.users_contacts;
        const fullName = `${first_name || ''} ${surname || ''}`.trim() || item.username;
        return {
          ...item,
          username: fullName
        };
      }

      // Fallback to stored username
      return item;
    });

    res.json(formattedFeedback);
  } catch (error) {
    logger.error('Error fetching feedback:', error);
    res.status(500).json({ error: 'Failed to fetch feedback', code: 'OPERATION_FAILED' });
  }
};

/**
 * Create a new feedback report
 */
const createFeedback = async (req, res) => {
  try {
    const { feedback, anonymous } = req.body;
    const userId = req.session.userId;
    const username = req.session.username;
    const firstName = req.session.first_name;
    const surname = req.session.surname;

    if (!feedback) {
      return res.status(400).json({ error: 'Feedback is required', code: 'BAD_REQUEST' });
    }

    const feedbackData = {
      userId,
      username,
      firstName,
      surname,
      feedback,
      isAnonymous: anonymous === true || anonymous === 'true'
    };

    const newFeedback = await feedbackService.createFeedback(feedbackData);
    res.status(201).json(newFeedback);
  } catch (error) {
    logger.error('Error creating feedback:', error);
    res.status(500).json({ error: 'Failed to submit feedback', code: 'OPERATION_FAILED' });
  }
};

/**
 * Update feedback status (admin only)
 */
const updateFeedbackStatus = async (req, res) => {
  try {
    const { id } = req.params;
    const { status } = req.body;

    if (!status || !['active', 'inactive'].includes(status)) {
      return res.status(400).json({ error: 'Invalid status', code: 'BAD_REQUEST' });
    }

    const updatedFeedback = await feedbackService.updateFeedbackStatus(id, status);
    res.json(updatedFeedback);
  } catch (error) {
    logger.error('Error updating feedback status:', error);
    res.status(500).json({ error: 'Failed to update feedback status', code: 'OPERATION_FAILED' });
  }
};

/**
 * Respond to a feedback report (admin only)
 */
const respondToFeedback = async (req, res) => {
  try {
    const { feedback_id, response_message } = req.body;
    const responderId = req.session.userId;

    if (!feedback_id) {
      return res.status(400).json({ error: 'feedback_id is required', code: 'BAD_REQUEST' });
    }

    if (!response_message || !response_message.trim()) {
      return res.status(400).json({ error: 'response_message is required', code: 'BAD_REQUEST' });
    }

    await feedbackService.respondToFeedback(feedback_id, responderId, response_message.trim());
    res.json({ success: true, message: 'Response sent successfully' });
  } catch (error) {
    logger.error('Error responding to feedback:', error);

    if (error.message === 'Feedback report not found') {
      return res.status(404).json({ error: error.message, code: 'NOT_FOUND' });
    }

    if (error.message === 'Cannot respond to anonymous feedback') {
      return res.status(400).json({ error: error.message, code: 'BAD_REQUEST' });
    }

    res.status(500).json({ error: 'Failed to send response', code: 'OPERATION_FAILED' });
  }
};

module.exports = {
  getAllFeedback,
  createFeedback,
  updateFeedbackStatus,
  respondToFeedback
};
