  }

  // Subscribe to entity notifications
  static async subscribeToEntity(req, res) {
    try {
      const userId = req.session.userId;
      const { entity_type, entity_id, notification_preferences } = req.body;

      if (!entity_type || !entity_id) {
        return res.status(400).json({ error: 'entity_type and entity_id are required', code: 'MISSING_FIELDS' });
      }

      const subscription = await NotificationService.subscribeToEntity(
        userId,
        entity_type,
        entity_id,
        notification_preferences
      );

      res.json(subscription);
    } catch (error) {
      logger.error('Error subscribing to entity:', { error: error.message });
      res.status(500).json({ error: 'Failed to subscribe to entity', code: 'OPERATION_FAILED' });
    }
  }

  // Unsubscribe from entity notifications
  static async unsubscribeFromEntity(req, res) {
    try {
      const userId = req.session.userId;
      const { entity_type, entity_id } = req.body;

      if (!entity_type || !entity_id) {
        return res.status(400).json({ error: 'entity_type and entity_id are required', code: 'MISSING_FIELDS' });
      }

      await NotificationService.unsubscribeFromEntity(userId, entity_type, entity_id);

      res.json({ success: true, message: 'Unsubscribed successfully' });
    } catch (error) {
      logger.error('Error unsubscribing from entity:', { error: error.message });
      res.status(500).json({ error: 'Failed to unsubscribe from entity', code: 'OPERATION_FAILED' });
    }
  }

  // Create notification (internal use - admin/project_manager only)
  static async createNotification(req, res) {
    try {
      // Allow admin and project_manager users to create notifications
      const userRoles = req.session.roles || [];
      if (!userRoles.includes('admin') && !userRoles.includes('project_manager')) {
        return res.status(403).json({ error: 'Access denied', code: 'ACCESS_DENIED' });
      }

      const { entity_type, entity_id, notification_type, title, message, data, user_ids, link } = req.body;

      if (!entity_type || !entity_id || !notification_type || !title || !message) {
        return res.status(400).json({
          error: 'entity_type, entity_id, notification_type, title, and message are required',
          code: 'MISSING_FIELDS'
        });
      }

      // Validate user_ids if provided (for broadcast notifications)
      if (user_ids && (!Array.isArray(user_ids) || user_ids.length === 0)) {
        return res.status(400).json({
          error: 'user_ids must be a non-empty array when provided',
          code: 'BAD_REQUEST'
        });
      }

      // If this is a broadcast notification, include sender information
      let notificationData = data;
      if (entity_type === 'broadcast' && user_ids && user_ids.length > 0) {
        notificationData = {
          ...data,
          sent_by_user_id: req.session.userId,
          recipient_count: user_ids.length
        };
      }

      const notification = await NotificationService.createNotification(
        entity_type,
        entity_id,
        notification_type,
        title,
        message,
        notificationData,
        user_ids,
        link
      );

      res.json(notification);
    } catch (error) {
      logger.error('Error creating notification:', { error: error.message });
      res.status(500).json({ error: 'Failed to create notification', code: 'OPERATION_FAILED' });
    }
  }

