describe('Fire Safety Systems Integration - Note 1a (SM Bed Exemption)', () => {

  test('should exempt Type 2 for SM with ≤10 beds', () => {
    const firecell = {
      riskGroup: 'SM',
      occupantLoad: 8, // Using occupantLoad as bed count for SM
      maxEscapeRouteBeds: 8,
      escapeHeight: 5.0
    };

    const baseSystems = getFireSafetySystems('SM', {
      occupantLoad: firecell.occupantLoad,
      escapeHeight: firecell.escapeHeight
    });

    const result = applyNoteEvaluations(baseSystems, firecell, {}, []);

    // Type 2 should be removed (if it was in base systems with ^1a)
    expect(result.systems).not.toContain('2');

    // Check compliance info for exemption tracking
    if (result.complianceInfo.bedExemption) {
      expect(result.complianceInfo.bedExemption.exempt).toBe(true);
    }
  });

  test('should require Type 2 for SM with >10 beds', () => {
    const firecell = {
      riskGroup: 'SM',
      occupantLoad: 15,
      maxEscapeRouteBeds: 15,
      escapeHeight: 5.0
    };

    const baseSystems = getFireSafetySystems('SM', {
      occupantLoad: firecell.occupantLoad,
      escapeHeight: firecell.escapeHeight
    });

    const result = applyNoteEvaluations(baseSystems, firecell, {}, []);

    // Type 2 may be present depending on base systems for 15 beds
    // Check if base had it with ^1a notation
    const hadType2WithNote = baseSystems.some(sys => sys.includes('2') && sys.includes('1a'));

    if (hadType2WithNote) {
      // Should remain because >10 beds
      expect(result.systems.some(sys => sys.includes('2'))).toBe(true);
    }
  });

