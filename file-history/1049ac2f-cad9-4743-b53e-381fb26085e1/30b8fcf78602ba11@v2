// Form functionality for dynamic firecell management
let firecellCount = 1;

function addFirecell() {
  const container = document.getElementById('firecellsContainer');
  const index = firecellCount;

  const firecellDiv = document.createElement('div');
  firecellDiv.className = 'firecell-item';
  firecellDiv.setAttribute('data-index', index);

  // Get the current occupant types from the first firecell
  const firstFirecell = document.querySelector('.firecell-item');
  const occupantSelect = firstFirecell.querySelector('select[name*="occupantType"]');

  const occupantOptions = Array.from(occupantSelect.options).map(opt =>
    `<option value="${opt.value}">${opt.text}</option>`
  ).join('');

  const riskGroupOptions = `
    <option value="">-- Select Risk Group --</option>
    <option value="SM">SM</option>
    <option value="SI">SI</option>
    <option value="CA">CA</option>
    <option value="WB">WB</option>
    <option value="WS">WS</option>
    <option value="VP">VP</option>
  `;

  firecellDiv.innerHTML = `
    <h3>Firecell ${index + 1}</h3>

    <div>
      <label>Risk Group:</label>
      <select name="firecells[${index}][riskGroup]" required>
        ${riskGroupOptions}
      </select>
    </div>

    <div>
      <label>Occupant Type:</label>
      <select name="firecells[${index}][occupantType]" required>
        ${occupantOptions}
      </select>
    </div>

    <div>
      <label>Occupant Load:</label>
      <input type="number" name="firecells[${index}][occupantLoad]" min="0" step="1" required>
    </div>

    <div>
      <label>Escape Height (m):</label>
      <input type="number" name="firecells[${index}][escapeHeight]" min="0" step="0.1" required>
    </div>

    <div>
      <label>Is Sprinklered:</label>
      <select name="firecells[${index}][isSprinklered]" required>
        <option value="">-- Select --</option>
        <option value="true">Yes</option>
        <option value="false">No</option>
      </select>
    </div>

    <div>
      <label>Floor Area (m²):</label>
      <input type="number" name="firecells[${index}][floorArea]" min="0.1" step="0.1" required>
    </div>

    <div class="vp-only" style="display: none;">
      <label>Has Vehicle Stacker:</label>
      <select name="firecells[${index}][hasVehicleStacker]">
        <option value="">-- Select --</option>
        <option value="true">Yes</option>
        <option value="false">No</option>
      </select>
    </div>

    <div class="ca-only" style="display: none;">
      <label>Is Cinema or Theatre:</label>
      <select name="firecells[${index}][isCinemaOrTheatre]">
        <option value="">-- Select --</option>
        <option value="true">Yes</option>
        <option value="false">No</option>
      </select>

      <div>
        <label>Is Early Childhood Centre:</label>
        <select class="early-childhood-toggle" name="firecells[${index}][isEarlyChildhoodCentre]">
          <option value="">-- Select --</option>
          <option value="true">Yes</option>
          <option value="false">No</option>
        </select>
      </div>
    </div>

    <div class="early-childhood-low-height" style="display: none;">
      <p class="info-message" style="font-style: italic; color: #666; margin: 10px 0;">CAS2 2.2.4(a) - Single storey early childhood centre requirements</p>
      <div>
        <label>Has Dedicated Sleeping Areas:</label>
        <select class="sleeping-areas-toggle" name="firecells[${index}][hasDedicatedSleepingAreas]">
          <option value="">-- Select --</option>
          <option value="true">Yes</option>
          <option value="false">No</option>
        </select>
      </div>
      <div class="sleeping-area-fields" style="display: none;">
        <label title="Required for dedicated sleeping areas in single-storey early childhood centres per NZS 4512">Supplementary smoke detectors compliant with NZS 4512:</label>
        <select name="firecells[${index}][supplementarySmokeDetectorsCompliant]">
          <option value="">-- Select --</option>
          <option value="true">Yes - Compliant</option>
          <option value="false">No - Non-compliant</option>
        </select>
      </div>
    </div>

    <div class="early-childhood-high-height" style="display: none;">
      <p class="info-message" style="font-style: italic; color: #1a73e8; margin: 10px 0; font-weight: bold;">CAS2 2.2.4(b)(i) - Type 7 emergency warning system will be automatically added to fire safety systems</p>
      <div>
        <label title="Two separate places of safety with fire separations and direct access to safe path/final exit per CAS2 2.2.4(b)(ii)&(iii)">Two separate places of safety with fire separations and direct access:</label>
        <select name="firecells[${index}][placesOfSafetyCompliant]">
          <option value="">-- Select --</option>
          <option value="true">Yes - Compliant</option>
          <option value="false">No - Non-compliant</option>
        </select>
      </div>
    </div>

    <button class="remove-firecell" type="button" data-index="${index}">Remove Firecell</button>
  `;

  container.appendChild(firecellDiv);

  // Add event listener to the new risk group select
  const newRiskGroupSelect = firecellDiv.querySelector('select[name*="riskGroup"]');
  newRiskGroupSelect.addEventListener('change', function() {
    toggleConditionalFields(this);
  });

  // Add event listeners for early childhood fields
  const earlyChildhoodToggle = firecellDiv.querySelector('.early-childhood-toggle');
  if (earlyChildhoodToggle) {
    earlyChildhoodToggle.addEventListener('change', function() {
      toggleEarlyChildhoodFields(firecellDiv);
    });
  }

  const escapeHeightInput = firecellDiv.querySelector('input[name*="escapeHeight"]');
  if (escapeHeightInput) {
    escapeHeightInput.addEventListener('change', function() {
      toggleEarlyChildhoodFields(firecellDiv);
    });
  }

  const sleepingAreasToggle = firecellDiv.querySelector('.sleeping-areas-toggle');
  if (sleepingAreasToggle) {
    sleepingAreasToggle.addEventListener('change', function() {
      toggleSleepingAreaFields(firecellDiv);
    });
  }

  // Add event listener to the remove button
  const removeButton = firecellDiv.querySelector('.remove-firecell');
  removeButton.addEventListener('click', function() {
    removeFirecell(this.getAttribute('data-index'));
  });

  firecellCount++;
  updateRemoveButtons();
}

function removeFirecell(index) {
  const firecell = document.querySelector(`[data-index="${index}"]`);
  if (firecell) {
    firecell.remove();
    updateRemoveButtons();
    updateFirecellTitles();
  }
}

function updateRemoveButtons() {
  const firecells = document.querySelectorAll('.firecell-item');
  const removeButtons = document.querySelectorAll('.remove-firecell');

  removeButtons.forEach(button => {
    button.style.display = firecells.length > 1 ? 'inline-block' : 'none';
  });
}

function updateFirecellTitles() {
  const firecells = document.querySelectorAll('.firecell-item');
  firecells.forEach((firecell, index) => {
    const title = firecell.querySelector('h3');
    if (title) {
      title.textContent = `Firecell ${index + 1}`;
    }
  });
}

function toggleConditionalFields(selectElement) {
  const firecell = selectElement.closest('.firecell-item');
  const vpFields = firecell.querySelector('.vp-only');
  const caFields = firecell.querySelector('.ca-only');

  // Hide all conditional fields first
  if (vpFields) vpFields.style.display = 'none';
  if (caFields) caFields.style.display = 'none';

  // Show relevant fields based on risk group
  if (selectElement.value === 'VP' && vpFields) {
    vpFields.style.display = 'block';
  } else if (selectElement.value === 'CA' && caFields) {
    caFields.style.display = 'block';
  }
}

function toggleEarlyChildhoodFields(firecell) {
  const earlyChildhoodSelect = firecell.querySelector('.early-childhood-toggle');
  const escapeHeightInput = firecell.querySelector('input[name*="escapeHeight"]');
  const lowHeightSection = firecell.querySelector('.early-childhood-low-height');
  const highHeightSection = firecell.querySelector('.early-childhood-high-height');

  if (!earlyChildhoodSelect || !lowHeightSection || !highHeightSection) {
    return; // Elements not found (may not be CA risk group)
  }

  const isEarlyChildhood = earlyChildhoodSelect.value === 'true';
  const escapeHeight = parseFloat(escapeHeightInput?.value || 0);

  // Hide both sections by default
  lowHeightSection.style.display = 'none';
  highHeightSection.style.display = 'none';

  if (isEarlyChildhood) {
    if (escapeHeight <= 2.0) {
      // Condition (a): Show low height section
      lowHeightSection.style.display = 'block';
      // Clear high height fields
      clearEarlyChildhoodFields(highHeightSection);
    } else {
      // Condition (b): Show high height section
      highHeightSection.style.display = 'block';
      // Clear low height fields
      clearEarlyChildhoodFields(lowHeightSection);
    }
  } else {
    // Not an early childhood centre - clear all fields
    clearEarlyChildhoodFields(lowHeightSection);
    clearEarlyChildhoodFields(highHeightSection);
  }
}

function clearEarlyChildhoodFields(section) {
  if (!section) return;
  const selects = section.querySelectorAll('select');
  selects.forEach(select => {
    select.value = '';
  });
}

function toggleSleepingAreaFields(firecell) {
  const sleepingAreasSelect = firecell.querySelector('.sleeping-areas-toggle');
  const sleepingAreaFields = firecell.querySelector('.sleeping-area-fields');

  if (!sleepingAreasSelect || !sleepingAreaFields) {
    return;
  }

  if (sleepingAreasSelect.value === 'true') {
    sleepingAreaFields.style.display = 'block';
  } else {
    sleepingAreaFields.style.display = 'none';
    // Clear the smoke detector compliance field
    const complianceSelect = sleepingAreaFields.querySelector('select[name*="supplementarySmokeDetectorsCompliant"]');
    if (complianceSelect) {
      complianceSelect.value = '';
    }
  }
}

function fillTestData() {
  // Remove all firecells except the first one
  const allFirecells = document.querySelectorAll('.firecell-item');
  for (let i = allFirecells.length - 1; i > 0; i--) {
    const firecell = allFirecells[i];
    firecell.remove();
  }

  // Reset the firecell counter
  firecellCount = 1;

  updateRemoveButtons();
  updateFirecellTitles();

  // Fill project-level fields (from scripts/pipeline-test.js)
  document.getElementById('hasRemoteReceivingCentreConnection').value = 'false';
  document.getElementById('storesHazardousGoods').value = 'false';

  // Fill first firecell - ground floor CA office
  const firstFirecell = document.querySelector('.firecell-item');
  if (firstFirecell) {
    // Risk group
    const riskGroupSelect = firstFirecell.querySelector('select[name*="riskGroup"]');
    riskGroupSelect.value = 'CA';
    toggleConditionalFields(riskGroupSelect); // Show CA conditional fields

    // Occupant type
    const occupantTypeSelect = firstFirecell.querySelector('select[name*="occupantType"]');
    occupantTypeSelect.value = 'Office spaces';

    // Occupant load
    const occupantLoadInput = firstFirecell.querySelector('input[name*="occupantLoad"]');
    occupantLoadInput.value = 50;

    // Escape height - ground floor
    const escapeHeightInput = firstFirecell.querySelector('input[name*="escapeHeight"]');
    escapeHeightInput.value = 0;

    // Is sprinklered
    const isSprinkleredSelect = firstFirecell.querySelector('select[name*="isSprinklered"]');
    isSprinkleredSelect.value = 'false';

    // Floor area
    const floorAreaInput = firstFirecell.querySelector('input[name*="floorArea"]');
    floorAreaInput.value = 400;

    // CA-specific field (is cinema or theatre) - set to No
    const isCinemaSelect = firstFirecell.querySelector('select[name*="isCinemaOrTheatre"]');
    if (isCinemaSelect) {
      isCinemaSelect.value = 'false';
    }
  }

  // Add second firecell - upstairs SM residential
  addFirecell();

  // Wait for DOM to update, then fill the second firecell
  setTimeout(() => {
    const allFirecells = document.querySelectorAll('.firecell-item');
    const secondFirecell = allFirecells[1];

    if (secondFirecell) {
      // Risk group
      const riskGroupSelect = secondFirecell.querySelector('select[name*="riskGroup"]');
      riskGroupSelect.value = 'SM';
      toggleConditionalFields(riskGroupSelect);

      // Occupant type
      const occupantTypeSelect = secondFirecell.querySelector('select[name*="occupantType"]');
      occupantTypeSelect.value = 'Sleeping non institutional';

      // Occupant load
      const occupantLoadInput = secondFirecell.querySelector('input[name*="occupantLoad"]');
      occupantLoadInput.value = 20;

      // Escape height - upstairs
      const escapeHeightInput = secondFirecell.querySelector('input[name*="escapeHeight"]');
      escapeHeightInput.value = 4;

      // Is sprinklered
      const isSprinkleredSelect = secondFirecell.querySelector('select[name*="isSprinklered"]');
      isSprinkleredSelect.value = 'false';

      // Floor area
      const floorAreaInput = secondFirecell.querySelector('input[name*="floorArea"]');
      floorAreaInput.value = 200;
    }
  }, 100);
}

document.addEventListener('DOMContentLoaded', function() {
  // Initialize the form
  updateRemoveButtons();

  // Add event listener to the add button
  const addButton = document.getElementById('addFirecell');
  if (addButton) {
    addButton.addEventListener('click', addFirecell);
  }

  // Add event listener to fill test data button
  const fillTestDataButton = document.getElementById('fillTestData');
  if (fillTestDataButton) {
    fillTestDataButton.addEventListener('click', fillTestData);
  }

  // Add event listeners to existing risk group selects
  const existingSelects = document.querySelectorAll('select[name*="riskGroup"]');
  existingSelects.forEach(select => {
    select.addEventListener('change', function() {
      toggleConditionalFields(this);
    });
  });

  // Add event listeners to existing early childhood toggles
  const existingEarlyChildhoodToggles = document.querySelectorAll('.early-childhood-toggle');
  existingEarlyChildhoodToggles.forEach(toggle => {
    toggle.addEventListener('change', function() {
      const firecell = this.closest('.firecell-item');
      toggleEarlyChildhoodFields(firecell);
    });
  });

  // Add event listeners to existing escape height inputs
  const existingEscapeHeightInputs = document.querySelectorAll('input[name*="escapeHeight"]');
  existingEscapeHeightInputs.forEach(input => {
    input.addEventListener('change', function() {
      const firecell = this.closest('.firecell-item');
      toggleEarlyChildhoodFields(firecell);
    });
  });

  // Add event listeners to existing sleeping areas toggles
  const existingSleepingAreasToggles = document.querySelectorAll('.sleeping-areas-toggle');
  existingSleepingAreasToggles.forEach(toggle => {
    toggle.addEventListener('change', function() {
      const firecell = this.closest('.firecell-item');
      toggleSleepingAreaFields(firecell);
    });
  });

  // Add event listeners to existing remove buttons
  const existingRemoveButtons = document.querySelectorAll('.remove-firecell');
  existingRemoveButtons.forEach(button => {
    button.addEventListener('click', function() {
      const index = this.closest('.firecell-item').getAttribute('data-index');
      removeFirecell(index);
    });
  });
});