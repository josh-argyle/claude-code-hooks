{
  "name": "faster-project",
  "version": "1.0.28",
  "description": "",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "postinstall": "npx prisma generate --schema=api/schema.prisma",
    "lint": "npm run lint:js && npm run lint:pug && npm run lint:css",
    "lint:js": "eslint .",
    "lint:pug": "node scripts/lint-pug-console.js",
    "lint:css": "node scripts/check-css-issues.js",
    "lint:fix": "eslint . --fix",
    "lint:pug:fix": "pug-lint views/ --fix",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test:unit:coverage": "jest --coverage",
    "test:integration": "jest --config=jest.integration.config.js",
    "test:integration:watch": "jest --config=jest.integration.config.js --watch",
    "test:integration:coverage": "jest --config=jest.integration.config.js --coverage",
    "test:e2e": "playwright test",
    "test:e2e:no-security": "playwright test --project=setup --project=chromium --project=firefox --project=webkit --project=mobile-chrome --project=mobile-safari",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:install": "playwright install",
    "test:report": "playwright show-report",
    "test:login": "playwright test tests/e2e/auth/login.spec.js",
    "test:security": "playwright test tests/e2e/security/ --project=chromium-no-auth",
    "test:security:auth": "playwright test tests/e2e/security/authentication.spec.js --project=chromium-no-auth",
    "test:security:headed": "playwright test tests/e2e/security/ --project=chromium-no-auth --headed",
    "test:security:debug": "playwright test tests/e2e/security/ --project=chromium-no-auth --debug",
    "test:clean": "npm run test:integration -- --testNamePattern='cleanup' --verbose",
    "test:setup": "npm run test:integration -- --testNamePattern='setup' --verbose",
    "test:validate": "npm run test:unit && npm run test:integration -- --testNamePattern='validation'",
    "test:security:report": "playwright test tests/e2e/security/ --project=chromium-no-auth --reporter=html",
    "test:server": "node tests/test-server.js"
  },
  "private": true,
  "dependencies": {
    "@prisma/client": "6.11.1",
    "@sendgrid/mail": "^8.1.5",
    "axios": "^1.10.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "connect-pg-simple": "^10.0.0",
    "css": "^3.0.0",
    "dompurify": "^3.2.6",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "express-session": "^1.18.1",
    "express-slow-down": "^3.0.0",
    "helmet": "^8.1.0",
    "jsdom": "^26.1.0",
    "marked": "^16.0.0",
    "multer": "^2.0.1",
    "openai": "^4.73.1",
    "openmeteo": "^1.2.0",
    "pg": "^8.16.3",
    "prisma": "6.11.1",
    "pug": "^3.0.3",
    "socket.io": "^4.8.1",
    "validator": "^13.15.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/jest": "^30.0.0",
    "concurrently": "^8.2.2",
    "dotenv-cli": "^10.0.0",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-local-rules": "^3.0.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.6.0",
    "jest": "^30.1.3",
    "jest-environment-node": "^30.1.2",
    "nodemon": "^3.1.10",
    "playwright": "^1.54.2",
    "pug-lint": "^2.7.0",
    "supertest": "^7.1.4"
  }
}
