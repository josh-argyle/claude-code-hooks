## Part 4: Correct Implementation (Write This)

### File to Rewrite
`/api/processors/fire-safety-systems/note-evaluators/note-7-evaluator.js`

### Complete Correct Implementation

```javascript
/**
 * Evaluate CAS2 Table 2.2 Note 7
 *
 * REGULATORY REFERENCE: C/AS2 Table 2.2, Page 40, Note 7
 *
 * In buildings with Occupancy WB, where:
 * - the occupant load is 10 to 99, and
 * - storage is greater than 3 m in height,
 *
 * a Type 3 fire alarm system is required as an alternative to the
 * Type 9 automatic sprinkler system shown in the table.
 *
 * BEHAVIOR: This is an ADDITION note - adds Type 3 if conditions met
 *
 * @param {Object} firecell - The firecell being evaluated
 * @param {string} firecell.riskGroup - Risk group classification (must be 'WB')
 * @param {number} firecell.occupantLoad - Number of occupants in firecell
 * @param {number} firecell.maxStorageHeight - Maximum storage height in meters
 * @param {Object} projectModel - Project-wide parameters (not used for Note 7)
 * @param {Array} allFirecells - All firecells in building (not used for Note 7)
 * @returns {Object} Evaluation result
 * @returns {boolean} returns.applies - Whether note applies to this firecell
 * @returns {boolean} returns.requiresType3 - Whether Type 3 system should be added
 * @returns {string} returns.reason - Human-readable explanation
 * @returns {Object} returns.details - Additional details for debugging/reporting
 */
function evaluateNote7(firecell, projectModel, allFirecells = []) {
  // Note 7 only applies to WB (Working - Business/Storage) risk group
  if (firecell.riskGroup !== 'WB') {
    return {
      applies: false,
      requiresType3: false,
      reason: `Note 7 does not apply to risk group ${firecell.riskGroup} (only applies to WB)`,
      details: {
        riskGroup: firecell.riskGroup,
        expectedRiskGroup: 'WB',
      },
    };
  }

  // Get firecell parameters with defaults
  const occupantLoad = firecell.occupantLoad || 0;
  const maxStorageHeight = firecell.maxStorageHeight || 0;

  // Check Condition 1: Occupant load must be in range 10-99 (inclusive)
  const occupantInRange = occupantLoad >= 10 && occupantLoad <= 99;

  // Check Condition 2: Storage height must be greater than 3 meters (strictly >3.0m)
  const storageExceedsThreshold = maxStorageHeight > 3.0;

  // Both conditions must be true (AND logic)
  const requiresType3 = occupantInRange && storageExceedsThreshold;

  // Build detailed reason
  let reason;
  if (requiresType3) {
    reason = `Type 3 required: WB with ${occupantLoad} occupants (10-99 range) and ${maxStorageHeight}m storage (>3m threshold)`;
  } else if (!occupantInRange && !storageExceedsThreshold) {
    reason = `Type 3 not required: Occupant load ${occupantLoad} (need 10-99) and storage ${maxStorageHeight}m (need >3m)`;
  } else if (!occupantInRange) {
    reason = `Type 3 not required: Occupant load ${occupantLoad} outside range 10-99`;
  } else {
    reason = `Type 3 not required: Storage height ${maxStorageHeight}m not greater than 3m`;
  }

  return {
    applies: true, // Note 7 applies to WB risk group
    requiresType3: requiresType3,
    reason: reason,
    details: {
      riskGroup: firecell.riskGroup,
      occupantLoad: occupantLoad,
      occupantInRange: occupantInRange,
      occupantRangeCheck: '10-99 inclusive',
      maxStorageHeight: maxStorageHeight,
      storageExceedsThreshold: storageExceedsThreshold,
      storageThreshold: '>3.0m',
      bothConditionsMet: requiresType3,
    },
  };
}

module.exports = {
  evaluateNote7,
};
```

