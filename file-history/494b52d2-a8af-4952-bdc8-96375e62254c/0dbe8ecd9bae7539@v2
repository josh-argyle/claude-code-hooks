**Floor Normalization Logic:**

| Input Variations | Normalized Output | Description |
|------------------|-------------------|-------------|
| 'G', 'g', 'Ground', 'GROUND', '0', 0, 'Level 0' | 0 | Ground floor |
| 'B', 'Basement', 'BASEMENT', 'B1' | -1 | Basement level 1 |
| 'B2', 'B 2' | -2 | Basement level 2 |
| 'SB', 'SB1' | -11 | Sub-basement level 1 |
| 'SB2' | -12 | Sub-basement level 2 |
| 'M', 'Mezzanine', 'MEZZANINE' | 0.5 | Mezzanine between ground and first |
| 'R', 'Roof', 'ROOF' | 999 | Roof level |
| '1', 1, 'Level 1', 'Floor 1' | 1 | First floor |
| '2', 2, 'Level 2', 'Floor 2' | 2 | Second floor |
| null, undefined, '' | 0 | Default to ground floor |

**Complete Implementation (use this exactly):**

```javascript
/**
 * Floor Normalization Utility
 *
 * Normalizes floor identifiers to consistent numeric values for comparison.
 * Required for Notes 1b and 1c which check for "single level building".
 *
 * @module floor-normalization
 */

/**
 * Normalize floor identifiers to consistent numeric values
 *
 * Handles common floor naming variations:
 * - Ground floor: G, 0, Ground, Level 0 → 0
 * - Basement: B, Basement, B1 → -1, B2 → -2
 * - Sub-basement: SB, SB1 → -11, SB2 → -12
 * - Mezzanine: M, Mezzanine → 0.5
 * - Roof: R, Roof → 999
 * - Standard: 1, 2, 3, etc. → 1, 2, 3
 *
 * @param {string|number} floor - Floor identifier (e.g., 'G', '0', 'Ground', 1, 'B1')
 * @returns {number} Normalized floor number
 *
 * @example
 * normalizeFloor('G')       // Returns: 0
 * normalizeFloor('0')       // Returns: 0
 * normalizeFloor('Ground')  // Returns: 0
 * normalizeFloor('B')       // Returns: -1
 * normalizeFloor('B2')      // Returns: -2
 * normalizeFloor('1')       // Returns: 1
 * normalizeFloor('M')       // Returns: 0.5
 */
function normalizeFloor(floor) {
  // Handle null, undefined, or empty string
  if (floor === null || floor === undefined || floor === '') {
    return 0; // Default to ground floor
  }

  // Convert to string for consistent processing
  const floorStr = String(floor).trim().toUpperCase();

  // Handle empty string after trim
  if (floorStr === '') {
    return 0;
  }

  // Ground floor variations
  if (
    floorStr === 'G' ||
    floorStr === 'GROUND' ||
    floorStr === 'GROUND FLOOR' ||
    floorStr === '0' ||
    floorStr === 'LEVEL 0'
  ) {
    return 0;
  }

  // Basement variations
  if (floorStr === 'B' || floorStr === 'BASEMENT') {
    return -1;
  }

  // Basement with level number (B1, B2, B 1, B 2, etc.)
  if (floorStr.startsWith('B') && floorStr !== 'BASEMENT') {
    const basementMatch = floorStr.match(/B\s*(\d+)/);
    if (basementMatch) {
      const level = parseInt(basementMatch[1]);
      return -level;
    }
    // Just 'B' followed by non-numeric - treat as B1
    return -1;
  }

  // Sub-basement variations (SB, SB1, SB2, etc.)
  if (floorStr === 'SB' || floorStr === 'SUB-BASEMENT' || floorStr === 'SUBBASEMENT') {
    return -11;
  }

  if (floorStr.startsWith('SB')) {
    const sbMatch = floorStr.match(/SB\s*(\d+)/);
    if (sbMatch) {
      const level = parseInt(sbMatch[1]);
      return -(level + 10); // SB1 = -11, SB2 = -12, etc.
    }
    // Just 'SB' followed by non-numeric - treat as SB1
    return -11;
  }

  // Mezzanine
  if (floorStr === 'M' || floorStr === 'MEZZANINE') {
    return 0.5;
  }

  // Roof
  if (floorStr === 'R' || floorStr === 'ROOF') {
    return 999;
  }

  // Try to parse as direct number
  const numericFloor = parseFloat(floorStr);
  if (!isNaN(numericFloor)) {
    return numericFloor;
  }

  // Extract numeric from "Level 1", "Floor 2", etc.
  const levelMatch = floorStr.match(/(?:LEVEL|FLOOR|L|F)\s*(\d+)/);
  if (levelMatch) {
    return parseInt(levelMatch[1]);
  }

  // Extract any standalone number from the string
  const anyNumberMatch = floorStr.match(/\d+/);
  if (anyNumberMatch) {
    return parseInt(anyNumberMatch[0]);
  }

  // Fallback: treat as ground floor and log warning
  console.warn(`Unable to normalize floor identifier: "${floor}", defaulting to ground floor (0)`);
  return 0;
}

/**
 * Check if all firecells are on the same normalized floor
 *
 * @param {Array} firecells - Array of firecell objects with floor property
 * @returns {boolean} True if all firecells are on the same floor
 *
 * @example
 * allOnSameFloor([
 *   { floor: 'G' },
 *   { floor: '0' },
 *   { floor: 'Ground' }
 * ]) // Returns: true (all ground floor)
 *
 * allOnSameFloor([
 *   { floor: 'G' },
 *   { floor: '1' }
 * ]) // Returns: false (different floors)
 */
function allOnSameFloor(firecells) {
  // Handle edge cases
  if (!firecells || firecells.length === 0) {
    return true; // Empty array is trivially "all on same floor"
  }

  if (firecells.length === 1) {
    return true; // Single firecell is trivially "all on same floor"
  }

  // Normalize all floor values
  const normalizedFloors = firecells.map(fc => normalizeFloor(fc.floor));

  // Get first floor as reference
  const referenceFloor = normalizedFloors[0];

  // Check if all normalized floors match the reference
  return normalizedFloors.every(floor => floor === referenceFloor);
}

/**
 * Check if building is single-level (all firecells on one floor)
 *
 * This is a convenience wrapper around allOnSameFloor() for better readability
 * in code that checks for "single level building" requirements (Notes 1b, 1c).
 *
 * @param {Array} firecells - All firecells in the building
 * @returns {boolean} True if single-level building
 *
 * @example
 * isSingleLevelBuilding([
 *   { floor: 'G' },
 *   { floor: '0' }
 * ]) // Returns: true
 */
function isSingleLevelBuilding(firecells) {
  return allOnSameFloor(firecells);
}

module.exports = {
  normalizeFloor,
  allOnSameFloor,
  isSingleLevelBuilding,
};
```

