```javascript
// Add to api/utils/floor-normalization.js (NEW FILE)
/**
 * Normalize floor identifiers to consistent numeric values
 * @param {string|number} floor - Floor identifier
 * @returns {number} Normalized floor number
 */
function normalizeFloor(floor) {
  if (floor === null || floor === undefined) {
    return 0; // Default to ground
  }

  // Convert to string for comparison
  const floorStr = String(floor).trim().toUpperCase();

  // Ground floor variations
  if (
    floorStr === 'G' ||
    floorStr === 'GROUND' ||
    floorStr === '0' ||
    floorStr === 'LEVEL 0'
  ) {
    return 0;
  }

  // Basement/lower floors
  if (floorStr === 'B' || floorStr === 'BASEMENT' || floorStr.startsWith('B')) {
    // Handle B1, B2, etc.
    const basementMatch = floorStr.match(/B(\d+)?/);
    if (basementMatch) {
      const level = basementMatch[1] ? parseInt(basementMatch[1]) : 1;
      return -level;
    }
    return -1;
  }

  // Sub-basement
  if (floorStr === 'SB' || floorStr.startsWith('SB')) {
    const sbMatch = floorStr.match(/SB(\d+)?/);
    if (sbMatch) {
      const level = sbMatch[1] ? parseInt(sbMatch[1]) : 1;
      return -(level + 10); // SB1 = -11, SB2 = -12, etc.
    }
    return -11;
  }

  // Mezzanine (treat as 0.5)
  if (floorStr === 'M' || floorStr === 'MEZZANINE') {
    return 0.5;
  }

  // Roof (treat as 999)
  if (floorStr === 'R' || floorStr === 'ROOF') {
    return 999;
  }

  // Standard numeric floors
  const numericFloor = parseFloat(floorStr);
  if (!isNaN(numericFloor)) {
    return numericFloor;
  }

  // Extract numeric from "Level 1", "Floor 2", etc.
  const levelMatch = floorStr.match(/\d+/);
  if (levelMatch) {
    return parseInt(levelMatch[0]);
  }

  // Fallback: treat as ground
  console.warn(`Unable to normalize floor: ${floor}, defaulting to 0`);
  return 0;
}

/**
 * Check if all firecells are on the same normalized floor
 * @param {Array} firecells - Array of firecell objects with floor property
 * @returns {boolean} True if all on same floor
 */
function allOnSameFloor(firecells) {
  if (!firecells || firecells.length === 0) return true;
  if (firecells.length === 1) return true;

  const normalizedFloors = firecells.map(fc => normalizeFloor(fc.floor));
  const firstFloor = normalizedFloors[0];

  return normalizedFloors.every(floor => floor === firstFloor);
}

/**
 * Check if building is single-level (all firecells on one floor)
 * @param {Array} firecells - All firecells in building
 * @returns {boolean} True if single-level building
 */
function isSingleLevelBuilding(firecells) {
  return allOnSameFloor(firecells);
}

module.exports = {
  normalizeFloor,
  allOnSameFloor,
  isSingleLevelBuilding,
};
```

