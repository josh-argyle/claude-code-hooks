  { id: 'WB-1', floor: 'G', maxStorageHeight: 2.5, occupantLoad: 40 },  // Meets both
  { id: 'WB-2', floor: 'G', maxStorageHeight: 2.0, occupantLoad: 45 },  // Meets both
  { id: 'WB-3', floor: 'G', maxStorageHeight: 3.5, occupantLoad: 30 },  // FAILS storage
];

// Result: ALL THREE keep Type 2 system
