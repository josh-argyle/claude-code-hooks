```javascript
// api/utils/firecell-validator.js (NEW FILE)
const REQUIRED_PROPERTIES = {
  ALL: ['riskGroup', 'occupantLoad', 'escapeHeight'],
  SM: ['smOccupantType'],
  SI: [],
  CA: [],
  WB: [],
  WS: [],
  VP: [],
};

const OPTIONAL_PROPERTIES = {
  SM: ['maxEscapeRouteBeds', 'exitDirectlyToSafePlace', 'floor'],
  SI: ['hospitalCareDetentionCount'],
  CA: ['maxEscapeRouteOccupants', 'floor', 'isEarlyChildhoodCentre', 'challengingSmokeEnvironment'],
  WB: ['maxEscapeRouteOccupants', 'floor', 'maxStorageHeight', 'totalFloorArea', 'challengingSmokeEnvironment'],
  WS: [],
  VP: ['vehicleCount', 'floorArea', 'isSprinklered', 'hasCrossVentilation'],
};

function validateFirecellProperties(firecell) {
  const errors = [];
  const warnings = [];

  // Check required properties
  REQUIRED_PROPERTIES.ALL.forEach(prop => {
    if (firecell[prop] === undefined || firecell[prop] === null) {
      errors.push(`Missing required property: ${prop}`);
    }
  });

  // Check risk group specific required properties
  if (firecell.riskGroup) {
    const riskRequired = REQUIRED_PROPERTIES[firecell.riskGroup] || [];
    riskRequired.forEach(prop => {
      if (firecell[prop] === undefined || firecell[prop] === null) {
        errors.push(`Missing required property for ${firecell.riskGroup}: ${prop}`);
      }
    });
  }

  // Warn about missing optional properties that affect note evaluations
  if (firecell.riskGroup) {
    const riskOptional = OPTIONAL_PROPERTIES[firecell.riskGroup] || [];
    riskOptional.forEach(prop => {
      if (firecell[prop] === undefined || firecell[prop] === null) {
        warnings.push(`Optional property ${prop} not provided - may affect note evaluations`);
      }
    });
  }

  return {
    valid: errors.length === 0,
    errors,
    warnings,
  };
}

module.exports = {
  validateFirecellProperties,
};
```

