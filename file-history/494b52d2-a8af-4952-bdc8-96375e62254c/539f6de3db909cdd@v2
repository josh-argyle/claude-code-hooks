```javascript
// After displaying fire safety systems table, add compliance section

function generateNote4ComplianceSection(firecell) {
  const compliance = firecell.fireSafetySystemsCompliance;
  const paragraphs = [];

  // Condition (a): Supplementary smoke detectors
  if (compliance.supplementarySmokeDetectors) {
    const ssd = compliance.supplementarySmokeDetectors;

    paragraphs.push({
      type: 'heading',
      level: 4,
      content: 'Early Childhood Centre - Supplementary Smoke Detectors (CAS2 2.2.4(a))'
    });

    paragraphs.push({
      type: 'text',
      content: `This single-storey early childhood centre has dedicated sleeping areas
                that require supplementary smoke detectors compliant with NZS 4512.
                Compliance status: ${getComplianceStatus(ssd.compliant)}`
    });
  }

  // Condition (b): Places of safety
  if (compliance.placesOfSafety) {
    const pos = compliance.placesOfSafety;

    paragraphs.push({
      type: 'heading',
      level: 4,
      content: 'Early Childhood Centre - Places of Safety (CAS2 2.2.4(b))'
    });

    paragraphs.push({
      type: 'text',
      content: `This early childhood centre has an escape height greater than 2.0m and
                therefore requires a Type 7 emergency warning system throughout the building.
                Additionally, at least ${pos.minimumRequired} separate places of safety must
                be provided, with fire separations designed to the property rating and direct
                access to a safe path or final exit. Compliance status: ${getComplianceStatus(pos.compliant)}`
    });
  }

  return paragraphs;
}

function getComplianceStatus(compliant) {
  if (compliant === true) {
    return '✓ COMPLIANT';
  } else if (compliant === false) {
    return '✗ NON-COMPLIANT';
  } else {
    return '? COMPLIANCE STATUS NOT PROVIDED';
  }
}
```

