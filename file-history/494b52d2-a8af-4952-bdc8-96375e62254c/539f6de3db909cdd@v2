#### 4.3 Form State Management

**Handle escape height changes:**

```javascript
function handleEscapeHeightChange(newHeight) {
  // Update escape height
  setFormData(prev => ({ ...prev, escapeHeight: newHeight }));

  // Clear irrelevant fields when crossing 2.0m threshold
  const prevHeight = formData.escapeHeight || 0;

  if (prevHeight <= 2.0 && newHeight > 2.0) {
    // Moving from condition (a) to condition (b)
    setFormData(prev => ({
      ...prev,
      hasDedicatedSleepingAreas: null,
      supplementarySmokeDetectorsCompliant: null
    }));
  } else if (prevHeight > 2.0 && newHeight <= 2.0) {
    // Moving from condition (b) to condition (a)
    setFormData(prev => ({
      ...prev,
      placesOfSafetyCompliant: null
    }));
  }
}
```

#### 4.4 Form Validation

**Client-side validation rules:**

```javascript
function validateNote4Fields(formData) {
  const errors = [];

  if (formData.isEarlyChildhoodCentre && formData.riskGroup === 'CA') {
    // Condition (a) validation
    if (formData.escapeHeight <= 2.0) {
      if (formData.hasDedicatedSleepingAreas === true) {
        if (formData.supplementarySmokeDetectorsCompliant === null ||
            formData.supplementarySmokeDetectorsCompliant === undefined) {
          errors.push({
            field: 'supplementarySmokeDetectorsCompliant',
            message: 'Please indicate if supplementary smoke detectors are compliant with NZS 4512'
          });
        }
      }
    }

    // Condition (b) validation
    if (formData.escapeHeight > 2.0) {
      if (formData.placesOfSafetyCompliant === null ||
          formData.placesOfSafetyCompliant === undefined) {
        errors.push({
          field: 'placesOfSafetyCompliant',
          message: 'Please indicate if two separate places of safety are provided per CAS2 2.2.4(b)'
        });
      }
    }
  }

  return errors;
}
```

