            email: `${userData.username}@test.com`,
            phone: '+64 3 123 4567',
            updated_at: new Date()
          }
        });

        createdUsers.push({ ...user, role: userData.role });
      }

      return createdUsers;
    });

    // Store user references globally for easy access in tests
    global.TEST_USER_IDS = {};
    global.TEST_USERNAMES = {};

    const userMap = {
      admin: 'ROOT_ADMIN',
      test_admin: 'ADMIN',
