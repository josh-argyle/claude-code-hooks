  static async seedLabourForecastingData(prisma) {
    // Helper function to get Monday of current week
    const getCurrentWeekMonday = () => {
      const now = new Date();
      const dayOfWeek = now.getDay();
      const mondayOffset = dayOfWeek === 0 ? -6 : 1;
      const diff = now.getDate() - dayOfWeek + mondayOffset;
      const monday = new Date(now.getFullYear(), now.getMonth(), diff);
      return monday;
    };

    // Helper function to add weeks to a date
    const addWeeks = (date, weeks) => {
      const result = new Date(date.getTime());
      // eslint-disable-next-line no-restricted-syntax
      result.setDate(result.getDate() + (weeks * 7));
      return result;
    };

    const currentWeekMonday = getCurrentWeekMonday();
    const foremanUser = global.TEST_USER_IDS.FOREMAN;
    const foreman2User = global.TEST_USER_IDS.FOREMAN2;

    const projectCodes = ['DN001', 'CH002', 'QT003'];

    // Create forecasting data for current week and next 2 weeks
    for (let weekOffset = 0; weekOffset < 3; weekOffset++) {
      const weekStart = addWeeks(currentWeekMonday, weekOffset);

      for (const projectCode of projectCodes) {
        const foremanId = projectCode === 'DN001'
          ? foremanUser
          : projectCode === 'CH002'
            ? foreman2User
            : null;

        let baseWorkforce;
        if (projectCode === 'DN001') {
          baseWorkforce = { mon_am: 4, mon_pm: 4, tue_am: 3, tue_pm: 3, wed_am: 4, wed_pm: 4, thu_am: 3, thu_pm: 3, fri_am: 2, fri_pm: 2, sat: 0 };
        } else if (projectCode === 'CH002') {
          baseWorkforce = { mon_am: 6, mon_pm: 6, tue_am: 6, tue_pm: 6, wed_am: 5, wed_pm: 5, thu_am: 6, thu_pm: 6, fri_am: 4, fri_pm: 4, sat: 2 };
        } else {
          baseWorkforce = { mon_am: 2, mon_pm: 2, tue_am: 3, tue_pm: 3, wed_am: 3, wed_pm: 3, thu_am: 2, thu_pm: 2, fri_am: 2, fri_pm: 2, sat: 0 };
        }

        // Vary workforce by week (simulate planning changes)
        const weekMultiplier = weekOffset === 0 ? 1 : weekOffset === 1 ? 0.8 : 1.2;
        const adjustedWorkforce = Object.fromEntries(
          Object.entries(baseWorkforce).map(([key, value]) => [key, Math.round(value * weekMultiplier)])
        );

        await prisma.rostering_project_data.upsert({
          where: {
            project_code_forecast_week_start: {
              project_code: projectCode,
              forecast_week_start: weekStart
            }
          },
          update: {},
          create: {
            project_code: projectCode,
            forecast_week_start: weekStart,
            foreman_id: foremanId,
            is_visible: true,
            ...adjustedWorkforce,
            created_at: new Date(),
            updated_at: new Date()
          }
        });
      }
    }

