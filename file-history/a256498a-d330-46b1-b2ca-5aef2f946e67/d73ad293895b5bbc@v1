          } else {
            categoryData = { mon_am: 0, mon_pm: 0, tue_am: 0, tue_pm: 0, wed_am: 0, wed_pm: 0, thu_am: 0, thu_pm: 0, fri_am: 0, fri_pm: 0, sat: 0 };
          }

          await prisma.rostering_profit_centre_data.upsert({
            where: {
              profit_centre_category_name_forecast_week_start: {
                profit_centre: profitCentre,
                category_name: category,
                forecast_week_start: weekStart
              }
            },
            update: {},
            create: {
