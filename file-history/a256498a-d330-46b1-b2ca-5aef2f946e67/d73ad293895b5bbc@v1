            is_active: true,
            updated_at: new Date()
          }
        });

        // Assign role using role_id (upsert to handle duplicates)
        const roleId = roleMap[userData.role];
        if (roleId) {
          await tx.users_roles.upsert({
            where: {
              user_id_role_id: {
                user_id: user.user_id,
