  static async cleanupWithRelationships() {
    const prisma = await this.getConnection();

    // Clean up test data in reverse dependency order to avoid foreign key violations
    const cleanupOrder = [
      // Analytics tables (reference users)
      'analytics_page_visits',

      // Initiative-related tables (reference users and config tables)
      'initiative_steps',
      'initiative_phases',
      'initiative_requirements',
      'initiatives',

      // NCR-related tables (must be before users due to foreign key constraints)
      'ncr_images',
      'ncr_companies',
      'ncr_users',
      'ncr_reports',

      // Rostering tables (must be before config_profit_centres and users)
      'rostering_profit_centre_availability',
      'rostering_project_data',
      'rostering_profit_centre_data',
      'rostering_staff_allocations',

      // Other dependent tables
      'staff_profit_centre_assignments',
      'articles',
      'feedback_reports',
      'users_contacts',
      'users_roles',
      'company_types',
      'contacts',
      'companies',

      // Core tables (users references config_profit_centres)
      'users',
      'config_roles',
      'config_initiative_statuses',
      'config_profit_centres'
    ];

    console.log('🧹 Starting database cleanup...');

    const cleanedTables = [];
    const failedTables = [];

    for (const table of cleanupOrder) {
      try {
        await prisma.$executeRawUnsafe(`DELETE FROM ${table} WHERE 1=1`);
        cleanedTables.push(table);
      } catch (error) {
        // Table might not exist or might be empty - this is OK
        failedTables.push(`${table} (${error.message})`);
      }
    }

    console.log(`✅ Database cleanup completed: ${cleanedTables.length} tables cleaned${failedTables.length > 0 ? `, ${failedTables.length} failed` : ''}`);
  }

  static async validateEnvironment() {
    DatabaseConnection.validateTestEnvironment();

    const healthy = await DatabaseConnection.healthCheck();
    if (!healthy) {
      throw new Error('❌ Database health check failed');
    }
  }

