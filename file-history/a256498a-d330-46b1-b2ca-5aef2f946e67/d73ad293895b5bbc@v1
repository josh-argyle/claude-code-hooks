            categoryData = { mon_am: 1, mon_pm: 1, tue_am: 0, tue_pm: 0, wed_am: 1, wed_pm: 1, thu_am: 2, thu_pm: 2, fri_am: 3, fri_pm: 3, sat: 0 };
