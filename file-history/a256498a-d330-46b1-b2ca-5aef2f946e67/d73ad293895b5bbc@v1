          closing_date: new Date('2025-06-01'),
          tender_amount: 4200000.00,
          winning_competitor_id: null, // Was winning_competitor: 'Hawkins Construction',
          area: 'South Dunedin',
          notes: 'Lost to incumbent contractor',
          contractors: [
            { contractor_name: 'Community Builders', status: 'Submitted' },
            { contractor_name: 'Social Housing Specialists', status: 'Submitted' }
          ]
        }
      ];

      // Create tenders and their contractors
      for (const tenderData of testTenders) {
        const { contractors, ...tenderInfo } = tenderData;

        // Create the tender
        await prisma.tenders.create({
          data: {
            ...tenderInfo,
            created_at: new Date(),
            updated_at: new Date()
          }
        });

        // Add contractors for this tender
        for (const contractor of contractors) {
          await prisma.tenders_main_contractors.create({
            data: {
              tender_id: tenderInfo.tender_id,
              contractor_name: contractor.contractor_name,
              status: contractor.status
            }
          });
        }
      }

      return 'tenderbook';
    } catch (error) {
      console.log('  ⚠️  Tenderbook seeding error:', error.message);
      return 'tenderbook (failed)';
    }
  }

  static async disconnect() {
    await DatabaseConnection.disconnect();
  }
}

module.exports = DatabaseUtils;
