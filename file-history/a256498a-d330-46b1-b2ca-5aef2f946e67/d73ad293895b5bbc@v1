    results.push(await this.seedTestNotifications(prisma));
    results.push(await this.seedTestTodos(prisma));
    results.push(await this.seedTestTenderbook(prisma));

    console.log(`🌱 Test data seeded: ${results.filter(Boolean).join(', ')}`);
  }

