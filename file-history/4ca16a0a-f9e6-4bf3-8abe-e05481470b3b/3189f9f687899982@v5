// Import route calculation from existing validator
// Or replicate the logic from route-number-validator.js
function getRequiredRouteCount(riskGroup, occupantLoad) {
  // Simplified version - full logic should match route-number-validator.js
  const ROUTE_REQUIREMENTS = {
    SM: { 50: 1, 100: 2, 150: 3, 200: 3, 250: 4, 300: 4 },
    SI: { 50: 2, 100: 3, 150: 3, 200: 4, 250: 4, 300: 4 },
    // ... etc
  };

  const requirements = ROUTE_REQUIREMENTS[riskGroup];
  if (!requirements) return 1;

  for (const [threshold, routes] of Object.entries(requirements).sort((a, b) => a[0] - b[0])) {
    if (occupantLoad <= parseInt(threshold)) {
      return routes;
    }
  }
  return 1;
}
```

