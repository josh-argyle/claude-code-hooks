        // Update name attribute based on risk group
        smSiSelect.name = selectElement.value === 'SM'
          ? smSiSelect.name.replace('[siOccupantType]', '[smOccupantType]')
          : smSiSelect.name.replace('[smOccupantType]', '[siOccupantType]');
