#### Processing Logic

```javascript
function processEscapeRoutes(projectModel) {
  const firecells = projectModel.getAllFirecells();

  for (let i = 0; i < firecells.length; i++) {
    const firecell = firecells[i];

    // 1. Calculate required number of escape routes (CAS2 Table 3.1)
    const requiredRoutes = getRequiredRouteCount(
      firecell.riskGroup,
      firecell.occupantLoad
    );

    // 2. Validate route count meets CAS2 requirements
    if (!firecell.numberOfEscapeRoutes) {
      throw new Error(`Firecell ${i + 1}: Number of escape routes is required`);
    }

    if (firecell.numberOfEscapeRoutes < requiredRoutes) {
      throw new Error(
        `Firecell ${i + 1}: Insufficient escape routes. ` +
        `Provided: ${firecell.numberOfEscapeRoutes}, Required: ${requiredRoutes}`
      );
    }

    // 3. Validate maxEscapeRouteBeds/maxEscapeRouteOccupants (user-provided from form)
    if (firecell.riskGroup === 'SM' || firecell.riskGroup === 'SI') {
      if (firecell.maxEscapeRouteBeds === undefined) {
        throw new Error(`Firecell ${i + 1}: Maximum beds per escape route is required`);
      }
      if (firecell.maxEscapeRouteBeds > firecell.occupantLoad) {
        throw new Error(
          `Firecell ${i + 1}: Max beds/route (${firecell.maxEscapeRouteBeds}) ` +
          `cannot exceed total beds (${firecell.occupantLoad})`
        );
      }
    } else {
      if (firecell.maxEscapeRouteOccupants === undefined) {
        throw new Error(`Firecell ${i + 1}: Maximum occupants per escape route is required`);
      }
      if (firecell.maxEscapeRouteOccupants > firecell.occupantLoad) {
        throw new Error(
          `Firecell ${i + 1}: Max occupants/route (${firecell.maxEscapeRouteOccupants}) ` +
          `cannot exceed total occupants (${firecell.occupantLoad})`
        );
      }
    }

    // 4. Store validated route requirements
    projectModel.firecells[i].requiredEscapeRoutes = requiredRoutes;

    // 4. Calculate route widths (CAS2 Table 3.1a)
    const minWidths = calculateMinimumRouteWidths(
      firecell.riskGroup,
      firecell.occupantLoad,
      requiredRoutes
    );
    projectModel.firecells[i].minimumRouteWidths = minWidths;

    // 5. Calculate travel distance limits (CAS2 Tables 3.2, 3.4)
    const fireSystems = projectModel.firecells[i].fireSafetySystems || [];
    const fireProtectionLevel = determineFireProtectionLevel(fireSystems);

    const travelLimits = calculateTravelDistanceLimits(
      firecell.riskGroup,
      fireProtectionLevel
    );
    projectModel.firecells[i].travelDistanceLimits = travelLimits;
  }

  return projectModel;
}
```

#### Why User Input is the Correct Approach

1. **Accuracy**: Users have architectural drawings showing actual escape route layouts
2. **Safety**: No unsafe assumptions - real data from building design
3. **Note 1a Works Correctly**: Genuine data for "escape routes serve no more than 10 beds"
4. **Compliance Validation**: Can verify route count meets CAS2 Table 3.1
5. **Educational**: Helps users understand escape route requirements

**Examples**:
- **Equal distribution**: 20 beds, 2 routes, each serves 10 beds
  - User enters: `numberOfEscapeRoutes=2`, `maxEscapeRouteBeds=10`
  - Note 1a: maxEscapeRouteBeds=10 → ≤10 → Exemption granted ✅

- **Unequal distribution**: 20 beds, 2 routes, Route A serves 15, Route B serves 5
  - User enters: `numberOfEscapeRoutes=2`, `maxEscapeRouteBeds=15` (the larger)
  - Note 1a: maxEscapeRouteBeds=15 → >10 → No exemption ✅

