function updateRouteDistributionHint(firecell) {
  const riskGroup = firecell.querySelector('select[name*="[riskGroup]"]')?.value;
  const occupantLoad = parseInt(firecell.querySelector('input[name*="[occupantLoad]"]')?.value || 0);
  const numberOfRoutes = parseInt(firecell.querySelector('.route-count')?.value || 1);

  if (occupantLoad > 0 && numberOfRoutes > 0) {
    const perRoute = Math.ceil(occupantLoad / numberOfRoutes);

    if (riskGroup === 'SM' || riskGroup === 'SI') {
      const maxBedsInput = firecell.querySelector('input[name*="[maxEscapeRouteBeds]"]');
      if (maxBedsInput && !maxBedsInput.value) {
