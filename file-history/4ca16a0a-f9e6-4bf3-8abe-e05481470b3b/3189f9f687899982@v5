    } else {
      const maxOccupantsInput = firecell.querySelector('input[name*="[maxEscapeRouteOccupants]"]');
      if (maxOccupantsInput && !maxOccupantsInput.value) {
        maxOccupantsInput.placeholder = `Suggested: ${perRoute} occupants (equal distribution)`;
      }
    }
  }
}

