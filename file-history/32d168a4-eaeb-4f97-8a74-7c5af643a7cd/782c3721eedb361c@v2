const {
  createInfoParagraph,
  createTableParagraph,
  createComplianceParagraph,
  createListParagraph,
} = require('../../utilities/paragraph-builder');

/**
 * TEXT constants with professional fire safety language
 * Adapted for C/AS2 Table 2.2 fire safety systems requirements
 */
const TEXT = {
  SECTION_TITLE: "Fire Safety System Requirements",

  intro: {
    content: "The following fire safety systems are required in accordance with C/AS2 Table 2.2:"
  },

  table_title: "Required Fire Safety Systems (C/AS2 Table 2.2)",

  remote_receiving_centre: {
    title: "Remote Receiving Centre Connection",
    required_compliant: "A connection to a remote receiving centre is required and has been provided in accordance with C/AS2 requirements.",
    required_non_compliant: "A connection to a remote receiving centre is required by C/AS2 but has not been provided.",
    not_required: (message) => message || "A connection to a remote receiving centre is not required for this building configuration."
  },

  early_childhood: {
    title: (firecellNum) => `Early Childhood Centre Requirements - Firecell ${firecellNum} (CAS2 2.2.4)`,

    // Condition (a): Escape height ≤ 2.0m with sleeping areas
    condition_a_title: "Single Storey Early Childhood Centre (CAS2 2.2.4(a))",
    sleeping_areas_compliant: "This single-storey early childhood centre has dedicated sleeping areas protected with supplementary smoke detectors compliant with NZS 4512.",
    sleeping_areas_non_compliant: "This single-storey early childhood centre has dedicated sleeping areas that require supplementary smoke detectors compliant with NZS 4512. Compliance status: NON-COMPLIANT.",
    sleeping_areas_not_provided: "This single-storey early childhood centre has dedicated sleeping areas that require supplementary smoke detectors compliant with NZS 4512. Compliance status has not been provided.",
    no_sleeping_areas: "This single-storey early childhood centre does not have dedicated sleeping areas, therefore supplementary smoke detectors are not required under CAS2 2.2.4(a).",

    // Condition (b): Escape height > 2.0m
    condition_b_title: "Early Childhood Centre with Escape Height > 2.0m (CAS2 2.2.4(b))",
    type7_required: (escapeHeight) => `This early childhood centre has an escape height of ${escapeHeight}m (greater than 2.0m) and therefore requires a Type 7 emergency warning system throughout the building in accordance with CAS2 2.2.4(b)(i). The Type 7 system has been included in the required fire safety systems listed above.`,
    places_of_safety_compliant: "Two separate places of safety have been provided, with fire separations designed to the property rating and direct access to a safe path or final exit, in accordance with CAS2 2.2.4(b)(ii) and (iii).",
    places_of_safety_non_compliant: "CAS2 2.2.4(b)(ii) and (iii) require at least two separate places of safety with fire separations designed to the property rating and direct access to a safe path or final exit. Compliance status: NON-COMPLIANT.",
    places_of_safety_not_provided: "CAS2 2.2.4(b)(ii) and (iii) require at least two separate places of safety with fire separations designed to the property rating and direct access to a safe path or final exit. Compliance status has not been provided."
  },

  nzs_4515: {
    title: "NZS 4515 Sprinkler Substitution (C/AS2 Para 2.2.3)",
    eligible: (totalArea, scopeLimit) =>
      `This building is within NZS 4515 scope (${totalArea}m² ≤ ${scopeLimit}m²). The Type 7 sprinkler component may be substituted with NZS 4515 life protection sprinklers per C/AS2 Paragraph 2.2.3.`,
    substituted: "NZS 4515 life protection sprinklers have been selected and will be used instead of Type 7 sprinkler component. This substitution is compliant with C/AS2 2.2.3.",
    not_eligible_exceeds_scope: (totalArea, scopeLimit) =>
      `Building total floor area (${totalArea}m²) exceeds NZS 4515 scope limit (${scopeLimit}m²). Type 7 system is required - NZS 4515 substitution is not permitted.`,
    not_substituted: "Type 7 system will be installed (no NZS 4515 substitution requested).",
    extended_scope_note: "Note: Buildings between 500m² and 2000m² require 60-minute water supply, fire brigade alarm, and fire sprinkler inlet per NZS 4515:2009 Section 1.1.3.2."
  },

  validation: {
    title: (firecellNum) => `Fire Safety Systems Validation - Firecell ${firecellNum}`,
    table_title: "Required vs Installed Systems",
    compliant: "✓ All required fire safety systems are installed and compliant.",
    non_compliant: (count) => `✗ ${count} required system(s) missing or non-compliant. See details below.`,
    no_systems: "✗ NO FIRE SAFETY SYSTEMS INSTALLED - All required systems are missing.",
    missing_systems_title: "Missing Required Systems",
    unnecessary_systems_title: "Additional Systems Installed (Not Required)",
    unnecessary_note: "Note: Installing additional systems beyond requirements is acceptable and may provide enhanced protection.",
    substitutions_title: "Substitutions Applied"
  }
};

/**
 * Generate compliance paragraphs for fire safety systems
 * @param {ProjectModel} projectModel - The complete project model with all data
 * @returns {Array} Array of paragraph objects
 */
function generateComplianceParagraphs(projectModel) {
  const paragraphs = [];

  // Introduction
  paragraphs.push(
    createInfoParagraph(
      TEXT.SECTION_TITLE,
      TEXT.intro.content
    )
  );

  // Table of fire safety systems per firecell
  if (projectModel.firecells && projectModel.firecells.length > 0) {
    const headers = ['Firecell', 'Risk Group', 'Escape Height (m)', 'Required Systems'];
    const rows = [];

    projectModel.firecells.forEach((firecell, index) => {
      // Get system descriptions from processedFireSafetySystems
      let systemDescriptions = 'Not specified';
      if (firecell.processedFireSafetySystems && firecell.processedFireSafetySystems.length > 0) {
        systemDescriptions = firecell.processedFireSafetySystems
          .map(system => `Type ${system.type} (${system.definition})`)
          .join(', ');
      }

      rows.push([
        `Firecell ${index + 1}`,
        firecell.riskGroup || 'Not specified',
        (firecell.escapeHeight || 0).toString(),
        systemDescriptions
      ]);
    });

    paragraphs.push(
      createTableParagraph(
        TEXT.table_title,
        headers,
        rows
      )
    );
  }

  // Note 4: Early Childhood Centre compliance (per firecell)
  if (projectModel.firecells && projectModel.firecells.length > 0) {
    projectModel.firecells.forEach((firecell, index) => {
      if (firecell.riskGroup === 'CA' && firecell.isEarlyChildhoodCentre === true) {
        const compliance = firecell.fireSafetySystemsCompliance;

        if (compliance) {
          // Condition (a): Supplementary smoke detectors (escape height ≤ 2.0m)
          if (compliance.supplementarySmokeDetectors) {
            const ssd = compliance.supplementarySmokeDetectors;
            let content = '';
            let status = 'compliant';

            if (ssd.compliant === true) {
              content = TEXT.early_childhood.sleeping_areas_compliant;
              status = 'compliant';
            } else if (ssd.compliant === false) {
              content = TEXT.early_childhood.sleeping_areas_non_compliant;
              status = 'non-compliant';
            } else {
              content = TEXT.early_childhood.sleeping_areas_not_provided;
              status = 'info';
            }

            paragraphs.push(
              createComplianceParagraph(
                TEXT.early_childhood.title(index + 1),
                content,
                status
              )
            );
          }

          // Condition (b): Type 7 and places of safety (escape height > 2.0m)
          if (compliance.placesOfSafety) {
            const pos = compliance.placesOfSafety;
            const escapeHeight = firecell.escapeHeight || 0;

            // Type 7 requirement paragraph
            paragraphs.push(
              createInfoParagraph(
                TEXT.early_childhood.title(index + 1),
                TEXT.early_childhood.type7_required(escapeHeight.toFixed(1))
              )
            );

            // Places of safety compliance paragraph
            let content = '';
            let status = 'compliant';

            if (pos.compliant === true) {
              content = TEXT.early_childhood.places_of_safety_compliant;
              status = 'compliant';
            } else if (pos.compliant === false) {
              content = TEXT.early_childhood.places_of_safety_non_compliant;
              status = 'non-compliant';
            } else {
              content = TEXT.early_childhood.places_of_safety_not_provided;
              status = 'info';
            }

            paragraphs.push(
              createComplianceParagraph(
                null, // No title for continuation paragraph
                content,
                status
              )
            );
          }
        }
      }
    });
  }

  // NZS 4515 substitution info (per applicable firecell)
  if (projectModel.firecells && projectModel.firecells.length > 0) {
    projectModel.firecells.forEach((firecell, index) => {
      if (firecell.nzs4515SubstitutionInfo && firecell.nzs4515SubstitutionInfo.applies) {
        const info = firecell.nzs4515SubstitutionInfo;

        let content = '';
        let status = 'info';

        if (info.eligible) {
          content = TEXT.nzs_4515.eligible(info.totalFloorArea, info.scopeLimit);

          // Add extended scope note if between 500-2000m²
          if (info.totalFloorArea > 500 && info.totalFloorArea <= 2000) {
            content += ' ' + TEXT.nzs_4515.extended_scope_note;
          }

          if (info.userSelectedSubstitution) {
            content += ' ' + TEXT.nzs_4515.substituted;
            status = 'compliant';
          } else {
            content += ' ' + TEXT.nzs_4515.not_substituted;
          }
        } else if (!info.withinNZS4515Scope) {
          content = TEXT.nzs_4515.not_eligible_exceeds_scope(info.totalFloorArea, info.scopeLimit);
          status = 'info';
        }

        if (content) {
          paragraphs.push(
            createComplianceParagraph(
              TEXT.nzs_4515.title,
              content,
              status
            )
          );
        }
      }
    });
  }

  // System validation results (per firecell)
  if (projectModel.firecells && projectModel.firecells.length > 0) {
    projectModel.firecells.forEach((firecell, index) => {
      if (firecell.fireSafetySystemsValidation) {
        const validation = firecell.fireSafetySystemsValidation;

        // Compliance status paragraph
        let statusContent = '';
        let statusType = 'info';

        if (validation.noSystemsInstalled) {
          statusContent = TEXT.validation.no_systems;
          statusType = 'danger';
        } else if (validation.compliant) {
          statusContent = TEXT.validation.compliant;
          statusType = 'compliant';
        } else {
          statusContent = TEXT.validation.non_compliant(validation.missingSystems.length);
          statusType = 'danger';
        }

        paragraphs.push(
          createComplianceParagraph(
            TEXT.validation.title(index + 1),
            statusContent,
            statusType
          )
        );

        // Required vs Installed table (skip if no systems installed)
        if (!validation.noSystemsInstalled && validation.requiredSystems && validation.requiredSystems.length > 0) {
          const headers = ['System Type', 'Description', 'Required', 'Installed', 'Status'];
          const rows = validation.requiredSystems.map(sys => {
            const status = sys.compliant ? '✓ Compliant' : '✗ MISSING';
            const statusWithSubstitution = sys.substitutedWith
              ? `✓ Compliant (via ${sys.substitutedWith})`
              : status;

            return [
              `Type ${sys.type}`,
              sys.description,
              '✓',
              sys.installed ? '✓' : '✗',
              statusWithSubstitution
            ];
          });

          paragraphs.push(
            createTableParagraph(
              TEXT.validation.table_title,
              headers,
              rows
            )
          );
        }

        // Substitutions applied
        if (validation.substitutionsApplied && validation.substitutionsApplied.length > 0) {
          paragraphs.push(
            createInfoParagraph(
              TEXT.validation.substitutions_title,
              validation.substitutionsApplied.join(' ')
            )
          );
        }

        // Missing systems (if any)
        if (validation.missingSystems && validation.missingSystems.length > 0) {
          const missingList = validation.missingSystems.map(sys =>
            `Type ${sys.type} - ${sys.description}`
          );
          paragraphs.push(
            createListParagraph(
              TEXT.validation.missing_systems_title,
              missingList,
              'unordered'
            )
          );
        }

        // Unnecessary systems (informational only)
        if (validation.unnecessarySystems && validation.unnecessarySystems.length > 0) {
          const unnecessaryList = validation.unnecessarySystems.map(sys =>
            sys.description
          );
          paragraphs.push(
            createListParagraph(
              TEXT.validation.unnecessary_systems_title,
              unnecessaryList,
              'unordered'
            )
          );
          paragraphs.push(
            createInfoParagraph(
              null,
              TEXT.validation.unnecessary_note
            )
          );
        }
      }
    });
  }

  // Remote Receiving Centre compliance
  if (projectModel.remoteReceivingCentreCompliance) {
    const rrc = projectModel.remoteReceivingCentreCompliance;
    let content = '';
    let status = rrc.status || 'compliant';

    if (rrc.required && rrc.provided) {
      content = TEXT.remote_receiving_centre.required_compliant;
      status = 'compliant';
    } else if (rrc.required && !rrc.provided) {
      content = TEXT.remote_receiving_centre.required_non_compliant;
      status = 'non-compliant';
    } else {
      content = TEXT.remote_receiving_centre.not_required(rrc.message);
      status = 'compliant';
    }

    paragraphs.push(
      createComplianceParagraph(
        TEXT.remote_receiving_centre.title,
        content,
        status
      )
    );
  }

  return paragraphs;
}

module.exports = { generateComplianceParagraphs };