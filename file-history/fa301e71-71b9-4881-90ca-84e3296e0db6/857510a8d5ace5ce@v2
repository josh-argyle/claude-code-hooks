const {
  createInfoParagraph,
  createListParagraph,
  createNestedListParagraph,
} = require('../../utilities/paragraph-builder');

/**
 * TEXT constants with professional legal requirements language
 * Adapted from reference documents for fire safety reports
 */
const TEXT = {
  SECTION_TITLE: "Legal Requirements",

  bca_consent: {
    content: "The Building Consent Authority (BCA) is only able to issue a Building Consent under Section 49 of the New Zealand Building Act 2004 when they are satisfied on reasonable grounds that the provisions of the Building Code would be met if the building work were properly completed in accordance with the plans and the specifications that accompanied the consent application (C/AS2)."
  },

  section_49: {
    content: "Section 49: Grant of Building Consent: `(1) A building consent authority must grant a building consent if it is satisfied on reasonable grounds that the provisions of the building code would be met if the building work were properly completed in accordance with the plans and specifications that accompanied the application.`"
  },

  new_building_compliance: {
    content: "This project relates to the construction of new building. All building work must fully comply with the provisions of the Building Codes in accordance with Section 17 of the Building Act 2004."
  },

  section_17: {
    content: "Section 17: `All building work must comply with the building code to the extent required by this Act, whether or not a building consent is required in respect of that building work.`"
  },

  unit_title: {
    section: "Section 116A: Code compliance requirements: subdivision",
    intro: "A territorial authority must not issue a certificate under section 224(f) of the Resource Management Act 1991 for the purpose of giving effect to a subdivision affecting a building or part of a building unless satisfied, on reasonable grounds, that the building—",
    nestedStructure: {
      a: {
        parent: "(a) will comply, as nearly as is reasonably practicable, with every provision of the building code that relates to the following matters:",
        children: [
          "means of escape from fire:",
          "access and facilities for persons with disabilities (if this is a requirement under section 118):",
          "protection of other property;\""
        ]
      }
    }
  },

  gazette: {
    intro: "In accordance with Section 46(1) of the Building Act 2004 certain applications for Building Consent must be provided to Fire and Emergency New Zealand (FENZ) for review.",
    section: "Section 46(1): Copy of certain applications for building consent must be provided to Fire and Emergency New Zealand:",
    bullet: "(1) This section applies to an application for a building consent that is of a kind specified by the chief executive by notice published in the Gazette.\"",
    summary: "This project and the proposed fire design do not fall within the criteria specified in the Gazette Notice No.49 (2 May 2012) by the Chief Executive of the Ministry of Business, Innovation and Employment. Therefore, this application is not required to be forwarded to Fire and Emergency New Zealand."
  },

  demonstrate_compliance: {
    content: "To demonstrate compliance with the relevant fire safety clauses of the Building Code, the following Compliance Documents have been adopted as the design basis:"
  },

  cas2_adoption: {
    content: "C/AS2 – Acceptable Solution for Buildings other than Risk Group SH, 1st Edition Amendment 3"
  },

  verification_alternative: {
    content: "No verification method or alternative solution is proposed in this fire report, except for the use of the C/VM2 tabulated method for external fire spread assessment as a permitted methodology substitute."
  }
};

/**
 * Generate compliance paragraphs for legal requirements
 * @param {ProjectModel} projectModel - The complete project model
 * @returns {Array} Array of paragraph objects
 */
function generateComplianceParagraphs(projectModel) {
  const paragraphs = [];

  // 1. BCA Consent (with section title)
  paragraphs.push(
    createInfoParagraph(
      TEXT.SECTION_TITLE,
      TEXT.bca_consent.content
    )
  );

  // 2. Section 49 (as list)
  paragraphs.push(
    createListParagraph(
      '',
      [TEXT.section_49.content]
    )
  );

  // 3. New building compliance
  paragraphs.push(
    createInfoParagraph(
      '',
      TEXT.new_building_compliance.content
    )
  );

  // 4. Section 17 (as list)
  paragraphs.push(
    createListParagraph(
      '',
      [TEXT.section_17.content]
    )
  );

  // 5. Unit title - Section 116A (as nested list)
  paragraphs.push(
    createInfoParagraph(
      '',
      TEXT.unit_title.section
    )
  );

  paragraphs.push(
    createNestedListParagraph(
      '',
      TEXT.unit_title.intro,
      TEXT.unit_title.nestedStructure
    )
  );

  // 6. Gazette/FENZ
  paragraphs.push(
    createInfoParagraph(
      '',
      TEXT.gazette.intro
    )
  );

  paragraphs.push(
    createInfoParagraph(
      '',
      TEXT.gazette.section
    )
  );

  paragraphs.push(
    createListParagraph(
      '',
      [TEXT.gazette.bullet]
    )
  );

  paragraphs.push(
    createInfoParagraph(
      '',
      TEXT.gazette.summary
    )
  );

  // 7. Compliance documents
  paragraphs.push(
    createInfoParagraph(
      '',
      TEXT.demonstrate_compliance.content
    )
  );

  paragraphs.push(
    createListParagraph(
      '',
      [TEXT.cas2_adoption.content]
    )
  );

  paragraphs.push(
    createInfoParagraph(
      '',
      TEXT.verification_alternative.content
    )
  );

  return paragraphs;
}

module.exports = { generateComplianceParagraphs };