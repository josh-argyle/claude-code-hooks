    // Load preferred contacts for email functionality
    async function loadPreferredContacts() {
      try {
        const response = await fetch('/api/contacts/preferred');
        
        if (!response.ok) {
          throw new Error(`HTTP ${response.status}: ${response.statusText}`);
        }
        
        preferredContacts = await response.json();
        populateContactsDropdown();
        
      } catch (error) {
        logger.error('Error loading preferred contacts:', error);
        showNotification('Failed to load preferred contacts', 'error');
      }
    }
    
    // Populate contacts dropdown
    function populateContactsDropdown() {
      if (preferredContacts.length === 0) {
        logger.warn('No preferred contacts available');
        document.getElementById('send-email-btn').disabled = true;
        return;
      }
      
      // Find the unique ID for the search multi-select
      const emailRecipientsContainer = document.querySelector('#email-recipients').closest('.search-multi-select-container');
      const uniqueId = emailRecipientsContainer?.querySelector('[data-multiselect-id]')?.getAttribute('data-multiselect-id');
      
      if (!uniqueId) {
        logger.error('Could not find email recipients multi-select unique ID');
        return;
      }
      
      // Prepare options for the search multi-select
      const contactOptions = preferredContacts.map(contact => ({
        value: contact.contact_id,
        label: `${contact.name} (${contact.email})${contact.company_name ? ' - ' + contact.company_name : ''}`
      }));
      
      // Initialize search multi-select with options
      if (typeof MultiSelectManager !== 'undefined') {
        MultiSelectManager.initSearchMultiSelect(uniqueId, contactOptions);
        
        
        // Add event listener for selection changes
        const hiddenInput = document.getElementById(`${uniqueId}-hidden`);
        if (hiddenInput) {
          const observer = new MutationObserver(() => {
            const hasSelection = hiddenInput.value && hiddenInput.value.length > 0;
            document.getElementById('send-email-btn').disabled = !hasSelection;
            
          });
          observer.observe(hiddenInput, { attributes: true, attributeFilter: ['value'] });
        }
      }
      
      // Initially disable email button until selections are made
      document.getElementById('send-email-btn').disabled = true;
    }
    
    // Add CONTEGO branded header to PDF
    function addPDFHeader(doc, pageNumber) {
      const pageWidth = doc.internal.pageSize.getWidth();
      
      // CONTEGO branding - matching nav header styling
      doc.setFontSize(18);
      doc.setFont(undefined, 'bold');
      
      // Position for header text
      const headerY = 15;
      let headerX = 20;
      
      // "C" in primary color
      doc.setTextColor(225, 65, 65); // #e14141 primary color
      doc.text('C', headerX, headerY);
      
      // Measure width of "C" to position next text
      const cWidth = doc.getTextWidth('C');
      headerX += cWidth;
      
      // "ONTEGO" in black
      doc.setTextColor(0, 0, 0); // black
      doc.text('ONTEGO', headerX, headerY);
      
      // Measure width of "ONTEGO" to position period
      const ontegoWidth = doc.getTextWidth('ONTEGO');
      headerX += ontegoWidth;
      
      // "." in primary color
      doc.setTextColor(225, 65, 65); // #e14141 primary color
      doc.text('.', headerX, headerY);
      
      // Page number on the right
      doc.setTextColor(0, 0, 0); // black
      doc.setFontSize(10);
      doc.setFont(undefined, 'normal');
      doc.text(`Page ${pageNumber}`, pageWidth - 40, headerY);
      
      // Header line removed for cleaner PDF appearance
      
      // Reset text color to black for content
      doc.setTextColor(0, 0, 0);
    }
    
    // Add footer to PDF
    function addPDFFooter(doc, pageNumber, totalPages) {
      const pageWidth = doc.internal.pageSize.getWidth();
      const pageHeight = doc.internal.pageSize.getHeight();
      const footerY = pageHeight - 15;
      
      doc.setFontSize(8);
      doc.setFont(undefined, 'normal');
      doc.setTextColor(100, 100, 100); // gray
      
      // Footer text removed as requested
      
      // Page number on right
      doc.text(`Page ${pageNumber} of ${totalPages}`, pageWidth - 40, footerY);
      
      // Reset text color to black
      doc.setTextColor(0, 0, 0);
    }

    // Handle download as PDF
    async function handleDownloadPDF() {
      if (!currentPOData) return;
      
      try {
        // Show loading state
        document.getElementById('download-pdf-btn').disabled = true;
        document.getElementById('download-pdf-btn').innerHTML = `${Icons.getIcon('loader')}<span>Generating...</span>`;
        
        // Get purchase order details
        const poNumber = currentPOData.poNumber;
        const supplierName = currentPOData.supplierName;
        
        // Find the purchase order in the list for basic details
        const poData = purchaseOrders.find(order => extractCellValue(order.PONumber) === poNumber);
        if (!poData) {
          throw new Error('Purchase order data not found');
        }
        
        const poDate = extractCellValue(poData.PODate);
        const originalValue = parseFloat(extractCellValue(poData.OriginalValue)) || 0;
        const poStatus = extractCellValue(poData.POStatus);
        
        // Get line items data
        const response = await fetch(`/api/purchase-orders/${encodeURIComponent(poNumber)}`);
        if (!response.ok) {
          throw new Error(`Failed to fetch purchase order details: ${response.status}`);
        }
        
        const result = await response.json();
        if (!result.success || !result.data || !result.data.Rows) {
          throw new Error('Failed to load line items data');
        }
        
        const lineItems = result.data.Rows;
        
        // Initialize jsPDF - check if library is loaded
        if (!window.jspdf) {
          throw new Error('jsPDF library not loaded. Please refresh and try again.');
        }
        
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();
        
        // PDF styling constants
        const margin = 20;
        const headerHeight = 25; // Space for header
        const footerHeight = 25; // Space for footer
        const pageWidth = doc.internal.pageSize.getWidth();
        const pageHeight = doc.internal.pageSize.getHeight();
        const contentWidth = pageWidth - (margin * 2);
        const maxContentHeight = pageHeight - headerHeight - footerHeight - 20; // Available content height
        
        let currentPage = 1;
        let totalPages = 1; // We'll calculate this properly later
        let yPosition = margin + headerHeight;
        
        // Add header to first page
        addPDFHeader(doc, currentPage);
        
        // Header
        doc.setFontSize(20);
        doc.setFont(undefined, 'bold');
        doc.text('Purchase Order', margin, yPosition);
        yPosition += 15;
        
        // Purchase Order Details - Two-column aligned layout
        doc.setFontSize(12);
        
        // Define consistent column positions for alignment
        const labelColumn = margin;
        const valueColumn = margin + 85; // Standardized offset for all values
        
        // PO Number
        doc.setFont(undefined, 'bold');
        doc.text('PO Number:', labelColumn, yPosition);
        doc.setFont(undefined, 'normal');
        doc.text(`#${poNumber}`, valueColumn, yPosition);
        yPosition += 8;
        
        // Add quote instruction under PO number (spans both columns)
        doc.setFontSize(10);
        doc.setFont(undefined, 'normal');
        doc.text('Please Quote Order Number On All Invoices', labelColumn, yPosition);
        doc.setFontSize(12);
        yPosition += 10;
        
        // Supplier
        doc.setFont(undefined, 'bold');
        doc.text('Supplier:', labelColumn, yPosition);
        doc.setFont(undefined, 'normal');
        doc.text(supplierName, valueColumn, yPosition);
        yPosition += 8;
        
        // Add delivery address if available
        const deliveryAddress = extractCellValue(poData.DeliveryAddress);
        if (deliveryAddress && deliveryAddress.trim()) {
          doc.setFont(undefined, 'bold');
          doc.text('Delivery Address:', labelColumn, yPosition);
          doc.setFont(undefined, 'normal');
          doc.text(deliveryAddress, valueColumn, yPosition);
          yPosition += 8;
        }
        
        // Date
        doc.setFont(undefined, 'bold');
        doc.text('Date:', labelColumn, yPosition);
        doc.setFont(undefined, 'normal');
        doc.text(formatDate(poDate), valueColumn, yPosition);
        yPosition += 8;
        
        // Status
        doc.setFont(undefined, 'bold');
        doc.text('Status:', labelColumn, yPosition);
        doc.setFont(undefined, 'normal');
        doc.text(poStatus, valueColumn, yPosition);
        yPosition += 8;
        
        // Total Amount
        doc.setFont(undefined, 'bold');
        doc.text('Total Amount:', labelColumn, yPosition);
        doc.setFont(undefined, 'normal');
        doc.text(formatCurrency(originalValue), valueColumn, yPosition);
        yPosition += 8;
        
        // Get purchaser name safely - try to fetch full name, fallback to username
        let purchaserName = window.sessionData?.username || 'Unknown User';
        
        try {
          // Try to get current user's full details including name
          const userResponse = await fetch('/api/users/current');
          if (userResponse.ok) {
            const userData = await userResponse.json();
            // Create display name from contact info if available
            if (userData.users_contacts?.first_name || userData.users_contacts?.surname) {
              const firstName = userData.users_contacts.first_name || '';
              const surname = userData.users_contacts.surname || '';
              purchaserName = `${firstName} ${surname}`.trim();
            }
          }
        } catch (error) {
          logger.warn('Could not fetch user details, using username fallback', { error: error.message });
          // Continue with username fallback
        }
        // Purchaser
        doc.setFont(undefined, 'bold');
        doc.text('Purchaser:', labelColumn, yPosition);
        doc.setFont(undefined, 'normal');
        doc.text(purchaserName, valueColumn, yPosition);
        yPosition += 15;
        
        // Line Items Header
        doc.setFont(undefined, 'bold');
        doc.text('Line Items:', margin, yPosition);
        yPosition += 10;
        
        // Table headers
        doc.setFontSize(10);
        const tableHeaders = ['Description', 'Order Quantity', 'Unit', 'Unit Cost', 'Order Cost'];
        const headerAlignments = ['left', 'right', 'left', 'right', 'right']; // Alignment for each column
        // Adjust column widths to fit page width (contentWidth is ~170)
        const columnWidths = [65, 25, 20, 25, 35];

        // Add table header background (simulate table styling)
        doc.setFillColor(225, 65, 65); // Primary color for header
        doc.rect(margin, yPosition - 2, contentWidth, 12, 'F');

        // Draw headers over the background in white
        doc.setTextColor(255, 255, 255); // white text
        doc.setFont(undefined, 'bold');
        let xPosition = margin;
        tableHeaders.forEach((header, index) => {
          if (headerAlignments[index] === 'right') {
            // Right-align: position at end of column minus padding
            doc.text(header, xPosition + columnWidths[index] - 2, yPosition + 4, { align: 'right' });
          } else {
            // Left-align: position at start of column plus padding
            doc.text(header, xPosition + 2, yPosition + 4);
          }
          xPosition += columnWidths[index];
        });
        
        yPosition += 15;
        
        // Line items data
        doc.setTextColor(0, 0, 0); // reset to black
        doc.setFont(undefined, 'normal');
        let totalAmount = 0;
        let rowIndex = 0;
        
        lineItems.forEach((item) => {
          const description = extractCellValue(item.LineDescription) || 'No description';
          const unit = extractCellValue(item.Unit) || '';
          const quantity = parseFloat(extractCellValue(item.OrderQuantity)) || 0;
          const unitCost = parseFloat(extractCellValue(item.FCUnitCost)) || 0;
          const lineTotal = unitCost * quantity;
          totalAmount += lineTotal;

          // Split description into multiple lines if needed
          const descriptionLines = doc.splitTextToSize(description, columnWidths[0] - 4);
          const rowHeight = Math.max(8, descriptionLines.length * 5 + 3); // Dynamic height based on lines

          // Check if we need a new page (account for row height)
          if (yPosition + rowHeight > maxContentHeight) {
            // Add footer to current page
            addPDFFooter(doc, currentPage, totalPages);

            // Add new page
            doc.addPage();
            currentPage++;
            totalPages = Math.max(totalPages, currentPage);

            // Add header to new page
            addPDFHeader(doc, currentPage);

            // Reset position after header
            yPosition = margin + headerHeight;
          }

          // Add alternating row background for better readability
          if (rowIndex % 2 === 1) {
            doc.setFillColor(248, 249, 250); // Light gray for alternating rows
            doc.rect(margin, yPosition - 4, contentWidth, rowHeight, 'F');
          }

          xPosition = margin;

          // Description - left-aligned with text wrapping
          doc.text(descriptionLines, xPosition + 2, yPosition);
          xPosition += columnWidths[0];

          // Order Quantity - right-aligned
          doc.text(quantity.toString(), xPosition + columnWidths[1] - 2, yPosition, { align: 'right' });
          xPosition += columnWidths[1];

          // Unit - left-aligned
          doc.text(unit, xPosition + 2, yPosition);
          xPosition += columnWidths[2];

          // Unit Cost - right-aligned
          doc.text(formatCurrency(unitCost).replace('$', ''), xPosition + columnWidths[3] - 2, yPosition, { align: 'right' });
          xPosition += columnWidths[3];

          // Order Cost - right-aligned
          doc.text(formatCurrency(lineTotal).replace('$', ''), xPosition + columnWidths[4] - 2, yPosition, { align: 'right' });

          yPosition += rowHeight;
          rowIndex++;
        });
        
        // Total line
        yPosition += 5;
        // Total line removed for cleaner PDF appearance
        yPosition += 5;
        
        doc.setFont(undefined, 'bold');
        doc.text(`Total: NZD ${formatCurrency(totalAmount)}`, margin + contentWidth - 80, yPosition);
        yPosition += 10;
        
        // Add GST exclusion note
        doc.setFont(undefined, 'normal');
        doc.setFontSize(9);
        doc.text('All values are exclusive of GST', margin + contentWidth - 80, yPosition);
        yPosition += 15;
        
        // Note: Invoice quote instruction already added under PO number
        
        // Add footer to final page
        addPDFFooter(doc, currentPage, currentPage);
        
        // Download the PDF
        doc.save(`Purchase_Order_${poNumber}.pdf`);
        
        showNotification('PDF downloaded successfully', 'success');
        
      } catch (error) {
        logger.error('Error generating PDF:', error);
        showNotification(`Failed to generate PDF: ${error.message}`, 'error');
      } finally {
        // Reset button state
        document.getElementById('download-pdf-btn').disabled = false;
        document.getElementById('download-pdf-btn').innerHTML = `${Icons.getIcon('file-text')}<span>Download as PDF</span>`;
        
      }
    }
    
    // Handle send email
    async function handleSendEmail() {
      if (!currentPOData) return;
      
      // Find the unique ID for the search multi-select
      const emailRecipientsContainer = document.querySelector('#email-recipients').closest('.search-multi-select-container');
      const uniqueId = emailRecipientsContainer?.querySelector('[data-multiselect-id]')?.getAttribute('data-multiselect-id');
      
      if (!uniqueId) {
        logger.error('Could not find email recipients multi-select unique ID');
        showNotification('Error finding email recipients', 'error');
        return;
      }
      
      // Get selected contact IDs
      const selectedContactIds = MultiSelectManager.getSelectedValues(uniqueId);
      
      if (selectedContactIds.length === 0) {
        showNotification('Please select at least one contact', 'error');
        return;
      }
      
      // Map selected IDs to contact objects
      const selectedContacts = selectedContactIds.map(contactId => {
        const contact = preferredContacts.find(c => c.contact_id === contactId);
        return contact ? {
          contact_id: contact.contact_id,
          name: contact.name,
          email: contact.email
        } : null;
      }).filter(Boolean);
      
      if (selectedContacts.length === 0) {
        showNotification('Selected contacts not found', 'error');
        return;
      }
      
      showNotification('Email functionality will be implemented soon', 'info');
      // TODO: Implement email service
      logger.debug('Email send requested', { contacts: selectedContacts, poNumber: currentPOData.poNumber });
    }
    
