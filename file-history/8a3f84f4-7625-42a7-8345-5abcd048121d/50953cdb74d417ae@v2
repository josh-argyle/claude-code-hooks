        const maxWidth = 600;

        // Load saved panel width from localStorage
        function loadPanelWidth() {
          const savedWidth = localStorage.getItem('aiPanelWidth');
          const parsedWidth = parseInt(savedWidth, 10);
          
          // Validate saved width with proper bounds checking
          if (savedWidth && !isNaN(parsedWidth) && parsedWidth >= minWidth && parsedWidth <= maxWidth) {
            document.documentElement.style.setProperty('--ai-panel-width', parsedWidth + 'px');
          } else if (savedWidth) {
            // Clear invalid saved width
            localStorage.removeItem('aiPanelWidth');
          }
        }

        // Save panel width to localStorage with validation
        function savePanelWidth(width) {
          const validatedWidth = Math.max(minWidth, Math.min(maxWidth, parseInt(width, 10)));
          if (!isNaN(validatedWidth)) {
            localStorage.setItem('aiPanelWidth', validatedWidth);
          }
        }

        // Initialize panel width and enable transitions
        function initializePanelState() {
          // Load width first (without transitions)
          loadPanelWidth();
          
          // Force a reflow to ensure width is applied
          aiPanel.offsetWidth;
          navPanel.offsetWidth;
          
          // Enable transitions immediately
          aiPanel.classList.add('transitions-enabled');
          navPanel.classList.add('transitions-enabled');
        }

        // Initialize panel state on load
        initializePanelState();

        // Start resize
        aiPanelResizeHandle.addEventListener('mousedown', function(e) {
          isResizing = true;
          startX = e.clientX;
          startWidth = aiPanel.offsetWidth;
          
          // Add visual feedback
          document.body.style.cursor = 'ew-resize';
          document.body.style.userSelect = 'none';
          aiPanel.parentElement.classList.add('resizing');
          
          e.preventDefault();
        });

        // Handle resize
        document.addEventListener('mousemove', function(e) {
          if (!isResizing) return;
          
          const deltaX = e.clientX - startX;
          const newWidth = Math.max(minWidth, Math.min(maxWidth, startWidth + deltaX));
          
          // Update CSS custom property
          document.documentElement.style.setProperty('--ai-panel-width', newWidth + 'px');
          
          e.preventDefault();
        });

        // End resize
        document.addEventListener('mouseup', function(e) {
          if (!isResizing) return;
          
          isResizing = false;
          
          // Remove visual feedback
          document.body.style.cursor = '';
          document.body.style.userSelect = '';
          aiPanel.parentElement.classList.remove('resizing');
          
          // Save the final width
          const finalWidth = aiPanel.offsetWidth;
          savePanelWidth(finalWidth);
        });
      });
      
      // User switching functionality  
