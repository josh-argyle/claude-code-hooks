    script.
      // Panel functionality
      document.addEventListener('DOMContentLoaded', function() {
        const aiToggle = document.getElementById('ai-toggle');
        const navToggle = document.getElementById('nav-toggle');
        const aiPanel = document.getElementById('ai-panel-container');
        const navPanel = document.getElementById('nav-panel-container');
        const panelOverlay = document.getElementById('panel-overlay');
        const aiClose = document.getElementById('ai-close');
        const navClose = document.getElementById('nav-close');
        const aiInput = document.getElementById('ai-input');
        const aiSend = document.getElementById('ai-send');
        const aiMessages = document.getElementById('ai-messages');
        const aiModelSelect = document.getElementById('ai-model-select');
        const aiHistoryBtn = document.getElementById('ai-history-btn');
        const aiNewBtn = document.getElementById('ai-new-btn');
        const aiHistoryPanel = document.getElementById('ai-history-panel');
        const aiHistoryClose = document.getElementById('ai-history-close');
        const aiHistoryList = document.getElementById('ai-history-list');
        
        // Toggle functions
        function toggleAIPanel() {
          const isActive = aiPanel.classList.contains('active');
          aiPanel.classList.toggle('active');
          aiToggle.classList.toggle('panel-open');
          panelOverlay.classList.toggle('active', !isActive);
          if (!isActive) {
            navPanel.classList.remove('active');
            navToggle.classList.remove('panel-open');
            navToggle.classList.add('blurred');
            aiToggle.classList.add('blurred');
          } else {
            navToggle.classList.remove('blurred');
            aiToggle.classList.remove('blurred');
          }
        }
        
        function toggleNavPanel() {
          const isActive = navPanel.classList.contains('active');
          navPanel.classList.toggle('active');
          navToggle.classList.toggle('panel-open');
          panelOverlay.classList.toggle('active', !isActive);
          if (!isActive) {
            aiPanel.classList.remove('active');
            aiToggle.classList.remove('panel-open');
            aiToggle.classList.add('blurred');
            navToggle.classList.add('blurred');
          } else {
            aiToggle.classList.remove('blurred');
            navToggle.classList.remove('blurred');
          }
        }
        
        function closePanels() {
          aiPanel.classList.remove('active');
          navPanel.classList.remove('active');
          aiToggle.classList.remove('panel-open');
          navToggle.classList.remove('panel-open');
          panelOverlay.classList.remove('active');
          aiToggle.classList.remove('blurred');
          navToggle.classList.remove('blurred');
        }
        
        // Event listeners
        aiToggle.addEventListener('click', toggleAIPanel);
        navToggle.addEventListener('click', toggleNavPanel);
        aiClose.addEventListener('click', toggleAIPanel);
        navClose.addEventListener('click', toggleNavPanel);
        panelOverlay.addEventListener('click', closePanels);

        
        // AI Chat functionality
        function updateTokenDisplay(tokenInfo) {
          const tokenValue = document.getElementById('token-value');
          if (tokenValue && tokenInfo) {
            const remaining = tokenInfo.remaining || 0;
            const limit = tokenInfo.dailyLimit || 0;
            
            // Format numbers with commas
            const formattedRemaining = remaining.toLocaleString();
            const formattedLimit = limit.toLocaleString();
            
            tokenValue.textContent = `${formattedRemaining} / ${formattedLimit}`;
          }
        }
        
        function addMessage(content, isUser = false) {
          const messageDiv = document.createElement('div');
          messageDiv.className = `ai-message ${isUser ? 'user' : 'assistant'}`;
          const contentDiv = document.createElement('div');
          contentDiv.className = 'ai-message-content';
          
          if (isUser) {
            // User messages stay as plain text
            contentDiv.textContent = content;
          } else {
            // Assistant messages get markdown parsing with compact formatting
            const parsedContent = marked.parse(content);
            // Remove excessive whitespace that marked.js might add
            const compactContent = parsedContent
              .replace(/>\s+</g, '><')  // Remove whitespace between tags
              .replace(/\n\s*\n/g, '\n') // Remove multiple line breaks
              .trim();
            contentDiv.innerHTML = compactContent;
          }
          
          messageDiv.appendChild(contentDiv);
          aiMessages.appendChild(messageDiv);
          aiMessages.scrollTop = aiMessages.scrollHeight;
        }
        
        let currentSessionId = null;
        let chatSessions = [];
        
        // Load persisted session from localStorage
        function loadPersistedSession() {
          // Check if user is authenticated before attempting to load session
          if (!window.sessionData || !window.sessionData.userId) {
            // User not authenticated, clear any persisted session
            localStorage.removeItem('aiPanel_currentSessionId');
            return;
          }
          
          const persistedSession = localStorage.getItem('aiPanel_currentSessionId');
          if (persistedSession) {
            currentSessionId = persistedSession;
            // Load the conversation for this session
            loadChatSession(currentSessionId, false); // false = don't close history panel
          }
        }
        
        // Save session to localStorage
        function savePersistedSession() {
          if (currentSessionId) {
            localStorage.setItem('aiPanel_currentSessionId', currentSessionId);
          } else {
            localStorage.removeItem('aiPanel_currentSessionId');
          }
        }
        
        // Chat history functionality
        function toggleHistoryPanel() {
          const isActive = aiHistoryPanel.classList.contains('active');
          aiHistoryPanel.classList.toggle('active');
          if (!isActive) {
            loadChatHistory();
          }
        }
        
        function closeHistoryPanel() {
          aiHistoryPanel.classList.remove('active');
        }
        
        function clearMessages() {
          aiMessages.innerHTML = '<div class="ai-message assistant"><div class="ai-message-content">Welcome! How can I help you today?</div></div>';
        }
        
        async function loadChatHistory() {
          try {
            // Check if user is authenticated before attempting to load chat history
            if (!window.sessionData || !window.sessionData.userId) {
              aiHistoryList.innerHTML = '<div class="ai-history-error">Please log in to view chat history</div>';
              return;
            }
            
            aiHistoryList.innerHTML = '<div class="ai-history-loading">Loading conversations...</div>';
            
            const response = await fetch('/api/chat/sessions');
            if (response.ok) {
              chatSessions = await response.json();
              displayChatHistory();
            } else {
              if (response.status === 401) {
                aiHistoryList.innerHTML = '<div class="ai-history-error">Please log in to view chat history</div>';
              } else {
                aiHistoryList.innerHTML = '<div class="ai-history-error">Failed to load conversations</div>';
              }
            }
          } catch (error) {
            logger.error('Error loading chat history:', error);
            aiHistoryList.innerHTML = '<div class="ai-history-error">Error loading conversations</div>';
          }
        }
        
        function displayChatHistory() {
          if (chatSessions.length === 0) {
            aiHistoryList.innerHTML = '<div class="ai-history-empty">No previous conversations</div>';
            return;
          }
          
          let html = '';
          chatSessions.forEach(session => {
            const date = new Date(session.last_accessed || session.created_at).toLocaleDateString();
            const time = new Date(session.last_accessed || session.created_at).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
            const isActive = session.session_id === currentSessionId;
            
            html += `
              <div class="ai-history-item ${isActive ? 'active' : ''}" data-session-id="${session.session_id}">
                <div class="ai-history-item-header">
                  <h5 class="ai-history-item-title">${session.chat_name}</h5>
                  <span class="ai-history-item-time">${date} ${time}</span>
                </div>
                <div class="ai-history-item-meta">
                  <span class="ai-history-item-messages">${session.message_count} messages</span>
                </div>
              </div>
            `;
          });
          
          aiHistoryList.innerHTML = html;
          
          // Add click handlers
          aiHistoryList.querySelectorAll('.ai-history-item').forEach(item => {
            item.addEventListener('click', function() {
              const sessionId = this.getAttribute('data-session-id');
              loadChatSession(sessionId);
            });
          });
        }
        
        async function loadChatSession(sessionId, closeHistory = true) {
          try {
            // Check if user is authenticated before attempting to load session
            if (!window.sessionData || !window.sessionData.userId) {
              clearMessages();
              currentSessionId = null;
              savePersistedSession(); // Clear persistence
              return;
            }
            
            if (closeHistory) {
              closeHistoryPanel();
            }
            clearMessages();
            
            // Add loading message
            const loadingDiv = document.createElement('div');
            loadingDiv.className = 'ai-message assistant';
            loadingDiv.innerHTML = '<div class="ai-message-content">Loading conversation...</div>';
            aiMessages.appendChild(loadingDiv);
            
            const response = await fetch(`/api/chat/sessions/${sessionId}/messages`);
            if (response.ok) {
              const messages = await response.json();
              currentSessionId = sessionId;
              savePersistedSession(); // Save to localStorage
              
              // Remove loading message
              loadingDiv.remove();
              
              // Clear and load messages
              clearMessages();
              messages.forEach(message => {
                if (message.role === 'user' || message.role === 'assistant') {
                  addMessage(message.content, message.role === 'user');
                }
              });
              
            } else {
              // Remove loading message
              loadingDiv.remove();
              
              // Handle various error cases
              if (response.status === 404) {
                // Session doesn't exist anymore, clear persistence
                currentSessionId = null;
                savePersistedSession();
                clearMessages();
                addMessage('Chat session no longer exists', false);
              } else if (response.status === 401) {
                // User not authenticated, clear persistence
                currentSessionId = null;
                savePersistedSession();
                clearMessages();
                addMessage('Please log in to view chat history', false);
              } else {
                clearMessages();
                addMessage('Failed to load conversation', false);
              }
            }
          } catch (error) {
            logger.error('Error loading chat session:', error);
            clearMessages();
            addMessage('Error loading conversation', false);
          }
        }
        
        function startNewChat() {
          currentSessionId = null;
          savePersistedSession(); // Clear persistence
          clearMessages();
          closeHistoryPanel();
        }
        
        // Event listeners for history functionality
        aiHistoryBtn.addEventListener('click', toggleHistoryPanel);
        aiHistoryClose.addEventListener('click', closeHistoryPanel);
        aiNewBtn.addEventListener('click', startNewChat);
        
        async function ensureSession() {
          // Check if user is authenticated before creating session
          if (!window.sessionData || !window.sessionData.userId) {
            addMessage('Please log in to start a chat session', false);
            return false;
          }
          
          if (!currentSessionId) {
            try {
              const response = await fetch('/api/chat/sessions', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ chat_name: 'AI Chat ' + new Date().toLocaleString() })
              });
              
              if (response.ok) {
                const session = await response.json();
                currentSessionId = session.session_id;
                savePersistedSession(); // Save new session to localStorage
              } else if (response.status === 401) {
                addMessage('Please log in to start a chat session', false);
                return false;
              } else {
                throw new Error('Failed to create session');
              }
            } catch (error) {
              logger.error('Error creating session:', error);
              addMessage('Error: Could not start chat session. Please try again.', false);
              return false;
            }
          }
          return true;
        }
        
        async function sendMessage() {
          const message = aiInput.value.trim();
          if (!message) return;
          
          // Disable input while processing
          aiInput.disabled = true;
          aiSend.disabled = true;
          
          addMessage(message, true);
          aiInput.value = '';
          
          try {
            // Ensure we have a session
            if (!(await ensureSession())) {
              return;
            }
            
            // Add typing indicator
            const typingDiv = document.createElement('div');
            typingDiv.className = 'ai-message assistant typing';
            typingDiv.innerHTML = '<div class="ai-message-content">AI is thinking...</div>';
            aiMessages.appendChild(typingDiv);
            aiMessages.scrollTop = aiMessages.scrollHeight;
            
            // Get selected model (if available)
            const selectedModel = aiModelSelect ? aiModelSelect.value : null;
            
            // Send message to API
            const response = await fetch(`/api/chat/sessions/${currentSessionId}/messages`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ 
                message: message,
                model: selectedModel 
              })
            });
            
            // Remove typing indicator
            typingDiv.remove();
            
            if (response.ok) {
              const data = await response.json();
              addMessage(data.assistantMessage.content, false);
              
              // Update token display if available
              if (data.tokenInfo) {
                updateTokenDisplay(data.tokenInfo);
              }
            } else {
              const errorData = await response.json();
              addMessage(`Error: ${errorData.error || 'Failed to get response'}`, false);
            }
            
          } catch (error) {
            logger.error('Error sending message:', error);
            addMessage('Error: Could not send message. Please check your connection and try again.', false);
          } finally {
            // Re-enable input
            aiInput.disabled = false;
            aiSend.disabled = false;
            aiInput.focus();
          }
        }
        
        aiSend.addEventListener('click', sendMessage);
        aiInput.addEventListener('keypress', function(e) {
          if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            sendMessage();
          }
        });
        
        // Load available models for model selector
