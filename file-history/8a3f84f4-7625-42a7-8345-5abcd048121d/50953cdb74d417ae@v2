            //- To add or modify navigation items:
            //- 1. Edit /api/config/routePermissions.js
            //- 2. Add your route configuration with:
            //-    - path: the route path
            //-    - roles: array of roles (empty [] = any authenticated user)
            //-    - label: the display text
