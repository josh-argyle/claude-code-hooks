      // Auto-trim text fields on blur to prevent whitespace-only values
      document.addEventListener('blur', function(e) {
        const field = e.target;

        // Only process input/textarea elements
        if (!field || (field.tagName !== 'INPUT' && field.tagName !== 'TEXTAREA')) {
          return;
        }

        // Determine if field should be trimmed
        const fieldType = field.type?.toLowerCase();
        const fieldName = field.name?.toLowerCase() || '';

        // Skip password fields (preserve exact input for security)
        if (fieldType === 'password' || fieldName.includes('password')) {
          return;
        }

        // Skip non-text fields
        const textTypes = ['text', 'email', 'tel', 'url', 'search'];
        if (fieldType && !textTypes.includes(fieldType) && field.tagName !== 'TEXTAREA') {
          return;
        }

        // Trim the value if it has changed
        if (typeof field.value === 'string' && field.value !== field.value.trim()) {
          field.value = field.value.trim();

          // Trigger input event so any listeners are notified
          field.dispatchEvent(new Event('input', { bubbles: true }));
        }
      }, true); // Use capture phase to catch all blur events

      // Helper function to determine if a value should be trimmed
      function shouldTrimValue(key, value, field) {
        // Only trim strings
        if (typeof value !== 'string') return false;

        // Don't trim password fields
        if (key.toLowerCase().includes('password')) return false;

        // Don't trim if it's a date/time field
        if (field && (field.type === 'date' || field.type === 'datetime-local' || field.type === 'time')) {
          return false;
        }

        return true;
      }

      // Handle form submission
      document.addEventListener('submit', function(e) {
        if (e.target.classList.contains('modal-form') || e.target.classList.contains('new-modal-form')) {
          // Check if the event has already been prevented by another handler
          if (e.defaultPrevented) {
            return;
          }
          e.preventDefault();
          const formData = new FormData(e.target);
          const url = e.target.action;
          const method = e.target.getAttribute('data-method') || 'POST';
          
          // Convert FormData to JSON object
          const jsonData = {};
          
          // First, handle search-select components which store their actual values in dataset.selectedValue
          const searchSelectInputs = e.target.querySelectorAll('input[data-search-select="true"]');
          searchSelectInputs.forEach(input => {
            const key = input.name;
            if (key && input.dataset.selectedValue !== undefined) {
              // Use the selected value from dataset, or null if empty
              jsonData[key] = input.dataset.selectedValue || null;
            }
          });
          
          // Then process regular FormData entries
          for (let [key, value] of formData.entries()) {
            // Skip if we already handled this field as a search-select
            if (jsonData.hasOwnProperty(key)) {
              continue;
            }

            // Trim string values (except passwords and date fields)
            let processedValue = value;
            const field = e.target.querySelector(`[name="${key}"]`);
            if (shouldTrimValue(key, value, field)) {
              processedValue = value.trim();
            }

            // Convert string booleans to actual booleans
            if (processedValue === 'true') {
              processedValue = true;
            } else if (processedValue === 'false') {
              processedValue = false;
            }
            
            // Special handling for company_types: convert comma-separated string to array
            if (key === 'company_types' && typeof processedValue === 'string' && processedValue.length > 0) {
              processedValue = processedValue.split(',').map(s => s.trim()).filter(s => s.length > 0);
            }
            
            // Handle multiple values with the same key (create arrays)
            if (jsonData.hasOwnProperty(key)) {
              if (Array.isArray(jsonData[key])) {
                jsonData[key].push(processedValue);
              } else {
                jsonData[key] = [jsonData[key], processedValue];
              }
            } else {
              jsonData[key] = processedValue;
            }
          }
          
          fetch(url, {
            method: method,
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(jsonData)
          })
          .then(response => {
            return response.json().then(data => ({ response, data }));
          })
          .then(({ response, data }) => {
            if (!ErrorHandler.showError(response, data)) {
              // Handle both modal systems
              const modal = e.target.closest('.modal');
              const newModalOverlay = e.target.closest('.new-modal-overlay');
              
              if (modal) {
                modal.classList.remove('active');
              }
              if (newModalOverlay) {
                newModalOverlay.classList.remove('active');
              }
              
              e.target.reset();
              
              // Clear search-multi-select components that aren't reset by standard form reset
              const searchMultiSelectInputs = e.target.querySelectorAll('input[data-multiselect-id]');
              searchMultiSelectInputs.forEach(input => {
                const uniqueId = input.getAttribute('data-multiselect-id');
                if (uniqueId && typeof MultiSelectManager !== 'undefined' && MultiSelectManager.clearSearchMultiSelect) {
                  MultiSelectManager.clearSearchMultiSelect(uniqueId);
                }
              });
              
              // Optimistic updates instead of page reload
              const isCompaniesPage = window.location.pathname === '/companies';
              const isContactsPage = window.location.pathname === '/contacts';
              
              if (isCompaniesPage && typeof window.addCompanyToTable === 'function' && typeof window.updateCompanyInTable === 'function') {
                try {
                  if (method === 'POST') {
                    // CREATE operation - add new company to table
                    const newCompanyData = {
                      company_id: data.company_id,
                      name: jsonData.name,
                      website_url: jsonData.website || null,
                      logo_url: jsonData.logo || null,
                      created_at: new Date().toISOString(),
                      all_types: Array.isArray(jsonData.company_types) ? jsonData.company_types : []
                    };
                    window.addCompanyToTable(newCompanyData);
                    showNotification('Company added successfully', 'success');
                  } else if (method === 'PUT') {
                    // UPDATE operation - update existing company in table
                    const companyId = url.split('/').pop(); // Extract ID from URL like /api/companies/123
                    const updatedCompanyData = {
                      name: jsonData.name,
                      website_url: jsonData.website || null,
                      logo_url: jsonData.logo || null,
                      all_types: Array.isArray(jsonData.company_types) ? jsonData.company_types : [],
                      updated_at: new Date().toISOString()
                    };
                    window.updateCompanyInTable(companyId, updatedCompanyData);
                    showNotification('Company updated successfully', 'success');
                  }
                } catch (error) {
                  logger.error('Error with optimistic update:', error);
                  // Fallback to page reload if optimistic update fails
                  location.reload();
                }
              } else if (isContactsPage && typeof window.addContactToTable === 'function' && typeof window.updateContactInTable === 'function') {
                try {
                  if (method === 'POST') {
                    // CREATE operation - add new contact to table
                    const newContactData = {
                      contact_id: data.contact_id,
                      name: jsonData.name,
                      position: jsonData.position || '',
                      email: jsonData.email,
                      phone: jsonData.phone || '',
                      company: data.company || '', // Company name for display
                      area: jsonData.area || '',
                      preferred_contact: jsonData.preferred_contact || '',
                      is_preferred: jsonData.preferred === 'yes',
                      created_at: new Date().toISOString()
                    };
                    window.addContactToTable(newContactData);
                    showNotification('Contact added successfully', 'success');
                  } else if (method === 'PUT') {
                    // UPDATE operation - update existing contact in table
                    const contactId = url.split('/').pop(); // Extract ID from URL like /api/contacts/123
                    const updatedContactData = {
                      name: jsonData.name,
                      position: jsonData.position || '',
                      email: jsonData.email,
                      phone: jsonData.phone || '',
                      company: data.company || '', // Company name for display
                      area: jsonData.area || '',
                      preferred_contact: jsonData.preferred_contact || '',
                      is_preferred: jsonData.preferred === 'yes',
                      updated_at: new Date().toISOString()
                    };
                    window.updateContactInTable(contactId, updatedContactData);
                    showNotification('Contact updated successfully', 'success');
                  }
                } catch (error) {
                  logger.error('Error with optimistic update:', error);
                  // Fallback to page reload if optimistic update fails
                  location.reload();
                }
              } else {
                // For Surveys page, use optimistic updates
                const isSurveysPage = window.location.pathname === '/surveys';
                if (isSurveysPage && typeof window.addCampaignToTable === 'function' && typeof window.updateCampaignInTable === 'function') {
                  try {
                    if (url.includes('/api/surveys/campaigns')) {
                      if (method === 'POST') {
                        // CREATE operation - add new campaign to table
                        showNotification('Campaign created successfully', 'success');
                        window.addCampaignToTable(data);
                      } else if (method === 'PUT') {
                        // UPDATE operation - update existing campaign in table
                        const campaignId = url.split('/').pop(); // Extract ID from URL
                        showNotification('Campaign updated successfully', 'success');
                        window.updateCampaignInTable(campaignId, data);
                      }
                    }
                  } catch (error) {
                    logger.error('Error with optimistic update:', error);
                    // Fallback to page reload if optimistic update fails
                    location.reload();
                  }
                // For NCR page, show notification but don't reload
                } else if (window.location.pathname === '/ncr') {
                  if (url.includes('/api/ncr')) {
                    if (method === 'POST') {
                      showNotification('NCR created successfully', 'success');
                      // Add the new NCR to the table if the function exists
                      if (typeof window.addNcrToTable === 'function' && data) {
                        window.addNcrToTable(data);
                      }
                    } else if (method === 'PUT') {
                      showNotification('NCR updated successfully', 'success');
                      // Update the NCR in the table if the function exists
                      if (typeof window.updateNcrInTable === 'function' && data) {
                        // Extract NCR ID from the form's hidden field or from the data
                        const ncrId = data.ncr_report_id || jsonData.ncr_report_id;
                        if (ncrId) {
                          window.updateNcrInTable(ncrId, data);
                        }
                      }
                    }
                  }
                } else {
                  // Fallback to page reload for other pages
                  location.reload();
                }
              }
            }
          })
          .catch(error => {
            logger.error('Error:', error);
            showNotification('An error occurred while saving', 'error');
          });
        }
        
        // Dynamic Navigation Section Management
        // Hide navigation sections with 1 or fewer visible links
        function updateNavigationSections() {
          const navSections = document.querySelectorAll('.nav-section');
          navSections.forEach(section => {
            const visibleLinks = section.querySelectorAll('.nav-link:not([style*="display: none"])');
            if (visibleLinks.length <= 1) {
              section.style.display = 'none';
            } else {
              section.style.display = '';
            }
          });
        }
        
        // Run navigation section update on page load
        updateNavigationSections();
      });