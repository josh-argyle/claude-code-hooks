mixin search-multi-select(options = {})
  - const { name, placeholder = '', label = placeholder, required = false, disabled = false, id, classes = '', validation = '' } = options
  - const inputId = id || name
  - const dropdownId = `${inputId}-dropdown`
  - const validationClasses = validation === 'error' ? 'error' : validation === 'success' ? 'success' : ''
  - const uniqueId = `searchmultiselect-${inputId}-${Math.random().toString(36).substr(2, 9)}`

  .search-multi-select-container(class=classes)
    .multi-select-container(class=validationClasses)
      .multi-select-header
        .multi-select-selected-pills(id=`${uniqueId}-pills`)
          // Selected items as pills will be populated here
        
        .search-multi-select-input-wrapper
          input.search-multi-select-input(
            type="text"
            id=inputId
            placeholder=placeholder
            disabled=disabled
            autocomplete="off"
            data-dropdown=dropdownId
            data-multiselect-id=uniqueId
          )
          .search-dropdown-arrow
            +icon('chevron-down')
      
      .search-dropdown(id=dropdownId class="hidden")
        .search-dropdown-list
          // Options will be populated dynamically
    
    // Hidden input to store selected values for form submission
    input(type="hidden" name=name id=`${uniqueId}-hidden` value="" data-required=required)
    
    label.floating-label(for=inputId) #{label}