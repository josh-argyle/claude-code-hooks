const prisma = require('../utils/prisma');
const logger = require('../utils/logger');

const getAllCompanies = async (includeTypes = false) => {
  const companies = await prisma.companies.findMany({
    where: {
      is_active: true
    },
    ...(includeTypes && {
      include: {
        company_types: {
          include: {
            company_type_ref: true
          },
          orderBy: {
            company_type: 'asc'
          }
        }
      }
    }),
    orderBy: {
      name: 'asc'
    }
  });

  // If including types, transform the data for easier consumption
  if (includeTypes) {
    return companies.map(company => {
      const companyTypes = company.company_types || [];
      return {
        ...company,
        name: company.name ? company.name.trim() : company.name, // Trim company name
        types: companyTypes.map(ct => ({
          company_type: ct.company_type,
          description: ct.company_type_ref?.description || ''
        })),
        all_types: companyTypes.map(ct => ct.company_type)
      };
    });
  }

  // Trim company names even when not including types
  return companies.map(company => ({
    ...company,
    name: company.name ? company.name.trim() : company.name
  }));
};

const getCompanyById = async (companyId, includeTypes = false) => {
  // Validate UUID format
  const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
  if (!uuidRegex.test(companyId)) {
    throw new Error('Invalid UUID format');
  }

  const company = await prisma.companies.findUnique({
    where: { company_id: companyId },
    ...(includeTypes && {
      include: {
        company_types: {
          include: {
            company_type_ref: true
          },
          orderBy: {
            company_type: 'asc'
          }
        }
      }
    })
  });

  if (!company) return null;

  // If including types, transform the data
  if (includeTypes) {
    const companyTypes = company.company_types || [];
    return {
      ...company,
      types: companyTypes.map(ct => ({
        company_type: ct.company_type,
        description: ct.company_type_ref?.description || ''
      })),
      all_types: companyTypes.map(ct => ct.company_type)
    };
  }

  return company;
};

const createCompany = async (companyData, userId = null) => {
  if (!companyData) {
    throw new Error('Company data is required');
  }

  const { name, company_types, website, logo } = companyData;

  if (!name) {
    throw new Error('Name is required');
  }

  // Handle multiple company types
  let typesToAssign = [];
  if (company_types && Array.isArray(company_types) && company_types.length > 0) {
    typesToAssign = company_types.map(type =>
      typeof type === 'string' ? { company_type: type } : type
    );
  } else {
    throw new Error('At least one company type is required');
  }

  // Create company with transaction to ensure consistency
  const result = await prisma.$transaction(async (tx) => {
    const company = await tx.companies.create({
      data: {
        name: name.trim(), // Trim company name to prevent search-select issues
        website_url: website || null,
        logo_url: logo || null
      }
    });

    // Create company type relationships
    for (const typeData of typesToAssign) {
      await tx.company_types.create({
        data: {
          company_id: company.company_id,
          company_type: typeData.company_type,
          added_by: userId
        }
      });
    }

    return company;
  });

  return result;
};

const updateCompany = async (companyId, companyData, userId = null) => {
  if (!companyData) {
    throw new Error('Company data is required');
  }

  const { name, company_types, website, logo } = companyData;

  if (!name) {
    throw new Error('Name is required');
  }

  // Validate company_types is provided and not empty
  if (!company_types || !Array.isArray(company_types) || company_types.length === 0) {
    throw new Error('At least one company type is required');
  }

  // Update company with transaction to ensure consistency
  const result = await prisma.$transaction(async (tx) => {
    // Remove existing type relationships
    await tx.company_types.deleteMany({
      where: { company_id: companyId }
    });

    // Add new type relationships
    for (const typeData of company_types) {
      await tx.company_types.create({
        data: {
          company_id: companyId,
          company_type: typeof typeData === 'string' ? typeData : typeData.company_type,
          added_by: userId
        }
      });
    }

    // Update company record
    const company = await tx.companies.update({
      where: { company_id: companyId },
      data: {
        name: name.trim(), // Trim company name to prevent search-select issues
        website_url: website || null,
        logo_url: logo || null,
        updated_at: new Date()
      }
    });

    return company;
  });

  return result;
};

const getCompaniesByTypes = async (companyTypes) => {
  logger.info('🚀 [COMPANY-SERVICE] getCompaniesByTypes called with:', {
    companyTypes,
    companyTypesIsArray: Array.isArray(companyTypes),
    companyTypesLength: companyTypes?.length || 0
  });

  if (!Array.isArray(companyTypes) || companyTypes.length === 0) {
    logger.error('❌ [COMPANY-SERVICE] Invalid company types provided');
    throw new Error('Company types must be a non-empty array');
  }

  logger.info('🔍 [COMPANY-SERVICE] Querying companies by types');
  const companies = await prisma.companies.findMany({
    where: {
      company_types: {
        some: {
          company_type: {
            in: companyTypes
          }
        }
      }
    },
    select: {
      name: true,
      company_id: true,
      company_types: {
        select: {
          company_type: true
        }
      }
    },
    orderBy: {
      name: 'asc'
    }
  });
  logger.info('📊 [COMPANY-SERVICE] Query result:', {
    companiesCount: companies?.length || 0,
    companies: companies?.slice(0, 5) // Show first 5 for debugging
  });

  const result = companies
    .filter(c => c.name && c.name.trim() !== '')
    .map(c => ({
      company_id: c.company_id,
      name: c.name.trim() // Trim company names to prevent search-select issues
    }));
  logger.info('✅ [COMPANY-SERVICE] Final filtered result:', {
    originalCount: companies?.length || 0,
    filteredCount: result.length,
    result: result.slice(0, 10) // Show first 10 company names
  });

  return result;
};

/**
 * Add a company type to an existing company
 */
const addCompanyType = async (companyId, companyType, userId = null) => {
  // Validate UUID format
  const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
  if (!uuidRegex.test(companyId)) {
    throw new Error('Invalid UUID format');
  }

  // Check if company exists
  const company = await prisma.companies.findUnique({
    where: { company_id: companyId }
  });

  if (!company) {
    throw new Error('Company not found');
  }

  // Check if the company type already exists for this company
  const existingType = await prisma.company_types.findUnique({
    where: {
      company_id_company_type: {
        company_id: companyId,
        company_type: companyType
      }
    }
  });

  if (existingType) {
    throw new Error('Company already has this type');
  }

  // Add the new company type
  const newCompanyType = await prisma.company_types.create({
    data: {
      company_id: companyId,
      company_type: companyType,
      added_by: userId || null,
      created_at: new Date(),
      updated_at: new Date()
    }
  });

  return newCompanyType;
};

/**
 * Remove a company type from a company
 */
const removeCompanyType = async (companyId, companyType) => {
  // Validate UUID format
  const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
  if (!uuidRegex.test(companyId)) {
    throw new Error('Invalid UUID format');
  }

  // Check if company exists
  const company = await prisma.companies.findUnique({
    where: { company_id: companyId }
  });

  if (!company) {
    throw new Error('Company not found');
  }

  // Get the type to be removed
  const typeToRemove = await prisma.company_types.findUnique({
    where: {
      company_id_company_type: {
        company_id: companyId,
        company_type: companyType
      }
    }
  });

  if (!typeToRemove) {
    throw new Error('Company does not have this type');
  }

  // Check if this is the last type
  const allTypes = await prisma.company_types.findMany({
    where: { company_id: companyId }
  });

  if (allTypes.length === 1) {
    throw new Error('Cannot remove the last company type');
  }

  // Remove the type
  await prisma.company_types.delete({
    where: {
      company_id_company_type: {
        company_id: companyId,
        company_type: companyType
      }
    }
  });

  return { success: true };
};

/**
 * Get companies that have multiple types
 */
const getMultiTypeCompanies = async () => {
  const companies = await prisma.companies.findMany({
    include: {
      company_types: {
        include: {
          company_type_ref: true
        },
        orderBy: {
          company_type: 'asc'
        }
      }
    },
    where: {
      company_types: {
        some: {}
      }
    }
  });

  // Filter to only companies with multiple types
  const multiTypeCompanies = companies.filter(company => company.company_types.length > 1);

  return multiTypeCompanies.map(company => ({
    ...company,
    types: company.company_types.map(ct => ({
      company_type: ct.company_type,
      description: ct.company_type_ref.description,
      added_date: ct.added_date
    })),
    all_types: company.company_types.map(ct => ct.company_type)
  }));
};

/**
 * Archive a company (soft delete)
 */
const archiveCompany = async (companyId) => {
  // Validate UUID format
  const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
  if (!uuidRegex.test(companyId)) {
    throw new Error('Invalid UUID format');
  }

  try {
    const company = await prisma.companies.update({
      where: { company_id: companyId },
      data: {
        is_active: false,
        updated_at: new Date()
      }
    });
    return company;
  } catch (error) {
    if (error.code === 'P2025') {
      // Record not found
      return null;
    }
    throw error;
  }
};

module.exports = {
  getAllCompanies,
  getCompanyById,
  createCompany,
  updateCompany,
  getCompaniesByTypes,
  addCompanyType,
  removeCompanyType,
  getMultiTypeCompanies,
  archiveCompany
};
