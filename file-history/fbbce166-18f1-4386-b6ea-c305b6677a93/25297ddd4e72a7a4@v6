### Example: Monthly Leave Approval Reminder (EXAMPLE ONLY - NOT TO BE IMPLEMENTED)

**Create `/scripts/scheduled/leave-approval-reminder.js`:**

```javascript
#!/usr/bin/env node
require('dotenv').config();

const { getUsersByRoles } = require('../api/services/userService');
const NotificationService = require('../api/services/notificationService');
const prisma = require('../api/utils/prisma');
const logger = require('../api/utils/logger');

// ===== CONFIGURATION =====
const CONFIG = {
  daysThreshold: 7,  // Remind for requests older than 7 days
  title: '📋 Pending Leave Approvals',
  message: 'You have leave requests awaiting your approval.'
};

// ===== MAIN LOGIC =====
async function runLeaveApprovalReminders() {
  logger.info('Starting leave approval reminder job');

  try {
    // 1. Get managers and admins
    const managers = await getUsersByRoles(
      ['project_manager', 'admin'],
      [],
      { onlyActive: true }
    );

    // 2. Find pending leave requests older than threshold
    const threshold = new Date();
    threshold.setDate(threshold.getDate() - CONFIG.daysThreshold);

    const pendingRequests = await prisma.leave_requests.findMany({
      where: {
        status: 'pending',
        requested_at: { lt: threshold }
      },
      include: { approver: true }
    });

    // 3. Group by approver
    const approverMap = new Map();
    pendingRequests.forEach(req => {
      const approverId = req.approver_id;
      if (!approverMap.has(approverId)) approverMap.set(approverId, []);
      approverMap.get(approverId).push(req);
    });

    // 4. Send notifications
    for (const manager of managers) {
      const pending = approverMap.get(manager.user_id);
      if (pending && pending.length > 0) {
        await NotificationService.createNotification(
          'leave_approval',
          manager.user_id,
          'reminder',
          CONFIG.title,
          `${CONFIG.message} (${pending.length} pending)`,
          { link: '/leave/approvals', count: pending.length },
          [manager.user_id]
        );
      }
    }

    logger.info('Leave approval reminder job complete');
    process.exit(0);
  } catch (error) {
    logger.error('Leave approval reminder job failed:', error);
    process.exit(1);
  }
}

runLeaveApprovalReminders();
```

