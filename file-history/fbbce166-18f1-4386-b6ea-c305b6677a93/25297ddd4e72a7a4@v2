### `scheduledNotificationService.js` Structure

```javascript
class ScheduledNotificationService {
  // Registration system - easy to add new types
  static jobTypes = {
    'timesheet-reminder': {
      handler: this.sendTimesheetReminders,
      notificationType: 'todo',
      description: 'Weekly timesheet submission reminder'
    },
    // Future jobs...
    'leave-approval-reminder': {
      handler: this.sendLeaveApprovalReminders,
      notificationType: 'notification',
      description: 'Monthly leave approval reminder'
    }
  }

  // Main entry point
  static async runScheduledJob(jobType) {
    const config = this.jobTypes[jobType];
    if (!config) throw new Error(`Unknown job type: ${jobType}`);

    logger.info(`Starting scheduled job: ${jobType}`);
    await config.handler();
    logger.info(`Completed scheduled job: ${jobType}`);
  }

  // ===== SHARED HELPERS =====
  static async getActiveUsersWithWorkbench() { }
  static async getUsersWithRole(roles) { }
  static async checkWorkbenchTimesheetStatus(userId) { }
  static getNextFriday(date) { }
  static getSundayNight(date) { }

  // ===== NOTIFICATION HANDLERS =====
  static async sendTimesheetReminders() {
    // 1. Get all active users with Workbench mapping
    const users = await this.getActiveUsersWithWorkbench();

    // 2. Check each user's timesheet status via Workbench API
    const incompleteUsers = [];
    for (const user of users) {
      const isComplete = await this.checkWorkbenchTimesheetStatus(user);
      if (!isComplete) incompleteUsers.push(user);
    }

    // 3. Calculate due date (Sunday 11:59pm NZDT)
    const dueDate = this.getSundayNight(new Date());

    // 4. Create TODO for each user (no batch method exists)
    let successCount = 0, errorCount = 0;

    for (const user of incompleteUsers) {
      try {
        await NotificationService.createTodo(
          user.user_id,  // created by (system)
          '⏰ Submit Your Timesheet',
          'Please submit your timesheet for this week by tonight.',
          dueDate,
          user.user_id   // assigned to
        );
        successCount++;

        // Optional: Send email
        if (process.env.SEND_TIMESHEET_REMINDER_EMAIL === 'true') {
          await this.sendTimesheetReminderEmail(user, dueDate);
        }
      } catch (error) {
        logger.error(`Failed to create todo for user ${user.user_id}:`, error);
        errorCount++;
      }
    }

    // 5. Log results
    logger.info('Timesheet reminder job complete', {
      totalEligible: users.length,
      incompleteUsers: incompleteUsers.length,
      todosCreated: successCount,
      errors: errorCount
    });

    return { successCount, errorCount };
  }

  // Future handlers added here...
  static async sendLeaveApprovalReminders() { }
  static async sendContractExpiryAlerts() { }
}
```

### `scripts/scheduled-jobs.js` (Heroku Wrapper)

```javascript
#!/usr/bin/env node
require('dotenv').config();
const ScheduledNotificationService = require('../api/services/scheduledNotificationService');
const logger = require('../api/utils/logger');

const jobType = process.argv[2];

if (!jobType) {
  console.error('Usage: node scripts/scheduled-jobs.js <job-type>');
  console.error('Available jobs:', Object.keys(ScheduledNotificationService.jobTypes).join(', '));
  process.exit(1);
}

// Run job
ScheduledNotificationService.runScheduledJob(jobType)
  .then((result) => {
    logger.info('Job completed successfully', { jobType, result });
    process.exit(0);
  })
  .catch((error) => {
    logger.error('Job failed', { jobType, error: error.message });
    process.exit(1);
  });
```

