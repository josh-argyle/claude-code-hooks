const { getFireSafetySystems } = require('../../api/data');
const { applyNoteEvaluations } = require('../../api/processors/fire-safety-systems/calculator');
const { parseSystemCode } = require('../../api/data/services/fire-safety-systems-service');

describe('Fire Safety Systems Integration - Note 4 Early Childhood Centres', () => {

  test('should add Type 7 to CA early childhood centre with escape height > 2.0m', () => {
    const firecell = {
      riskGroup: 'CA',
      isEarlyChildhoodCentre: true,
      occupantLoad: 30,
      escapeHeight: 2.5,
      placesOfSafetyCompliant: true
    };

    // Get base systems for CA with 30 occupants and 2.5m escape height
    const baseSystems = getFireSafetySystems('CA', {
      occupantLoad: firecell.occupantLoad,
      escapeHeight: firecell.escapeHeight
    });

    // Apply note evaluations (Note 4 should add Type 7)
    const result = applyNoteEvaluations(baseSystems, firecell, {}, []);

    // Type 7 should be in final systems
    expect(result.systems).toContain('7');

    // Compliance info should be populated
    expect(result.complianceInfo.placesOfSafety).toEqual({
      minimumRequired: 2,
      requiresFireSeparations: true,
      requiresDirectAccessToSafePath: true,
      compliant: true,
      paragraph: '2.2.4(b)(ii)&(iii)'
    });

    // Verify Type 7 is present in final systems
    const hasType7 = result.systems.some(sys => {
      const parsed = parseSystemCode(sys);
      return parsed.type === 7;
    });
    expect(hasType7).toBe(true);
  });

  test('should NOT add Type 7 when escape height ≤ 2.0m', () => {
    const firecell = {
      riskGroup: 'CA',
      isEarlyChildhoodCentre: true,
      occupantLoad: 30,
      escapeHeight: 1.8,
      hasDedicatedSleepingAreas: true,
      supplementarySmokeDetectorsCompliant: true
    };

    // Get base systems for CA with 30 occupants and 1.8m escape height
    const baseSystems = getFireSafetySystems('CA', {
      occupantLoad: firecell.occupantLoad,
      escapeHeight: firecell.escapeHeight
    });

    // Apply note evaluations (Note 4 should NOT add Type 7)
    const result = applyNoteEvaluations(baseSystems, firecell, {}, []);

    // Type 7 should NOT be added (unless already in base systems, which it shouldn't be for this config)
    // Base systems for CA with 30 occupants and 1.8m height: ['2', '18^2']
    // Note 4 should track smoke detector compliance but NOT add Type 7
    expect(result.complianceInfo.supplementarySmokeDetectors).toEqual({
      required: true,
      location: 'Dedicated sleeping areas',
      standard: 'NZS 4512',
      compliant: true,
      paragraph: '2.2.4(a)'
    });

    // Places of safety should NOT be tracked (condition b doesn't apply)
    expect(result.complianceInfo.placesOfSafety).toBeNull();
  });

  test('should not duplicate Type 7 if already in base systems', () => {
    const firecell = {
      riskGroup: 'CA',
      isEarlyChildhoodCentre: true,
      occupantLoad: 1500, // High occupant load - base systems may include Type 7
      escapeHeight: 3.0,
      placesOfSafetyCompliant: true
    };

    // Get base systems for CA with high occupant load (should include Type 7)
    const baseSystems = getFireSafetySystems('CA', {
      occupantLoad: firecell.occupantLoad,
      escapeHeight: firecell.escapeHeight
    });

    // Apply note evaluations (Note 4 will try to add Type 7)
    const result = applyNoteEvaluations(baseSystems, firecell, {}, []);

    // Count Type 7 occurrences
    const type7Count = result.systems.filter(sys => {
      const parsed = parseSystemCode(sys);
      return parsed.type === 7;
    }).length;

    // Should only have ONE Type 7, not duplicated
    expect(type7Count).toBe(1);
  });

  test('should handle boundary case: exactly 2.0m (condition a applies)', () => {
    const firecell = {
      riskGroup: 'CA',
      isEarlyChildhoodCentre: true,
      occupantLoad: 30,
      escapeHeight: 2.0, // Exactly 2.0m
      hasDedicatedSleepingAreas: true,
      supplementarySmokeDetectorsCompliant: true
    };

    const baseSystems = getFireSafetySystems('CA', {
      occupantLoad: firecell.occupantLoad,
      escapeHeight: firecell.escapeHeight
    });

    const result = applyNoteEvaluations(baseSystems, firecell, {}, []);

    // Condition (a) should apply (≤ 2.0m), NOT condition (b)
    expect(result.complianceInfo.supplementarySmokeDetectors).toBeDefined();
    expect(result.complianceInfo.placesOfSafety).toBeNull();

    // Type 7 should NOT be added
    const hasType7 = result.systems.some(sys => {
      const parsed = parseSystemCode(sys);
      return parsed.type === 7;
    });
    // Base systems for CA with 30 occupants and 2.0m don't include Type 7
    expect(hasType7).toBe(false);
  });

  test('should handle boundary case: 2.01m (condition b applies)', () => {
    const firecell = {
      riskGroup: 'CA',
      isEarlyChildhoodCentre: true,
      occupantLoad: 30,
      escapeHeight: 2.01, // Just over 2.0m
      placesOfSafetyCompliant: true
    };

    const baseSystems = getFireSafetySystems('CA', {
      occupantLoad: firecell.occupantLoad,
      escapeHeight: firecell.escapeHeight
    });

    const result = applyNoteEvaluations(baseSystems, firecell, {}, []);

    // Condition (b) should apply (> 2.0m)
    expect(result.complianceInfo.placesOfSafety).toBeDefined();
    expect(result.complianceInfo.supplementarySmokeDetectors).toBeNull();

    // Type 7 should be added
    const hasType7 = result.systems.some(sys => {
      const parsed = parseSystemCode(sys);
      return parsed.type === 7;
    });
    expect(hasType7).toBe(true);
  });

  test('should not affect non-early childhood CA buildings', () => {
    const firecell = {
      riskGroup: 'CA',
      isEarlyChildhoodCentre: false, // Not an early childhood centre
      occupantLoad: 30,
      escapeHeight: 3.0
    };

    const baseSystems = getFireSafetySystems('CA', {
      occupantLoad: firecell.occupantLoad,
      escapeHeight: firecell.escapeHeight
    });

    const result = applyNoteEvaluations(baseSystems, firecell, {}, []);

    // Note 4 should not apply
    expect(result.complianceInfo.supplementarySmokeDetectors).toBeNull();
    expect(result.complianceInfo.placesOfSafety).toBeNull();

    // Systems should be same as base systems (no Type 7 added by Note 4)
    const hasType7 = result.systems.some(sys => {
      const parsed = parseSystemCode(sys);
      return parsed.type === 7;
    });

    // Base systems for CA with 30 occupants and 3.0m: ['4^5', '9', '18^2']
    // Type 7 should NOT be in there
    expect(hasType7).toBe(false);
  });
});

describe('Fire Safety Systems Integration - Foundation Tests', () => {

  test('should process fire safety systems for single firecell', () => {
    const firecell = {
      riskGroup: 'CA',
      occupantLoad: 150,
      escapeHeight: 3.0
    };

    // Get base systems for CA with 150 occupants and 3.0m escape height
    const baseSystems = getFireSafetySystems('CA', {
      occupantLoad: firecell.occupantLoad,
      escapeHeight: firecell.escapeHeight
    });

    // Apply note evaluations
    const result = applyNoteEvaluations(baseSystems, firecell, {}, []);

    // Verify systems array is populated
    expect(result.systems).toBeDefined();
    expect(Array.isArray(result.systems)).toBe(true);
    expect(result.systems.length).toBeGreaterThan(0);

    // Verify compliance info object exists
    expect(result.complianceInfo).toBeDefined();
    expect(typeof result.complianceInfo).toBe('object');
  });

  test('should process multiple firecells of same risk group', () => {
    const firecells = [
      {
        riskGroup: 'CA',
        occupantLoad: 50,
        escapeHeight: 3.0
      },
      {
        riskGroup: 'CA',
        occupantLoad: 150,
        escapeHeight: 5.0
      },
      {
        riskGroup: 'CA',
        occupantLoad: 500,
        escapeHeight: 15.0
      }
    ];

    const results = firecells.map(fc => {
      const baseSystems = getFireSafetySystems(fc.riskGroup, {
        occupantLoad: fc.occupantLoad,
        escapeHeight: fc.escapeHeight
      });
      return applyNoteEvaluations(baseSystems, fc, {}, firecells);
    });

    // Verify each has independent systems
    results.forEach((result, index) => {
      expect(result.systems).toBeDefined();
      expect(result.systems.length).toBeGreaterThan(0);
    });

    // Verify systems are different for different parameters
    // First firecell (50 occupants, 3m) vs second (150 occupants, 5m) should differ
    expect(results[0].systems).not.toEqual(results[1].systems);
  });

  test('should process multi-risk building (all 6 risk groups)', () => {
    const firecells = [
      {
        riskGroup: 'SM',
        occupantType: 'permanent',
        occupantLoad: 15,
        escapeHeight: 5.0
      },
      {
        riskGroup: 'SI',
        occupantType: 'careOrDetention',
        occupantLoad: 80,
        escapeHeight: 8.0
      },
      {
        riskGroup: 'CA',
        occupantLoad: 150,
        escapeHeight: 5.0
      },
      {
        riskGroup: 'WB',
        occupantLoad: 50,
        escapeHeight: 3.0
      },
      {
        riskGroup: 'WS',
        occupantLoad: 500,
        escapeHeight: 6.0
      },
      {
        riskGroup: 'VP',
        occupantLoad: 10,
        escapeHeight: 5.0,
        hasVehicleStacker: false
      }
    ];

    const results = firecells.map(fc => {
      // SM/SI use occupantType, others use occupantLoad
      const params = fc.riskGroup === 'SM' || fc.riskGroup === 'SI'
        ? { occupantType: fc.occupantType, escapeHeight: fc.escapeHeight }
        : fc.riskGroup === 'VP'
          ? { escapeHeight: fc.escapeHeight, hasVehicleStacker: fc.hasVehicleStacker }
          : { occupantLoad: fc.occupantLoad, escapeHeight: fc.escapeHeight };

      const baseSystems = getFireSafetySystems(fc.riskGroup, params);
      return applyNoteEvaluations(baseSystems, fc, {}, firecells);
    });

    // Verify all risk groups get appropriate systems
    expect(results).toHaveLength(6);
    results.forEach((result, index) => {
      expect(result.systems).toBeDefined();
      expect(result.systems.length).toBeGreaterThan(0);
    });
  });

});

describe('Fire Safety Systems Integration - Note 1a SM Bed Exemption', () => {

  test('should exempt Type 2 for SM with ≤10 beds (note 1a)', () => {
