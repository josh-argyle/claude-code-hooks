    expect(baseSystems).toContain('18^2');

    // Apply note evaluations
    const result = applyNoteEvaluations(baseSystems, firecell, {}, []);

    // Type 5 should be REMOVED (exempt for ≤10 beds + <4m height)
    const hasType5 = result.systems.some(sys => {
      const parsed = parseSystemCode(sys);
      return parsed.type === 5;
    });
    expect(hasType5).toBe(false);

    // Only Type 18 should remain
    const hasType18 = result.systems.some(sys => {
      const parsed = parseSystemCode(sys);
      return parsed.type === 18;
    });
    expect(hasType18).toBe(true);

    // NOTE: Calculator currently doesn't track requiresType1SmokeAlarms in complianceInfo
    // This is a known limitation - Type 1 smoke alarms ARE required per CAS2 Table 2.2 Note 1a
    // but the compliance tracking for this specific requirement is not yet implemented
  });

});

