    // Get base systems for SM permanent with 5.0m escape height
    const baseSystems = getFireSafetySystems('SM', {
      occupantType: firecell.occupantType,
      escapeHeight: firecell.escapeHeight
    });

    // Base systems should be ['1', '2^1a', '18^2']
    expect(baseSystems).toContain('2^1a');

    // Apply note evaluations
    const result = applyNoteEvaluations(baseSystems, firecell, {}, []);

    // Type 2 should REMAIN (>10 beds)
    const hasType1 = result.systems.some(sys => {
      const parsed = parseSystemCode(sys);
      return parsed.type === 1;
    });
    expect(hasType1).toBe(true);

    const hasType18 = result.systems.some(sys => {
      const parsed = parseSystemCode(sys);
      return parsed.type === 18;
    });
    expect(hasType18).toBe(true);

    const hasType2 = result.systems.some(sys => {
      const parsed = parseSystemCode(sys);
      return parsed.type === 2;
    });
    expect(hasType2).toBe(true);
  });

  test('should exempt Type 2 for SM with direct exit (note 1a)', () => {
    const firecell = {
      riskGroup: 'SM',
      occupantType: 'permanent',
      sleepingOccupantType: 'permanent',
      occupantLoad: 20,
      escapeHeight: 5.0,
      maxEscapeRouteBeds: 20,
      exitDirectlyToSafePlace: true
    };

    // Get base systems for SM permanent with 5.0m escape height
    const baseSystems = getFireSafetySystems('SM', {
      occupantType: firecell.occupantType,
      escapeHeight: firecell.escapeHeight
    });

    // Base systems should be ['1', '2^1a', '18^2']
    expect(baseSystems).toContain('2^1a');

    // Apply note evaluations
    const result = applyNoteEvaluations(baseSystems, firecell, {}, []);

    // Type 2 should be REMOVED (direct exit exemption)
    const hasType1 = result.systems.some(sys => {
      const parsed = parseSystemCode(sys);
      return parsed.type === 1;
    });
    expect(hasType1).toBe(true);

    const hasType18 = result.systems.some(sys => {
      const parsed = parseSystemCode(sys);
      return parsed.type === 18;
    });
    expect(hasType18).toBe(true);

    const hasType2 = result.systems.some(sys => {
      const parsed = parseSystemCode(sys);
      return parsed.type === 2;
    });
    expect(hasType2).toBe(false);
  });

  test('should exempt Type 5 for transient with ≤10 beds at ground level (note 1a)', () => {
    const firecell = {
      riskGroup: 'SM',
      occupantType: 'transient',
      sleepingOccupantType: 'transient',
      occupantLoad: 5,
      escapeHeight: 0,  // Must be 0 to get '5^1a' system code
      maxEscapeRouteBeds: 5
    };

    // Get base systems for SM transient with 0m escape height
    const baseSystems = getFireSafetySystems('SM', {
      occupantType: firecell.occupantType,
      escapeHeight: firecell.escapeHeight
    });

    // Base systems should be ['5^1a', '18^2'] (transient at 0m, line 89)
