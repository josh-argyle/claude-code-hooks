const { processOccupantLoads } = require('../../../api/processors/occupant-load/orchestrator');
const { calculateOccupantLoad, needsOccupantLoadCalculation } = require('../../../api/processors/occupant-load/occupant-load-calculator');
const { determinePrimaryRiskGroup } = require('../../../api/processors/occupant-load/primary-risk-group');
const { processMultipleAreas } = require('../../../api/processors/occupant-load/multi-area-processor');
const ProjectModel = require('../../../api/models/project-model');

describe('Occupant Load Processor', () => {
  describe('calculateOccupantLoad', () => {
    test('should calculate occupant load correctly for office spaces', () => {
      const result = calculateOccupantLoad(1000, 'Office spaces');
      expect(result).toBe(100); // 1000 / 10 = 100
    });

    test('should round up occupant load', () => {
      const result = calculateOccupantLoad(105, 'Office spaces');
      expect(result).toBe(11); // 105 / 10 = 10.5, rounded up to 11
    });

    test('should return null for invalid inputs', () => {
      expect(calculateOccupantLoad(null, 'Office spaces')).toBeNull();
      expect(calculateOccupantLoad(1000, null)).toBeNull();
      expect(calculateOccupantLoad(0, 'Office spaces')).toBeNull();
      expect(calculateOccupantLoad(1000, 'Invalid Activity')).toBeNull();
    });

    test('should handle edge case with very small areas', () => {
      const result = calculateOccupantLoad(1, 'Office spaces');
      expect(result).toBe(1); // 1 / 10 = 0.1, rounded up to 1
    });
  });

  describe('needsOccupantLoadCalculation', () => {
    test('should return true for risk groups that need calculation', () => {
      expect(needsOccupantLoadCalculation('CA')).toBe(true);
      expect(needsOccupantLoadCalculation('WB')).toBe(true);
      expect(needsOccupantLoadCalculation('WS')).toBe(true);
      expect(needsOccupantLoadCalculation('VP')).toBe(true);
    });

    test('should return false for risk groups that do not need calculation', () => {
      expect(needsOccupantLoadCalculation('SM')).toBe(false);
      expect(needsOccupantLoadCalculation('SI')).toBe(false);
    });

    test('should return false for invalid risk groups', () => {
      expect(needsOccupantLoadCalculation('INVALID')).toBe(false);
      expect(needsOccupantLoadCalculation(null)).toBe(false);
    });
  });

  describe('determinePrimaryRiskGroup', () => {
    test('should determine primary risk group based on priority order', () => {
      const firecells = [
        { riskGroup: 'WB' },
        { riskGroup: 'CA' },
        { riskGroup: 'VP' }
      ];
      expect(determinePrimaryRiskGroup(firecells)).toBe('CA');
    });

    test('should return highest priority risk group', () => {
      const firecells = [
        { riskGroup: 'VP' },
        { riskGroup: 'SI' },
        { riskGroup: 'WB' }
      ];
      expect(determinePrimaryRiskGroup(firecells)).toBe('SI');
    });

    test('should handle single firecell', () => {
      const firecells = [{ riskGroup: 'WB' }];
      expect(determinePrimaryRiskGroup(firecells)).toBe('WB');
    });

    test('should return null for empty array', () => {
      expect(determinePrimaryRiskGroup([])).toBeNull();
    });

    test('should handle firecells without risk groups', () => {
      const firecells = [{ name: 'test' }];
      expect(determinePrimaryRiskGroup(firecells)).toBeNull();
    });
  });

  describe('processMultipleAreas', () => {
    test('should process multiple areas and calculate total', () => {
      const areas = [
        { floorArea: 1000, occupantType: 'Office spaces' },
        { floorArea: 500, occupantType: 'Meeting rooms' }
      ];

      const result = processMultipleAreas(areas);

      expect(result.areas).toHaveLength(2);
      expect(result.areas[0].occupantLoad).toBe(100); // 1000 / 10
      expect(result.areas[1].occupantLoad).toBe(200);  // 500 / 2.5
      expect(result.totalOccupantLoad).toBe(300);
    });

    test('should handle areas with invalid data', () => {
      const areas = [
        { floorArea: 1000, occupantType: 'Office spaces' },
        { floorArea: null, occupantType: 'Office spaces' },
        { floorArea: 500, occupantType: 'Invalid Activity' }
      ];

      const result = processMultipleAreas(areas);

      expect(result.areas).toHaveLength(3);
      expect(result.areas[0].occupantLoad).toBe(100);
      expect(result.areas[1].occupantLoad).toBeNull();
      expect(result.areas[2].occupantLoad).toBeNull();
      expect(result.totalOccupantLoad).toBe(100);
    });

    test('should return empty result for empty array', () => {
      const result = processMultipleAreas([]);
      expect(result.areas).toEqual([]);
      expect(result.totalOccupantLoad).toBe(0);
    });
  });

  describe('processOccupantLoads (Orchestrator)', () => {
    let projectModel;

    beforeEach(() => {
      projectModel = new ProjectModel();
    });

    test('should process firecells that need occupant load calculation', () => {
      // Add firecells that need calculation
      projectModel.addFirecell({
        riskGroup: 'CA',
        occupantType: 'Office spaces',
        // occupantLoad removed - will be calculated as 1000/10 = 100
        escapeHeight: 5,
        isSprinklered: true,
        floorArea: 1000,
        floor: 'G'
      });

      projectModel.addFirecell({
        riskGroup: 'WB',
        occupantType: 'Meeting rooms',
        // occupantLoad removed - will be calculated as 500/2.5 = 200
        escapeHeight: 3,
        isSprinklered: false,
        floorArea: 500,
        floor: 'G'
      });

      const result = processOccupantLoads(projectModel);

      expect(result.firecells[0].occupantLoad).toBe(100); // 1000 / 10
      expect(result.firecells[0].calculatedOccupantLoad).toBe(100); // Backwards compat
      expect(result.firecells[1].occupantLoad).toBe(200);  // 500 / 2.5
      expect(result.firecells[1].calculatedOccupantLoad).toBe(200); // Backwards compat
    });

    test('should skip firecells that do not need calculation', () => {
      projectModel.addFirecell({
        riskGroup: 'SM',
        sleepingOccupantType: 'permanent',
        occupantLoad: 20,
        escapeHeight: 8,
        isSprinklered: true,
        floorArea: 500,
        floor: 'G'
      });

      const result = processOccupantLoads(projectModel);

      expect(result.firecells[0].calculatedOccupantLoad).toBeUndefined();
    });

    test('should handle mixed firecells', () => {
      // Needs calculation
      projectModel.addFirecell({
        riskGroup: 'CA',
        occupantType: 'Office spaces',
        // occupantLoad removed - will be calculated as 1000/10 = 100
        escapeHeight: 5,
        isSprinklered: true,
        floorArea: 1000,
        floor: 'G'
      });

      // Does not need calculation (SM uses bed spaces)
      projectModel.addFirecell({
        riskGroup: 'SM',
        sleepingOccupantType: 'permanent',
        occupantLoad: 20, // Keep for SM (bed spaces)
        escapeHeight: 8,
        isSprinklered: true,
        floorArea: 500,
        floor: 'G'
      });

      const result = processOccupantLoads(projectModel);

      expect(result.firecells[0].occupantLoad).toBe(100);
      expect(result.firecells[0].calculatedOccupantLoad).toBe(100);
      expect(result.firecells[1].calculatedOccupantLoad).toBeUndefined();
    });

    test('should handle calculation errors gracefully', () => {
      // This test simulates calculation error by using a valid occupant type but testing the processor's error handling
      // We'll modify the firecell after creation to test error handling
      projectModel.addFirecell({
        riskGroup: 'CA',
        occupantType: 'Office spaces',
        // occupantLoad removed - will be calculated as 1000/10 = 100
        escapeHeight: 5,
        isSprinklered: true,
        floorArea: 1000,
        floor: 'G'
      });

      // Manually corrupt the occupant type to test error handling
      projectModel.firecells[0].occupantType = 'Invalid Activity Type';

      const result = processOccupantLoads(projectModel);

      expect(result.firecells[0].occupantLoad).toBeNull();
      expect(result.firecells[0].calculatedOccupantLoad).toBeNull();
    });

    test('should preserve original project model structure', () => {
      projectModel.addFirecell({
        riskGroup: 'WB',
        occupantType: 'Office spaces',
        // occupantLoad removed - will be calculated as 1000/10 = 100
        escapeHeight: 3,
        isSprinklered: false,
        floorArea: 1000,
        floor: 'G'
      });

      const originalFirecellCount = projectModel.getFirecellCount();
      const result = processOccupantLoads(projectModel);

      expect(result.getFirecellCount()).toBe(originalFirecellCount);
      expect(result.firecells[0].riskGroup).toBe('WB');
      expect(result.firecells[0].occupantType).toBe('Office spaces');
      expect(result.firecells[0].occupantLoad).toBe(100); // Calculated value
      expect(result.firecells[0].escapeHeight).toBe(3);
    });

    test('should return same project model instance', () => {
      const result = processOccupantLoads(projectModel);
      expect(result).toBe(projectModel);
    });

    test('should handle empty project model', () => {
      const result = processOccupantLoads(projectModel);
      expect(result.getFirecellCount()).toBe(0);
    });
  });
});