const {
  calculateEffectiveFireResistanceRatings,
  getBaseFireResistanceRatings,
  applyEscapeHeightModification,
  applyBoundaryStorageModification,
  applyVentilationSubstitution,
  getApplicableNotes
} = require('../../../api/processors/fire-resistance/calculator');

const { processFireResistance } = require('../../../api/processors/fire-resistance/orchestrator');
const ProjectModel = require('../../../api/models/project-model');

describe('Fire Resistance Processor', () => {
  describe('getBaseFireResistanceRatings', () => {
    test('should get correct ratings for SM unsprinklered', () => {
      const result = getBaseFireResistanceRatings('SM', false);
      expect(result.life).toBe(60);
      expect(result.property).toBe(60);
      expect(result.lifeNote).toBeNull();
      expect(result.propertyNote).toBeNull();
    });

    test('should get correct ratings for SM sprinklered', () => {
      const result = getBaseFireResistanceRatings('SM', true);
      expect(result.life).toBe(30);
      expect(result.property).toBe(30);
    });

    test('should get correct ratings for CA unsprinklered', () => {
      const result = getBaseFireResistanceRatings('CA', false);
      expect(result.life).toBe(60);
      expect(result.property).toBe(120);
    });

    test('should get correct ratings for WB unsprinklered', () => {
      const result = getBaseFireResistanceRatings('WB', false);
      expect(result.life).toBe(60);
      expect(result.property).toBe(120);
      expect(result.lifeNote).toBe('1');
      expect(result.propertyNote).toBe('2');
    });

    test('should handle SI which requires sprinklers', () => {
      expect(() => getBaseFireResistanceRatings('SI', false)).toThrow('Risk group SI must be sprinklered');
    });

    test('should handle WS which requires sprinklers', () => {
      expect(() => getBaseFireResistanceRatings('WS', false)).toThrow('Risk group WS must be sprinklered');
    });

    test('should throw error for invalid risk group', () => {
      expect(() => getBaseFireResistanceRatings('INVALID', false)).toThrow('Invalid risk group');
    });
  });

  describe('applyEscapeHeightModification', () => {
    const baseRatings = { life: 60, property: 120 };

    test('should not modify ratings when escape height <= 10m', () => {
      const result = applyEscapeHeightModification(baseRatings, 8);
      expect(result.exitwayFRR).toBeUndefined();
      expect(result.exitwayNote).toBeUndefined();
    });

    test('should add exitway requirements when escape height > 10m', () => {
      const result = applyEscapeHeightModification(baseRatings, 15);
      expect(result.exitwayFRR).toBe(120);
      expect(result.exitwayNote).toBe('Exitways require property rating due to escape height > 10m');
    });

    test('should handle missing escape height as 0', () => {
      const result = applyEscapeHeightModification(baseRatings, undefined);
      expect(result.exitwayFRR).toBeUndefined();
    });

    test('should handle invalid escape height as 0', () => {
      const result = applyEscapeHeightModification(baseRatings, NaN);
      expect(result.exitwayFRR).toBeUndefined();
    });
  });

  describe('applyBoundaryStorageModification', () => {
    const baseRatings = { life: 60, property: 90 };

    test('should not modify non-WB risk groups', () => {
      const result = applyBoundaryStorageModification(baseRatings, 'CA', false, 4, false);
      expect(result.property).toBe(90);
      expect(result.propertyAlt).toBeUndefined();
    });

    test('should not modify when boundary >= 15m', () => {
      const result = applyBoundaryStorageModification(baseRatings, 'WB', true, 4, false);
      expect(result.property).toBe(90);
    });

    test('should not modify when storage <= 3m', () => {
      const result = applyBoundaryStorageModification(baseRatings, 'WB', false, 2, false);
      expect(result.property).toBe(90);
    });

    test('should apply Note 2 when WB, boundary < 15m, storage > 3m, unsprinklered', () => {
      const result = applyBoundaryStorageModification(baseRatings, 'WB', false, 4, false);
      expect(result.property).toBe(180);
      expect(result.propertyAlt).toBe(180);
    });

    test('should apply Note 2 when WB, boundary < 15m, storage > 3m, sprinklered', () => {
      const result = applyBoundaryStorageModification(baseRatings, 'WB', false, 4, true);
      expect(result.property).toBe(90);
      expect(result.propertyAlt).toBe(90);
    });

    test('should handle missing storage height as 0', () => {
      const result = applyBoundaryStorageModification(baseRatings, 'WB', false, undefined, false);
      expect(result.property).toBe(90);
    });
  });

  describe('applyVentilationSubstitution', () => {
    const baseRatings = { life: 30, property: 60 };

    test('should not modify non-VP risk groups', () => {
      const result = applyVentilationSubstitution(baseRatings, 'CA', true);
      expect(result.ventilationSubstitution).toBeUndefined();
    });

    test('should add ventilation info for VP with cross ventilation', () => {
      const result = applyVentilationSubstitution(baseRatings, 'VP', true);
      expect(result.ventilationSubstitution).toBe(true);
      expect(result.ventilationNote).toBe('Cross ventilation can substitute for sprinkler system');
    });

    test('should not add ventilation info when no cross ventilation', () => {
      const result = applyVentilationSubstitution(baseRatings, 'VP', false);
      expect(result.ventilationSubstitution).toBeUndefined();
    });
  });

  describe('getApplicableNotes', () => {
    test('should return Note 1 for CA with escape height > 10m', () => {
      const notes = getApplicableNotes('CA', 15, true, 2);
      expect(notes).toContain('1');
    });

    test('should return Note 2 for WB with boundary < 15m and storage > 3m', () => {
      const notes = getApplicableNotes('WB', 8, false, 4);
      expect(notes).toContain('2');
    });

    test('should return Note 3 for VP', () => {
      const notes = getApplicableNotes('VP', 8, true, 0);
      expect(notes).toContain('3');
    });

    test('should return multiple notes when conditions overlap', () => {
      const notes = getApplicableNotes('WB', 15, false, 4);
      expect(notes).toContain('1');
      expect(notes).toContain('2');
    });

    test('should return empty array when no notes apply', () => {
      const notes = getApplicableNotes('SM', 8, true, 2);
      expect(notes).toEqual([]);
    });
  });

  describe('calculateEffectiveFireResistanceRatings', () => {
    test('should calculate basic ratings for SM unsprinklered', () => {
      const result = calculateEffectiveFireResistanceRatings({
        riskGroup: 'SM',
        isSprinklered: false,
        escapeHeight: 8
      });

      expect(result.life).toBe(60);
      expect(result.property).toBe(60);
      expect(result.exitwayFRR).toBeUndefined();
      expect(result.applicableNotes).toEqual([]);
    });

    test('should apply escape height modification for CA', () => {
      const result = calculateEffectiveFireResistanceRatings({
        riskGroup: 'CA',
        isSprinklered: false,
        escapeHeight: 15
      });

      expect(result.life).toBe(60);
      expect(result.property).toBe(120);
      expect(result.exitwayFRR).toBe(120);
      expect(result.exitwayNote).toBe('Exitways require property rating due to escape height > 10m');
      expect(result.applicableNotes).toContain('1');
    });

    test('should apply boundary/storage modification for WB', () => {
      const result = calculateEffectiveFireResistanceRatings({
        riskGroup: 'WB',
        wbActivityType: 'storage',
        isSprinklered: false,
        escapeHeight: 8,
        distanceFromBoundary15mOrMore: false,
        maxStorageHeight: 4
      });

      expect(result.life).toBe(60);
      expect(result.property).toBe(180);
      expect(result.applicableNotes).toContain('2');
    });

    test('should apply ventilation substitution for VP', () => {
      const result = calculateEffectiveFireResistanceRatings({
        riskGroup: 'VP',
        isSprinklered: false,
        escapeHeight: 8,
        hasCrossVentilation: true
      });

      expect(result.ventilationSubstitution).toBe(true);
      expect(result.ventilationNote).toBe('Cross ventilation can substitute for sprinkler system');
      expect(result.applicableNotes).toContain('3');
    });

    test('should handle complex scenario with multiple modifications', () => {
      const result = calculateEffectiveFireResistanceRatings({
        riskGroup: 'WB',
        wbActivityType: 'storage',
        isSprinklered: false,
        escapeHeight: 15,
        distanceFromBoundary15mOrMore: false,
        maxStorageHeight: 4
      });

      expect(result.life).toBe(60);
      expect(result.property).toBe(180); // Note 2 applied
      expect(result.exitwayFRR).toBe(180); // Uses modified property rating
      expect(result.applicableNotes).toEqual(['1', '2']);
    });
  });

  describe('Integration with ProjectModel', () => {
    let projectModel;

    beforeEach(() => {
      projectModel = new ProjectModel();
      projectModel.addFirecell({
        riskGroup: 'CA',
        occupantType: 'Dining, restaurant and cafeteria spaces',
        // occupantLoad removed - will be calculated as 1000/2.5 = 400
        escapeHeight: 8,
        isSprinklered: false,
        floorArea: 1000,
        floor: 'G'
      });
    });

    test('should process fire resistance for project with single firecell', () => {
      const result = processFireResistance(projectModel);

      expect(result.fireResistanceCalculations.life).toBe(60);
      expect(result.fireResistanceCalculations.property).toBe(120);
      expect(result).toBe(projectModel); // Should return same project model
    });

    test('should add fire resistance calculations to project model', () => {
      const result = processFireResistance(projectModel);

      expect(result.fireResistanceCalculations).toBeDefined();
      expect(result.fireResistanceCalculations.life).toBeDefined();
      expect(result.fireResistanceCalculations.property).toBeDefined();
    });

    test('should handle project with escape height > 10m', () => {
      // Add a firecell with escape height > 10m to trigger Note 1
      projectModel.addFirecell({
        riskGroup: 'WB',
        wbActivityType: 'professional',
        occupantType: 'Office spaces',
        escapeHeight: 15, // > 10m triggers exitway FRR requirement
        isSprinklered: false,
        floorArea: 500,
        floor: '3'
      });

      const result = processFireResistance(projectModel);

      // Project-level summary should include exitway FRR from the tall firecell
      expect(result.fireResistanceCalculations.exitwayFRR).toBe(120);
      expect(result.fireResistanceCalculations.applicableNotes).toContain('1');

      // Verify the specific firecell has exitwayFRR set
      expect(result.firecells[1].fireResistanceRatings.exitwayFRR).toBe(120);
    });
  });

  describe('Per-Firecell FRR Calculation', () => {
    test('should calculate FRR per-firecell with different boundary distances', () => {
      const projectModel = new ProjectModel();

      // FC1: Close to boundary, tall storage → Note 2 applies
      projectModel.addFirecell({
        riskGroup: 'WB',
        wbActivityType: 'storage',
        occupantType: 'Office spaces',
        escapeHeight: 5,
        isSprinklered: false,
        floorArea: 1000,
        floor: 'G',
        distanceFromBoundary15mOrMore: false, // <15m
        maxStorageHeight: 4 // >3m
      });

      // FC2: Far from boundary → Note 2 does NOT apply
      projectModel.addFirecell({
        riskGroup: 'WB',
        wbActivityType: 'storage',
        occupantType: 'Office spaces',
        escapeHeight: 5,
        isSprinklered: false,
        floorArea: 1000,
        floor: '1',
        distanceFromBoundary15mOrMore: true, // ≥15m
        maxStorageHeight: 4 // >3m
      });

      const result = processFireResistance(projectModel);

      // FC1: <15m AND >3m → Note 2 applies → 180 min
      expect(result.firecells[0].fireResistanceRatings.property).toBe(180);
      expect(result.firecells[0].fireResistanceRatings.applicableNotes).toContain('2');

      // FC2: ≥15m → Note 2 does NOT apply → 120 min
      expect(result.firecells[1].fireResistanceRatings.property).toBe(120);
      expect(result.firecells[1].fireResistanceRatings.applicableNotes).not.toContain('2');
    });

    test('should store FRR on each firecell individually', () => {
      const projectModel = new ProjectModel();

      projectModel.addFirecell({
        riskGroup: 'CA',
        occupantType: 'Office spaces',
        escapeHeight: 5,
        isSprinklered: false,
        floorArea: 1000,
        floor: 'G'
      });

      projectModel.addFirecell({
        riskGroup: 'SM',
        sleepingOccupantType: 'permanent',
        occupantLoad: 20,
        escapeHeight: 3,
        isSprinklered: true,
        floorArea: 500,
        floor: '1'
      });

      const result = processFireResistance(projectModel);

      // Both firecells should have their own FRR
      expect(result.firecells[0].fireResistanceRatings).toBeDefined();
      expect(result.firecells[0].fireResistanceRatings.life).toBe(60);
      expect(result.firecells[0].fireResistanceRatings.property).toBe(120);

      expect(result.firecells[1].fireResistanceRatings).toBeDefined();
      expect(result.firecells[1].fireResistanceRatings.life).toBe(30);
      expect(result.firecells[1].fireResistanceRatings.property).toBe(30);
    });

    test('should calculate project-level summary using most onerous ratings', () => {
      const projectModel = new ProjectModel();

      // FC1: Lower FRR
      projectModel.addFirecell({
        riskGroup: 'SM',
        sleepingOccupantType: 'permanent',
        occupantLoad: 20,
        escapeHeight: 3,
        isSprinklered: true,
        floorArea: 500,
        floor: 'G'
      });

      // FC2: Higher FRR
      projectModel.addFirecell({
        riskGroup: 'CA',
        occupantType: 'Office spaces',
        escapeHeight: 5,
        isSprinklered: false,
        floorArea: 1000,
        floor: '1'
      });

      const result = processFireResistance(projectModel);

      // Project-level summary should use max values
      expect(result.fireResistanceCalculations.life).toBe(60);
      expect(result.fireResistanceCalculations.property).toBe(120);
      expect(result.fireResistanceCalculations.summary).toContain('2 firecell');
    });

    test('should handle multi-firecell with different escape heights', () => {
      const projectModel = new ProjectModel();

      // FC1: Low escape height
      projectModel.addFirecell({
        riskGroup: 'WB',
        wbActivityType: 'professional',
        occupantType: 'Office spaces',
        escapeHeight: 5,
        isSprinklered: false,
        floorArea: 1000,
        floor: 'G'
      });

      // FC2: High escape height (triggers Note 1)
      projectModel.addFirecell({
        riskGroup: 'WB',
        wbActivityType: 'professional',
        occupantType: 'Office spaces',
        escapeHeight: 15,
        isSprinklered: false,
        floorArea: 1000,
        floor: '3'
      });

      const result = processFireResistance(projectModel);

      // FC1: No exitway FRR
      expect(result.firecells[0].fireResistanceRatings.exitwayFRR).toBeUndefined();

      // FC2: Has exitway FRR due to escape height > 10m
      expect(result.firecells[1].fireResistanceRatings.exitwayFRR).toBe(120);
      expect(result.firecells[1].fireResistanceRatings.applicableNotes).toContain('1');
    });

    test('should handle empty firecells array', () => {
      const projectModel = new ProjectModel();

      const result = processFireResistance(projectModel);

      expect(result.fireResistanceCalculations).toBeNull();
    });
  });
});