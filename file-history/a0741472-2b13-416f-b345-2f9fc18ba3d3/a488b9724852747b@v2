const { processPipeline } = require('../../api/pipeline');
const ProjectModel = require('../../api/models/project-model');

describe('Pipeline', () => {
  describe('processPipeline', () => {
    test('should call buildReport and populate reportParagraphs', () => {
      const projectModel = new ProjectModel();
      projectModel.addFirecell({
        riskGroup: 'SM',
        sleepingOccupantType: 'permanent',
        occupantLoad: 10, // Keep for SM (bed spaces)
        escapeHeight: 5,
        isSprinklered: false,
        floorArea: 100,
        floor: 'G',
        numberOfEscapeRoutes: 1,
        maxEscapeRouteBeds: 10
      });

      const result = processPipeline(projectModel, 'fire-report');

      expect(result.reportParagraphs).toBeDefined();
      expect(Array.isArray(result.reportParagraphs)).toBe(true);
    });

    test('should accept documentType parameter', () => {
      const projectModel = new ProjectModel();
      projectModel.addFirecell({
        riskGroup: 'WB',
        wbActivityType: 'professional',
        occupantType: 'Office spaces',
        // occupantLoad removed - will be calculated as 100/10 = 10
        escapeHeight: 5,
        isSprinklered: false,
        floorArea: 100,
        floor: 'G',
        numberOfEscapeRoutes: 1,
        maxEscapeRouteOccupants: 10
      });

      const result = processPipeline(projectModel, 'fire-report');

      expect(result).toBeDefined();
      expect(result.reportParagraphs).toBeDefined();
    });

    test('should still perform all calculations', () => {
      const projectModel = new ProjectModel();
      projectModel.addFirecell({
        riskGroup: 'SM',
        sleepingOccupantType: 'permanent',
        occupantLoad: 10, // Keep for SM (bed spaces)
        escapeHeight: 5,
        isSprinklered: false,
        floorArea: 100,
        floor: 'G',
        numberOfEscapeRoutes: 1,
        maxEscapeRouteBeds: 10
      });

      const result = processPipeline(projectModel, 'fire-report');

      // Verify calculations were performed (firecells should have compliance data)
      expect(result.firecells).toBeDefined();
      expect(result.firecells.length).toBeGreaterThan(0);
      expect(result.firecells[0].compliance).toBeDefined();
    });

    test('should work without documentType (backward compatibility)', () => {
      const projectModel = new ProjectModel();
      projectModel.addFirecell({
        riskGroup: 'WB',
        wbActivityType: 'professional',
        occupantType: 'Office spaces',
        // occupantLoad removed - will be calculated as 100/10 = 10
        escapeHeight: 5,
        isSprinklered: false,
        floorArea: 100,
        floor: 'G',
        numberOfEscapeRoutes: 1,
        maxEscapeRouteOccupants: 10
      });

      const result = processPipeline(projectModel);

      // Should still work and add reportParagraphs
      expect(result).toBeDefined();
      expect(result.reportParagraphs).toBeDefined();
    });
  });
});