    </div>

    <div class="sm-si-only" style="display: none;">
      <label>Bed Spaces:</label>
      <input class="bed-spaces-input" type="number" name="firecells[${index}][occupantLoad]" min="0" step="1" title="Number of beds (accounts for staff and visitors per CAS2 1.4.5)" placeholder="e.g., 10 beds">
