  const floorsAbove = parseInt(document.getElementById('numberOfFloorsAboveGround').value) || 1;
  const basements = parseInt(document.getElementById('numberOfBasementLevels').value) || 0;
  const floors = getFloorOptions(floorsAbove, basements);
  const newFloorSelect = firecellDiv.querySelector('.firecell-floor');
  if (newFloorSelect) {
    floors.forEach(floor => {
      const option = document.createElement('option');
      option.value = floor;
      option.textContent = `${floor} (${getFloorLabel(floor)})`;
      newFloorSelect.appendChild(option);
    });
  }

  // Add event listener to the new risk group select
  const newRiskGroupSelect = firecellDiv.querySelector('select[name*="riskGroup"]');
  newRiskGroupSelect.addEventListener('change', function() {
    toggleConditionalFields(this);
  });

  // Initialize occupant load label for new firecell (defaults to "Occupant Load")
  updateOccupantLoadLabel(firecellDiv, '');

  // Initialize occupant load field visibility for new firecell
  updateOccupantLoadFields(firecellDiv, '');

  // Add event listeners for early childhood fields
  const earlyChildhoodToggle = firecellDiv.querySelector('.early-childhood-toggle');
  if (earlyChildhoodToggle) {
    earlyChildhoodToggle.addEventListener('change', function() {
      toggleEarlyChildhoodFields(firecellDiv);
    });
  }

  const escapeHeightInput = firecellDiv.querySelector('input[name*="escapeHeight"]');
  if (escapeHeightInput) {
    escapeHeightInput.addEventListener('change', function() {
      toggleEarlyChildhoodFields(firecellDiv);
    });
  }

  const sleepingAreasToggle = firecellDiv.querySelector('.sleeping-areas-toggle');
  if (sleepingAreasToggle) {
    sleepingAreasToggle.addEventListener('change', function() {
      toggleSleepingAreaFields(firecellDiv);
    });
  }

  // NEW: Add event listener for sleeping occupant type (NZS 4515 visibility)
  const sleepingOccupantTypeSelect = firecellDiv.querySelector('select[name*="sleepingOccupantType"]');
  if (sleepingOccupantTypeSelect) {
    sleepingOccupantTypeSelect.addEventListener('change', function() {
      toggleNZS4515Option(firecellDiv);
    });
  }

  // NEW: Setup NZS 4515 scope listeners for new firecell
  setupNZS4515ScopeListeners();

  // Add event listener to the remove button
  const removeButton = firecellDiv.querySelector('.remove-firecell');
  removeButton.addEventListener('click', function() {
    removeFirecell(this.getAttribute('data-index'));
  });

  firecellCount++;
  updateRemoveButtons();
}

function removeFirecell(index) {
  const firecell = document.querySelector(`[data-index="${index}"]`);
  if (firecell) {
    firecell.remove();
    updateRemoveButtons();
    updateFirecellTitles();
  }
}

function updateRemoveButtons() {
  const firecells = document.querySelectorAll('.firecell-item');
  const removeButtons = document.querySelectorAll('.remove-firecell');

  removeButtons.forEach(button => {
    button.style.display = firecells.length > 1 ? 'inline-block' : 'none';
  });
}

function updateFirecellTitles() {
  const firecells = document.querySelectorAll('.firecell-item');
  firecells.forEach((firecell, index) => {
    const title = firecell.querySelector('h3');
    if (title) {
      title.textContent = `Firecell ${index + 1}`;
    }
  });
}

// NEW: Toggle NZS 4515 option visibility based on occupant type
function toggleNZS4515Option(firecellDiv) {
  const nzs4515Div = firecellDiv.querySelector('.nzs-4515-option');
  const riskGroupSelect = firecellDiv.querySelector('[name*="[riskGroup]"]');
  const sleepingOccupantTypeSelect = firecellDiv.querySelector('[name*="[sleepingOccupantType]"]');

  if (!nzs4515Div || !riskGroupSelect) return;

  const riskGroup = riskGroupSelect.value;
  const occupantType = sleepingOccupantTypeSelect ? sleepingOccupantTypeSelect.value : '';

  // Show NZS 4515 option for SM education and SI (all types)
  const eligible =
    (riskGroup === 'SM' && occupantType === 'education') ||
    (riskGroup === 'SI' && occupantType);

  if (eligible) {
    nzs4515Div.style.display = 'block';
  } else {
    nzs4515Div.style.display = 'none';
    // Reset selections if hidden
    const scopeSelect = nzs4515Div.querySelector('.nzs-4515-scope-select');
    if (scopeSelect) scopeSelect.value = '';
    const choiceDiv = nzs4515Div.querySelector('.nzs-4515-substitution-choice');
    if (choiceDiv) choiceDiv.style.display = 'none';
  }
}

// NEW: Toggle NZS 4515 substitution choice based on scope
function setupNZS4515ScopeListeners() {
  document.querySelectorAll('.nzs-4515-scope-select').forEach(select => {
    // Remove existing listeners (if any)
    const newSelect = select.cloneNode(true);
    select.parentNode.replaceChild(newSelect, select);

    newSelect.addEventListener('change', function() {
      const firecellDiv = this.closest('.firecell-item');
      if (!firecellDiv) return;

      const choiceDiv = firecellDiv.querySelector('.nzs-4515-substitution-choice');

      if (this.value === 'true') {
        choiceDiv.style.display = 'block';
      } else {
        choiceDiv.style.display = 'none';
        // Uncheck the substitution checkbox if scope is exceeded
        const checkbox = choiceDiv.querySelector('input[type="checkbox"]');
        if (checkbox) checkbox.checked = false;
      }
    });
  });
}

function toggleConditionalFields(selectElement) {
  const firecell = selectElement.closest('.firecell-item');
  const vpFields = firecell.querySelector('.vp-only');
  const caFields = firecell.querySelector('.ca-only');

  // Get escape route and occupant type fields
  const sleepingOccupantType = firecell.querySelector('.sleeping-occupant-type');
  const otherOccupantType = firecell.querySelector('.other-occupant-type');
  const smSiRouteDistribution = firecell.querySelector('.sm-si-route-distribution');
  const otherRouteDistribution = firecell.querySelector('.other-route-distribution');

  // Hide all conditional fields first
  if (vpFields) vpFields.style.display = 'none';
  if (caFields) caFields.style.display = 'none';
  if (sleepingOccupantType) sleepingOccupantType.style.display = 'none';
  if (otherOccupantType) otherOccupantType.style.display = 'none';
  if (smSiRouteDistribution) smSiRouteDistribution.style.display = 'none';
  if (otherRouteDistribution) otherRouteDistribution.style.display = 'none';

  // Show relevant fields based on risk group
  if (selectElement.value === 'VP' && vpFields) {
    vpFields.style.display = 'block';
  } else if (selectElement.value === 'CA' && caFields) {
    caFields.style.display = 'block';
  }

  // Show relevant occupant type dropdown and escape route distribution fields
  if (selectElement.value === 'SM' || selectElement.value === 'SI') {
    // SM/SI: Show sleeping occupant type and beds per route
    if (sleepingOccupantType) sleepingOccupantType.style.display = 'block';
    if (smSiRouteDistribution) smSiRouteDistribution.style.display = 'block';

    // Make maxEscapeRouteBeds required, maxEscapeRouteOccupants not required
    const bedsInput = firecell.querySelector('input[name*="[maxEscapeRouteBeds]"]');
    const occupantsInput = firecell.querySelector('input[name*="[maxEscapeRouteOccupants]"]');
    if (bedsInput) bedsInput.required = true;
    if (occupantsInput) occupantsInput.required = false;

    // Make sleepingOccupantType select required
    const sleepingSelect = sleepingOccupantType?.querySelector('select');
    if (sleepingSelect) sleepingSelect.required = true;

    // Make occupantType select not required for SM/SI
    const occupantSelect = otherOccupantType?.querySelector('select');
    if (occupantSelect) occupantSelect.required = false;
  } else if (['CA', 'WB', 'WS', 'VP'].includes(selectElement.value)) {
    // CA/WB/WS/VP: Show occupant density dropdown and occupants per route
    if (otherOccupantType) otherOccupantType.style.display = 'block';
    if (otherRouteDistribution) otherRouteDistribution.style.display = 'block';

    // Make maxEscapeRouteOccupants required, maxEscapeRouteBeds not required
    const bedsInput = firecell.querySelector('input[name*="[maxEscapeRouteBeds]"]');
    const occupantsInput = firecell.querySelector('input[name*="[maxEscapeRouteOccupants]"]');
    if (bedsInput) bedsInput.required = false;
    if (occupantsInput) occupantsInput.required = true;

    // Make occupantType select required
    const occupantSelect = otherOccupantType?.querySelector('select');
    if (occupantSelect) occupantSelect.required = true;

    // Make sleepingOccupantType select not required
    const sleepingSelect = sleepingOccupantType?.querySelector('select');
    if (sleepingSelect) sleepingSelect.required = false;
  }

  // Update occupant load label based on risk group (SM/SI use "Bed Spaces")
  updateOccupantLoadLabel(firecell, selectElement.value);

  // Update occupant load field visibility (hide input for CA/WB/WS/VP)
  updateOccupantLoadFields(firecell, selectElement.value);

  // Update required routes hint and distribution suggestion
  updateRequiredRoutesHint(firecell);
  updateRouteDistributionHint(firecell);

  // NEW: Update NZS 4515 option visibility
  toggleNZS4515Option(firecell);
}

function toggleEarlyChildhoodFields(firecell) {
  const earlyChildhoodSelect = firecell.querySelector('.early-childhood-toggle');
  const escapeHeightInput = firecell.querySelector('input[name*="escapeHeight"]');
  const lowHeightSection = firecell.querySelector('.early-childhood-low-height');
  const highHeightSection = firecell.querySelector('.early-childhood-high-height');

  if (!earlyChildhoodSelect || !lowHeightSection || !highHeightSection) {
    return; // Elements not found (may not be CA risk group)
  }

  const isEarlyChildhood = earlyChildhoodSelect.value === 'true';
  const escapeHeight = parseFloat(escapeHeightInput?.value || 0);

  // Hide both sections by default
  lowHeightSection.style.display = 'none';
  highHeightSection.style.display = 'none';

  if (isEarlyChildhood) {
    if (escapeHeight <= 2.0) {
      // Condition (a): Show low height section
      lowHeightSection.style.display = 'block';
      // Clear high height fields
      clearEarlyChildhoodFields(highHeightSection);
    } else {
      // Condition (b): Show high height section
      highHeightSection.style.display = 'block';
      // Clear low height fields
      clearEarlyChildhoodFields(lowHeightSection);
    }
  } else {
    // Not an early childhood centre - clear all fields
    clearEarlyChildhoodFields(lowHeightSection);
    clearEarlyChildhoodFields(highHeightSection);
  }
}

function clearEarlyChildhoodFields(section) {
  if (!section) return;
  const selects = section.querySelectorAll('select');
  selects.forEach(select => {
    select.value = '';
  });
}

function toggleSleepingAreaFields(firecell) {
  const sleepingAreasSelect = firecell.querySelector('.sleeping-areas-toggle');
  const sleepingAreaFields = firecell.querySelector('.sleeping-area-fields');

  if (!sleepingAreasSelect || !sleepingAreaFields) {
    return;
  }

  if (sleepingAreasSelect.value === 'true') {
    sleepingAreaFields.style.display = 'block';
  } else {
    sleepingAreaFields.style.display = 'none';
    // Clear the smoke detector compliance field
    const complianceSelect = sleepingAreaFields.querySelector('select[name*="supplementarySmokeDetectorsCompliant"]');
    if (complianceSelect) {
      complianceSelect.value = '';
    }
  }
}

function fillTestData() {
  // Remove all firecells except the first one
  const allFirecells = document.querySelectorAll('.firecell-item');
  for (let i = allFirecells.length - 1; i > 0; i--) {
    const firecell = allFirecells[i];
    firecell.remove();
  }

  // Reset the firecell counter
  firecellCount = 1;

  updateRemoveButtons();
  updateFirecellTitles();

  // Fill project-level fields (from scripts/pipeline-test.js)
  document.getElementById('hasRemoteReceivingCentreConnection').value = 'false';
  document.getElementById('storesHazardousGoods').value = 'false';
  document.getElementById('confirmedNoComplexFeatures').checked = true; // C/AS2 scope confirmation

  // Fill building vertical structure (2 floors: ground and 1st floor)
  document.getElementById('numberOfFloorsAboveGround').value = '1';
  document.getElementById('numberOfBasementLevels').value = '0';
  updateFloorPreview();

  // Fill first firecell - ground floor CA office
  const firstFirecell = document.querySelector('.firecell-item');
  if (firstFirecell) {
    // Risk group
    const riskGroupSelect = firstFirecell.querySelector('select[name*="riskGroup"]');
    riskGroupSelect.value = 'CA';
    toggleConditionalFields(riskGroupSelect); // Show CA conditional fields

    // Occupant type
    const occupantTypeSelect = firstFirecell.querySelector('select[name*="occupantType"]');
    occupantTypeSelect.value = 'Office spaces';

    // Occupant load - REMOVED: Will be calculated automatically for CA risk group
    // Per CAS2 Section 1.4.2, occupant load is calculated from floor area (400m²) and
    // activity type (Office spaces @ 10 m²/person) = 400/10 = 40 people

    // Escape height - ground floor
    const escapeHeightInput = firstFirecell.querySelector('input[name*="escapeHeight"]');
    escapeHeightInput.value = 0;

    // Is sprinklered
    const isSprinkleredSelect = firstFirecell.querySelector('select[name*="isSprinklered"]');
    isSprinkleredSelect.value = 'false';

    // Floor area
    const floorAreaInput = firstFirecell.querySelector('input[name*="floorArea"]');
    floorAreaInput.value = 400;

    // Floor - ground floor
    const floorSelect = firstFirecell.querySelector('.firecell-floor');
    if (floorSelect) {
      floorSelect.value = 'G';
    }

    // CA-specific field (is cinema or theatre) - set to No
    const isCinemaSelect = firstFirecell.querySelector('select[name*="isCinemaOrTheatre"]');
    if (isCinemaSelect) {
      isCinemaSelect.value = 'false';
    }

    // CA-specific field (is early childhood centre) - set to No
    const isEarlyChildhoodSelect = firstFirecell.querySelector('.early-childhood-toggle');
    if (isEarlyChildhoodSelect) {
      isEarlyChildhoodSelect.value = 'false';
    }

    // NEW: Escape route configuration
    const routeCountInput = firstFirecell.querySelector('input[name*="numberOfEscapeRoutes"]');
    if (routeCountInput) {
      routeCountInput.value = 2; // 2 escape routes for CA
    }

    const maxOccupantsInput = firstFirecell.querySelector('input[name*="maxEscapeRouteOccupants"]');
    if (maxOccupantsInput) {
      maxOccupantsInput.value = 20; // 40 total / 2 routes = 20 per route
    }
  }

  // Add second firecell - upstairs SM residential
  addFirecell();

  // Wait for DOM to update, then fill the second firecell
  setTimeout(() => {
    const allFirecells = document.querySelectorAll('.firecell-item');
    const secondFirecell = allFirecells[1];

    if (secondFirecell) {
      // Risk group
      const riskGroupSelect = secondFirecell.querySelector('select[name*="riskGroup"]');
      riskGroupSelect.value = 'SM';
      toggleConditionalFields(riskGroupSelect);

      // Sleeping occupant type (NEW)
      const sleepingOccupantTypeSelect = secondFirecell.querySelector('select[name*="sleepingOccupantType"]');
      if (sleepingOccupantTypeSelect) {
        sleepingOccupantTypeSelect.value = 'permanent';
      }

      // Occupant load (bed spaces for SM risk group)
      const occupantLoadInput = secondFirecell.querySelector('input[name*="occupantLoad"]');
      if (occupantLoadInput) {
        occupantLoadInput.value = 10; // 10 beds (e.g., 10-bed hostel/boarding house)
      }

      // Escape height - upstairs
      const escapeHeightInput = secondFirecell.querySelector('input[name*="escapeHeight"]');
      if (escapeHeightInput) {
        escapeHeightInput.value = 4;
      }

      // Is sprinklered
      const isSprinkleredSelect = secondFirecell.querySelector('select[name*="isSprinklered"]');
      if (isSprinkleredSelect) {
        isSprinkleredSelect.value = 'false';
      }

      // Floor area
      const floorAreaInput = secondFirecell.querySelector('input[name*="floorArea"]');
      if (floorAreaInput) {
        floorAreaInput.value = 200;
      }

      // Floor - upstairs (1st floor)
      const floorSelect = secondFirecell.querySelector('.firecell-floor');
      if (floorSelect) {
        floorSelect.value = '1';
      }

      // NEW: Escape route configuration
      const routeCountInput = secondFirecell.querySelector('input[name*="numberOfEscapeRoutes"]');
      if (routeCountInput) {
        routeCountInput.value = 1;
      }

      const maxBedsInput = secondFirecell.querySelector('input[name*="maxEscapeRouteBeds"]');
      if (maxBedsInput) {
        maxBedsInput.value = 10; // All 10 beds on one route
      }
    }
  }, 100);
}

document.addEventListener('DOMContentLoaded', function() {
  // Initialize the form
  updateRemoveButtons();

  // Initialize floor options on page load
  updateFloorPreview();

  // Add event listeners for floor configuration changes
  const floorsAboveInput = document.getElementById('numberOfFloorsAboveGround');
  const basementsInput = document.getElementById('numberOfBasementLevels');

  if (floorsAboveInput) {
    floorsAboveInput.addEventListener('change', updateFloorPreview);
    floorsAboveInput.addEventListener('input', updateFloorPreview);
  }

  if (basementsInput) {
    basementsInput.addEventListener('change', updateFloorPreview);
    basementsInput.addEventListener('input', updateFloorPreview);
  }

  // Add event listener to the add button
  const addButton = document.getElementById('addFirecell');
  if (addButton) {
    addButton.addEventListener('click', addFirecell);
  }

  // Add event listener to fill test data button
  const fillTestDataButton = document.getElementById('fillTestData');
  if (fillTestDataButton) {
    fillTestDataButton.addEventListener('click', fillTestData);
  }

  // Add event listeners to existing risk group selects
  const existingSelects = document.querySelectorAll('select[name*="riskGroup"]');
  existingSelects.forEach(select => {
    select.addEventListener('change', function() {
      toggleConditionalFields(this);
    });

    // Initialize label for existing firecells based on current selection
    const firecell = select.closest('.firecell-item');
    if (firecell) {
      updateOccupantLoadLabel(firecell, select.value);

      // Initialize field visibility for existing firecells
      updateOccupantLoadFields(firecell, select.value);
    }
  });

  // Add event listeners to existing early childhood toggles
  const existingEarlyChildhoodToggles = document.querySelectorAll('.early-childhood-toggle');
  existingEarlyChildhoodToggles.forEach(toggle => {
    toggle.addEventListener('change', function() {
      const firecell = this.closest('.firecell-item');
      toggleEarlyChildhoodFields(firecell);
    });
  });

  // Add event listeners to existing escape height inputs
  const existingEscapeHeightInputs = document.querySelectorAll('input[name*="escapeHeight"]');
  existingEscapeHeightInputs.forEach(input => {
    input.addEventListener('change', function() {
      const firecell = this.closest('.firecell-item');
      toggleEarlyChildhoodFields(firecell);
    });
  });

  // Add event listeners to existing sleeping areas toggles
  const existingSleepingAreasToggles = document.querySelectorAll('.sleeping-areas-toggle');
  existingSleepingAreasToggles.forEach(toggle => {
    toggle.addEventListener('change', function() {
      const firecell = this.closest('.firecell-item');
      toggleSleepingAreaFields(firecell);
    });
  });

  // NEW: Add event listeners to sleeping occupant type selects (for NZS 4515 visibility)
  const existingSleepingOccupantTypeSelects = document.querySelectorAll('select[name*="sleepingOccupantType"]');
  existingSleepingOccupantTypeSelects.forEach(select => {
    select.addEventListener('change', function() {
      const firecell = this.closest('.firecell-item');
      toggleNZS4515Option(firecell);
    });
  });

  // NEW: Setup NZS 4515 scope listeners
  setupNZS4515ScopeListeners();

  // Add event listeners to existing remove buttons
  const existingRemoveButtons = document.querySelectorAll('.remove-firecell');
  existingRemoveButtons.forEach(button => {
    button.addEventListener('click', function() {
      const index = this.closest('.firecell-item').getAttribute('data-index');
      removeFirecell(index);
    });
  });

  // Add event listeners for dynamic hints
  document.addEventListener('input', (e) => {
    const firecell = e.target.closest('.firecell-item');
    if (!firecell) return;

    // Update hints when relevant fields change
    if (e.target.name?.includes('[occupantLoad]') ||
        e.target.name?.includes('[riskGroup]')) {
      updateRequiredRoutesHint(firecell);
      updateRouteDistributionHint(firecell);
    }

    if (e.target.classList.contains('route-count')) {
      updateRouteDistributionHint(firecell);
    }
  });
});

/**
 * Calculate and show required number of escape routes based on CAS2 Table 3.1
 */
function updateRequiredRoutesHint(firecell) {
  const riskGroup = firecell.querySelector('select[name*="[riskGroup]"]')?.value;
  const occupantLoad = parseInt(firecell.querySelector('input[name*="[occupantLoad]"]')?.value || 0);
  const minRoutesSpan = firecell.querySelector('.min-routes');

  if (riskGroup && occupantLoad > 0 && minRoutesSpan) {
    const requiredRoutes = getRequiredRouteCount(riskGroup, occupantLoad);
    minRoutesSpan.textContent = requiredRoutes;
    minRoutesSpan.parentElement.style.display = 'inline';
  } else if (minRoutesSpan) {
    minRoutesSpan.parentElement.style.display = 'none';
  }
}

/**
 * Get required route count from CAS2 Table 3.1
 * Simplified version - matches route-number-validator.js
 */
function getRequiredRouteCount(riskGroup, occupantLoad) {
  const ROUTE_REQUIREMENTS = {
    SM: [[50, 1], [100, 2], [150, 3], [200, 3], [250, 4], [300, 4]],
    SI: [[50, 2], [100, 3], [150, 3], [200, 4], [250, 4], [300, 4]],
    CA: [[50, 1], [100, 2], [150, 2], [200, 2], [250, 2], [300, 2], [500, 2], [1000, 3], [2000, 4], [4000, 5], [7000, 6]],
    WB: [[50, 1], [100, 2], [150, 2], [200, 2], [250, 2], [300, 2], [500, 2], [1000, 3], [2000, 4], [4000, 5], [7000, 6]],
    WS: [[50, 1], [100, 2], [150, 2], [200, 2], [250, 2], [300, 2], [500, 2], [1000, 3], [2000, 4], [4000, 5]],
    VP: [[50, 1], [100, 2], [150, 2], [200, 2], [250, 2], [300, 2], [500, 2], [1000, 3], [2000, 4], [4000, 5], [7000, 6]]
  };

  const requirements = ROUTE_REQUIREMENTS[riskGroup];
  if (!requirements) return 1;

  for (const [threshold, routes] of requirements) {
    if (occupantLoad <= threshold) {
      return routes;
    }
  }
  return 1;
}

/**
 * Suggest equal distribution of beds/occupants across routes
 */
function updateRouteDistributionHint(firecell) {
  const riskGroup = firecell.querySelector('select[name*="[riskGroup]"]')?.value;
  const occupantLoad = parseInt(firecell.querySelector('input[name*="[occupantLoad]"]')?.value || 0);
  const numberOfRoutes = parseInt(firecell.querySelector('.route-count')?.value || 1);

  if (occupantLoad > 0 && numberOfRoutes > 0) {
    const perRoute = Math.ceil(occupantLoad / numberOfRoutes);

    if (riskGroup === 'SM' || riskGroup === 'SI') {
      const maxBedsInput = firecell.querySelector('input[name*="[maxEscapeRouteBeds]"]');
      if (maxBedsInput && !maxBedsInput.value) {
        maxBedsInput.placeholder = `Suggested: ${perRoute} beds (equal distribution)`;
      }
    } else {
      const maxOccupantsInput = firecell.querySelector('input[name*="[maxEscapeRouteOccupants]"]');
      if (maxOccupantsInput && !maxOccupantsInput.value) {
        maxOccupantsInput.placeholder = `Suggested: ${perRoute} occupants (equal distribution)`;
      }
    }
  }
}