// Form functionality for dynamic firecell management
let firecellCount = 1;

// Floor options utilities (browser-compatible version)
function getFloorOptions(numberOfFloorsAboveGround = 1, numberOfBasementLevels = 0) {
  const floors = [];

  // Add basement levels (from deepest to shallowest)
  for (let i = numberOfBasementLevels; i >= 1; i--) {
    floors.push(`B${i}`);
  }

  // Add ground floor (always present)
  floors.push('G');

  // Add floors above ground
  for (let i = 1; i <= numberOfFloorsAboveGround; i++) {
    floors.push(String(i));
  }

  return floors;
}

function getFloorLabel(floor) {
  if (floor === 'G') {
    return 'Ground Floor';
  }

  if (floor.startsWith('B')) {
    const level = floor.substring(1);
    return `Basement Level ${level}`;
  }

  const floorNum = parseInt(floor);
  if (!isNaN(floorNum)) {
    const suffix = getOrdinalSuffix(floorNum);
    return `${floorNum}${suffix} Floor`;
  }

  return floor;
}

function getOrdinalSuffix(num) {
  const j = num % 10;
  const k = num % 100;

  if (j === 1 && k !== 11) return 'st';
  if (j === 2 && k !== 12) return 'nd';
  if (j === 3 && k !== 13) return 'rd';
  return 'th';
}

function updateFloorPreview() {
  const floorsAbove = parseInt(document.getElementById('numberOfFloorsAboveGround').value) || 0;
  const basements = parseInt(document.getElementById('numberOfBasementLevels').value) || 0;

  const floors = getFloorOptions(floorsAbove, basements);
  const preview = floors.map(f => `${f} (${getFloorLabel(f)})`).join(', ');

  const previewElement = document.getElementById('floorPreview');
  if (previewElement) {
    previewElement.textContent = preview;
  }

  // Update all firecell floor dropdowns
  updateAllFirecellFloorOptions(floors);
}

function updateAllFirecellFloorOptions(floors) {
  const floorSelects = document.querySelectorAll('.firecell-floor');

  floorSelects.forEach(select => {
    const currentValue = select.value;

    // Clear existing options except placeholder
    select.innerHTML = '<option value="">-- Select Floor --</option>';

    // Add floor options with labels
    floors.forEach(floor => {
      const option = document.createElement('option');
      option.value = floor;
      option.textContent = `${floor} (${getFloorLabel(floor)})`;

      if (floor === currentValue) {
        option.selected = true;
      }

      select.appendChild(option);
    });
  });
}

/**
 * Updates the Occupant Load label based on risk group
 * SM/SI risk groups use "Bed Spaces" per CAS2 Table 1.2
 * Other risk groups use "Occupant Load"
 *
 * @param {HTMLElement} firecellElement - The firecell container div
 * @param {string} riskGroup - The selected risk group (SM, SI, CA, WB, WS, VP, or empty string)
 */
function updateOccupantLoadLabel(firecellElement, riskGroup) {
  // Find the occupant load input
  const occupantLoadInput = firecellElement.querySelector('input[name*="occupantLoad"]');
  if (!occupantLoadInput) {
    // Input not found - this is OK (might not exist yet)
    return;
  }

  // Find the label - it's in the parent div
  const parentDiv = occupantLoadInput.closest('div');
  const label = parentDiv ? parentDiv.querySelector('label') : null;

  if (!label) {
    // Label not found - this shouldn't happen but handle gracefully
    return;
  }

  // Update label text and input attributes based on risk group
  if (riskGroup === 'SM' || riskGroup === 'SI') {
    // SM/SI: Use "Bed Spaces" per CAS2 Section 1.4.5 and Table 1.2
    label.textContent = 'Bed Spaces:';
    occupantLoadInput.setAttribute('title',
      'Number of beds (accounts for staff and visitors per CAS2 1.4.5)');
    occupantLoadInput.setAttribute('placeholder', 'e.g., 10 beds');
  } else {
    // CA/WB/WS/VP: Use standard "Occupant Load"
    label.textContent = 'Occupant Load:';
    occupantLoadInput.setAttribute('title', 'Number of occupants');
    occupantLoadInput.setAttribute('placeholder', 'e.g., 50 people');
  }
}

/**
 * Updates occupant load field visibility based on risk group
 * SM/SI: Shows manual "Bed Spaces" input
 * CA/WB/WS/VP: Hides bed spaces (occupant load calculated server-side)
 *
 * @param {HTMLElement} firecellElement - The firecell container
 * @param {string} riskGroup - Selected risk group
 */
function updateOccupantLoadFields(firecellElement, riskGroup) {
  const smSiFields = firecellElement.querySelector('.sm-si-only');

  if (!smSiFields) return;

  if (riskGroup === 'SM' || riskGroup === 'SI') {
    // Show bed spaces input
    smSiFields.style.display = 'block';

    // Make bed spaces input required
    const input = smSiFields.querySelector('input');
    if (input) input.required = true;
  } else if (['CA', 'WB', 'WS', 'VP'].includes(riskGroup)) {
    // Hide bed spaces (calculation happens server-side)
    smSiFields.style.display = 'none';

    // Remove required from bed spaces
    const input = smSiFields.querySelector('input');
    if (input) {
      input.required = false;
      input.value = ''; // Clear value
    }
  } else {
    // No risk group selected - hide bed spaces
    smSiFields.style.display = 'none';
  }
}

/**
 * Updates boundary distance field visibility based on risk group
 * Shows only for WB/VP firecells
 * @param {HTMLElement} firecellElement - The firecell container
 * @param {string} riskGroup - Selected risk group
 */
function updateBoundaryDistanceVisibility(firecellElement, riskGroup) {
  const boundaryDiv = firecellElement.querySelector('.wb-vp-boundary');

  if (!boundaryDiv) return;

  if (riskGroup === 'WB' || riskGroup === 'VP') {
    boundaryDiv.style.display = 'block';
    const select = boundaryDiv.querySelector('select');
    if (select) select.required = false; // Optional field
  } else {
    boundaryDiv.style.display = 'none';
    const select = boundaryDiv.querySelector('select');
    if (select) {
      select.required = false;
      select.value = ''; // Clear value when hidden
    }
  }
}

