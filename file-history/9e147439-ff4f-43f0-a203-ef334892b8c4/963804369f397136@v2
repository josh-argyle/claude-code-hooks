const { calculateEffectiveFireResistanceRatings } = require('./calculator');
const { generateComplianceParagraphs } = require('./compliance-generator');
const { generateRequirementsParagraphs } = require('./requirements-generator');

/**
 * Process fire resistance for all firecells in a project model
 * Calculates fire resistance ratings per-firecell and adds them to each firecell
 * Also calculates project-level summary using most onerous ratings
 * @param {ProjectModel} projectModel - The project model containing all firecells
 * @returns {ProjectModel} The same project model with fire resistance data added
 */
function processFireResistance(projectModel) {
  // Process each firecell individually
  if (!projectModel.firecells || projectModel.firecells.length === 0) {
    projectModel.fireResistanceCalculations = null;
    return projectModel;
  }

  projectModel.firecells.forEach((firecell, index) => {
    // Extract firecell-specific properties
    const riskGroup = firecell.riskGroup;
    const isSprinklered = firecell.isSprinklered;
    const escapeHeight = firecell.escapeHeight;
    const distanceFromBoundary15mOrMore = firecell.distanceFromBoundary15mOrMore || false;
    const maxStorageHeight = firecell.maxStorageHeight;
    const hasCrossVentilation = firecell.hasCrossVentilation;

    // Calculate fire resistance ratings for THIS firecell
    const calculations = calculateEffectiveFireResistanceRatings({
      riskGroup,
      isSprinklered,
      escapeHeight,
      distanceFromBoundary15mOrMore,
      maxStorageHeight,
      hasCrossVentilation
    });

    // Store per-firecell
    projectModel.firecells[index].fireResistanceRatings = calculations;
  });

  // Calculate project-level summary (for backward compatibility / shared elements)
  projectModel.fireResistanceCalculations = calculateProjectLevelSummary(projectModel.firecells);

  return projectModel;
}

/**
 * Calculate project-level summary using most onerous ratings
 * For shared walls/floors, use the higher rating from adjacent firecells
 * @param {Array} firecells - All firecells in the project
 * @returns {Object} Summary with max life/property ratings
 */
function calculateProjectLevelSummary(firecells) {
  if (!firecells || firecells.length === 0) return null;

  const maxLife = Math.max(...firecells.map(fc => fc.fireResistanceRatings?.life || 0));
  const maxProperty = Math.max(...firecells.map(fc => fc.fireResistanceRatings?.property || 0));

  // Collect all unique notes
  const allNotes = new Set();
  firecells.forEach(fc => {
    if (fc.fireResistanceRatings?.applicableNotes) {
      fc.fireResistanceRatings.applicableNotes.forEach(note => allNotes.add(note));
    }
  });

  // Check if any firecell has exitway FRR
  const exitwayFRRs = firecells
    .map(fc => fc.fireResistanceRatings?.exitwayFRR)
    .filter(frr => frr !== undefined && frr !== null);

  const summary = {
    life: maxLife,
    property: maxProperty,
    applicableNotes: Array.from(allNotes).sort(),
    summary: `Most onerous ratings from ${firecells.length} firecell(s)`
  };

  // Add exitway FRR if any firecell has it
  if (exitwayFRRs.length > 0) {
    summary.exitwayFRR = Math.max(...exitwayFRRs);
  }

  return summary;
}

module.exports = { processFireResistance };
