const {
  checkFirecellCompliance,
  getEffectiveFloorAreaLimit,
  needsBoundaryDistanceQuestion
} = require('./calculator');

/**
 * Process firecells for all firecells in a project model
 * Calculates firecell compliance for all firecells based on their properties
 * @param {ProjectModel} projectModel - The project model containing all firecells
 * @returns {ProjectModel} The same project model with firecell compliance data added
 */
function processFirecells(projectModel) {
  const firecells = projectModel.getAllFirecells();

  // Get project-level properties
  const distanceFromBoundary15mOrMore = projectModel.distanceFromBoundary15mOrMore || false;

  for (let i = 0; i < firecells.length; i++) {
    const firecell = firecells[i];

    try {
      // Get firecell properties
      const riskGroup = firecell.riskGroup;
      const isSprinklered = firecell.isSprinklered;
      const floorArea = firecell.floorArea;

      // Check if we have the required properties
      if (!riskGroup || typeof isSprinklered !== 'boolean' || typeof floorArea !== 'number') {
        projectModel.firecells[i].firecellCompliance = {
          isCompliant: false,
          reason: 'missing_required_properties',
          effectiveLimit: null,
          needsBoundaryQuestion: false,
          error: 'Missing required properties: riskGroup, isSprinklered, or floorArea'
        };
        continue;
      }

      // Calculate compliance
      const compliance = checkFirecellCompliance(
        riskGroup,
        isSprinklered,
        floorArea,
        distanceFromBoundary15mOrMore
      );

      // Get effective floor area limit
      const effectiveLimit = getEffectiveFloorAreaLimit(
        riskGroup,
        isSprinklered,
        floorArea,
        distanceFromBoundary15mOrMore
      );

      // Check if boundary distance question is needed
      const needsBoundaryQuestion = needsBoundaryDistanceQuestion(
        riskGroup,
        isSprinklered,
        floorArea
      );

      // Add compliance data to the firecell
      projectModel.firecells[i].firecellCompliance = {
        isCompliant: compliance.isCompliant,
        reason: compliance.reason,
        effectiveLimit: effectiveLimit,
        needsBoundaryQuestion: needsBoundaryQuestion,
        compliance: compliance
      };

    } catch (error) {
      // Handle any unexpected errors
      projectModel.firecells[i].firecellCompliance = {
        isCompliant: false,
        reason: 'calculation_error',
        effectiveLimit: null,
        needsBoundaryQuestion: false,
        error: error.message
      };
    }
  }

  return projectModel;
}

module.exports = {
  processFirecells
};