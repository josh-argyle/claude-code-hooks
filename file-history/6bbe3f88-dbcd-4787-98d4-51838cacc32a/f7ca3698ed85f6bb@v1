const { test, expect } = require('@playwright/test');

test.describe('NZS 4515 Sprinkler Substitution & System Validation', () => {

  test('Scenario 1: SM Education with NZS 4515 (within scope, substitution applied)', async ({ page }) => {
    await page.goto('/');

    // Confirm no complex features
    await page.check('#confirmedNoComplexFeatures');

    // Select SM risk group
    await page.selectOption('select[name="firecells[0][riskGroup]"]', 'SM');

    // Select Educational Accommodation
    await page.selectOption('select[name="firecells[0][sleepingOccupantType]"]', 'education');

    // Verify NZS 4515 option appears
    await expect(page.locator('.nzs-4515-option')).toBeVisible();

    // Fill in firecell data
    await page.fill('input[name="firecells[0][floorArea]"]', '1500');
    await page.fill('input[name="firecells[0][escapeHeight]"]', '12');
    await page.selectOption('select[name="firecells[0][isSprinklered]"]', 'true');
    await page.selectOption('select[name="firecells[0][floor]"]', 'G');
    await page.fill('input[name="firecells[0][occupantLoad]"]', '40');
    await page.fill('input[name="firecells[0][numberOfEscapeRoutes]"]', '2');
    await page.fill('input[name="firecells[0][maxEscapeRouteBeds]"]', '20');

    // Select NZS 4515 scope
    await page.selectOption('select[name="isWithinNZS4515Scope"]', 'true');

    // Verify substitution checkbox appears
    await expect(page.locator('.nzs-4515-substitution-choice')).toBeVisible();

    // Check NZS 4515 substitution
    await page.check('input[name="firecells[0][usesNZS4515Sprinklers]"]');

    // Select installed systems (NZS-4515, 9, 18)
    await page.selectOption('select[name="firecells[0][installedFireSafetySystems]"]', ['NZS-4515', '9', '18']);

    // Submit form
    await page.click('button[type="submit"]');

    // Wait for results page
    await expect(page.locator('h1')).toContainText('Fire Safety Compliance Report');

    // Verify NZS 4515 section appears
    await expect(page.locator('text=NZS 4515 Sprinkler Substitution')).toBeVisible();
    await expect(page.locator('text=1500m²')).toBeVisible();
    await expect(page.locator('text=Within NZS 4515 Scope')).toBeVisible();

    // Verify extended scope note (1500 > 500)
    await expect(page.locator('text=Extended Scope Requirements')).toBeVisible();
    await expect(page.locator('text=60-minute water supply')).toBeVisible();

    // Verify substitution applied
    await expect(page.locator('text=NZS 4515 SUBSTITUTION APPLIED')).toBeVisible();

    // Verify validation shows compliant
    await expect(page.locator('text=Fire Safety Systems Validation')).toBeVisible();
    await expect(page.locator('text=✓ COMPLIANT')).toBeVisible();

    // Verify table shows Type 7 substituted
    await expect(page.locator('text=Type 7')).toBeVisible();
    await expect(page.locator('text=Compliant (via NZS-4515)')).toBeVisible();
  });

  test('Scenario 2: SM Education exceeding scope (>2000m², Type 7 required)', async ({ page }) => {
    await page.goto('/');

    await page.check('#confirmedNoComplexFeatures');

    await page.selectOption('select[name="firecells[0][riskGroup]"]', 'SM');
    await page.selectOption('select[name="firecells[0][sleepingOccupantType]"]', 'education');

    await page.fill('input[name="firecells[0][floorArea]"]', '2500');
    await page.fill('input[name="firecells[0][escapeHeight]"]', '12');
    await page.selectOption('select[name="firecells[0][isSprinklered]"]', 'true');
    await page.selectOption('select[name="firecells[0][floor]"]', 'G');
    await page.fill('input[name="firecells[0][occupantLoad]"]', '60');
    await page.fill('input[name="firecells[0][numberOfEscapeRoutes]"]', '2');
    await page.fill('input[name="firecells[0][maxEscapeRouteBeds]"]', '30');

    // Select out of scope
    await page.selectOption('select[name="isWithinNZS4515Scope"]', 'false');

    // Verify substitution checkbox does NOT appear
    await expect(page.locator('.nzs-4515-substitution-choice')).not.toBeVisible();

    // Select installed systems (7, 9, 18)
    await page.selectOption('select[name="firecells[0][installedFireSafetySystems]"]', ['7', '9', '18']);

    await page.click('button[type="submit"]');

    await expect(page.locator('h1')).toContainText('Fire Safety Compliance Report');

    // Verify exceeds scope message
    await expect(page.locator('text=Building exceeds NZS 4515 scope')).toBeVisible();
    await expect(page.locator('text=2500m²')).toBeVisible();
    await expect(page.locator('text=exceeds 2000m² limit')).toBeVisible();

    // Verify validation compliant (Type 7 installed)
    await expect(page.locator('text=✓ COMPLIANT')).toBeVisible();
  });

  test('Scenario 3: Missing required systems (non-compliant)', async ({ page }) => {
    await page.goto('/');

    await page.check('#confirmedNoComplexFeatures');

    await page.selectOption('select[name="firecells[0][riskGroup]"]', 'CA');
    await page.selectOption('select[name="firecells[0][occupantType]"]', 'Space with loose seating');

    await page.fill('input[name="firecells[0][floorArea]"]', '400');
    await page.fill('input[name="firecells[0][escapeHeight]"]', '5');
    await page.selectOption('select[name="firecells[0][isSprinklered]"]', 'false');
    await page.selectOption('select[name="firecells[0][floor]"]', 'G');
    await page.fill('input[name="firecells[0][numberOfEscapeRoutes]"]', '2');
    await page.fill('input[name="firecells[0][maxEscapeRouteOccupants]"]', '150');

    // Intentionally omit Type 9 - only install 4 and 18
    await page.selectOption('select[name="firecells[0][installedFireSafetySystems]"]', ['4', '18']);

    await page.click('button[type="submit"]');

    await expect(page.locator('h1')).toContainText('Fire Safety Compliance Report');

    // Verify non-compliant status
    await expect(page.locator('text=✗ NON-COMPLIANT')).toBeVisible();
    await expect(page.locator('text=required system(s) missing')).toBeVisible();

    // Verify table shows Type 9 missing
    await expect(page.locator('text=Type 9')).toBeVisible();
    await expect(page.locator('text=✗ MISSING')).toBeVisible();

    // Verify missing systems section
    await expect(page.locator('text=Missing Required Systems')).toBeVisible();
    await expect(page.locator('text=Type 9 - Smoke control')).toBeVisible();
  });

  test('Scenario 4: No systems installed (danger state)', async ({ page }) => {
    await page.goto('/');

    await page.check('#confirmedNoComplexFeatures');

    await page.selectOption('select[name="firecells[0][riskGroup]"]', 'WB');
    await page.selectOption('select[name="firecells[0][occupantType]"]', 'Office spaces');

    await page.fill('input[name="firecells[0][floorArea]"]', '800');
    await page.fill('input[name="firecells[0][escapeHeight]"]', '3');
    await page.selectOption('select[name="firecells[0][isSprinklered]"]', 'false');
    await page.selectOption('select[name="firecells[0][floor]"]', 'G');
    await page.fill('input[name="firecells[0][numberOfEscapeRoutes]"]', '2');
    await page.fill('input[name="firecells[0][maxEscapeRouteOccupants]"]', '40');

    // Select "No systems installed"
    await page.selectOption('select[name="firecells[0][installedFireSafetySystems]"]', 'none');

    await page.click('button[type="submit"]');

    await expect(page.locator('h1')).toContainText('Fire Safety Compliance Report');

    // Verify danger state
    await expect(page.locator('text=✗ NO SYSTEMS INSTALLED')).toBeVisible();
    await expect(page.locator('text=All required fire safety systems are missing')).toBeVisible();
  });

  test('Scenario 5: SI Care/Detention with NZS 4515', async ({ page }) => {
    await page.goto('/');

    await page.check('#confirmedNoComplexFeatures');

    await page.selectOption('select[name="firecells[0][riskGroup]"]', 'SI');
    await page.selectOption('select[name="firecells[0][sleepingOccupantType]"]', 'careOrDetention');

    // Verify NZS 4515 option appears for SI
    await expect(page.locator('.nzs-4515-option')).toBeVisible();

    await page.fill('input[name="firecells[0][floorArea]"]', '1800');
    await page.fill('input[name="firecells[0][escapeHeight]"]', '8');
    await page.selectOption('select[name="firecells[0][isSprinklered]"]', 'true');
    await page.selectOption('select[name="firecells[0][floor]"]', 'G');
    await page.fill('input[name="firecells[0][occupantLoad]"]', '50');
    await page.fill('input[name="firecells[0][numberOfEscapeRoutes]"]', '2');
    await page.fill('input[name="firecells[0][maxEscapeRouteBeds]"]', '25');

    await page.selectOption('select[name="isWithinNZS4515Scope"]', 'true');
    await page.check('input[name="firecells[0][usesNZS4515Sprinklers]"]');

    // SI typically requires Type 15 (fire service lift) in addition
    await page.selectOption('select[name="firecells[0][installedFireSafetySystems]"]', ['NZS-4515', '9', '15', '18']);

    await page.click('button[type="submit"]');

    await expect(page.locator('h1')).toContainText('Fire Safety Compliance Report');

    // Verify NZS 4515 section displays for SI
    await expect(page.locator('text=NZS 4515 Sprinkler Substitution')).toBeVisible();
    await expect(page.locator('text=1800m²')).toBeVisible();
    await expect(page.locator('text=NZS 4515 SUBSTITUTION APPLIED')).toBeVisible();

    // Verify compliant
    await expect(page.locator('text=✓ COMPLIANT')).toBeVisible();
  });

  test('Scenario 6: Multi-firecell total area calculation', async ({ page }) => {
    await page.goto('/');

    await page.check('#confirmedNoComplexFeatures');

    // Set number of floors for multi-firecell building
    await page.fill('#numberOfFloorsAboveGround', '2');

    // Firecell 1: SM Education
    await page.selectOption('select[name="firecells[0][riskGroup]"]', 'SM');
    await page.selectOption('select[name="firecells[0][sleepingOccupantType]"]', 'education');
    await page.fill('input[name="firecells[0][floorArea]"]', '800');
    await page.fill('input[name="firecells[0][escapeHeight]"]', '10');
    await page.selectOption('select[name="firecells[0][isSprinklered]"]', 'true');
    await page.selectOption('select[name="firecells[0][floor]"]', 'G');
    await page.fill('input[name="firecells[0][occupantLoad]"]', '30');
    await page.fill('input[name="firecells[0][numberOfEscapeRoutes]"]', '2');
    await page.fill('input[name="firecells[0][maxEscapeRouteBeds]"]', '15');
    await page.selectOption('select[name="isWithinNZS4515Scope"]', 'true');
    await page.check('input[name="firecells[0][usesNZS4515Sprinklers]"]');
    await page.selectOption('select[name="firecells[0][installedFireSafetySystems]"]', ['NZS-4515', '9', '18']);

    // Add Firecell 2
    await page.click('#addFirecell');

    await page.selectOption('select[name="firecells[1][riskGroup]"]', 'CA');
    await page.selectOption('select[name="firecells[1][occupantType]"]', 'Classrooms');
    await page.fill('input[name="firecells[1][floorArea]"]', '600');
    await page.fill('input[name="firecells[1][escapeHeight]"]', '5');
    await page.selectOption('select[name="firecells[1][isSprinklered]"]', 'false');
    await page.selectOption('select[name="firecells[1][floor]"]', '1');
    await page.fill('input[name="firecells[1][numberOfEscapeRoutes]"]', '2');
    await page.fill('input[name="firecells[1][maxEscapeRouteOccupants]"]', '150');
    await page.selectOption('select[name="firecells[1][installedFireSafetySystems]"]', ['4', '9', '18']);

    // Add Firecell 3
    await page.click('#addFirecell');

    await page.selectOption('select[name="firecells[2][riskGroup]"]', 'WB');
    await page.selectOption('select[name="firecells[2][occupantType]"]', 'Office spaces');
    await page.fill('input[name="firecells[2][floorArea]"]', '400');
    await page.fill('input[name="firecells[2][escapeHeight]"]', '3');
    await page.selectOption('select[name="firecells[2][isSprinklered]"]', 'false');
    await page.selectOption('select[name="firecells[2][floor]"]', '2');
    await page.fill('input[name="firecells[2][numberOfEscapeRoutes]"]', '2');
    await page.fill('input[name="firecells[2][maxEscapeRouteOccupants]"]', '40');
    await page.selectOption('select[name="firecells[2][installedFireSafetySystems]"]', ['2', '18']);

    await page.click('button[type="submit"]');

    await expect(page.locator('h1')).toContainText('Fire Safety Compliance Report');

    // Verify total area calculation (800 + 600 + 400 = 1800m²)
    await expect(page.locator('text=1800m²')).toBeVisible();
    await expect(page.locator('text=Within NZS 4515 Scope')).toBeVisible();
    await expect(page.locator('text=NZS 4515 SUBSTITUTION APPLIED')).toBeVisible();

    // Verify all 3 firecells show validation
    const validationSections = page.locator('text=Fire Safety Systems Validation');
    await expect(validationSections).toHaveCount(3);
  });
});
