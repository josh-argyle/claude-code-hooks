const { test, expect } = require('../../fixtures/test-with-rate-limit-reset');
const WhatsNewPage = require('../../page-objects/WhatsNewPage');

test.describe('What\'s New CRUD & Search Tests', () => {
  let whatsNewPage;

  test.beforeEach(async ({ page }) => {
    whatsNewPage = new WhatsNewPage(page);
    await whatsNewPage.navigate();
    await whatsNewPage.waitForArticlesToLoad();
  });

  test.describe('Search & Filter Functionality', () => {
    test('should filter articles by search term', async ({ page }, testInfo) => {
      // Skip this test on mobile projects where search input might not be visible
      test.skip(
        testInfo.project.name.includes('mobile'),
        'Search functionality may not be visible on mobile viewports'
      );
      const initialCount = await whatsNewPage.getAllArticleCount();

      if (initialCount > 0) {
        // Get first article title
        const titles = await whatsNewPage.getArticleTitles();
        const firstTitle = titles[0];

        // Search for part of the title
        const searchTerm = firstTitle.substring(0, 5);
        await whatsNewPage.searchArticles(searchTerm);

        // Check that filtered results are shown
        const visibleCount = await whatsNewPage.getVisibleArticleCount();
        expect(visibleCount).toBeGreaterThan(0);
        expect(visibleCount).toBeLessThanOrEqual(initialCount);
      }
    });

    test('should filter articles by type', async ({ page }, testInfo) => {
      // Skip this test on mobile projects where filter might not be visible
      test.skip(
        testInfo.project.name.includes('mobile'),
        'Filter functionality may not be visible on mobile viewports'
      );
      const articleTypes = await whatsNewPage.getArticleTypes();

      if (articleTypes.length > 0) {
        const firstType = articleTypes[0];
        await whatsNewPage.filterByType(firstType);

        // All visible articles should have the selected type
        const visibleCount = await whatsNewPage.getVisibleArticleCount();
        const totalCount = await whatsNewPage.getAllArticleCount();

        expect(visibleCount).toBeLessThanOrEqual(totalCount);
      }
    });

    test('should reset search and filters', async ({ page }, testInfo) => {
      // Skip this test on mobile projects where search/filter might not be visible
      test.skip(
        testInfo.project.name.includes('mobile'),
        'Search and filter functionality may not be visible on mobile viewports'
      );
      const initialCount = await whatsNewPage.getAllArticleCount();

      if (initialCount > 0) {
        // Apply search
        await whatsNewPage.searchArticles('test');

        // Reset
        await whatsNewPage.resetSearch();

        // Check all articles are visible again
        const visibleCount = await whatsNewPage.getVisibleArticleCount();
        expect(visibleCount).toBe(initialCount);

        // Check search input is cleared
        const searchValue = await whatsNewPage.searchInput.inputValue();
        expect(searchValue).toBe('');
      }
    });
  });

  test.describe('CRUD Operations', () => {
    test('should create new article successfully', async ({ page }) => {
      const initialCount = await whatsNewPage.getAllArticleCount();

      await whatsNewPage.clickAddArticle();

      // Fill the form
      const testTitle = `Test Article ${Date.now()}`;
      await whatsNewPage.fillAddArticleForm(
        testTitle,
        'This is test content for the automated test.',
        'Update'
      );

      // Submit
      await whatsNewPage.submitAddArticle();

      // Wait for optimistic update to complete (no page reload)
      await page.waitForTimeout(1000);

      // Verify article was added
      const newCount = await whatsNewPage.getAllArticleCount();
      expect(newCount).toBe(initialCount + 1);

      // Find the new article
      const newArticle = await whatsNewPage.getArticleByTitle(testTitle);
      expect(newArticle).not.toBeNull();
    });

    test('should update article successfully', async ({ page }) => {
      const articleCount = await whatsNewPage.getAllArticleCount();

      if (articleCount > 0) {
        await whatsNewPage.clickArticleCard(0);

        // Update title
        const updatedTitle = `Updated ${Date.now()}`;
        await whatsNewPage.fillEditArticleForm(updatedTitle, undefined, undefined);

        // Submit
        await whatsNewPage.submitEditArticle();

        // Wait for optimistic update to complete (no page reload)
        await page.waitForTimeout(2000);

        // Verify article was updated
        const updatedArticle = await whatsNewPage.getArticleByTitle(updatedTitle);
        expect(updatedArticle).not.toBeNull();
      }
    });

    test('should archive article with confirmation', async ({ page }) => {
      const articleCount = await whatsNewPage.getAllArticleCount();

      if (articleCount > 0) {
        // Get initial article title
        const titles = await whatsNewPage.getArticleTitles();
        const titleToArchive = titles[0];

        // Set up dialog handler before clicking
        page.once('dialog', dialog => {
          expect(dialog.message()).toContain('Are you sure');
          dialog.accept();
        });

        // Open edit modal for first article
        await whatsNewPage.clickArticleCard(0);

        // Click archive button in modal
        await whatsNewPage.clickArchiveButton();

        // Wait for success notification
        await whatsNewPage.waitForSuccessNotification();

        // Wait for page reload
        await page.waitForLoadState('networkidle');
        await page.waitForTimeout(1000);

        // Wait for articles to load on the reloaded page
        await whatsNewPage.waitForArticlesToLoad();

        // Verify article is no longer visible
        const archivedArticle = await whatsNewPage.getArticleByTitle(titleToArchive);
        expect(archivedArticle).toBeNull();
      }
    });
  });
});
