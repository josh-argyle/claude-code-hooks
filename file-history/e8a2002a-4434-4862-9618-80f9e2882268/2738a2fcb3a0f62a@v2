const evaluateNote1a = require('../../../../api/processors/fire-safety-systems/note-evaluators/note-1a-evaluator');

describe('Note 1a Evaluator - SM Risk Group Type 2 System Exemption', () => {
  describe('Applicability', () => {
    test('should not apply to non-SM risk groups', () => {
      const firecell = { riskGroup: 'CA' };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(false);
      expect(result.exempt).toBeUndefined();
      expect(result.reason).toBeUndefined();
    });

    test('should apply to SM risk group', () => {
      const firecell = {
        riskGroup: 'SM',
        escapeHeight: 5
      };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(true);
    });
  });

  describe('Exemption - Bed Count', () => {
    test('should grant exemption when maxEscapeRouteBeds is 10 or less', () => {
      const firecell = {
        riskGroup: 'SM',
        maxEscapeRouteBeds: 10,
        escapeHeight: 8
      };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(true);
      expect(result.reason).toContain('≤10 beds');
    });

    test('should grant exemption when maxEscapeRouteBeds is less than 10', () => {
      const firecell = {
        riskGroup: 'SM',
        maxEscapeRouteBeds: 5,
        escapeHeight: 8
      };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(true);
    });

    test('should not grant exemption when maxEscapeRouteBeds exceeds 10', () => {
      const firecell = {
        riskGroup: 'SM',
        maxEscapeRouteBeds: 11,
        escapeHeight: 8
      };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
      expect(result.reason).toContain('no exemption');
    });

    test('should handle maxEscapeRouteBeds of 0', () => {
      const firecell = {
        riskGroup: 'SM',
        maxEscapeRouteBeds: 0,
        escapeHeight: 8
      };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(true);
    });

    test('should fallback to maxEscapeRouteOccupants if maxEscapeRouteBeds not provided', () => {
      const firecell = {
        riskGroup: 'SM',
        maxEscapeRouteOccupants: 8,
        escapeHeight: 8
      };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(true);
    });
  });

  describe('Exemption - Direct Exit to Safe Place', () => {
    test('should grant exemption when exitDirectlyToSafePlace is true', () => {
      const firecell = {
        riskGroup: 'SM',
        exitDirectlyToSafePlace: true,
        escapeHeight: 8
      };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(true);
      expect(result.reason).toContain('Direct exit to safe place');
    });

    test('should not grant exemption when exitDirectlyToSafePlace is false', () => {
      const firecell = {
        riskGroup: 'SM',
        exitDirectlyToSafePlace: false,
        maxEscapeRouteBeds: 15,
        escapeHeight: 8
      };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });

    test('should grant exemption when either bed count OR direct exit condition is met', () => {
      const firecell = {
        riskGroup: 'SM',
        exitDirectlyToSafePlace: true,
        maxEscapeRouteBeds: 20, // Over limit but direct exit is true
        escapeHeight: 8
      };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(true);
    });
  });

  describe('Type 1 Smoke Alarms - Transient Accommodation', () => {
    test('should require Type 1 smoke alarms for transient with escape height < 4m when exempt', () => {
      const firecell = {
        riskGroup: 'SM',
        sleepingOccupantType: 'transient', // UPDATED: was smOccupantType
        escapeHeight: 3,
        maxEscapeRouteBeds: 5
      };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(true);
      expect(result.requiresType1SmokeAlarms).toBe(true);
      expect(result.reason).toContain('Type 1 smoke alarms required');
    });

    test('should not require Type 1 smoke alarms for transient with escape height >= 4m', () => {
      const firecell = {
        riskGroup: 'SM',
        sleepingOccupantType: 'transient', // UPDATED: was smOccupantType
        escapeHeight: 5,
        maxEscapeRouteBeds: 5
      };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(true);
      expect(result.requiresType1SmokeAlarms).toBeUndefined();
    });

    test('should not require Type 1 smoke alarms for permanent accommodation', () => {
      const firecell = {
        riskGroup: 'SM',
        sleepingOccupantType: 'permanent', // UPDATED: was smOccupantType
        escapeHeight: 3,
        maxEscapeRouteBeds: 5
      };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(true);
      expect(result.requiresType1SmokeAlarms).toBeUndefined();
    });

    test('should not require Type 1 smoke alarms when not exempt', () => {
      const firecell = {
        riskGroup: 'SM',
        sleepingOccupantType: 'transient', // UPDATED: was smOccupantType
        escapeHeight: 3,
        maxEscapeRouteBeds: 15 // Not exempt
      };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
      expect(result.requiresType1SmokeAlarms).toBeUndefined();
    });
  });

  describe('Edge Cases', () => {
    test('should handle missing bed count and direct exit data as no exemption', () => {
      const firecell = {
        riskGroup: 'SM',
        escapeHeight: 8
      };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });

    test('should handle missing escape height gracefully', () => {
      const firecell = {
        riskGroup: 'SM',
        maxEscapeRouteBeds: 5
      };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(true);
    });

    test('should handle invalid bed count types', () => {
      const firecell = {
        riskGroup: 'SM',
        maxEscapeRouteBeds: 'invalid',
        escapeHeight: 8
      };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });

    test('should handle negative bed counts as invalid', () => {
      const firecell = {
        riskGroup: 'SM',
        maxEscapeRouteBeds: -5,
        escapeHeight: 8
      };
      const result = evaluateNote1a(firecell);

      expect(result.applies).toBe(true);
      expect(result.exempt).toBe(false);
    });
  });

  describe('Reason Messages', () => {
    test('should provide clear reason when bed exemption applies', () => {
      const firecell = {
        riskGroup: 'SM',
        maxEscapeRouteBeds: 10,
        escapeHeight: 8
      };
      const result = evaluateNote1a(firecell);

      expect(result.reason).toBe('Max escape route serves ≤10 beds');
    });

    test('should provide clear reason when direct exit exemption applies', () => {
      const firecell = {
        riskGroup: 'SM',
        exitDirectlyToSafePlace: true,
        escapeHeight: 8
      };
      const result = evaluateNote1a(firecell);

      expect(result.reason).toBe('Direct exit to safe place');
    });

    test('should provide clear reason when no exemption applies', () => {
      const firecell = {
        riskGroup: 'SM',
        maxEscapeRouteBeds: 15,
        escapeHeight: 8
      };
      const result = evaluateNote1a(firecell);

      expect(result.reason).toBe('Standard requirement - no exemption conditions met');
    });
  });
});